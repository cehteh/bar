#!/usr/bin/env bar
# -*- mode: sh; sh-shell: bash -*-
# vim: set ft=bash:
# shellcheck shell=bash
# shellcheck disable=SC2016

# This is the barfile for maintaining 'bar' itself. A more generalized and customizeable barfile
# that become installed with 'bar init_local' is the Barf.default file in this directory.

#shellcheck disable=2034
SHELLCHECK_LS_FILES=":!tests"


# We lint and build the doc here
MAIN: doc lints

# the checks an agent runs in this repository; 'bar check agent' prints the terse contract block
agent: lints tests

require git

function nodbg
{
    # shellcheck disable=2046
    if grep -n '^[[:space:]]*DBG' $(git_ls_files -c --other -- ':!README' ); then
        return 1
    fi
}

lints: 'is_testdir_used?' nodbg

# The repertoire guard: every rule of a helper module has to be registered with a
# '# helper: <name> | <purpose> | <invocation> | <output shape>' declaration above it
# (see Bar.d/helpers_rules).  A helper which is added without its declaration fails 'lints'.
lints: helpers_check

# manually testing the staged changes
test_staged: testdir_enter lints

# maintenance rules
build_docs:
	./bar help >README

# called by another name (githook)
pre-commit: (check agent)

# TODO: test Barf.default

## Run all tests in tests/ directory
