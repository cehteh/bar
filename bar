### The main BAsh Rulez script
###
### Provides only basic functionality for module loading and debugging and starting rule
### evaluation. Loads the 'std_lib' and 'rule_lib' to make them omnipresent.

# PLANNED: Autoinstall rules from global dir to local Barf.d
# PLANNED: parallel dependencies dep+
# PLANNED: load make style rules from a file?

function bar_main ## [rulefile] [--bare] [rule [arguments..]] - Loads a rulefile and executes rule with optional arguments
{
    ## [rulefile]           - File to load the user rules from.
    ##                        Default: Barf|barf|.Barf|.barf when called as bar or symlink.
    ##                                 Pleasef|pleasef|.Pleasef|.pleasef|\$HOME/.Pleasef when called as please.
    ## [--bare]             - Don't eval SETUP, PREPROCESS, POSTPROCESS and CLEANUP.
    ## [rule [arguments..]] - Target rule with arguments.
    ##                        Default: MAIN
    trace "$*"
    # shell sanity options
    set -euo pipefail
    # shellcheck disable=SC2155
    export LC_ALL=$(locale -a 2>/dev/null | grep -i 'C.utf.*8' || echo C)

    export TMPDIR="${TMPDIR:-/tmp}"

    # shellcheck disable=SC2155
    declare -grx BAR_SELF="$(realpath "$BASH_ARGV0")"  ## Path to bar itself.
    declare -grx BAR_CALLED_AS="${BASH_ARGV0##*/}"     ## Name of bar when called by symlink.
    declare -gx  BAR_DIR                               ## Directory to load rules from.
    declare -g   BAR_BARE                              ## When set, don't eval SETUP, PREPROCESS, POSTPROCESS and CLEANUP.
    declare -gx  BARF_FILE                             ## The Barf file used.
    declare -gxr BAR_PWD="$PWD"                        ## Initial working directory.
    declare -gxi BAR_VERBOSITY_LEVEL="${BAR_VERBOSITY_LEVEL:-2}" ## Verbosity level from 0 (silent) to 6 (trace).
    declare -gA  BAR_REQUIRE_LOADED
    # The style names of 'tty_lib' before it is loaded.  The module is found through 'BAR_DIR',
    # which 'find_toplevel' resolves below, and that function reports through these very tables:
    # with empty values the bootstrap -- and a project without 'tty_lib' -- prints unstyled,
    # which is what a stream that is no terminal gets.  'tty_lib' replaces both tables with the
    # real codes and binds 'TTYOUT'/'TTYERR' to them when it loads, 'Bar.d/tty_lib' names them.
    # shellcheck disable=2034
    declare -gA TTYOUT TTYERR
    local _style
    for _style in reset label ok fail panic warn info debug trace dbg strike clear_eol \
                       clear_line cr; do
        # shellcheck disable=2034
        TTYOUT[$_style]='' TTYERR[$_style]=''
    done
    unset _style

    # bootstrap/load std_lib (which defines 'require')
    # shellcheck disable=SC1091
    find_toplevel
    debug "using Bar directory: $BAR_DIR"
    # the std_lib and rule_lib are omnipresent other modules don't need to require it
    require std_lib rule_lib
    # load all '*_rules'
    require '*_rules'

    local maybe_barf=
    local initial_rule=
    if [[ "$BAR_CALLED_AS" =~ \.?bar|please ]]; then
        maybe_barf="${1:-}"
    else
        initial_rule="$BAR_CALLED_AS"
    fi

    local barfs=("$BAR_TOPLEVEL/Barf" "$BAR_TOPLEVEL/barf" "$BAR_TOPLEVEL/.Barf" "$BAR_TOPLEVEL/.barf")
    if [[ "$BAR_CALLED_AS" = please ]]; then
        barfs=("Pleasef" "pleasef" ".Pleasef" ".pleasef" "$HOME/.Pleasef")
    fi

    for BARF_FILE in "$maybe_barf" "${barfs[@]}"; do
        if [[ -f "$BARF_FILE" ]]; then
            debug "using: $BARF_FILE"
            [[ "$BARF_FILE" = "$maybe_barf" ]] && shift
            BARF_FILE="$(realpath "$BARF_FILE")"
            require "$BARF_FILE"
            break
        fi
    done

    if [[ "${1:-}" = '--bare' ]]; then
        shift
        BAR_BARE=true
    fi

    local rc=0
    [[ -z "$initial_rule" && -n "${1:-}" ]] && rule_autoload "$1"
    # shellcheck disable=SC2155
    declare -grix BAR_TIMESTAMP="$(bar_now)" ## Timestamp in microseconds since epoch of this invocation

    [[ -z "${initial_rule}" ]] && {
        initial_rule="${1:-MAIN}"
        shift || true
    }

    [[ "${BAR_RULE_FLAGS[$initial_rule]:-}" == *b* ]] && BAR_BARE=true

    if rule_exists "$initial_rule"; then
        [[ -z "${BAR_BARE:-}" ]] && {
            trap 'rule_exists CLEANUP && { rule_eval CLEANUP || error "CLEANUP failed" ; }' EXIT
            rule_exists SETUP && {
                rule_eval SETUP || die "SETUP failed" ;
            }
            rule_exists PREPROCESS && {
                rule_eval PREPROCESS || die "PREPROCESS failed" ;
            }
        }

        rule_eval "$initial_rule" "$@" || rc=$?
        if (( "$rc" == 0 )); then
            success "$initial_rule" "$@"
            [[ -z "${BAR_BARE:-}" ]] && rule_exists POSTPROCESS && { rule_eval POSTPROCESS || error "POSTPROCCESS failed" ; }
        else
            failure "$initial_rule" "$@"
        fi

        return $rc
    else
        die "No Barf/Pleasef file found in current directory and no rule defined.

USAGE

  bar [Rulefile] [Rule [Arguments]]
  please [Rulefile] [Rule [Arguments]]
or
  bar help
  please help
"
    fi
}

# When no rule directory is found the modules installed below BAR_PREFIX are used, but BAR_TOPLEVEL
# still stays the directory bar was invoked from: it must never end up as some ancestor or '/', which
# would resolve the rulefile (and everything else bar keeps in the project) outside of it.
function find_toplevel
{
    # The rule directory is 'Bar.d', 'bar.d', '.Bar.d' or '.bar.d' in the directory bar was invoked
    # from or in the closest ancestor that has one.  The walk upwards stops at the filesystem
    # boundary unless BAR_CROSS_FS is set.  On success BAR_TOPLEVEL is the directory that contains
    # the rule directory and is made readonly; everything that is project relative is resolved
    # below it.  'please' is the exception: its modules live in a single, absolute directory
    # (~/.config/please), no ancestor is searched.
    # shellcheck disable=2155
    local origin="$(command -v bar)"
    declare -gxr BAR_PREFIX="${origin%/bin/*}"
    declare -gx BAR_TOPLEVEL="$BAR_PWD"
    # shellcheck disable=2155
    local initial_fs_id="$(stat -f -c %i "$BAR_TOPLEVEL")"

    local -a barfd=("Bar.d" "bar.d" ".Bar.d" ".bar.d")
    local -i walk=1
    if [[ "$BAR_CALLED_AS" = please ]]; then
        barfd=("$HOME/.config/please")
        walk=0
    fi

    local cursor="$BAR_TOPLEVEL" name candidate
    while :; do
        for name in "${barfd[@]}"; do
            if [[ "$name" = /* ]]; then
                candidate="$name"
            else
                candidate="$cursor/$name"
            fi
            if [[ -d "$candidate" ]]; then
                BAR_DIR="$candidate"
                BAR_TOPLEVEL="$cursor"
                readonly BAR_TOPLEVEL
                return 0
            fi
        done
        (( walk )) || break
        if [[ "$cursor" = "/" ]]; then
            break
        fi
        cursor="$(readlink -f "$cursor/..")"
        if [[ ! -v BAR_CROSS_FS && "$(stat -f -c %i "$cursor")" != "$initial_fs_id" ]]; then
            break
        fi
    done

    warn "No Bar.d directory found, trying original/installed"

    BAR_DIR="$BAR_PREFIX/share/bar/Bar.d"
    [[ -d "$BAR_DIR" ]] || die "Bar directory '$BAR_DIR' does not exist"
}

function bar_origin_dir ## - the 'Bar.d' of the installation bar was run from, when it is not the one in use
{
    ## A project may carry its own (vendored) 'Bar.d', then the installation bar was run from is
    ## where modules missing from the project are taken from.  When bar runs from its
    ## installation there is no origin.  'please' has no vendored copy either: its modules live
    ## in a single, absolute directory.
    [[ -n "$BAR_PREFIX" && -d "$BAR_PREFIX/share/bar/Bar.d" ]] || return 1
    [[ "$BAR_CALLED_AS" != please ]] || return 1
    [[ "$(realpath "$BAR_DIR")" != "$(realpath "$BAR_PREFIX/share/bar/Bar.d")" ]] || return 1
    printf '%s\n' "$BAR_PREFIX/share/bar/Bar.d"
}

function bar_vendor_modules ## <modpath> - installs a module of Bar.d which is missing from the origin, prints what it installed
{
    ## <modpath> - The path the module would have in 'Bar.d' (a glob is expanded there).
    ##
    ## Copies the module(s) from the origin installation into 'Bar.d'.  An existing module is
    ## never touched (that is what '--update' of the init rules is for) and the origin is never
    ## written to, installing only ever adds a copy here.  Prints the installed paths, returns
    ## non-zero when there is no origin, the name is not a module of this 'Bar.d' or the origin
    ## does not have it either.
    local path="$1"
    local origin
    origin="$(bar_origin_dir)" || return 1
    local rel="${path#"$BAR_DIR"/}"
    [[ "$rel" != "$path" && "$rel" != */* ]] || return 1
    local -a found=()
    readarray -t found < <(compgen -G "$origin/$rel"; true)
    (( ${#found[@]} )) || return 1
    local -i installed=0
    local src dst
    for src in "${found[@]}"; do
        dst="$BAR_DIR/${src##*/}"
        [[ -f "$dst" ]] && continue
        cp -L "$src" "$dst.tmp" || continue
        mv "$dst.tmp" "$dst" || { rm -f "$dst.tmp"; continue; }
        note "installed module '${src##*/}' from ${src%/*}"
        printf '%s\n' "$dst"
        installed+=1
    done
    (( installed ))
}

# The rule-file filter (see :func:`preprocess`).  It is embedded here rather than kept in a
# 'Bar.d' module: it has to exist before the first module is sourced, and 'bar_vendor_modules'
# copies a module into a project's 'Bar.d', where a copy would trail the 'bar' that runs it.
declare -g BARF_PP_AWK=""
IFS= read -r -d '' BARF_PP_AWK <<'AWK' || true
# bar's rule-file preprocessor: expand the make/just syntax into the 'rule' syntax.
#
# Infallible by design.  A line which matches no transform is printed unchanged; one input line
# produces exactly one output line, in order, and nothing is added, dropped, merged or reordered.
# 'source <(preprocess f)' cannot report a failure of this program, so it must not have one: every
# state machine closes in END and no path exits.

function indentof(line,   i, n) {
    n = length(line)
    for (i = 1; i <= n; i++)
        if (substr(line, i, 1) != " " && substr(line, i, 1) != "\t")
            return i - 1
    return n
}

# text as one single quoted shell word
function squote(text) {
    gsub(/\047/, "\047\\\047\047", text)
    return text
}

function closebody(   i) {
    for (i = 1; i <= nbody; i++)
        print (i == nbody ? body[i] "\047" : body[i])
    nbody = 0
    inbody = 0
}

function flushheader(   i) {
    if (!havehdr)
        return
    print hdr
    for (i = 1; i <= nblank; i++)
        print ""
    nblank = 0
    havehdr = 0
}

function flushattrs(   i) {
    for (i = 1; i <= nattr; i++)
        print attrline[i]
    nattr = 0
    attrflags = ""
}

# The '[flag]' lines of a header which carries them are kept as comments: the flags travel on the
# 'rule' line, and one line in has to stay one line out, or every line number behind a flagged
# header would name the wrong line in bar's own diagnostics.  '[always]' is not a command.
function commentattrs(   i) {
    for (i = 1; i <= nattr; i++)
        print "# " attrline[i]
}

# Track the quote state across lines and queue the heredocs a line opens.  Sets sq/dq for a
# string left open at the end of the line.
function scan(line,   i, n, c, q, st, w, strip, pos) {
    # the common line carries neither a quote, an escape, a comment nor a '<': nothing to track
    if (!sq && !dq && line !~ /[\\\047"#<]/) {
        sq = 0
        dq = 0
        return
    }
    n = length(line)
    st = (sq ? 1 : (dq ? 2 : 0))
    for (i = 1; i <= n; i++) {
        c = substr(line, i, 1)
        if (st == 1) {
            if (c == "\047")
                st = 0
            continue
        }
        if (st == 2) {
            if (c == "\\") { i++; continue }
            if (c == "\"")
                st = 0
            continue
        }
        if (c == "\\") { i++; continue }
        if (c == "#" && (i == 1 || substr(line, i - 1, 1) ~ /[ \t;|&(]/))
            break
        if (c == "\047") { st = 1; continue }
        if (c == "\"") { st = 2; continue }
        if (c != "<" || substr(line, i + 1, 1) != "<")
            continue
        if (substr(line, i + 2, 1) == "<") { i += 2; continue }     # <<< herestring
        pos = i + 2
        strip = 0
        if (substr(line, pos, 1) == "-") { strip = 1; pos++ }
        while (substr(line, pos, 1) == " " || substr(line, pos, 1) == "\t")
            pos++
        q = substr(line, pos, 1)
        if (q == "\047" || q == "\"")
            pos++
        else if (q == "\\") { q = ""; pos++ }
        else
            q = ""
        w = ""
        while (pos <= n) {
            c = substr(line, pos, 1)
            if (q != "") {
                if (c == q) { pos++; break }
            } else if (c ~ /[ \t;|&<>()]/)
                break
            w = w c
            pos++
        }
        # a number is an arithmetic shift, not a here document
        if (w != "" && w !~ /^[0-9]+$/) {
            nh++
            hterm[nh] = w
            hstrip[nh] = strip
        }
        i = pos - 1
    }
    sq = (st == 1)
    dq = (st == 2)
}

# length of the word starting at <start> of <text>, quote, escape and paren aware
function wordlen(text, start,   i, n, c, depth, q) {
    n = length(text)
    i = start
    depth = 0
    q = ""
    while (i <= n) {
        c = substr(text, i, 1)
        if (q == "\047") {
            if (c == "\047") q = ""
            i++
            continue
        }
        if (q == "\"") {
            if (c == "\\") { i += 2; continue }
            if (c == "\"") q = ""
            i++
            continue
        }
        if (c == "\\") { i += 2; continue }
        if (c == "\047" || c == "\"") { q = c; i++; continue }
        if (c == "(") { depth++; i++; continue }
        if (c == ")") { if (depth > 0) depth--; i++; continue }
        if (depth == 0 && (c == " " || c == "\t" || c == ";"))
            break
        i++
    }
    return i - start
}

# '<pre>(<inner>)<post>' as one quoted dependency, the modifiers lifted onto its first word
function parens(tok,   i, n, c, q, depth, op, cl, pre, inner, post, len, first, more) {
    n = length(tok)
    q = ""
    depth = 0
    op = 0
    for (i = 1; i <= n; i++) {
        c = substr(tok, i, 1)
        if (q != "") {
            if (q == "\"" && c == "\\") { i++; continue }
            if (c == q) q = ""
            continue
        }
        if (c == "\\") { i++; continue }
        if (c == "\047" || c == "\"") { q = c; continue }
        if (c == "(" && depth == 0 && op == 0) { op = i; depth = 1; continue }
        if (c == "(" && op != 0) { depth++; continue }
        if (c == ")" && op != 0) {
            depth--
            if (depth == 0) { cl = i; break }
        }
    }
    if (op == 0 || cl == 0)
        return tok
    pre = substr(tok, 1, op - 1)
    inner = substr(tok, op + 1, cl - op - 1)
    post = substr(tok, cl + 1)
    sub(/^[ \t]+/, "", inner)
    sub(/[ \t]+$/, "", inner)
    if (inner == "")
        return tok
    len = wordlen(inner, 1)
    first = substr(inner, 1, len)
    more = substr(inner, len + 1)
    sub(/^[ \t]+/, "", more)
    return "\047" squote(pre first post (more == "" ? "" : " " more)) "\047"
}

# the text after 'name:' -- clause flags, dependencies, an inline body
function depregion(rest,   i, n, c, k, cnt, j, inner, lead, flags, cf, tok, w, out) {
    n = length(rest)
    i = 1
    while (i <= n && substr(rest, i, 1) ~ /[ \t]/)
        i++
    lead = substr(rest, 1, i - 1)
    flags = ""
    while (substr(rest, i, 1) == "[") {
        j = index(substr(rest, i), "]")
        if (j == 0)
            break
        inner = substr(rest, i + 1, j - 2)
        if (inner !~ /^[a-z][a-z-]*([ \t]+[a-z][a-z-]*)*$/)
            break
        cnt = split(inner, cf, /[ \t]+/)
        for (k = 1; k <= cnt; k++)
            flags = flags " --" cf[k]
        i += j
        while (i <= n && substr(rest, i, 1) ~ /[ \t]/)
            i++
    }
    rest = substr(rest, i)
    if (flags != "") {
        lead = ""
        rest = (rest == "" ? "" : " " rest)
    }

    out = ""
    i = 1
    n = length(rest)
    while (i <= n) {
        c = substr(rest, i, 1)
        if (c == " " || c == "\t") {
            out = out c
            i++
            continue
        }
        if (c == ";") {
            sub(/[ \t]+$/, "", out)
            w = substr(rest, i + 1)
            sub(/^[ \t]+/, "", w)
            out = out " -- " w
            break
        }
        w = wordlen(rest, i)
        tok = substr(rest, i, w)
        if (index(tok, "("))
            tok = parens(tok)
        out = out tok
        i += w
    }
    return lead flags out
}

# Every state the program carries across lines, back to its start-of-file value: BEGIN runs it, and
# so does the end of a frame when one awk serves several files (see :func:`barf_pp_start`).
function framereset() {
    nh = 0
    sq = 0
    dq = 0
    nattr = 0
    attrflags = ""
    havehdr = 0
    hdr = ""
    nblank = 0
    inbody = 0
    base = 0
    nbody = 0
}

BEGIN {
    framereset()
}

# A frame is one file: the program is told its path and reads it itself, so no writer has to run
# beside the reader and a file without a trailing newline ends where it ends.  What the file left
# buffered is printed, its state dropped, and the marker closes the frame on the channel.
function frame(path,   n, line) {
    while ((getline line < path) > 0)
        transform(line)
    close(path)
    framedrain()
    framereset()
    print mark
    fflush()
}

{
    if (mark != "" && substr($0, 1, 2) == "F ")
        frame(substr($0, 3))
    else
        transform($0)
}

# One line of input through the whole transform: the program's name for a rule, and the only
# entry point a frame has -- a line off stdin and a line read out of a file go the same way.
function transform(line) {

    # a here document body is data
    if (nh > 0) {
        print line
        cmp = line
        if (hstrip[1])
            sub(/^\t+/, "", cmp)
        if (cmp == hterm[1]) {
            for (i = 1; i < nh; i++) {
                hterm[i] = hterm[i + 1]
                hstrip[i] = hstrip[i + 1]
            }
            nh--
        }
        return
    }

    # the rest of a multi line quoted string is data
    if (sq || dq) {
        print line
        scan(line)
        return
    }

    # an indented body block
    if (inbody) {
        if (line ~ /^[ \t]*$/) {
            body[++nbody] = ""
            return
        }
        if (indentof(line) >= base) {
            body[++nbody] = squote(substr(line, base + 1))
            return
        }
        closebody()
    }

    # blank lines between a buffered header and its body belong to the body
    if (havehdr && line ~ /^[ \t]*$/) {
        nblank++
        return
    }

    if (line ~ /^[ \t]*$/) {
        flushattrs()
        print line
        return
    }

    # an indented line after a buffered header is its body
    if (havehdr && indentof(line) > 0) {
        print hdr ((hdr ~ /--?$/) ? "\047" : " -- \047")
        for (i = 1; i <= nblank; i++)
            print ""
        nblank = 0
        havehdr = 0
        base = indentof(line)
        inbody = 1
        nbody = 0
        body[++nbody] = squote(substr(line, base + 1))
        return
    }

    # a header which nothing indented follows stays a plain header
    if (havehdr)
        flushheader()

    # 'NAME := value' is make's 'NAME=value'
    if (match(line, /^[A-Za-z_][A-Za-z0-9_]*[ \t]*:=/)) {
        flushattrs()
        name = substr(line, 1, RLENGTH)
        sub(/[ \t]*:=$/, "", name)
        value = substr(line, RLENGTH + 1)
        sub(/^[ \t]+/, "", value)
        print name "=" value
        scan(line)
        return
    }

    # 'NAME ?= value' is make's 'NAME ?= value' with the current value kept
    if (match(line, /^[A-Za-z_][A-Za-z0-9_]*[ \t]*\?=/)) {
        flushattrs()
        name = substr(line, 1, RLENGTH)
        sub(/[ \t]*\?=$/, "", name)
        value = substr(line, RLENGTH + 1)
        sub(/^[ \t]+/, "", value)
        print ": \"${" name ":=" value "}\""
        scan(line)
        return
    }

    # stacked '[flag]' lines attach to the next header
    if (line ~ /^\[[a-z][a-z-]*([ \t]+[a-z][a-z-]*)*\][ \t]*(#.*)?$/) {
        inner = line
        sub(/^\[/, "", inner)
        sub(/\].*$/, "", inner)
        cnt = split(inner, tok, /[ \t]+/)
        for (k = 1; k <= cnt; k++)
            attrflags = attrflags " --" tok[k]
        attrline[++nattr] = line
        return
    }

    # a header: '<name>: ...' at column 0
    if (line ~ /^[A-Za-z_][A-Za-z0-9_.-]*:/ && line !~ /\\$/) {
        flushheader()
        nblank = 0
        match(line, /^[A-Za-z_][A-Za-z0-9_.-]*:/)
        name = substr(line, 1, RLENGTH - 1)
        hdr = "rule" (nattr ? attrflags : "") " " name ":" depregion(substr(line, RLENGTH + 1))
        commentattrs()
        attrflags = ""
        nattr = 0
        havehdr = 1
        scan(line)
        # a header line which opens a string or a heredoc has its data behind it: it can not be
        # waiting for a body block, or the data would overtake it
        if (sq || dq || nh > 0)
            flushheader()
        return
    }

    # anything else passes through
    flushattrs()
    print line
    scan(line)
}

# an indented body may start with the first indented line after a buffered header; a body block or a
# header still buffered when the text ends belongs to the file that buffered it
function framedrain() {
    if (inbody)
        closebody()
    flushheader()
    flushattrs()
}

END {
    framedrain()
    if (mark != "")
        fflush()
}
AWK

# The preprocessor is started once per run and talked to over two descriptors: the path of a file
# goes in as 'F <path>', the printed text comes back with BAR_PP_MARK closing the frame.  The
# marker is also what clears the state the file leaves behind, so a file expands as if it were the
# only one -- awk's startup is paid once instead of once per module.
# No regex metacharacter in the marker: the reader matches it with 'sed'.
declare -g BAR_PP_IN="" BAR_PP_OUT="" BAR_PP_MARK='!!!!!!!!!!!!!!!!!EOF!!!!!!!!!!!!!!!!!'

function barf_pp_start # - starts the preprocessor; sets BAR_PP_IN and BAR_PP_OUT
{
    # 'coproc' hands the two ends of the connection out as BARF_PP[0] (read) and BARF_PP[1]
    # (write), but bash closes a coprocess's own descriptors in every subshell -- and 'preprocess'
    # runs in one ('<(preprocess f)'), as does the writer of a frame.  They are duplicated onto
    # ordinary descriptors, which are inherited, and both stay open for the rest of the run: a
    # closed descriptor is reused by the next 'exec {fd}<' and the module behind it would report
    # the wrong file.
    local ppin ppout ppw ppr
    coproc BARF_PP { LC_ALL=C awk -v mark="$BAR_PP_MARK" "$BARF_PP_AWK"; }
    ppw="${BARF_PP[1]}" ppr="${BARF_PP[0]}"
    exec {ppin}>&"$ppw" {ppout}<&"$ppr"
    exec {ppw}>&- {ppr}<&-
    BAR_PP_IN="$ppin"
    BAR_PP_OUT="$ppout"
}

# Started here, in the shell which sources the modules: 'preprocess' runs in a subshell -- 'require'
# sources '<(preprocess f)' -- and a descriptor set there does not outlive the module.
if [[ -n "${BARF_PP_AWK:-}" ]] && command -v awk >/dev/null; then
    barf_pp_start
fi

function preprocess ## <file> - Print a rule file with its make/just syntax expanded
{
    ## <file> - The rule file to print.
    ##
    ## Prints the text which 'require' sources for the file: a line written in the syntax close to
    ## makefiles and justfiles is expanded into the 'rule' syntax and every other line is passed
    ## through unchanged.  The preprocessor is infallible, it never refuses input -- what it does
    ## not understand is reported by bar's own parser, at the line it is on.  A file it cannot read
    ## is an error rather than an empty expansion.  'bar preprocess <file>' shows exactly the text
    ## which gets sourced.  That syntax is documented under "RULE FILE PREPROCESSOR" in 'bar help'.
    case "${1:-}" in
    -h | --help)
        require --opt help
        help_usage preprocess
        return 0
        ;;
    "")
        require --opt help
        help_usage_error preprocess "no rule file given"
        return 2
        ;;
    esac
    if [[ -z "${BARF_PP_AWK:-}" ]] || ! command -v awk >/dev/null; then
        cat -- "$1"
        return 0
    fi
    if [[ ! -r $1 || -d $1 ]]; then
        error "cannot read '$1'"
        return 1
    fi
    [[ -n "$BAR_PP_IN" ]] || barf_pp_start
    # the path, not the text: the program opens and reads the file itself, which leaves no writer
    # to run beside the reader and no last line to glue the marker onto
    printf 'F %s\n' "$1" >&"$BAR_PP_IN"
    # The frame is copied by a process, not by a bash loop: 'read' costs about 11us a line (36ms over
    # this tree's 3387) where a 'sed' started per module copies the frame in one go.  'sed -n' plus
    # 'q' quits on the marker without printing it, so the leftover after it is nothing.
    LC_ALL=C sed -n "/^$BAR_PP_MARK\$/q;p" <&"$BAR_PP_OUT"
    # A reader which quits before the marker leaves the program writing into a closed pipe, and it
    # dies with the next frame; every later module would then expand to nothing.  Report that
    # instead of sourcing an empty file -- the preprocessor cannot be restarted from here, a
    # coprocess started in this subshell would die with it.
    if ! kill -0 "$BARF_PP_PID" 2>/dev/null; then
        error "the rule file filter stopped mid run"
        return 1
    fi
}

# 'require' sources the text the filter prints, which means the module's statements are read from
# a pipe rather than from the module: 'BASH_SOURCE' inside it names '/dev/fd/NN'.  'BARF_PP_FILES'
# keeps the module behind each such descriptor so a report can name the file it happened in.  It
# is a plain '<fd>=<path>' list and exported, because a rule body runs in a subshell where an array
# would be lost and its reports would fall back to '/dev/fd/NN'.  The descriptor is never closed:
# bash hands out the lowest free one, so a closed one is reused by the next module and every
# function defined from the earlier module would report the later one.
declare -gx BARF_PP_FILES=""
declare -g BARF_PP_NAME=""

function barf_pp_name # <path> - Sets BARF_PP_NAME to the module behind a filtered stream
{
    ## The path itself when it does not name one of our descriptors.
    local fd="${1#/dev/fd/}"
    local entry
    BARF_PP_NAME="$1"
    for entry in $BARF_PP_FILES; do
        if [[ "${entry%%=*}" == "$fd" ]]; then
            BARF_PP_NAME="${entry#*=}"
            return 0
        fi
    done
}

function require ## [--opt] [modules..] - Loads modules.
{
    ## [--opt]     - Make the modules optional, when they do not exist then no warning is emitted
    ##               and no failure returned.
    ## [modules..] - List of module names to be loaded. Modules are loaded only once, further
    ##               attempts to load it will be a no-op.  A name may be a glob which expands
    ##               to several modules.
    ##
    ## A module which is missing from the 'Bar.d' in use is taken from the installation bar was
    ## run from (see :func:`bar_vendor_modules`) and loaded from there.  When there is no origin
    ## or the module does not exist there either it is missing: with '--opt' that is silent and
    ## succeeds, without it a warning is emitted and a failure returned.

    trace "$*"
    declare -i rc=0
    local try_load=""
    if [[ "$1" = "--opt" ]]; then
        try_load=true
        shift
    fi
    local mod modname mod_file
    #shellcheck disable=2167,2165
    for mod in "$@"; do
        local moddir="$BAR_DIR/"
        [[ "$mod" = */* ]] && moddir=
        local -a mods=()
        readarray -t mods < <(compgen -G "$moddir$mod"; true)
        if (( ${#mods[@]} == 0 )); then
            # nothing of that name in 'Bar.d': a vendored project pulls it in from the origin.
            # Keeping this on the file (not on 'not loaded yet') matters: a failed '--opt' probe
            # records the name as false and a later bare 'require' of it is a no-op.
            readarray -t mods < <(bar_vendor_modules "$moddir$mod"; true)
        fi
        (( ${#mods[@]} )) || mods=( "$moddir$mod" )
        for mod_file in "${mods[@]}"; do
            modname="${mod_file##*/}"
            if [[ ! -v BAR_REQUIRE_LOADED["$modname"] ]]; then
                if [[ -f "$mod_file" ]]; then
                    debug "loading: $mod_file"
                    BAR_REQUIRE_LOADED["$modname"]=pending
                    local pp_fd
                    exec {pp_fd}< <(preprocess "$mod_file")
                    BARF_PP_FILES+=" ${pp_fd}=${mod_file}"
                    # shellcheck disable=SC1090 # dynamic source
                    source "/dev/fd/$pp_fd" && BAR_REQUIRE_LOADED["$modname"]=true
                else
                    if [[ -z "$try_load" ]]; then
                        warn "failed loading: $mod_file"
                        rc=1
                    else
                        trace "failed try loading: $mod_file"
                    fi
                    BAR_REQUIRE_LOADED["$modname"]=false
                fi
            fi
        done
    done
    return $rc
}

# placeholder, overwritten by tty_lib when present
function tty_newline { :; }

function source_info # [N] - returns file:line N (or 0) up the bash call stack
{
    ## A module is sourced from the text the filter printed, so its frame names '/dev/fd/NN'; the
    ## descriptor is mapped back to the module.  Line numbers need no such help: the filter prints
    ## one line per line.
    local file="${BASH_SOURCE[$((${1:-0}+1))]}"
    if [[ "$file" == /dev/fd/* ]]; then
        barf_pp_name "$file"
        file="$BARF_PP_NAME"
    fi
    echo "$file:${BASH_LINENO[$((${1:-0}))]}:${FUNCNAME[$((${1:-0}+1))]:+${FUNCNAME[$((${1:-0}+1))]}:}"
}

## Source site (file and function) of the last report, and the location prefix of the current
## one. Used to condense the repeated 'file:line:func:' prefix of a multi line report.
declare -gx BAR_LAST_SITE=""
declare -gx BAR_REPORT_LOC=""
declare -gx BAR_REPORT_REPEATED=false

function bar_report_condense ## - True when the source location should be condensed on the console.
{
    ## The verbose 'file:line:func:' location is only condensed when the output goes to the
    ## console. Redirected output keeps the full, easily filterable format.
    case "${BAR_REPORT_CONDENSE:-auto}" in
        always) return 0 ;;
        never)  return 1 ;;
        auto|*) [[ -t 2 ]] ;;
    esac
}

function bar_report_loc ## [N] - Sets BAR_REPORT_LOC for a report N frames up the stack.
{
    ## Like 'source_info N' but condenses the source location of consecutive reports from the
    ## same file and function: the location is printed once and then replaced by blanks of the
    ## same width. Sets 'BAR_REPORT_REPEATED' when this report continued such a block.
    local loc
    loc="$(source_info "$((${1:-0}+1))")"

    if ! bar_report_condense; then
        BAR_REPORT_LOC="$loc"
        BAR_REPORT_REPEATED=false
        return 0
    fi

    local rest="${loc#*:}"                  # strip '<file>:'
    local func="${rest#*:}"                 # strip '<line>:'
    local site="${loc%%:*}:${func%:*}"      # '<file>:<func>' without the line number
    if [[ -n "$BAR_LAST_SITE" && "$site" = "$BAR_LAST_SITE" ]]; then
        BAR_REPORT_LOC="${loc//?/ }"
        BAR_REPORT_REPEATED=true
    else
        BAR_REPORT_LOC="$loc"
        BAR_REPORT_REPEATED=false
        BAR_LAST_SITE="$site"
    fi
    return 0
}

function bar_report_condensed ## - True when the repeated location is to be blanked down to a ':'.
{
    ## 'BAR_REPORT_STYLE=tag' (default) keeps the message tag in front of the blanked location,
    ## 'colon' blanks the tag as well so that only the ':' of the location remains.
    [[ "$BAR_REPORT_REPEATED" = true && "${BAR_REPORT_STYLE:-tag}" = colon ]]
}

function DBG ## [message..] - For print-style debugging, should not be present in production code.
{
    {
        tty_newline
        echo "${TTYERR[dbg]}  DBG:${TTYERR[reset]} $(source_info 1) $*"
    } >&2
}

function die ## [message..] - Prints 'message' to stderr and exits with failure
{
    ## Unexpected fatal problem. Will terminate execution, CLEANUP rules will be called.
    ## The source location is condensed like 'error' does, see there for 'BAR_REPORT_CONDENSE' and
    ## 'BAR_REPORT_STYLE'.
    if (( BAR_VERBOSITY_LEVEL > 0 )); then
        tty_newline
        bar_report_loc 1
        if bar_report_condensed; then
            echo "${TTYERR[panic]}$(printf '%*s' "$(( ${#BAR_REPORT_LOC} + 6 ))" '')${TTYERR[reset]}: $*"
        else
            echo "${TTYERR[panic]}PANIC:${TTYERR[reset]} ${BAR_REPORT_LOC} $*"
        fi
    fi >&2
    exit 1
}

function error ## [message..] - Print a error message to stderr.
{
    ## Unexpected but not fatal.
    ## The source location is printed for the first report of a function and condensed to blanks
    ## for the following ones, so a multi line report stays readable. 'BAR_REPORT_CONDENSE' is
    ## 'always', 'never' or 'auto' (default: only on a console, redirected output keeps the full
    ## format) and 'BAR_REPORT_STYLE' is 'tag' (default) or 'colon'.
    if (( BAR_VERBOSITY_LEVEL > 0 )); then
        tty_newline
        bar_report_loc 1
        if bar_report_condensed; then
            echo "${TTYERR[fail]}$(printf '%*s' "$(( ${#BAR_REPORT_LOC} + 6 ))" '')${TTYERR[reset]}: $*"
        else
            echo "${TTYERR[fail]}ERROR:${TTYERR[reset]} ${BAR_REPORT_LOC} $*"
        fi
    fi >&2
}

function warn ## [message..] - Print an warning to stderr.
{
    ## Expected, non fatal problem.
    BAR_LAST_SITE=""
    if (( BAR_VERBOSITY_LEVEL > 1 )); then
        tty_newline
        echo "${TTYERR[warn]} WARN:${TTYERR[reset]} $*" >&2
    fi >&2
}

function note ## [message..] - Print an important notice to stderr.
{
    ## Important message the user should be notified about.
    BAR_LAST_SITE=""
    if (( BAR_VERBOSITY_LEVEL > 2 )); then
        tty_newline
        echo "${TTYERR[warn]} NOTE:${TTYERR[reset]} $*"
    fi >&2
}

function info ## [message..] - Print an informal message to stderr.
{
    ## Broader message about non rule related progress.
    BAR_LAST_SITE=""
    if (( BAR_VERBOSITY_LEVEL > 3 )); then
        tty_newline
        echo "${TTYERR[info]} INFO:${TTYERR[reset]} $*"
    fi >&2
}

function debug ## [message..] - Print a debug message to stderr.
{
    ## Finer grained progress messages.
    if (( BAR_VERBOSITY_LEVEL > 4 )); then
        tty_newline
        echo "${TTYERR[debug]}DEBUG:${TTYERR[reset]} $(source_info 1) $*"
    fi >&2
}

function trace ## [message] - Prints a trace message to stderr.
{
    ## Very verbose function call or finer messages.
    if (( BAR_VERBOSITY_LEVEL > 5 )); then
        tty_newline
        echo "${TTYERR[trace]}TRACE:${TTYERR[reset]} $(source_info 1) $*"
    fi >&2
}

bar_main "$@"
