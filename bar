### The main BAsh Rulez script
###
### Provides only basic functionality for module loading and debugging and starting rule
### evaluation. Loads the 'std_lib' and 'rule_lib' to make them omnipresent.

# PLANNED: parallel dependencies dep+

function bar_main ## [rulefile] [--bare] [rule [arguments..]] - Loads a rulefile and executes rule with optional arguments
{
    ## [rulefile]           - File to load the user rules from.
    ##                        Default: Barf|barf|.Barf|.barf when called as bar or symlink.
    ##                                 Pleasef|pleasef|.Pleasef|.pleasef|\$HOME/.Pleasef when called as please.
    ## [--bare]             - Don't eval SETUP, PREPROCESS, POSTPROCESS and CLEANUP.
    ## [rule [arguments..]] - Target rule with arguments.
    ##                        Default: MAIN
    trace "$*"
    # shell sanity options
    set -euo pipefail
    # shellcheck disable=SC2155
    export LC_ALL=$(locale -a 2>/dev/null | grep -i -m1 -x 'C\.utf-\?8' || echo C)

    # Bar is routinely installed as a githook ('pre-commit -> ../../bar'), and git hands its hooks
    # the repository context it is working in: 'GIT_DIR', an 'GIT_INDEX_FILE' which is relative to
    # *git's* working directory, 'GIT_PREFIX' for a commit made in a subdirectory.  That context
    # describes git's own invocation, not the tree bar was started in: bar's context is the
    # directory its rulefile is found in, and every path a rule body resolves is relative to that.
    # Left in place it is inherited by everything bar launches -- a rule body which runs git in
    # another repository (a test fixture, a testdir, a 'rad_topic') resolves the relative index
    # against the wrong tree.  Measured: under a hook's 'GIT_DIR', 'git init <dir>' re-initialises
    # that 'GIT_DIR' instead of '<dir>' and sets 'core.bare' on the repository the hook belongs to,
    # so every later commit in that checkout fails; and 'git -C <fixture> commit' lands in the
    # checkout instead of the fixture.  The derived context is dropped here, before the first rule
    # runs; git discovers the repository from the directory it is run in.
    unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR GIT_OBJECT_DIRECTORY \
          GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_NAMESPACE GIT_QUARANTINE_PATH GIT_SHALLOW_FILE \
          GIT_REPLACE_REF_BASE GIT_CEILING_DIRECTORIES

    export TMPDIR="${TMPDIR:-/tmp}"

    # shellcheck disable=SC2155
    declare -grx BAR_SELF="$(realpath "$BASH_ARGV0")"  ## Path to bar itself.
    declare -grx BAR_CALLED_AS="${BASH_ARGV0##*/}"     ## Name of bar when called by symlink.
    declare -gx  BAR_DIR                               ## Directory to load rules from.
    declare -g   BAR_BARE                              ## When set, don't eval SETUP, PREPROCESS, POSTPROCESS and CLEANUP.
    declare -gx  BARF_FILE                             ## The Barf file used.
    declare -gxr BAR_PWD="$PWD"                        ## Initial working directory.
    declare -gxi BAR_VERBOSITY_LEVEL="${BAR_VERBOSITY_LEVEL:-2}" ## Verbosity level from 0 (silent) to 6 (trace).
    # The run's parallel budget: one job per available processor unless the caller says otherwise.
    # 'rule_parallel_budget' in 'rule_lib' validates it, and a run at 1 evaluates serially.
    # shellcheck disable=SC2155
    declare -g  BAR_PARALLEL="${BAR_PARALLEL:-$(command -v nproc >/dev/null 2>&1 && nproc || echo 1)}"
    declare -gA  BAR_REQUIRE_LOADED
    # The style names of 'tty_lib' before it is loaded.  The module is found through 'BAR_DIR',
    # which 'find_toplevel' resolves below, and that function reports through these very tables:
    # with empty values the bootstrap -- and a project without 'tty_lib' -- prints unstyled,
    # which is what a stream that is no terminal gets.  'tty_lib' replaces both tables with the
    # real codes and binds 'TTYOUT'/'TTYERR' to them when it loads, 'Bar.d/tty_lib' names them.
    # shellcheck disable=2034
    declare -gA TTYOUT TTYERR
    local _style
    for _style in reset label ok fail panic warn info debug trace dbg strike clear_eol \
                       clear_line cr; do
        # shellcheck disable=2034
        TTYOUT[$_style]='' TTYERR[$_style]=''
    done
    unset _style

    # bootstrap/load std_lib (which defines 'require')
    # shellcheck disable=SC1091
    find_toplevel
    debug "using Bar directory: $BAR_DIR"

    local maybe_barf=
    local initial_rule=
    if [[ "$BAR_CALLED_AS" =~ \.?bar|please ]]; then
        maybe_barf="${1:-}"
    else
        initial_rule="$BAR_CALLED_AS"
    fi

    local barfs=("$BAR_TOPLEVEL/Barf" "$BAR_TOPLEVEL/barf" "$BAR_TOPLEVEL/.Barf" "$BAR_TOPLEVEL/.barf")
    if [[ "$BAR_CALLED_AS" = please ]]; then
        barfs=("Pleasef" "pleasef" ".Pleasef" ".pleasef" "$HOME/.Pleasef")
    fi

    for BARF_FILE in "$maybe_barf" "${barfs[@]}"; do
        if [[ -f "$BARF_FILE" ]]; then
            debug "using: $BARF_FILE"
            [[ "$BARF_FILE" = "$maybe_barf" ]] && shift
            BARF_FILE="$(realpath "$BARF_FILE")"
            break
        fi
    done
    [[ -f "${BARF_FILE:-}" ]] || BARF_FILE=

    # what the environment says about the dump, before a rulefile could have said anything: the
    # loader has to know where the dump is before it reads the rulefile, so a rulefile can only
    # turn the mechanism off ('bar_state_dump' then writes none)
    BAR_STATE_SETTING="$BAR_STATE_DUMP"

    # the modules and the rulefile are loaded from the state dump when it is current, and sourced
    # otherwise -- the dump is written from that load, so the next run has one
    if ! bar_state_load; then
        # The preprocessor is started here, and only on this path: a run served from the dump loads
        # no file and never hands the filter one, so a coprocess started for it would idle until the
        # run ends.  It runs before 'bar_state_snapshot', so its descriptors belong to the shell's
        # own state rather than to a module, and before the first 'require': that sources
        # '<(preprocess f)' in a subshell, and a descriptor set there does not outlive the module.
        barf_pp_ensure
        bar_state_off "$BAR_STATE_SETTING" || bar_state_snapshot
        # the std_lib and rule_lib are omnipresent other modules don't need to require it
        require std_lib rule_lib
        # load all '*_rules'
        require '*_rules'
        [[ -n "$BARF_FILE" ]] && require "$BARF_FILE"
        bar_state_dump
    fi

    if [[ "${1:-}" = '--bare' ]]; then
        shift
        BAR_BARE=true
    fi

    local rc=0
    [[ -z "$initial_rule" && -n "${1:-}" ]] && rule_autoload "$1"
    # shellcheck disable=SC2155
    declare -grix BAR_TIMESTAMP="$(bar_now)" ## Timestamp in microseconds since epoch of this invocation

    [[ -z "${initial_rule}" ]] && {
        initial_rule="${1:-MAIN}"
        shift || true
    }

    [[ "${BAR_RULE_FLAGS[$initial_rule]:-}" == *b* ]] && BAR_BARE=true

    if rule_exists "$initial_rule"; then
        [[ -z "${BAR_BARE:-}" ]] && {
            # the two stops are guarded: a bootstrap ('bar init') reaches this line before the
            # modules which define them are all loaded, and a missing function must not turn the
            # exit status of a run into 127
            trap 'declare -F barf_pp_stop >/dev/null && barf_pp_stop; declare -F rule_jobs_drain >/dev/null && rule_jobs_drain; rule_exists CLEANUP && { rule_eval CLEANUP || error "CLEANUP failed" ; }' EXIT
            # an interrupt ends the run, not only its shell: what bar started has the terminal's
            # signal ignored (an asynchronous command of a non-interactive shell does), so the run
            # itself is the only thing which can end it -- and it must, or the work outlives the run
            # which pays for it.  The status is the signal's, as a shell which took it would report.
            trap 'if declare -F rule_jobs_interrupt >/dev/null; then rule_jobs_interrupt 130; else exit 130; fi' INT
            trap 'if declare -F rule_jobs_interrupt >/dev/null; then rule_jobs_interrupt 143; else exit 143; fi' TERM
            trap 'if declare -F rule_jobs_interrupt >/dev/null; then rule_jobs_interrupt 129; else exit 129; fi' HUP
            rule_exists SETUP && {
                rule_eval SETUP || die "SETUP failed" ;
            }
            rule_exists PREPROCESS && {
                rule_eval PREPROCESS || die "PREPROCESS failed" ;
            }
        }

        rule_eval "$initial_rule" "$@" || rc=$?
        if (( "$rc" == 0 )); then
            success "$initial_rule" "$@"
            [[ -z "${BAR_BARE:-}" ]] && rule_exists POSTPROCESS && { rule_eval POSTPROCESS || error "POSTPROCCESS failed" ; }
        else
            failure "$initial_rule" "$@"
        fi

        return $rc
    else
        die "No Barf/Pleasef file found in current directory and no rule defined.

USAGE

  bar [Rulefile] [Rule [Arguments]]
  please [Rulefile] [Rule [Arguments]]
or
  bar help
  please help
"
    fi
}

# When no rule directory is found the modules installed below BAR_PREFIX are used, but BAR_TOPLEVEL
# still stays the directory bar was invoked from: it must never end up as some ancestor or '/', which
# would resolve the rulefile (and everything else bar keeps in the project) outside of it.
function find_toplevel
{
    # The rule directory is 'Bar.d', 'bar.d', '.Bar.d' or '.bar.d' in the directory bar was invoked
    # from or in the closest ancestor that has one.  The walk upwards stops at the filesystem
    # boundary unless BAR_CROSS_FS is set.  On success BAR_TOPLEVEL is the directory that contains
    # the rule directory and is made readonly; everything that is project relative is resolved
    # below it.  'please' is the exception: its modules live in a single, absolute directory
    # (~/.config/please), no ancestor is searched.
    # shellcheck disable=2155
    local origin="$(command -v bar)"
    declare -gxr BAR_PREFIX="${origin%/bin/*}"
    declare -gx BAR_TOPLEVEL="$BAR_PWD"
    # shellcheck disable=2155
    local initial_fs_id="$(stat -f -c %i "$BAR_TOPLEVEL")"

    local -a barfd=("Bar.d" "bar.d" ".Bar.d" ".bar.d")
    local -i walk=1
    if [[ "$BAR_CALLED_AS" = please ]]; then
        barfd=("$HOME/.config/please")
        walk=0
    fi

    local cursor="$BAR_TOPLEVEL" name candidate
    while :; do
        for name in "${barfd[@]}"; do
            if [[ "$name" = /* ]]; then
                candidate="$name"
            else
                candidate="$cursor/$name"
            fi
            if [[ -d "$candidate" ]]; then
                BAR_DIR="$candidate"
                BAR_TOPLEVEL="$cursor"
                readonly BAR_TOPLEVEL
                return 0
            fi
        done
        (( walk )) || break
        if [[ "$cursor" = "/" ]]; then
            break
        fi
        cursor="$(readlink -f "$cursor/..")"
        if [[ ! -v BAR_CROSS_FS && "$(stat -f -c %i "$cursor")" != "$initial_fs_id" ]]; then
            break
        fi
    done

    warn "No Bar.d directory found, trying original/installed"

    BAR_DIR="$BAR_PREFIX/share/bar/Bar.d"
    [[ -d "$BAR_DIR" ]] || die "Bar directory '$BAR_DIR' does not exist"
}

function bar_origin_dir ## - the 'Bar.d' of the installation bar was run from, when it is not the one in use
{
    ## A project may carry its own (vendored) 'Bar.d', then the installation bar was run from is
    ## where modules missing from the project are taken from.  When bar runs from its
    ## installation there is no origin.  'please' has no vendored copy either: its modules live
    ## in a single, absolute directory.
    [[ -n "$BAR_PREFIX" && -d "$BAR_PREFIX/share/bar/Bar.d" ]] || return 1
    [[ "$BAR_CALLED_AS" != please ]] || return 1
    [[ "$(realpath "$BAR_DIR")" != "$(realpath "$BAR_PREFIX/share/bar/Bar.d")" ]] || return 1
    printf '%s\n' "$BAR_PREFIX/share/bar/Bar.d"
}

function bar_vendor_modules ## <modpath> - installs a module of Bar.d which is missing from the origin, prints what it installed
{
    ## <modpath> - The path the module would have in 'Bar.d' (a glob is expanded there).
    ##
    ## Copies the module(s) from the origin installation into 'Bar.d'.  An existing module is
    ## never touched (that is what '--update' of the init rules is for) and the origin is never
    ## written to, installing only ever adds a copy here.  Prints the installed paths, returns
    ## non-zero when there is no origin, the name is not a module of this 'Bar.d' or the origin
    ## does not have it either.
    local path="$1"
    local origin
    origin="$(bar_origin_dir)" || return 1
    local rel="${path#"$BAR_DIR"/}"
    [[ "$rel" != "$path" && "$rel" != */* ]] || return 1
    local -a found=()
    readarray -t found < <(compgen -G "$origin/$rel"; true)
    (( ${#found[@]} )) || return 1
    local -i installed=0
    local src dst
    for src in "${found[@]}"; do
        dst="$BAR_DIR/${src##*/}"
        [[ -f "$dst" ]] && continue
        cp -L "$src" "$dst.tmp" || continue
        mv "$dst.tmp" "$dst" || { rm -f "$dst.tmp"; continue; }
        note "installed module '${src##*/}' from ${src%/*}"
        printf '%s\n' "$dst"
        installed+=1
    done
    (( installed ))
}

# The rule-file filter (see :func:`preprocess`).  It is embedded here rather than kept in a
# 'Bar.d' module: it has to exist before the first module is sourced, and 'bar_vendor_modules'
# copies a module into a project's 'Bar.d', where a copy would trail the 'bar' that runs it.
declare -g BARF_PP_AWK=""
IFS= read -r -d '' BARF_PP_AWK <<'AWK' || true
# bar's rule-file preprocessor: expand the make/just syntax into the 'rule' syntax.
#
# Infallible by design.  A line which matches no transform is printed unchanged; one input line
# produces exactly one output line, in order, and nothing is added, dropped, merged or reordered.
# 'source <(preprocess f)' cannot report a failure of this program, so it must not have one: every
# state machine closes in END and no path exits.

function indentof(line,   i, n) {
    n = length(line)
    for (i = 1; i <= n; i++)
        if (substr(line, i, 1) != " " && substr(line, i, 1) != "\t")
            return i - 1
    return n
}

# text as one single quoted shell word
function squote(text) {
    gsub(/\047/, "\047\\\047\047", text)
    return text
}

function closebody(   i) {
    for (i = 1; i <= nbody; i++)
        print (i == nbody ? body[i] "\047" : body[i])
    nbody = 0
    inbody = 0
}

function flushheader(   i) {
    if (!havehdr)
        return
    print hdr
    for (i = 1; i <= nblank; i++)
        print ""
    nblank = 0
    havehdr = 0
}

function flushattrs(   i) {
    for (i = 1; i <= nattr; i++)
        print attrline[i]
    nattr = 0
    attrflags = ""
}

# The '[flag]' lines of a header which carries them are kept as comments: the flags travel on the
# 'rule' line, and one line in has to stay one line out, or every line number behind a flagged
# header would name the wrong line in bar's own diagnostics.  '[always]' is not a command.
function commentattrs(   i) {
    for (i = 1; i <= nattr; i++)
        print "# " attrline[i]
}

# Track the quote state across lines and queue the heredocs a line opens.  Sets sq/dq for a
# string left open at the end of the line.
function scan(line,   i, n, c, q, st, w, strip, pos) {
    # the common line carries neither a quote, an escape, a comment nor a '<': nothing to track
    if (!sq && !dq && line !~ /[\\\047"#<]/) {
        sq = 0
        dq = 0
        return
    }
    n = length(line)
    st = (sq ? 1 : (dq ? 2 : 0))
    for (i = 1; i <= n; i++) {
        c = substr(line, i, 1)
        if (st == 1) {
            if (c == "\047")
                st = 0
            continue
        }
        if (st == 2) {
            if (c == "\\") { i++; continue }
            if (c == "\"")
                st = 0
            continue
        }
        if (c == "\\") { i++; continue }
        if (c == "#" && (i == 1 || substr(line, i - 1, 1) ~ /[ \t;|&(]/))
            break
        if (c == "\047") { st = 1; continue }
        if (c == "\"") { st = 2; continue }
        if (c != "<" || substr(line, i + 1, 1) != "<")
            continue
        if (substr(line, i + 2, 1) == "<") { i += 2; continue }     # <<< herestring
        pos = i + 2
        strip = 0
        if (substr(line, pos, 1) == "-") { strip = 1; pos++ }
        while (substr(line, pos, 1) == " " || substr(line, pos, 1) == "\t")
            pos++
        q = substr(line, pos, 1)
        if (q == "\047" || q == "\"")
            pos++
        else if (q == "\\") { q = ""; pos++ }
        else
            q = ""
        w = ""
        while (pos <= n) {
            c = substr(line, pos, 1)
            if (q != "") {
                if (c == q) { pos++; break }
            } else if (c ~ /[ \t;|&<>()]/)
                break
            w = w c
            pos++
        }
        # a number is an arithmetic shift, not a here document
        if (w != "" && w !~ /^[0-9]+$/) {
            nh++
            hterm[nh] = w
            hstrip[nh] = strip
        }
        i = pos - 1
    }
    sq = (st == 1)
    dq = (st == 2)
}

# length of the word starting at <start> of <text>, quote, escape and paren aware
function wordlen(text, start,   i, n, c, depth, q) {
    n = length(text)
    i = start
    depth = 0
    q = ""
    while (i <= n) {
        c = substr(text, i, 1)
        if (q == "\047") {
            if (c == "\047") q = ""
            i++
            continue
        }
        if (q == "\"") {
            if (c == "\\") { i += 2; continue }
            if (c == "\"") q = ""
            i++
            continue
        }
        if (c == "\\") { i += 2; continue }
        if (c == "\047" || c == "\"") { q = c; i++; continue }
        if (c == "(") { depth++; i++; continue }
        if (c == ")") { if (depth > 0) depth--; i++; continue }
        if (depth == 0 && (c == " " || c == "\t" || c == ";"))
            break
        i++
    }
    return i - start
}

# '<pre>(<inner>)<post>' as one quoted dependency, the modifiers lifted onto its first word
function parens(tok,   i, n, c, q, depth, op, cl, pre, inner, post, len, first, more) {
    n = length(tok)
    q = ""
    depth = 0
    op = 0
    for (i = 1; i <= n; i++) {
        c = substr(tok, i, 1)
        if (q != "") {
            if (q == "\"" && c == "\\") { i++; continue }
            if (c == q) q = ""
            continue
        }
        if (c == "\\") { i++; continue }
        if (c == "\047" || c == "\"") { q = c; continue }
        if (c == "(" && depth == 0 && op == 0) { op = i; depth = 1; continue }
        if (c == "(" && op != 0) { depth++; continue }
        if (c == ")" && op != 0) {
            depth--
            if (depth == 0) { cl = i; break }
        }
    }
    if (op == 0 || cl == 0)
        return tok
    pre = substr(tok, 1, op - 1)
    inner = substr(tok, op + 1, cl - op - 1)
    post = substr(tok, cl + 1)
    sub(/^[ \t]+/, "", inner)
    sub(/[ \t]+$/, "", inner)
    if (inner == "")
        return tok
    len = wordlen(inner, 1)
    first = substr(inner, 1, len)
    more = substr(inner, len + 1)
    sub(/^[ \t]+/, "", more)
    return "\047" squote(pre first post (more == "" ? "" : " " more)) "\047"
}

# the 'clause_local' argument a dependency word stands for, empty when it defines no variable:
# 'var=value' and 'var=' are locals assigned in the clause, '=var' is a local initialized from the
# outer scope
function vardef(tok) {
    if (tok ~ /^=[A-Za-z_][A-Za-z0-9_]*$/)
        return substr(tok, 2)
    if (tok ~ /^[A-Za-z_][A-Za-z0-9_]*=/)
        return tok
    return ""
}

# the text after 'name:' -- clause flags, dependencies, an inline body
function depregion(rest,   i, n, c, k, cnt, j, inner, lead, flags, cf, tok, w, out, ws, run, inrun, vd, body) {
    n = length(rest)
    i = 1
    while (i <= n && substr(rest, i, 1) ~ /[ \t]/)
        i++
    lead = substr(rest, 1, i - 1)
    flags = ""
    while (substr(rest, i, 1) == "[") {
        j = index(substr(rest, i), "]")
        if (j == 0)
            break
        inner = substr(rest, i + 1, j - 2)
        if (inner !~ /^[a-z][a-z-]*([ \t]+[a-z][a-z-]*)*$/)
            break
        cnt = split(inner, cf, /[ \t]+/)
        for (k = 1; k <= cnt; k++)
            flags = flags " --" cf[k]
        i += j
        while (i <= n && substr(rest, i, 1) ~ /[ \t]/)
            i++
    }
    rest = substr(rest, i)
    if (flags != "") {
        lead = ""
        rest = (rest == "" ? "" : " " rest)
    }

    out = ""
    ws = ""
    run = ""
    inrun = 0
    body = 0
    i = 1
    n = length(rest)
    while (i <= n) {
        c = substr(rest, i, 1)
        if (c == " " || c == "\t") {
            ws = ws c
            i++
            continue
        }
        if (c == ";") {
            if (inrun) {
                out = out squote(run) "\047"
                inrun = 0
                run = ""
            }
            ws = ""
            w = substr(rest, i + 1)
            sub(/^[ \t]+/, "", w)
            out = out " -- " w
            break
        }
        w = wordlen(rest, i)
        tok = substr(rest, i, w)
        if (index(tok, "("))
            tok = parens(tok)
        # '--' starts the body: what follows is commands, never a variable definition
        if (tok == "--")
            body = 1
        vd = (body ? "" : vardef(tok))
        if (vd == "") {
            if (inrun) {
                out = out squote(run) "\047"
                inrun = 0
                run = ""
            }
            out = out ws tok
        } else {
            # one 'clause_local' per run: consecutive definitions are its arguments, a word of
            # another kind ends the run, and the order they are written in is kept
            if (!inrun) {
                out = out ws "\047clause_local"
                inrun = 1
                run = ""
            }
            run = run " " vd
        }
        ws = ""
        i += w
    }
    if (inrun)
        out = out squote(run) "\047"
    return lead flags out
}

# Every state the program carries across lines, back to its start-of-file value: BEGIN runs it, and
# so does the end of a frame when one awk serves several files (see :func:`barf_pp_start`).
function framereset() {
    nh = 0
    sq = 0
    dq = 0
    nattr = 0
    attrflags = ""
    havehdr = 0
    hdr = ""
    nblank = 0
    inbody = 0
    base = 0
    nbody = 0
}

BEGIN {
    framereset()
}

# A frame is one file: the program is told its path and reads it itself, so no writer has to run
# beside the reader and a file without a trailing newline ends where it ends.  What the file left
# buffered is printed, its state dropped, and the marker closes the frame on the channel.
function frame(path,   n, line) {
    while ((getline line < path) > 0)
        transform(line)
    close(path)
    framedrain()
    framereset()
    print mark
    fflush()
}

{
    if (mark != "" && substr($0, 1, 2) == "F ")
        frame(substr($0, 3))
    else
        transform($0)
}

# One line of input through the whole transform: the program's name for a rule, and the only
# entry point a frame has -- a line off stdin and a line read out of a file go the same way.
function transform(line) {

    # a here document body is data
    if (nh > 0) {
        print line
        cmp = line
        if (hstrip[1])
            sub(/^\t+/, "", cmp)
        if (cmp == hterm[1]) {
            for (i = 1; i < nh; i++) {
                hterm[i] = hterm[i + 1]
                hstrip[i] = hstrip[i + 1]
            }
            nh--
        }
        return
    }

    # the rest of a multi line quoted string is data
    if (sq || dq) {
        print line
        scan(line)
        return
    }

    # an indented body block
    if (inbody) {
        if (line ~ /^[ \t]*$/) {
            body[++nbody] = ""
            return
        }
        if (indentof(line) >= base) {
            body[++nbody] = squote(substr(line, base + 1))
            return
        }
        closebody()
    }

    # blank lines between a buffered header and its body belong to the body
    if (havehdr && line ~ /^[ \t]*$/) {
        nblank++
        return
    }

    if (line ~ /^[ \t]*$/) {
        flushattrs()
        print line
        return
    }

    # an indented line after a buffered header is its body
    if (havehdr && indentof(line) > 0) {
        print hdr ((hdr ~ /--?$/) ? "\047" : " -- \047")
        for (i = 1; i <= nblank; i++)
            print ""
        nblank = 0
        havehdr = 0
        base = indentof(line)
        inbody = 1
        nbody = 0
        body[++nbody] = squote(substr(line, base + 1))
        return
    }

    # a header which nothing indented follows stays a plain header
    if (havehdr)
        flushheader()

    # 'NAME := value' is make's 'NAME=value'
    if (match(line, /^[A-Za-z_][A-Za-z0-9_]*[ \t]*:=/)) {
        flushattrs()
        name = substr(line, 1, RLENGTH)
        sub(/[ \t]*:=$/, "", name)
        value = substr(line, RLENGTH + 1)
        sub(/^[ \t]+/, "", value)
        print name "=" value
        scan(line)
        return
    }

    # 'NAME ?= value' is make's 'NAME ?= value' with the current value kept
    if (match(line, /^[A-Za-z_][A-Za-z0-9_]*[ \t]*\?=/)) {
        flushattrs()
        name = substr(line, 1, RLENGTH)
        sub(/[ \t]*\?=$/, "", name)
        value = substr(line, RLENGTH + 1)
        sub(/^[ \t]+/, "", value)
        print ": \"${" name ":=" value "}\""
        scan(line)
        return
    }

    # stacked '[flag]' lines attach to the next header
    if (line ~ /^\[[a-z][a-z-]*([ \t]+[a-z][a-z-]*)*\][ \t]*(#.*)?$/) {
        inner = line
        sub(/^\[/, "", inner)
        sub(/\].*$/, "", inner)
        cnt = split(inner, tok, /[ \t]+/)
        for (k = 1; k <= cnt; k++)
            attrflags = attrflags " --" tok[k]
        attrline[++nattr] = line
        return
    }

    # a header: '<name>: ...' at column 0
    if (line ~ /^[A-Za-z_][A-Za-z0-9_.-]*:/ && line !~ /\\$/) {
        flushheader()
        nblank = 0
        match(line, /^[A-Za-z_][A-Za-z0-9_.-]*:/)
        name = substr(line, 1, RLENGTH - 1)
        hdr = "rule" (nattr ? attrflags : "") " " name ":" depregion(substr(line, RLENGTH + 1))
        commentattrs()
        attrflags = ""
        nattr = 0
        havehdr = 1
        scan(line)
        # a header line which opens a string or a heredoc has its data behind it: it can not be
        # waiting for a body block, or the data would overtake it
        if (sq || dq || nh > 0)
            flushheader()
        return
    }

    # anything else passes through
    flushattrs()
    print line
    scan(line)
}

# an indented body may start with the first indented line after a buffered header; a body block or a
# header still buffered when the text ends belongs to the file that buffered it
function framedrain() {
    if (inbody)
        closebody()
    flushheader()
    flushattrs()
}

END {
    framedrain()
    if (mark != "")
        fflush()
}
AWK

# The preprocessor is started once per run which loads a file, and talked to over two descriptors:
# the path of a file goes in as 'F <path>', the printed text comes back with BAR_PP_MARK closing the
# frame.  The marker is also what clears the state the file leaves behind, so a file expands as if
# it were the only one -- awk's startup is paid once instead of once per module.
# No regex metacharacter in the marker: the reader matches it with 'sed'.
declare -g BAR_PP_IN="" BAR_PP_OUT="" BAR_PP_MARK="!$RANDOM$RANDOM$RANDOM$RANDOM!"
declare -g BAR_PP_OWNER=""   # the shell which started the filter this one talks to

function barf_pp_start # - starts the preprocessor; sets BAR_PP_IN and BAR_PP_OUT
{
    # 'coproc' hands the two ends of the connection out as BARF_PP[0] (read) and BARF_PP[1]
    # (write), but bash closes a coprocess's own descriptors in every subshell -- and 'preprocess'
    # runs in one ('<(preprocess f)'), as does the writer of a frame.  They are duplicated onto
    # ordinary descriptors, which are inherited, and both stay open for the rest of the run: a
    # closed descriptor is reused by the next 'exec {fd}<' and the module behind it would report
    # the wrong file.
    local ppin ppout ppw ppr
    coproc BARF_PP { LC_ALL=C awk -v mark="$BAR_PP_MARK" "$BARF_PP_AWK"; }
    ppw="${BARF_PP[1]}" ppr="${BARF_PP[0]}"
    exec {ppin}>&"$ppw" {ppout}<&"$ppr"
    exec {ppw}>&- {ppr}<&-
    # A body is evaluated in this shell, and a bare 'wait' waits for every child in its job table:
    # the filter is one of them, and it ends only when the run closes the channel -- which the
    # stop below does, after the bodies.  A body which waits for its own background jobs would
    # then sit on a filter which is waiting for the body.  Disowning takes the filter out of that
    # table; the descriptors and the parentage a frame needs stay as they are, and BARF_PP_PID
    # keeps the pid for :func:`barf_pp_stop`.
    disown "$BARF_PP_PID" 2>/dev/null || true
    BAR_PP_IN="$ppin"
    BAR_PP_OUT="$ppout"
    BAR_PP_OWNER="$BASHPID"
}

function barf_pp_fork # - a forked job drops the filter channel its parent started
{
    ## Every job the scheduler starts calls this before it evaluates anything.  The parent's
    ## channel is not shared: two readers on one connection tear frames (measured), the parent's
    ## stop needs every copy of the write end closed, and no job may talk to a filter it does not
    ## own.  Dropping it here costs nothing -- a job which never preprocesses never starts one --
    ## and 'barf_pp_ensure' starts the job's own on its first 'require', in the shell whose
    ## descriptors every module of that load inherits.
    [[ -n "${BAR_PP_IN:-}" && "${BAR_PP_OWNER:-}" != "$BASHPID" ]] || return 0
    exec {BAR_PP_IN}>&- {BAR_PP_OUT}<&-
    BAR_PP_IN=""
    BAR_PP_OUT=""
    BAR_PP_OWNER=""
    return 0
}

function barf_pp_stop # - closes the filter channel; the filter exits on EOF
{
    ## Closing is the whole of the stop: awk sees EOF on the frame pipe, runs its 'END' and exits.
    ## Nothing waits for it here, and the filter is disowned (:func:`barf_pp_start`), so there is
    ## no job of this shell to wait for either -- a 'wait' on the pid answers 127 at once, and this
    ## runs from the EXIT trap, where a failing command under errexit ends the run with that status
    ## instead of the one the rules earned.
    [[ -n "${BAR_PP_IN:-}" ]] || return 0
    exec {BAR_PP_IN}>&- {BAR_PP_OUT}<&-
    BAR_PP_IN=""
    BAR_PP_OUT=""
    BAR_PP_OWNER=""
    return 0
}

function barf_pp_ensure # - starts the preprocessor unless one is running or there is no filter
{
    # Called by whoever is about to source a file, never from inside 'preprocess': that runs in a
    # subshell ('<(preprocess f)'), where a descriptor set does not outlive the one frame it prints,
    # so a start there would cost one awk per file.  'require' calls it instead, in the shell whose
    # descriptors every module of that load inherits.
    [[ -n "$BAR_PP_IN" ]] && return 0
    if [[ -n "${BARF_PP_AWK:-}" ]] && command -v awk >/dev/null; then
        barf_pp_start
    fi
    return 0
}

# Started where the modules are loaded (:func:`bar_main`), in the shell which sources them, and by
# 'require' for the loads which happen after it (a rule body's require, an autoloaded module).  A run
# served from the state dump starts none of that load, so the first file it does source -- a rule
# body's 'require', 'bar preprocess <file>' -- starts the filter when it is used.

function preprocess ## <file> - Print a rule file with its make/just syntax expanded
{
    ## <file> - The rule file to print.
    ##
    ## Prints the text which 'require' sources for the file: a line written in the syntax close to
    ## makefiles and justfiles is expanded into the 'rule' syntax and every other line is passed
    ## through unchanged.  The preprocessor is infallible, it never refuses input -- what it does
    ## not understand is reported by bar's own parser, at the line it is on.  A file it cannot read
    ## is an error rather than an empty expansion.  'bar preprocess <file>' shows exactly the text
    ## which gets sourced.  That syntax is documented under "RULE FILE PREPROCESSOR" in 'bar help'.
    case "${1:-}" in
    -h | --help)
        require --opt help
        help_usage preprocess
        return 0
        ;;
    "")
        require --opt help
        help_usage_error preprocess "no rule file given"
        return 2
        ;;
    esac
    if [[ -z "${BARF_PP_AWK:-}" ]] || ! command -v awk >/dev/null; then
        cat -- "$1"
        return 0
    fi
    if [[ ! -r $1 || -d $1 ]]; then
        error "cannot read '$1'"
        return 1
    fi
    # this call is the only one which reaches here without 'require' having started the filter
    barf_pp_ensure
    # the path, not the text: the program opens and reads the file itself, which leaves no writer
    # to run beside the reader and no last line to glue the marker onto
    printf 'F %s\n' "$1" >&"$BAR_PP_IN"
    # The frame is copied by a process, not by a bash loop: 'read' costs about 11us a line (36ms over
    # this tree's 3387) where a 'sed' started per module copies the frame in one go.  'sed -n' plus
    # 'q' quits on the marker without printing it, so the leftover after it is nothing.
    LC_ALL=C sed -n "/^$BAR_PP_MARK\$/q;p" <&"$BAR_PP_OUT"
    # A reader which quits before the marker leaves the program writing into a closed pipe, and it
    # dies with the next frame; every later module would then expand to nothing.  Report that
    # instead of sourcing an empty file -- the preprocessor cannot be restarted from here, a
    # coprocess started in this subshell would die with it.
    if ! kill -0 "$BARF_PP_PID" 2>/dev/null; then
        error "the rule file filter stopped mid run"
        return 1
    fi
}

# 'require' sources the text the filter prints, which means the module's statements are read from
# a pipe rather than from the module: 'BASH_SOURCE' inside it names '/dev/fd/NN'.  'BARF_PP_FILES'
# keeps the module behind each such descriptor so a report can name the file it happened in.  It
# is a plain '<fd>=<path>' list and exported, because a rule body runs in a subshell where an array
# would be lost and its reports would fall back to '/dev/fd/NN'.  The descriptor is never closed:
# bash hands out the lowest free one, so a closed one is reused by the next module and every
# function defined from the earlier module would report the later one.
declare -gx BARF_PP_FILES=""
declare -g BARF_PP_NAME=""

function barf_pp_name # <path> - Sets BARF_PP_NAME to the module behind a filtered stream
{
    ## The path itself when it does not name one of our descriptors.
    local fd="${1#/dev/fd/}"
    local entry
    BARF_PP_NAME="$1"
    for entry in $BARF_PP_FILES; do
        if [[ "${entry%%=*}" == "$fd" ]]; then
            BARF_PP_NAME="${entry#*=}"
            return 0
        fi
    done
}

function require ## [--opt] [modules..] - Loads modules.
{
    ## [--opt]     - Make the modules optional, when they do not exist then no warning is emitted
    ##               and no failure returned.
    ## [modules..] - List of module names to be loaded. Modules are loaded only once, further
    ##               attempts to load it will be a no-op.  A name may be a glob which expands
    ##               to several modules.
    ##
    ## A module which is missing from the 'Bar.d' in use is taken from the installation bar was
    ## run from (see :func:`bar_vendor_modules`) and loaded from there.  When there is no origin
    ## or the module does not exist there either it is missing: with '--opt' that is silent and
    ## succeeds, without it a warning is emitted and a failure returned.

    trace "$*"
    declare -i rc=0
    local try_load=""
    if [[ "$1" = "--opt" ]]; then
        try_load=true
        shift
    fi
    local mod modname mod_file
    #shellcheck disable=2167,2165
    for mod in "$@"; do
        local moddir="$BAR_DIR/"
        [[ "$mod" = */* ]] && moddir=
        local -a mods=()
        readarray -t mods < <(compgen -G "$moddir$mod"; true)
        if (( ${#mods[@]} == 0 )); then
            # nothing of that name in 'Bar.d': a vendored project pulls it in from the origin.
            # Keeping this on the file (not on 'not loaded yet') matters: a failed '--opt' probe
            # records the name as false and a later bare 'require' of it is a no-op.
            readarray -t mods < <(bar_vendor_modules "$moddir$mod"; true)
        fi
        (( ${#mods[@]} )) || mods=( "$moddir$mod" )
        for mod_file in "${mods[@]}"; do
            modname="${mod_file##*/}"
            if [[ ! -v BAR_REQUIRE_LOADED["$modname"] ]]; then
                if [[ -f "$mod_file" ]]; then
                    debug "loading: $mod_file"
                    BAR_REQUIRE_LOADED["$modname"]=pending
                    local pp_fd
                    # started here, in the shell whose descriptors the frames inherit: all modules of
                    # this load share one filter, wherever the load happens
                    barf_pp_ensure
                    exec {pp_fd}< <(preprocess "$mod_file")
                    BARF_PP_FILES+=" ${pp_fd}=${mod_file}"
                    # shellcheck disable=SC1090 # dynamic source
                    source "/dev/fd/$pp_fd" && BAR_REQUIRE_LOADED["$modname"]=true
                else
                    if [[ -z "$try_load" ]]; then
                        warn "failed loading: $mod_file"
                        rc=1
                    else
                        trace "failed try loading: $mod_file"
                    fi
                    BAR_REQUIRE_LOADED["$modname"]=false
                fi
            fi
        done
    done
    return $rc
}

# STATE DUMP
#
# Loading the modules and the rulefile is most of bar's startup: every file is run through the
# filter (one awk per file) and sourced, and a rule definition costs parameter expansion and
# arithmetic.  What that produces is a table of declarations -- rules, functions, constants -- and
# the table depends on nothing but the files.  So it is written to a dump once and sourced instead
# of the files, for as long as none of them changed.
#
# The dump carries what the loads created or changed, never bar's own state: a variable whose
# declaration is unchanged from the snapshot taken before the first module was sourced came from
# the environment, and a value which belongs to the invocation ('BAR_PWD', the tty binding, the
# descriptor numbers of the filtered text) is wrong by the time it is read again.  A module whose
# state is decided at load time from the environment exposes a function and registers it in
# 'BAR_STATE_INIT_FNS'; the dump runs those again after it was sourced.
#
# The dump sits beside the rulefile and is named after it ('.bar.<rulefile>.dump'): the state of a
# run includes the rulefile, two rulefiles never share a dump, and a directory may carry one per
# rulefile -- 'Pleasef' and 'SomeOtherRules' are no different from 'Barf' in this.  'BAR_STATE_DUMP'
# names another file, 'off' disables the mechanism (a rulefile may set that too), empty is the
# default path.  A run without a rulefile has nothing to name a dump after and keeps none.

declare -gA BAR_STATE_BASE_VARS=()   # variable names and declarations from before the modules
declare -gA BAR_STATE_BASE_FUNCS=()  # function names from before the modules were loaded
declare -ga BAR_STATE_INIT_FNS=()    ## Functions a module wants re-run after a dump was sourced.
declare -gx BAR_STATE_DUMP="${BAR_STATE_DUMP:-}" ## Dump file, 'off', or empty for the default path.
declare -g  BAR_STATE_SETTING=""     # 'BAR_STATE_DUMP' as the environment had it, before any rulefile
declare -g  BAR_STATE_PATH=""        # where the dump is, set by 'bar_state_path'
declare -g  BAR_STATE_VARS=""         # 'declare -p' of a dump write
declare -g  BAR_STATE_FUNCS=""        # 'declare -F' of a dump write
# shellcheck disable=2016 # the form is the point: it is the first line of the dump
declare -gr BAR_STATE_MAGIC="# bar-state 1"      ## First line of a dump: its format and version.

function bar_state_off ## [value] - True when the value is one which turns the dump off.
{
    ## <value> - Default: 'BAR_STATE_DUMP'.
    local value="${1-$BAR_STATE_DUMP}"
    case "$value" in
    off|no|0|false) return 0 ;;
    esac
    return 1
}

function bar_state_path ## - Sets 'BAR_STATE_PATH' to the dump file of this invocation.
{
    ## 'BAR_STATE_DUMP' when the environment set it, else '.bar.<rulefile name>.dump' beside the
    ## rulefile.  The name carries the rulefile, so two rulefiles in one directory never share a
    ## dump and nothing needs to know whether the run is 'bar' or 'please', in a project or next to
    ## an installation: the rulefile is what the state of a run depends on, and where it is, is
    ## where the dump goes.  Empty when there is no rulefile to name it after.  The setting is the
    ## one the environment had: the loader has to know where the dump is before it can read a
    ## rulefile which might name another.
    if [[ -n "$BAR_STATE_SETTING" ]]; then
        BAR_STATE_PATH="$BAR_STATE_SETTING"
    elif [[ -n "${BARF_FILE:-}" ]]; then
        local dir="${BARF_FILE%/*}"
        [[ -n "$dir" ]] || dir=.
        BAR_STATE_PATH="$dir/.bar.${BARF_FILE##*/}.dump"
    else
        BAR_STATE_PATH=""
    fi
}

function bar_state_volatile ## <name> - True for a variable or function a dump must not carry.
{
    ## bar's own state, and what belongs to the invocation rather than to the loaded modules.
    # A shell option is no declaration either: a module which changes one at load time sets it
    # again from a function registered in 'BAR_STATE_INIT_FNS'.
    case "$1" in
    BAR_STATE_BASE_VARS|BAR_STATE_BASE_FUNCS|BAR_STATE_DUMP|BAR_STATE_SETTING|BAR_STATE_PATH|\
    BAR_STATE_VARS|BAR_STATE_FUNCS|BAR_STATE_MAGIC|BAR_REQUIRE_LOADED|\
    BAR_SELF|BAR_CALLED_AS|BAR_PWD|BAR_TOPLEVEL|BAR_PREFIX|BAR_DIR|BARF_FILE|BAR_BARE|BAR_TIMESTAMP|\
    BAR_VERBOSITY_LEVEL|BARF_PP_AWK|BARF_PP_FILES|BARF_PP_NAME|BAR_PP_IN|BAR_PP_OUT|BAR_PP_MARK|BAR_PP_OWNER|\
    SHELLOPTS|BASHOPTS|TTYOUT|TTYERR|COLOR|TERM|PWD|OLDPWD|SHLVL|_|RANDOM|SECONDS|LINENO|\
    EPOCHREALTIME|EPOCHSECONDS|\
    BASHPID|PPID|GROUPS|DIRSTACK|PIPESTATUS|FUNCNAME|BASH*)
        return 0
        ;;
    esac
    return 1
}

function bar_state_snapshot ## - Records the declarations the module loads are about to change.
{
    ## Taken before the first module is sourced: whatever a module leaves the same came from the
    ## environment and must not be written into the dump.
    local line name
    while IFS= read -r line; do
        name="${line%%=*}"
        name="${name##* }"
        BAR_STATE_BASE_VARS["$name"]="$line"
    done < <(declare -p)
    # the names are enough: a module may add functions, and one which *replaces* a function bar
    # itself defines is not carried (it is not the module's state, and the one case of it here --
    # 'tty_newline' -- belongs to the invocation, see 'bar_state_volatile')
    while IFS= read -r line; do
        BAR_STATE_BASE_FUNCS["${line##* }"]=
    done < <(declare -F)
}

function bar_state_sums ## <files..> - Prints one checksum over the paths and the file contents.
{
    ## The paths are part of it, so the checksum answers for the set of inputs as well as for each
    ## of them.
    # A timestamp comparison was measured against this: a 'stat' per input plus the 100 ms window
    # a coarse mtime needs saves 2 of the ~29 ms a run takes here (~7%), which does not pay for
    # what the checksum covers (a file put back with an older mtime included).
    command -v cksum >/dev/null || return 1
    { printf '%s\n' "$@" && cat -- "$@" 2>/dev/null ; } | cksum
}

function bar_state_dump ## - Writes the state of the loaded modules to the dump file.
{
    bar_state_path
    # the rulefile may have turned it off during the load just done; the environment's 'off' never
    # reaches here (nothing was loaded which could have written)
    bar_state_off && return 0
    # The declarations are captured before this function declares anything of its own: 'declare
    # -p' lists the locals of every function on the call path, and those are the writer's state,
    # not the modules' -- they must never end up in the dump.
    BAR_STATE_VARS="$(declare -p)"
    BAR_STATE_FUNCS="$(declare -F)"
    local file="$BAR_STATE_PATH"
    # no rulefile, no name: a run which depends on the modules alone keeps no dump
    [[ -n "$file" ]] || return 0
    local dir="${file%/*}"
    [[ -n "$dir" ]] || dir=.
    # a rulefile directory we may not write to keeps no dump either -- the run is served from the
    # files as always, and the reason is one line rather than a failure of the run
    [[ -w "$dir" ]] || { warn "state: '$dir' is not writable, no dump"; return 0; }
    local -a files=("$BAR_SELF")
    local -A seen=(["$BAR_SELF"]=1)
    local entry line name flags rest result
    if [[ -n "${BARF_FILE:-}" && -z "${seen[$BARF_FILE]:-}" ]]; then
        files+=("$BARF_FILE")
        seen["$BARF_FILE"]=1
    fi
    for entry in $BARF_PP_FILES; do
        entry="${entry#*=}"
        [[ -n "${seen[$entry]:-}" ]] && continue
        files+=("$entry")
        seen["$entry"]=1
    done
    # What the load *declared* is text in the inputs, and a declaration whose value the environment
    # already supplied is unchanged by the load -- so it would not be carried, and a later run
    # without that variable would have no declaration at all: a module default such as
    # 'BAR_KEEP_GOING=1' would be missing and the run would die on 'set -u'.  The names the inputs
    # declare are collected for that reason, and a module variable the environment overrode keeps
    # its value as the default of the next run (set it again, or remove the dump).
    local -A declared=()
    while IFS= read -r name; do
        [[ -n "$name" ]] && declared["$name"]=1
    done < <(awk -v barf="${BARF_FILE:-}" -v self="$BAR_SELF" '
        FILENAME != self && match($0, /(declare|typeset|readonly) +-[a-zA-Z]+ +[A-Za-z_][A-Za-z0-9_]*/) {
            name = substr($0, RSTART, RLENGTH); sub(/.* +/, "", name); print name; next }
        # the rulefile assigns without a keyword ("NAME := value" is preprocessed into
        # "NAME=value") while a module declares: anywhere else, an assignment at the start of a
        # line is one inside a function
        FILENAME == barf && match($0, /^[ \t]*[A-Za-z_][A-Za-z0-9_]*[ \t]*(\?)?[:=]/) {
            name = substr($0, RSTART, RLENGTH); sub(/^[ \t]*/, "", name); sub(/[^A-Za-z0-9_].*/, "", name)
            print name }
    ' "${files[@]}" 2>/dev/null)
    result="$(bar_state_sums "${files[@]}")" || return 0
    {
        printf '%s\n' "$BAR_STATE_MAGIC"
        printf '# barf=%s\n' "${BARF_FILE:-}"
        for entry in "${files[@]}"; do
            printf '# file=%s\n' "$entry"
        done
        # which module names the load settled: 'loaded', or 'missing' for a name a 'require --opt'
        # probed and did not find.  Both are carried -- without the second, a bare 'require' of a
        # module the load already found missing would look it up again, and warn about it
        for name in "${!BAR_REQUIRE_LOADED[@]}"; do
            case "${BAR_REQUIRE_LOADED[$name]}" in
            true) printf '# loaded=%s\n' "$name" ;;
            false) printf '# missing=%s\n' "$name" ;;
            esac
        done
        printf '# sums=%s\n# end\n' "$result"
        while IFS= read -r line; do
            name="${line%%=*}"
            name="${name##* }"
            bar_state_volatile "$name" && continue
            # unchanged by the load: it came from the environment, and it is only carried when the
            # inputs declare it themselves (see 'declared' above)
            changed=''
            if [[ -n "${BAR_STATE_BASE_VARS[$name]+x}" ]]; then
                [[ "${BAR_STATE_BASE_VARS[$name]}" == "$line" ]] || changed=1
                [[ -n "$changed" || -n "${declared[$name]+x}" ]] || continue
            fi
            # the dump is sourced from inside a function, where a bare 'declare' would make the
            # variable local to it: every declaration is global, or it would be gone on return
            rest="${line#declare }"
            flags="${rest%% *}"
            rest="${rest#* }"
            [[ "$flags" == -- ]] && flags=
            flags="${flags#-}"
            # a declaration which is readonly already would abort the sourcing run: keep the form
            # re-declarable, the value is the same
            case "$flags" in
            *r*) printf 'if [[ ! -v %s ]]; then\ndeclare -g%s %s\nfi\n' "$name" "$flags" "$rest" ;;
            *[aA]*) printf 'declare -g%s %s\n' "$flags" "$rest" ;;
            *)
                # a value the load *changed* is carried as the load left it (the module computed it
                # from the environment, and an init function is the way to keep such a value live).
                # Everything else is a default the module wrote, and a run without a dump lets the
                # environment win over it ('${NAME:-default}' is how modules write those): the dump
                # loses the same way, or 'BAR_AGENT_HEAD=2 bar ...' would be answered with the
                # default of the run which wrote the dump.
                if [[ -n "$changed" ]]; then
                    printf 'declare -g%s %s\n' "$flags" "$rest"
                else
                    printf 'if [[ -z "${%s-}" ]]; then\ndeclare -g%s %s\nfi\n' "$name" "$flags" "$rest"
                fi
                ;;
            esac
        done <<<"$BAR_STATE_VARS"
        while IFS= read -r line; do
            name="${line##* }"
            bar_state_volatile "$name" && continue
            [[ -n "${BAR_STATE_BASE_FUNCS[$name]+x}" ]] && continue
            declare -f "$name"
        done <<<"$BAR_STATE_FUNCS"
    } >"$file.tmp.$$" 2>/dev/null || { rm -f "$file.tmp.$$"; return 0; }
    mv -f "$file.tmp.$$" "$file" || { rm -f "$file.tmp.$$"; return 0; }
    debug "state: wrote $file"
}

function bar_state_load ## - Sources the dump instead of the modules, when it is current.
{
    ## Succeeds only when a dump exists and is current, so that the caller can leave the files
    ## alone; any other case is a miss and it loads them as always.
    # Current means: made by this 'bar', from this rulefile, from these inputs, and none of them
    # changed since.
    bar_state_off "$BAR_STATE_SETTING" && return 1
    # 'BAR_INSTALL_DEPS' is the bootstrap 'bar init_deps' runs: it vendors what the *defining* of a
    # rule names, so a run which skipped the definitions has nothing to walk
    [[ -z "${BAR_INSTALL_DEPS:-}" ]] || return 1
    bar_state_path
    local file="$BAR_STATE_PATH" line
    [[ -n "$file" ]] || return 1
    [[ -f "$file" ]] || return 1

    local -a files=()
    local -A loaded=()
    local sums='' want_barf='' end=''
    while IFS= read -r line; do
        case "$line" in
        "$BAR_STATE_MAGIC") : ;;
        '# barf='*) want_barf="${line#'# barf='}" ;;
        '# file='*) files+=("${line#'# file='}") ;;
        '# loaded='*) loaded["${line#'# loaded='}"]=true ;;
        '# missing='*) loaded["${line#'# missing='}"]=false ;;
        '# sums='*) sums="${line#'# sums='}" ;;
        '# end') end=1 ; break ;;
        *) return 1 ;;
        esac
    done <"$file"
    [[ -n "$end" && -n "$sums" ]] || return 1
    (( ${#files[@]} )) || return 1
    [[ "$want_barf" == "${BARF_FILE:-}" ]] || return 1

    # a module which appeared in 'Bar.d' since the dump was made is in no file list: the startup
    # set itself has to be the recorded one
    local -A dumped=()
    local input mod
    for input in "${files[@]}"; do
        dumped["$input"]=1
    done
    for mod in "$BAR_DIR/std_lib" "$BAR_DIR/rule_lib" "$BAR_DIR"/*_rules; do
        [[ -f "$mod" ]] || continue
        [[ -n "${dumped[$mod]:-}" ]] || return 1
    done
    [[ "$(bar_state_sums "${files[@]}")" == "$sums" ]] || return 1

    # shellcheck disable=SC1090 # the dump is generated
    # a dump which cannot be sourced is broken, not stale: the files behind it checked out, so
    # half a state is worse than a message
    source "$file" || die "state dump '$file' could not be sourced, remove it"
    # the modules this dump was made from are loaded: a later 'require' of one of them is the
    # no-op it is without a dump, and one which is not in the dump loads as always
    for line in "${!loaded[@]}"; do
        BAR_REQUIRE_LOADED["$line"]="${loaded[$line]}"
    done
    for line in "${BAR_STATE_INIT_FNS[@]}"; do
        "$line"
    done
    debug "state: sourced $file"
}

# placeholder, overwritten by tty_lib when present
function tty_newline { :; }

function source_info # [N] - returns file:line N (or 0) up the bash call stack
{
    ## A module is sourced from the text the filter printed, so its frame names '/dev/fd/NN'; the
    ## descriptor is mapped back to the module.  Line numbers need no such help: the filter prints
    ## one line per line.
    local file="${BASH_SOURCE[$((${1:-0}+1))]}"
    if [[ "$file" == /dev/fd/* ]]; then
        barf_pp_name "$file"
        file="$BARF_PP_NAME"
    fi
    echo "$file:${BASH_LINENO[$((${1:-0}))]}:${FUNCNAME[$((${1:-0}+1))]:+${FUNCNAME[$((${1:-0}+1))]}:}"
}

## Source site (file and function) of the last report, and the location prefix of the current
## one. Used to condense the repeated 'file:line:func:' prefix of a multi line report.
declare -gx BAR_LAST_SITE=""
declare -gx BAR_REPORT_LOC=""
declare -gx BAR_REPORT_REPEATED=false

function bar_report_condense ## - True when the source location should be condensed on the console.
{
    ## The verbose 'file:line:func:' location is only condensed when the output goes to the
    ## console. Redirected output keeps the full, easily filterable format.
    case "${BAR_REPORT_CONDENSE:-auto}" in
        always) return 0 ;;
        never)  return 1 ;;
        auto|*) [[ -t 2 ]] ;;
    esac
}

function bar_report_loc ## [N] - Sets BAR_REPORT_LOC for a report N frames up the stack.
{
    ## Like 'source_info N' but condenses the source location of consecutive reports from the
    ## same file and function: the location is printed once and then replaced by blanks of the
    ## same width. Sets 'BAR_REPORT_REPEATED' when this report continued such a block.
    local loc
    loc="$(source_info "$((${1:-0}+1))")"

    if ! bar_report_condense; then
        BAR_REPORT_LOC="$loc"
        BAR_REPORT_REPEATED=false
        return 0
    fi

    local rest="${loc#*:}"                  # strip '<file>:'
    local func="${rest#*:}"                 # strip '<line>:'
    local site="${loc%%:*}:${func%:*}"      # '<file>:<func>' without the line number
    if [[ -n "$BAR_LAST_SITE" && "$site" = "$BAR_LAST_SITE" ]]; then
        BAR_REPORT_LOC="${loc//?/ }"
        BAR_REPORT_REPEATED=true
    else
        BAR_REPORT_LOC="$loc"
        BAR_REPORT_REPEATED=false
        BAR_LAST_SITE="$site"
    fi
    return 0
}

function bar_report_condensed ## - True when the repeated location is to be blanked down to a ':'.
{
    ## 'BAR_REPORT_STYLE=tag' (default) keeps the message tag in front of the blanked location,
    ## 'colon' blanks the tag as well so that only the ':' of the location remains.
    [[ "$BAR_REPORT_REPEATED" = true && "${BAR_REPORT_STYLE:-tag}" = colon ]]
}

function DBG ## [message..] - For print-style debugging, should not be present in production code.
{
    {
        tty_newline
        echo "${TTYERR[dbg]}  DBG:${TTYERR[reset]} $(source_info 1) $*"
    } >&2
}

function die ## [message..] - Prints 'message' to stderr and exits with failure
{
    ## Unexpected fatal problem. Will terminate execution, CLEANUP rules will be called.
    ## The source location is condensed like 'error' does, see there for 'BAR_REPORT_CONDENSE' and
    ## 'BAR_REPORT_STYLE'.
    if (( BAR_VERBOSITY_LEVEL > 0 )); then
        tty_newline
        bar_report_loc 1
        if bar_report_condensed; then
            echo "${TTYERR[panic]}$(printf '%*s' "$(( ${#BAR_REPORT_LOC} + 6 ))" '')${TTYERR[reset]}: $*"
        else
            echo "${TTYERR[panic]}PANIC:${TTYERR[reset]} ${BAR_REPORT_LOC} $*"
        fi
    fi >&2
    exit 1
}

function error ## [message..] - Print a error message to stderr.
{
    ## Unexpected but not fatal.
    ## The source location is printed for the first report of a function and condensed to blanks
    ## for the following ones, so a multi line report stays readable. 'BAR_REPORT_CONDENSE' is
    ## 'always', 'never' or 'auto' (default: only on a console, redirected output keeps the full
    ## format) and 'BAR_REPORT_STYLE' is 'tag' (default) or 'colon'.
    if (( BAR_VERBOSITY_LEVEL > 0 )); then
        tty_newline
        bar_report_loc 1
        if bar_report_condensed; then
            echo "${TTYERR[fail]}$(printf '%*s' "$(( ${#BAR_REPORT_LOC} + 6 ))" '')${TTYERR[reset]}: $*"
        else
            echo "${TTYERR[fail]}ERROR:${TTYERR[reset]} ${BAR_REPORT_LOC} $*"
        fi
    fi >&2
}

function warn ## [message..] - Print an warning to stderr.
{
    ## Expected, non fatal problem.
    BAR_LAST_SITE=""
    if (( BAR_VERBOSITY_LEVEL > 1 )); then
        tty_newline
        echo "${TTYERR[warn]} WARN:${TTYERR[reset]} $*" >&2
    fi >&2
}

function note ## [message..] - Print an important notice to stderr.
{
    ## Important message the user should be notified about.
    BAR_LAST_SITE=""
    if (( BAR_VERBOSITY_LEVEL > 2 )); then
        tty_newline
        echo "${TTYERR[warn]} NOTE:${TTYERR[reset]} $*"
    fi >&2
}

function info ## [message..] - Print an informal message to stderr.
{
    ## Broader message about non rule related progress.
    BAR_LAST_SITE=""
    if (( BAR_VERBOSITY_LEVEL > 3 )); then
        tty_newline
        echo "${TTYERR[info]} INFO:${TTYERR[reset]} $*"
    fi >&2
}

function debug ## [message..] - Print a debug message to stderr.
{
    ## Finer grained progress messages.
    if (( BAR_VERBOSITY_LEVEL > 4 )); then
        tty_newline
        echo "${TTYERR[debug]}DEBUG:${TTYERR[reset]} $(source_info 1) $*"
    fi >&2
}

function trace ## [message] - Prints a trace message to stderr.
{
    ## Very verbose function call or finer messages.
    if (( BAR_VERBOSITY_LEVEL > 5 )); then
        tty_newline
        echo "${TTYERR[trace]}TRACE:${TTYERR[reset]} $(source_info 1) $*"
    fi >&2
}

bar_main "$@"
