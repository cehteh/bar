# -*- mode: sh; sh-shell: bash -*-
# vim: set ft=bash:
# shellcheck shell=bash
#shellcheck disable=SC2016

### The library that implements rules, always loaded

declare -g   BAR_CHECK_LEVEL=0         # less alerting for check dependencies
declare -gx  BAR_KEEP_GOING="${BAR_KEEP_GOING:-1}"  ## Controls keep-going mode: 0 or 1 stops at first failure (default), numbers >= 2 allow that many failures before stopping, non-numeric values (yes/true/etc) continue until exhaustion. In keep-going mode, pure clauses continue executing after failures though failures are still propagated. Non-pure or conclusive clauses halt keep-going within the current rule.
declare -gAx BAR_RULES                 # discovered rules as name:"clauseidx.."
declare -gAx BAR_RULES_RESULT          # results "name":"hashes .." and "#hash":rc
declare -gA  BAR_RULE_FLAGS=(          # [r]everse [a]lways [m]eta [d]isjunct [m]meta [D]isabled [b]are
    [CLEANUP]="r"
    [clause_local]="am"
)
declare -gax BAR_CLAUSES=()            # clause bodies enumerated
declare -gax BAR_CLAUSE_DEPS=()        # dependencies for each clause
declare -ga  BAR_CLAUSE_FLAGS=()       # [c]onclusive [d]efault

function rule () ## [[--rule-flag].. <name>:] [--clause-flag].. [[+][!]dep[?] [arg]..].. [-- body..] - Defines a rule.
{
    ## See RULE DEFINITION SYNTAX in help for details
    trace "$*"

    local ruleflags=""
    while [[ "$#" -gt 0 ]]; do
        case "$1" in
        --always)
            ruleflags+="a"
            ;;
        --bare)
            ruleflags+="b"
            ;;
        --reverse)
            ruleflags+="r"
            ;;
        --disjunct)
            ruleflags+="d"
            ;;
        --meta)
            ruleflags+="m"
            ;;
        --parallel)
            ruleflags+="p"
            ;;
        --disable)
            ruleflags+="D"
            ;;
        *)
            break;;
        esac
        shift
    done

    local name="$1"
    if [[ "$name" = *: ]]; then
        name="${name%:}"
        shift
    else
        name=""
    fi

    local clauseflags=""
    while [[ "$#" -gt 0 ]]; do
        case "$1" in
        --conclusive)
            clauseflags+="c"
            ;;
        --default)
            clauseflags+="d"
            ;;
        --parallel)
            clauseflags+="p"
            ;;
        *)
            break;;
        esac
        shift
    done

    local deps=()
    local has_body=
    local deps_for_cmd=
    while [[ $# -ne 0 ]]; do
        if [[ "$1" = - ]]; then
            shift
            deps_for_cmd=true
            break
        fi
        if [[ "$1" = -- ]]; then
            shift
            has_body=true
            break
        fi
        deps+=("$1")
        shift
    done

    # name given but no deps, no body, make body default to the rule name
    local body=""
    if [[ "${#deps[*]}" = 0 && "$#" == 0 && -n "$name" ]]; then
        body="$name "'"${RULE_ARGS[@]}"'
    elif [[ -n "$deps_for_cmd" && "$#" == 0 && -n "$name" ]]; then
        rule_exists "$name" && die "rule '$name' already defined"
        body="$name "'"${RULE_ARGS[@]}"'
    elif [[ -z "$name" ]]; then
        # default to MAIN when no rule name is given
        name="MAIN"
    elif [[ -z "$deps_for_cmd" && -z "${BAR_RULES[$name]:-}" ]]  && command -v -- "$name" >/dev/null ; then
        note "defining rule '$name' for existing command"
    fi

    if [[ -v BAR_RULES_RESULT[$name] ]]; then
        die "Can not add clause '$name:${deps[*]:+ ${deps[*]}}' after rule got evaluated"
    fi

    local ifs="$IFS"
    IFS=$'\n'
    BAR_CLAUSE_DEPS+=("${deps[*]}")
    IFS="$ifs"

    if [[ "$has_body" = true && $# = 0 ]]; then
        BAR_CLAUSES+=("$(cat)")
    else
        BAR_CLAUSES+=("$body$*")
    fi

    BAR_CLAUSE_FLAGS+=("$clauseflags")
    BAR_RULE_FLAGS["$name"]="${BAR_RULE_FLAGS[$name]:-}$ruleflags"

    # BAR_INSTALL_DEPS is the bootstrap 'bar init_deps' uses: defining a rule loads everything its
    # clause names, so a vendored 'Bar.d' grows the modules a project really needs (see
    # rule_install_deps).  Unset (the normal case) this costs one test.
    [[ -z "${BAR_INSTALL_DEPS:-}" ]] || rule_install_deps "${BAR_CLAUSES[$((${#BAR_CLAUSES[@]} - 1))]}" ${deps[@]+"${deps[@]}"}

    local newclause=" $((${#BAR_CLAUSES[@]} - 1))"

    # if this clause is --default then just append it to the end
    if [[ "${BAR_CLAUSE_FLAGS[$newclause]}" = *d* ]]; then
        BAR_RULES["$name"]+="$newclause"
    else # append it before any defaults
        local newclauses=""
        local clause
        for clause in ${BAR_RULES["$name"]:-}; do
            if [[ -n "$newclause" && "${BAR_CLAUSE_FLAGS[$clause]}" = *d* ]]; then
                newclauses+="$newclause"
                newclause=""
            fi
            newclauses+=" $clause"
        done
        newclauses+="$newclause"
        BAR_RULES["$name"]="$newclauses"
    fi
}

function rule_install_dep ## <name> - makes what a clause dependency names reachable
{
    ## Called by :func:`rule_install_deps` while BAR_INSTALL_DEPS is set.  A dependency is
    ## resolved the way the evaluator resolves it, only without failing: this runs at *definition*
    ## time, where the rule that names the dependency is not evaluated at all, so a dependency
    ## nothing provides must not stop the walk (it is a dependency of a rule this project never
    ## calls, or one of the optional ones).  Loading the module a dependency lives in may define
    ## further rules, which walk their own dependencies in turn.
    local name="$1"
    rule_exists "$name" && return 0
    if command -v -- "$name" >/dev/null; then
        rule "$name:"
        return 0
    fi
    local modname="$name"
    modname="${modname#always_}"
    modname="${modname#is_}"
    modname="${modname#has_}"
    modname="${modname#try_}"
    modname="${modname%%_*}"
    if [[ -n "$modname" ]]; then
        # the same two names the autoloader requires, 'require' vendors them when they are
        # missing from this 'Bar.d'
        require --opt "$modname" "${modname}_lib"
    fi
    if ! rule_exists "$name" && command -v -- "$name" >/dev/null; then
        rule "$name:"
    fi
    if rule_exists "$name"; then
        return 0
    fi
    debug "install_deps: nothing provides '$name'"
    return 1
}

function rule_install_deps ## <body> [deps..] - loads what a clause's body and dependencies need
{
    ## Called from :func:`rule` while BAR_INSTALL_DEPS is set.  Every dependency is made
    ## reachable (and the module it lives in loaded, transitively) and the body is walked line by
    ## line: a line which is a 'require' command is executed.  Nothing is evaluated, this only
    ## makes sure the rules, commands and modules a clause names exist.
    ##
    ## A dependency with a '??' suffix is one the evaluator only runs *when it exists* -- forcing
    ## it here would install modules a project never uses, so it is skipped.
    local body="$1"
    shift
    local line
    while IFS= read -r line; do
        line="${line#"${line%%[![:space:]]*}"}"
        case "$line" in
        require | require\ *)
            debug "install_deps: $line"
            eval "$line" || warn "install_deps: '$line' failed"
            ;;
        esac
    done <<<"$body"

    local dep name
    for dep in ${1+"$@"}; do
        if [[ "$dep" = *'??'* ]]; then
            continue
        fi
        name="${dep%% *}"
        name="${name#"!"}"
        name="${name%?}"
        name="${name%~}"
        [[ -n "$name" ]] || continue
        rule_install_dep "$name" || true
    done
}

function newrule ## <name:> ... - Creates a new rule, deletes the existing one.
{
    ## Used to replace already existing rules/clauses.
    rule_delete "${1%:}"
    rule "$@"
}

function rule_delete ## <name> - Deletes a rule (and all it clauses).
{
    ## Can only be used when the rule was not evaluated yet.
    trace "$*"
    local name="$1"
    if [[ -z "$name" ]]; then
        die "rule_delete requires a rule name"
    fi

    if ! rule_exists "$name"; then
        error "rule '$name' does not exist"
        return 1
    fi

    if [[ -v BAR_RULES_RESULT[$name] ]]; then
        error "Can not delete rule '$name' after rule got evaluated"
        return 1
    fi

    unset "BAR_RULES[$name]"
    unset "BAR_RULE_FLAGS[$name]"
}

function rule_rename ## <oldname> <newname> - renames a rule
{
    ## Can only be used when the rule was not evaluated yet.
    trace "$*"
    local oldname="$1"
    local newname="$2"
    local rc

    if [[ -z "$oldname" || -z "$newname" ]]; then
        die "rule_rename requires two rule names"
    fi

    if ! rule_exists "$oldname"; then
        error "rule '$oldname' does not exist"
        return 1
    fi

    if [[ -v BAR_RULES_RESULT[$oldname] ]]; then
        error "Can not rename rule '$oldname' after it got evaluated"
        return 1
    fi

    BAR_RULES["$newname"]="${BAR_RULES[$oldname]}"
    unset "BAR_RULES[$oldname]"
    BAR_RULE_FLAGS["$newname"]="${BAR_RULE_FLAGS[$oldname]}"
    unset "BAR_RULE_FLAGS[$oldname]"
}

function clause_local ## [var[=value]|=var..] - Makes scalar variables local to a clause.
{
    # the locals carry a prefix: the variables this assigns are named by the caller, and a local
    # called 'var' or 'value' would take the assignment instead of the clause's variable
    local _cl_var
    local _cl_name
    local _cl_value
    local _cl_assign
    for _cl_var in "$@"; do
        _cl_name="${_cl_var%%=*}"
        _cl_value=""
        _cl_assign=0
        if [[ "$_cl_var" == *=* ]]; then
            _cl_assign=1
            _cl_value="${_cl_var#*=}"
        fi
        if [[ -v "$_cl_name" ]]; then
            is_scalar "$_cl_name" || die "only scalar variables can be clause_local"
            CLAUSE_LOCAL[$_cl_name]="${!_cl_name}"
        else
            # using some magic here
            CLAUSE_LOCAL[$_cl_name]="<<unset_clause_local_variable>>"
        fi
        if (( _cl_assign )); then
            eval "$_cl_name='$_cl_value'"
        fi
    done
}

function clause_local_restore
{
    local _cl_key
    local _cl_value
    for _cl_key in "${!CLAUSE_LOCAL[@]}"; do
        declare -n _cl_ref="$_cl_key"
        _cl_value="${CLAUSE_LOCAL[$_cl_key]}"
        if [[ "${_cl_value}" = "<<unset_clause_local_variable>>" ]]; then
            unset "$_cl_key"
        else
            _cl_ref="$_cl_value"
        fi
        unset -n _cl_ref
    done
    unset CLAUSE_LOCAL
}

### Dependency jobs -- '+' starts a run of dependencies concurrently

declare -g  BAR_PARALLEL="${BAR_PARALLEL:-1}"  ## How many dependency jobs may run at once. 1 (the default) starts nothing early and is the serial evaluation.
declare -gi BAR_INFLIGHT=0                     # jobs started and not yet collected in this shell
declare -ga BAR_JOB_PIDS=()                    # what the run still owes, for the exit path
declare -g  BAR_JOB_DIR=""                     # the run's job directory: the server FIFO and the shared results
declare -gi BAR_JOB_SERVER=-1                  # the server's descriptor, inherited by every job; -1 when there is none
declare -gi BAR_JOB_TOKEN=0                    # 1 while this shell holds a slot of its own
declare -gi BAR_JOB_OWED=0                     # 1 while this shell is owed its own slot back
declare -gi BAR_JOB_CLOSED=0                   # 1 once the run is tearing down: no server is started again
declare -ga BAR_JOB_CLAIMS=()                  # the rule claims this shell holds, for its exit path
declare -g  BAR_STORE_RC=""                    # what rule_result_get read out of the shared store
declare -g  BAR_ABANDONED=""                   # 1 once this run has given up what it has not started

# rule_parallel_budget - validates BAR_PARALLEL, setting it to 1 when it is unset or not a number
function rule_parallel_budget
{
    if [[ ! "${BAR_PARALLEL:-}" =~ ^[0-9]+$ ]] || (( BAR_PARALLEL < 1 )); then
        BAR_PARALLEL=1
    fi
    return 0
}

# Abandoning a run -- early fail, and the atomicity of a body
#
# When a conjunctive rule fails, nothing which has not started is worth starting: the rule returns
# the failure for the whole run.  'rule_jobs_abandon' says so once, in the run's job directory (a
# file, because a shell which already forked cannot be told any other way), and every shell of the
# tree asks before it starts the next dependency or the next body.  What has started is finished:
# a body is the atomic unit of work -- a rule body may have side effects in the directory and a
# grandchild's body is no different -- so the jobs which are running are collected, not killed.
# Abandonment is therefore about what would still be started: no new dependency, no new body, and a
# shell which finds the mark returns.

# rule_jobs_abandon - gives up what this run has not started yet
function rule_jobs_abandon
{
    BAR_ABANDONED=1
    [[ -n "${BAR_JOB_DIR:-}" ]] || return 0
    : >"${BAR_JOB_DIR:?}/abandon"
    return 0
}

# rule_jobs_abandoned - succeeds once the run has given up what it had not started
function rule_jobs_abandoned
{
    [[ -n "${BAR_ABANDONED:-}" ]] && return 0
    [[ -n "${BAR_JOB_DIR:-}" && -e "${BAR_JOB_DIR}/abandon" ]]
}

# rule_jobs_abandon_settle <pids> <rcs> - abandons the rest of the run and collects what this shell started
function rule_jobs_abandon_settle
{
    rule_jobs_abandon
    rule_jobs_flush "$1" "$2"
    # The mark goes when the rule which set it returns.  What this shell started is collected by
    # the line above -- a job waits for its own jobs before it returns, so the whole subtree has
    # seen the mark -- and the rules which run after this one (POSTPROCESS, CLEANUP) are a new
    # piece of work that owes its own start.
    BAR_ABANDONED=""
    [[ -n "${BAR_JOB_DIR:-}" ]] && rm -f "${BAR_JOB_DIR}/abandon"
    return 0
}

# The job server -- one budget for the whole process tree
#
# The server is a FIFO holding BAR_PARALLEL tokens, opened read-write: a descriptor opened that way
# never sees EOF and serves both the take and the give, and a job inherits it by fork.  A shell
# takes a token for the job it is about to start and the job returns it on its way out, so the cap
# belongs to the tree and a job which starts jobs of its own spends from the same budget.  A shell
# which has to wait for a token hands its own back first and collects what it already started, so a
# blocked shell holds no token -- which is what keeps a tree at the cap from waiting on itself
# (make's jobserver rule).

function rule_job_server_start # - starts the run's job server and result store unless one is running
{
    [[ -z "$BAR_JOB_DIR" ]] || return 0
    (( BAR_PARALLEL > 1 && ! BAR_JOB_CLOSED )) || return 0
    local dir fd
    if ! dir="$(mktemp -d "${TMPDIR:-/tmp}/bar-jobs.XXXXXXXXXX")"; then
        BAR_PARALLEL=1
        return 0
    fi
    if ! mkdir "$dir/results" "$dir/claims" || ! mkfifo "$dir/server"; then
        rm -rf "$dir"
        BAR_PARALLEL=1
        return 0
    fi
    if ! exec {fd}<>"$dir/server"; then
        rm -rf "$dir"
        BAR_PARALLEL=1
        return 0
    fi
    BAR_JOB_DIR="$dir"
    BAR_JOB_SERVER=$fd
    local -i token
    for ((token = 1; token <= BAR_PARALLEL; token++)); do
        printf 't\n' >&"$BAR_JOB_SERVER"
    done
    return 0
}

# rule_job_slot_available - succeeds when a slot can be taken without waiting
function rule_job_slot_available
{
    (( BAR_JOB_SERVER >= 0 )) || return 0
    local tok
    IFS= read -r -t 0 -u "$BAR_JOB_SERVER" tok
}

# rule_job_slot_take <pids> <rcs> - takes the slot a job is started with, giving its own slot back while it waits
function rule_job_slot_take
{
    local -n _sl_pids="$1" _sl_rcs="$2"
    (( BAR_JOB_SERVER >= 0 )) || return 0
    local tok
    # A shell which must wait hands its own slot back first: a shell which blocks holds no token,
    # and a token is therefore always held by something which is running.  That is what keeps a
    # tree whose budget is spent from waiting on itself (make's jobserver rule).  The own slot is
    # taken back only once the job holds this one -- 'rule_job_slot_restore', after the fork.
    local -i own=0
    if (( BAR_JOB_TOKEN )); then
        own=1
        rule_job_token_give
    fi
    while :; do
        # a probe which consumes nothing: 'read -t 0' succeeds only when a token is waiting
        if IFS= read -r -t 0 -u "$BAR_JOB_SERVER" tok; then
            IFS= read -r -u "$BAR_JOB_SERVER" tok && break
            continue
        fi
        # the budget is spent: collect what this shell started before waiting
        if (( BAR_INFLIGHT > 0 )); then
            rule_jobs_reap_one "$1" "$2"
            continue
        fi
        IFS= read -r -u "$BAR_JOB_SERVER" tok && break
    done
    BAR_JOB_OWED=$own
    return 0
}

# rule_job_slot_restore - takes this shell's own slot again once its job holds the one taken for it
function rule_job_slot_restore
{
    (( BAR_JOB_SERVER >= 0 && BAR_JOB_OWED )) || return 0
    BAR_JOB_OWED=0
    local tok
    # the token itself is not a value: taking it is what holds the slot
    # shellcheck disable=SC2034
    IFS= read -r -u "$BAR_JOB_SERVER" tok
    BAR_JOB_TOKEN=1
    return 0
}

# rule_job_token_give - returns a job slot to the server
function rule_job_token_give
{
    (( BAR_JOB_SERVER >= 0 )) || return 0
    printf 't\n' >&"$BAR_JOB_SERVER"
    return 0
}

# The shared result store -- one table for the whole run
#
# A job's own results die with the fork, so without a store a diamond whose two arms are jobs
# evaluates the rule they share twice.  Every verdict is also written to the run's store, keyed the
# way the memory table keys it, and a shell which does not find one in its own table reads it from
# there.  A claim directory is what stops two jobs evaluating the same rule at the same time: the
# shell which created it evaluates and the other takes its verdict.  Only a parallel run has a
# store; a serial run never looks, so it pays nothing.

function rule_result_get # <rule_id> - reads a verdict out of the run's store into BAR_STORE_RC
{
    [[ -n "${BAR_JOB_DIR:-}" && -f "$BAR_JOB_DIR/results/$1" ]] || return 1
    BAR_STORE_RC=""
    IFS= read -r BAR_STORE_RC <"$BAR_JOB_DIR/results/$1" || return 1
    [[ -n "$BAR_STORE_RC" ]] || return 1
    return 0
}

function rule_result_put # <rule_id> <rc> - writes a verdict to the run's store
{
    [[ -n "${BAR_JOB_DIR:-}" ]] || return 0
    local file="$BAR_JOB_DIR/results/$1"
    # written aside and renamed: a reader never sees half a verdict
    printf '%s\n' "$2" >"$file.$BASHPID" 2>/dev/null || return 0
    mv -f "$file.$BASHPID" "$file" 2>/dev/null || rm -f "$file.$BASHPID"
    return 0
}

# rule_result_claim <rule_id> - claims a rule in the run's store; 1 when another shell's verdict is there instead
function rule_result_claim
{
    [[ -n "${BAR_JOB_DIR:-}" ]] || return 0
    local dir="$BAR_JOB_DIR/claims/$1"
    local owner
    local -i waited=0
    while ! mkdir "$dir" 2>/dev/null; do
        # another shell is evaluating it: its verdict is what this one wants, and a claim whose
        # owner is gone is stale (it died between the claim and the write)
        [[ -f "$BAR_JOB_DIR/results/$1" ]] && return 1
        owner=""
        IFS= read -r owner <"$dir/owner" 2>/dev/null || owner=""
        if [[ -n "$owner" ]] && ! kill -0 "$owner" 2>/dev/null; then
            rm -rf "$dir"
            continue
        fi
        (( waited < 500 )) || { rm -rf "$dir"; continue; }
        waited=$((waited + 1))
        sleep 0.02
    done
    # the verdict may have landed between the check above and this claim: it is then still the
    # other shell's, and this one takes its result rather than evaluating a second time
    if [[ -f "$BAR_JOB_DIR/results/$1" ]]; then
        rm -rf "$dir"
        return 1
    fi
    printf '%s\n' "$BASHPID" >"$dir/owner"
    BAR_JOB_CLAIMS+=("$dir")
    return 0
}

# rule_result_drop_claims - gives back every claim this shell still holds, for its exit path
function rule_result_drop_claims
{
    local dir
    for dir in ${BAR_JOB_CLAIMS[@]+"${BAR_JOB_CLAIMS[@]}"}; do
        rm -rf "$dir"
    done
    BAR_JOB_CLAIMS=()
    return 0
}

# rule_result_release <rule_id> - gives the claim on one rule back
function rule_result_release
{
    [[ -n "${BAR_JOB_DIR:-}" ]] || return 0
    rm -rf "${BAR_JOB_DIR:?}/claims/$1"
    return 0
}

# rule_result_record <rule_id> <rc> - records a verdict in this shell and in the run's store
function rule_result_record
{
    BAR_RULES_RESULT["#$1"]="$2"
    [[ -n "${BAR_JOB_DIR:-}" ]] || return 0
    rule_result_put "$1" "$2"
    rule_result_release "$1"
    return 0
}

# rule_dep_parse <dependency> - splits a dependency into DEP_NAME, DEP_ARGS, DEP_CHECK, DEP_IFEXISTS and DEP_PARALLEL
function rule_dep_parse
{
    local dep="$1"
    DEP_NAME=""
    DEP_ARGS=()
    DEP_CHECK=""
    DEP_IFEXISTS=""
    DEP_PARALLEL=""
    if [[ "$dep" = "+"* ]]; then
        DEP_PARALLEL=true
        dep="${dep:1}"
    fi
    DEP_NAME="${dep%% *}"
    read -r -a DEP_ARGS <<<"${dep:${#DEP_NAME}+1}"
    if [[ "$DEP_NAME" = *"??" ]]; then
        DEP_IFEXISTS=true
        DEP_NAME="${DEP_NAME%??}"
    fi
    if [[ "$DEP_NAME" = *"?" ]]; then
        DEP_CHECK=check
        DEP_NAME="${DEP_NAME%?}"
    fi
    if [[ "$DEP_NAME" = "!"* ]]; then
        DEP_CHECK=negated
        DEP_NAME="${DEP_NAME:1}"
    fi
    if [[ "$DEP_NAME" = *"~" ]]; then
        [[ -z "$DEP_CHECK" ]] || die "~ can not be combined with ! or ?"
        DEP_CHECK=unconditional
        DEP_NAME="${DEP_NAME%?}"
    fi
    return 0
}

# rule_job_spawn <pids> <rcs> <key> <name> [args..] - starts one dependency as a job of its own; rcs[<key>] is 'pending' until collected
function rule_job_spawn
{
    local -n _sp_pids="$1" _sp_rcs="$2"
    # the key is a dependency id, not a number: an arithmetic one would read it as a variable
    local _sp_index="$3"
    shift 3
    # The job gets the parent's function and arrays by fork, and the run's job server: the budget it
    # spends from is the tree's, so a job which starts jobs of its own is bounded by what the whole
    # run may do at once.  Its filter channel is its own -- 'barf_pp_fork' drops the parent's, and
    # 'barf_pp_ensure' starts one in the shell whose descriptor the job's load inherits -- and its
    # own bookkeeping starts empty.
    (
        # the slot the parent took for this job is held here and returned on the way out, which is
        # what makes the budget the tree's rather than one per shell
        # shellcheck disable=SC2030,SC2031
        BAR_INFLIGHT=0
        # shellcheck disable=SC2030
        BAR_JOB_PIDS=()
        # shellcheck disable=SC2030
        BAR_JOB_CLAIMS=()
        BAR_JOB_TOKEN=1
        if command -v barf_pp_fork >/dev/null; then barf_pp_fork; fi
        trap 'rule_job_token_give; rule_result_drop_claims' EXIT
        rule_eval "$@"
    ) &
    _sp_pids["$_sp_index"]="$!"
    _sp_rcs["$_sp_index"]="pending"
    # shellcheck disable=SC2031
    BAR_JOB_PIDS+=("$!")
    # shellcheck disable=SC2031
    BAR_INFLIGHT=$((BAR_INFLIGHT + 1))
    # the own slot again: the job holds the one taken for it now, so this one waits on a job which
    # is running rather than on a token sitting in its own hand
    rule_job_slot_restore
    return 0
}

# rule_job_collect <pids> <rcs> <key> - waits for one started job, records its status and releases its slot
function rule_job_collect
{
    local -n _co_pids="$1" _co_rcs="$2"
    local _co_index="$3"
    [[ -n "${_co_pids[$_co_index]:-}" && "${_co_rcs[$_co_index]:-}" = pending ]] || return 0
    local _co_pid="${_co_pids[$_co_index]}"
    local -i _co_rc=0
    wait "$_co_pid" || _co_rc=$?
    _co_rcs["$_co_index"]="$_co_rc"
    BAR_INFLIGHT=$((BAR_INFLIGHT - 1))
    local -a _co_kept=()
    local _co_job
    for _co_job in ${BAR_JOB_PIDS[@]+"${BAR_JOB_PIDS[@]}"}; do
        [[ "$_co_job" = "$_co_pid" ]] || _co_kept+=("$_co_job")
    done
    BAR_JOB_PIDS=(${_co_kept[@]+"${_co_kept[@]}"})
    return 0
}

# rule_jobs_reap_one <pids> <rcs> - blocks until one started job ends, which frees its slot
function rule_jobs_reap_one
{
    local -n _ro_pids="$1" _ro_rcs="$2"
    local _ro_index
    for _ro_index in "${!_ro_pids[@]}"; do
        if [[ "${_ro_rcs[$_ro_index]:-}" = pending ]]; then
            rule_job_collect "$1" "$2" "$_ro_index"
            return 0
        fi
    done
    return 0
}

# rule_jobs_flush_clause <pids> <rcs> <clause> - collects the jobs the dependencies of one clause started
function rule_jobs_flush_clause
{
    local -n _fc_pids="$1" _fc_rcs="$2"
    local _fc_clause="$3"
    local -a _fc_deps=()
    local _fc_dep
    [[ "${#BAR_CLAUSE_DEPS[$_fc_clause]}" -gt 0 ]] && readarray -d $'\n' -t _fc_deps <<<"${BAR_CLAUSE_DEPS[$_fc_clause]}"
    for _fc_dep in ${_fc_deps[@]+"${_fc_deps[@]}"}; do
        rule_dep_parse "$_fc_dep"
        rule_job_collect "$1" "$2" "$(hash_args "$PWD $DEP_NAME ${DEP_ARGS[*]}")"
    done
    return 0
}

# rule_dep_jobs_prestart <pids> <rcs> <clause>.. - starts the dependencies of a parallel rule ahead
#
# The clauses of a rule marked '--parallel' are still evaluated in declared order and their bodies
# run serially in the shell of the rule -- a body works in the directory and may rely on what the
# body before it did -- but the dependencies of the clauses which follow are started at the first
# one, so a rule whose clauses are dependency lists spends one dependency's time instead of the
# sum.  The same barriers a clause's own run respects end the walk: a dependency which is not a
# candidate (a plain one, a conditional one, '--always'), a clause flagged '--conclusive' or
# '--default', and a dependency another shell already decided.
function rule_dep_jobs_prestart
{
    local _ps_pids_name="$1" _ps_rcs_name="$2"
    local -n _ps_pids="$_ps_pids_name" _ps_rcs="$_ps_rcs_name"
    shift 2
    local _ps_clause _ps_dep _ps_id
    local -a _ps_deps=()
    for _ps_clause in "$@"; do
        case "${BAR_CLAUSE_FLAGS[$_ps_clause]:-}" in
        *c* | *d*) return 0 ;;
        esac
        _ps_deps=()
        [[ "${#BAR_CLAUSE_DEPS[$_ps_clause]}" -gt 0 ]] && readarray -d $'\n' -t _ps_deps <<<"${BAR_CLAUSE_DEPS[$_ps_clause]}"
        for _ps_dep in ${_ps_deps[@]+"${_ps_deps[@]}"}; do
            rule_jobs_abandoned && return 0
            rule_dep_parse "$_ps_dep"
            # the rule is marked '--parallel', which is what puts every dependency of a clause
            # without a '--conclusive'/'--default' flag into its run: what ends the walk here is a
            # dependency which is conditional or one the run must not start again
            [[ -z "$DEP_IFEXISTS" && "$DEP_CHECK" != check && "$DEP_CHECK" != negated ]] || return 0
            [[ "${BAR_RULE_FLAGS[$DEP_NAME]-a}" = *a* ]] && return 0
            _ps_id="$(hash_args "$PWD $DEP_NAME ${DEP_ARGS[*]}")"
            [[ -z "${_ps_pids[$_ps_id]:-}" ]] || continue
            [[ -v BAR_RULES_RESULT[#$_ps_id] ]] && continue
            rule_result_get "$_ps_id" && continue
            # A spent budget ends the walk here rather than waiting for a slot: the evaluation
            # below starts the rest as the verdicts come in, taken in declared order, so a failure
            # in the first of them stops the work behind it instead of starting it.  Waiting here
            # would collect whichever job finishes first -- the table has no declared order -- and
            # the walk would go on regardless.
            (( BAR_INFLIGHT > 0 )) && ! rule_job_slot_available && return 0
            rule_job_slot_take "$_ps_pids_name" "$_ps_rcs_name"
            if rule_jobs_failed "$_ps_pids_name" "$_ps_rcs_name"; then
                # the wait collected a failure: the verdict is settled, so nothing more is started
                # here.  The evaluation below takes the verdicts in declared order and returns at
                # the dependency which failed.
                rule_job_slot_restore
                rule_job_token_give
                return 0
            fi
            rule_job_spawn "$_ps_pids_name" "$_ps_rcs_name" "$_ps_id" "$DEP_NAME" "${DEP_ARGS[@]}"
        done
    done
    return 0
}

# rule_jobs_failed <pids> <rcs> - succeeds when a collected job failed
#
# A slot is waited for by collecting what this shell started, so a failure can arrive while the
# next dependency is about to be started: the rule's verdict is settled then, and what the wait
# collected is the mark which stops the walk.
function rule_jobs_failed
{
    local -n _jf_rcs="$2"
    local _jf_key
    for _jf_key in "${!_jf_rcs[@]}"; do
        [[ "${_jf_rcs[$_jf_key]}" = pending ]] && continue
        [[ "${_jf_rcs[$_jf_key]}" = 0 ]] || return 0
    done
    return 1
}

# rule_jobs_flush <pids> <rcs> - collects every job still pending
function rule_jobs_flush
{
    local -n _fl_pids="$1" _fl_rcs="$2"
    local _fl_index
    for _fl_index in "${!_fl_pids[@]}"; do
        rule_job_collect "$1" "$2" "$_fl_index"
    done
    return 0
}

# rule_jobs_drain [<seconds>] - ends a run with no job left: waits, then signals what outlives the wait
function rule_jobs_drain
{
    local -i limit="${1:-5}"
    local -i ticks=0
    local pid
    for pid in ${BAR_JOB_PIDS[@]+"${BAR_JOB_PIDS[@]}"}; do
        kill -0 "$pid" 2>/dev/null || continue
        while (( ticks < limit * 20 )) && kill -0 "$pid" 2>/dev/null; do
            sleep 0.05
            ticks=$((ticks + 1))
        done
        if kill -0 "$pid" 2>/dev/null; then
            kill -TERM "$pid" 2>/dev/null
            sleep 0.05
            kill -0 "$pid" 2>/dev/null && kill -KILL "$pid" 2>/dev/null
        fi
        wait "$pid" 2>/dev/null
    done
    BAR_JOB_PIDS=()
    BAR_INFLIGHT=0
    # the run's job directory goes with the run: the server FIFO, the claims and the results.  The
    # CLEANUP rule runs after this in the exit path, and a rule there must not start a server the
    # run would then leave behind.
    BAR_JOB_CLOSED=1
    if (( BAR_JOB_SERVER >= 0 )); then
        exec {BAR_JOB_SERVER}>&-
        BAR_JOB_SERVER=-1
    fi
    if [[ -n "${BAR_JOB_DIR:-}" ]]; then
        rm -rf "${BAR_JOB_DIR:?}"
        BAR_JOB_DIR=""
    fi
    return 0
}

function rule_eval ## <name> [args..] - Evaluates a rule
{
    ## Normally this is used by bar itself but it can be used from function and rule bodies
    ## to evaluate rules.
    trace "$*"
    # shellcheck disable=2155
    local rule_id="$(hash_args "$PWD $*")"
    local RULE_NAME="$1"
    shift

    [[ "${BAR_RULE_FLAGS[$RULE_NAME]:-}" == *D* ]] && {
        debug "skipping disabled rule $RULE_NAME"
        return 0
    }

    # shellcheck disable=2034
    local RULE_ARGS=("$@")
    rule_exists "$RULE_NAME" || rule_autoload "$RULE_NAME"

    local evaluate_always=
    [[ "${BAR_RULE_FLAGS[$RULE_NAME]:-}" == *a* ]] && evaluate_always=true

    # a parallel run is the only one which needs the tree's budget and the shared store
    rule_parallel_budget
    rule_job_server_start

    [[ -v BAR_RULES_RESULT["#$rule_id"] ]] && {
        rc="${BAR_RULES_RESULT[#$rule_id]}"
        if [[ "$rc" == pending ]]; then
            die "recursive rule $RULE_NAME"
        else
            return "$rc"
        fi
    }

    # a verdict another job left in the run's store is this shell's verdict too
    if [[ -z "$evaluate_always" ]] && rule_result_get "$rule_id"; then
        rc="$BAR_STORE_RC"
        BAR_RULES_RESULT["#$rule_id"]="$rc"
        BAR_RULES_RESULT["$RULE_NAME"]+="$rule_id "
        return "$rc"
    fi

    # two jobs may reach the same rule at once (a diamond): the shell which claims it evaluates it,
    # the other takes that verdict instead of evaluating it a second time
    if [[ -z "$evaluate_always" ]] && ! rule_result_claim "$rule_id"; then
        if rule_result_get "$rule_id"; then
            rc="$BAR_STORE_RC"
            BAR_RULES_RESULT["#$rule_id"]="$rc"
            BAR_RULES_RESULT["$RULE_NAME"]+="$rule_id "
            return "$rc"
        fi
    fi

    BAR_RULES_RESULT["#$rule_id"]="pending"
    BAR_RULES_RESULT["$RULE_NAME"]+="$rule_id "

    local clauses="${BAR_RULES[$RULE_NAME]:-}"

    if [[ "${BAR_RULE_FLAGS[$RULE_NAME]:-}" = *r* ]]; then
        local rclauses=""
        for n in $clauses; do
            rclauses="$n $rclauses"
        done
        clauses=${rclauses# }
    fi

    # Keep-going state tracking
    local rule_failed=
    local rule_failure_rc=0
    
    # Parse BAR_KEEP_GOING: 0 or 1 = stop at first failure, >= 2 = countdown, non-numeric = unlimited
    if [[ "$BAR_KEEP_GOING" =~ ^[0-9]+$ ]]; then
        if (( BAR_KEEP_GOING <= 1 )); then
            BAR_KEEP_GOING=1  # Stop at first failure (default behavior)
        fi
        # else: use the number as countdown limit
    else
        # Non-numeric means unlimited
        BAR_KEEP_GOING=-1
    fi

    # The jobs this rule started, keyed by the dependency's own id: the pid while one runs, its
    # status once collected.  A dependency started ahead of its clause's turn is taken where it is
    # declared, whichever clause started it.  '--conclusive' needs nothing of its own -- a clause's
    # jobs are collected before its body runs, and a clause which stops the rule collects them
    # before it returns.
    local -A job_pid=()
    local -A job_rc=()

    # A rule marked '--parallel' starts the dependencies of all its clauses at the first of them;
    # the clause bodies stay in declared order (a body works in the directory).  A disjunct rule
    # does not: which clause is tried first is its meaning, so it inherits the flag per clause.
    if (( BAR_PARALLEL > 1 )) && [[ "${BAR_RULE_FLAGS[$RULE_NAME]:-}" = *p* && "${BAR_RULE_FLAGS[$RULE_NAME]:-}" != *d* && "${BAR_RULE_FLAGS[$RULE_NAME]:-}" != *m* ]]; then
        # shellcheck disable=SC2086
        rule_dep_jobs_prestart job_pid job_rc $clauses
    fi

    local clause
    for clause in $clauses; do
        # The run was abandoned meanwhile (a dependency failed in this tree): this shell starts
        # nothing more -- no dependency and no body -- and collects what it started before it
        # returns.  A body which already runs finishes: it is the atomic unit of work, and its
        # verdict goes nowhere because the rule which failed carries the failure for the run.
        if rule_jobs_abandoned; then
            rule_jobs_flush job_pid job_rc
            return 1
        fi
        [[ "${BAR_RULE_FLAGS[$RULE_NAME]}" != *m* ]] && {
            declare -A CLAUSE_LOCAL=()
        }
        local skip=
        local dep
        local deps=()
        [[ "${#BAR_CLAUSE_DEPS[$clause]}" -gt 0 ]] && readarray -d $'\n' -t deps <<<"${BAR_CLAUSE_DEPS[$clause]}"

        local can_parallel=
        local clause_parallel=
        if (( BAR_PARALLEL > 1 )) && [[ "${BAR_RULE_FLAGS[$RULE_NAME]:-}" != *m* ]]; then
            can_parallel=true
        fi
        [[ "${BAR_CLAUSE_FLAGS[$clause]}" = *p* ]] && clause_parallel=true
        # 'rule --parallel' is inherited by its clauses with opt-out semantics: a clause marked
        # '--conclusive' (the rule stops on its success) or '--default' (it always runs last) is a
        # barrier and keeps the serial evaluation.
        if [[ -z "$clause_parallel" && "${BAR_RULE_FLAGS[$RULE_NAME]:-}" = *p* &&
              "${BAR_CLAUSE_FLAGS[$clause]}" != *c* && "${BAR_CLAUSE_FLAGS[$clause]}" != *d* ]]; then
            clause_parallel=true
        fi

        local dep
        local -i dep_index
        for ((dep_index = 0; dep_index < ${#deps[@]}; dep_index++)); do
            if rule_jobs_abandoned; then
                rule_jobs_flush job_pid job_rc
                return 1
            fi
            dep="${deps[dep_index]}"
            rule_dep_parse "$dep"
            local depname="$DEP_NAME"
            local -a depargs=("${DEP_ARGS[@]}")
            local check="$DEP_CHECK"
            local ifexists="$DEP_IFEXISTS"
            local dep_parallel="$DEP_PARALLEL"

            # a clause marked '--parallel' is the shortcut for '+' on every dependency which is not
            # a conditional one.  '~' is not conditional: it discards the verdict but lets the rule
            # go on, so '+dep~' is a job like any other and only '?', '??' and '!' decide a run.
            [[ -n "$clause_parallel" && -z "$ifexists" && "$check" != check && "$check" != negated ]] && dep_parallel=true

            [[ -n "$check" ]] && BAR_CHECK_LEVEL=$((BAR_CHECK_LEVEL+1))

            # Check if bare rule depends on non-bare rule
            if [[ "${BAR_RULE_FLAGS[$RULE_NAME]:-}" == *b* ]]; then
                rule_exists "$depname" || rule_autoload "$depname"
                if [[ "${BAR_RULE_FLAGS[$depname]:-}" != *b* ]]; then
                    die "bare rule '$RULE_NAME' cannot depend on non-bare rule '$depname'"
                fi
            fi

            if [[ -n "$ifexists" ]] && ! rule_exists "$depname"; then
                BAR_CHECK_LEVEL=$((BAR_CHECK_LEVEL+1))
                failure "$RULE_NAME: $dep"
                BAR_CHECK_LEVEL=$((BAR_CHECK_LEVEL-1))
                skip=true
                break
            else
                progress "$RULE_NAME: $dep"
                # shellcheck disable=2155
                local dep_id="$(hash_args "$PWD $depname ${depargs[*]}")"
                local dep_rc="${BAR_RULES_RESULT[$dep_id]:-}"
                # another job may have decided it already; the run's store is where that verdict is
                if [[ -z "$dep_rc" ]] && rule_result_get "$dep_id"; then
                    dep_rc="$BAR_STORE_RC"
                fi

                # Start the run of '+' dependencies this one belongs to: every following dependency
                # which is a plain '+' one starts here too, up to the budget, so the run overlaps
                # while the verdicts below are still taken in declared order.  A conditional
                # dependency ('?', '??', '!') or one without the prefix ends the run ('~' does not:
                # it only discards a verdict), and a dependency already decided needs no job.
                if [[ -n "$can_parallel" && -n "$dep_parallel" && -z "${job_pid[$dep_id]:-}" && -z "$dep_rc" ]]; then
                    local ahead_id
                    local -i ahead
                    for ((ahead = dep_index; ahead < ${#deps[@]}; ahead++)); do
                        rule_dep_parse "${deps[ahead]}"
                        [[ -n "$DEP_PARALLEL" || -n "$clause_parallel" ]] || break
                        [[ -z "$DEP_IFEXISTS" && "$DEP_CHECK" != check && "$DEP_CHECK" != negated ]] || break
                        [[ "${BAR_RULE_FLAGS[$DEP_NAME]-a}" = *a* ]] && break
                        rule_jobs_abandoned && break
                        ahead_id="$(hash_args "$PWD $DEP_NAME ${DEP_ARGS[*]}")"
                        [[ -z "${job_pid[$ahead_id]:-}" ]] || continue
                        [[ -v BAR_RULES_RESULT[#$ahead_id] ]] && continue
                        rule_job_slot_take job_pid job_rc
                        if rule_jobs_failed job_pid job_rc; then
                            # the wait collected a failure: start nothing more of this run, the
                            # verdicts are taken where the dependencies are declared
                            rule_job_slot_restore
                            rule_job_token_give
                            break
                        fi
                        rule_job_spawn job_pid job_rc "$ahead_id" "$DEP_NAME" "${DEP_ARGS[@]}"
                    done
                    rule_dep_parse "$dep"
                fi

                if [[ -n "${job_pid[$dep_id]:-}" ]]; then
                    # the job ran early, but the verdict is taken where the dependency is declared
                    rule_job_collect job_pid job_rc "$dep_id"
                    dep_rc="${job_rc[$dep_id]}"
                    # a fork's table dies with it: this is how the next dependency sees the result,
                    # and the run's store is how a job which has not seen it yet does
                    if [[ "${BAR_RULE_FLAGS[$depname]-a}" != *a* ]]; then
                        BAR_RULES_RESULT[$dep_id]="$dep_rc"
                        rule_result_put "$dep_id" "$dep_rc"
                    fi
                elif [[ "${BAR_RULE_FLAGS[$depname]-a}" = *a* || -z "$dep_rc" ]]; then
                    dep_rc=0
                    # shellcheck disable=2086
                    rule_eval "$depname" "${depargs[@]}" || dep_rc=$?
                fi

                if [[ "$check" = unconditional ]]; then
                    uncond_call "$dep_rc" "$RULE_NAME: $depname~ ${depargs[*]}"
                    [[ -n "$check" ]] && BAR_CHECK_LEVEL=$((BAR_CHECK_LEVEL-1))
                    continue
                elif [[ "$dep_rc" == 0 && "$check" = negated ]]; then
                    skip=true
                    failure "$RULE_NAME: $dep"
                    [[ -n "$check" ]] && BAR_CHECK_LEVEL=$((BAR_CHECK_LEVEL-1))
                    break
                elif [[ "$dep_rc" != 0 ]]; then
                    if [[ "$check" = check ]]; then
                        failure "$RULE_NAME: $dep"
                        skip=true
                        [[ -n "$check" ]] && BAR_CHECK_LEVEL=$((BAR_CHECK_LEVEL-1))
                        break
                    elif [[ "$check" = negated ]]; then
                        success "$RULE_NAME: $dep"
                        [[ -n "$check" ]] && BAR_CHECK_LEVEL=$((BAR_CHECK_LEVEL-1))
                        continue
                    fi
                    # conclusive fail because of dep failure
                    failure "$RULE_NAME: $dep"
                    [[ -n "$check" ]] && BAR_CHECK_LEVEL=$((BAR_CHECK_LEVEL-1))
                    # a failure ends the rule: what it has not started is not started at all, and
                    # what it has started is collected (a body which runs is atomic)
                    rule_jobs_abandon_settle job_pid job_rc
                    if [[ -n "$evaluate_always" ]]; then
                        unset "BAR_RULES_RESULT[#$rule_id]"
                    else
                        rule_result_record "$rule_id" "$dep_rc"
                    fi
                    [[ "${BAR_RULE_FLAGS[$RULE_NAME]}" != *m* ]] && clause_local_restore
                    return "$dep_rc"
                else
                    success "$RULE_NAME: $dep"
                    [[ -n "$check" ]] && BAR_CHECK_LEVEL=$((BAR_CHECK_LEVEL-1))
                fi
           fi
        done

        # every path out of the dependency loop is a barrier: a skipped clause and a failing one
        # alike must leave no job running behind them.  A job another clause started is not this
        # clause's: it is taken where that clause declares it.
        rule_jobs_flush_clause job_pid job_rc "$clause"

        rc=0
        if [[ "$skip" != true ]]; then
            # Clear any progress message before executing clause body
            tty_newline
            eval "${BAR_CLAUSES[$clause]}" || rc=$?

            if [[ "${BAR_RULE_FLAGS[$RULE_NAME]}" = *d* ]]; then
                # Disjunct mode: stop at first success
                [[ "$rc" == 0 ]] && break
            else
                # Conjunct mode
                if [[ "$rc" != 0 ]]; then
                    # Clause failed - check if we can keep going
                    local clause_flags="${BAR_CLAUSE_FLAGS[$clause]}"
                    
                    if [[ "$BAR_KEEP_GOING" != 1 && "$clause_flags" != *c* ]]; then
                        # Check if we've exceeded the failure limit
                        if [[ "$BAR_KEEP_GOING" -ge 0 ]]; then
                            ((BAR_KEEP_GOING--))
                            if [[ "$BAR_KEEP_GOING" -eq 0 ]]; then
                                # Exhausted keep-going limit
                                failure "$RULE_NAME"
                                rule_jobs_abandon_settle job_pid job_rc
                                if [[ -n "$evaluate_always" ]]; then
                                    unset "BAR_RULES_RESULT[#$rule_id]"
                                else
                                    rule_result_record "$rule_id" "$rc"
                                fi
                                [[ "${BAR_RULE_FLAGS[$RULE_NAME]}" != *m* ]] && clause_local_restore
                                return "$rc"
                            fi
                        fi
                        
                        # Keep-going: clause is not conclusive
                        # Remember failure and continue to next clause
                        failure "$RULE_NAME"
                        rule_failed=true
                        [[ "$rule_failure_rc" == 0 ]] && rule_failure_rc=$rc
                    else
                        # Stop immediately: clause is conclusive or keep-going disabled
                        rule_jobs_abandon_settle job_pid job_rc
                        if [[ -n "$evaluate_always" ]]; then
                            unset "BAR_RULES_RESULT[#$rule_id]"
                        else
                            rule_result_record "$rule_id" "$rc"
                        fi
                        [[ "${BAR_RULE_FLAGS[$RULE_NAME]}" != *m* ]] && clause_local_restore
                        return "$rc"
                    fi
                elif [[ "${BAR_CLAUSE_FLAGS[$clause]}" = *c* ]]; then
                    # Conclusive success: stop, and nothing started for a later clause runs
                    rule_jobs_abandon_settle job_pid job_rc
                    if [[ -n "$evaluate_always" ]]; then
                        unset "BAR_RULES_RESULT[#$rule_id]"
                    else
                        rule_result_record "$rule_id" "$rc"
                    fi
                    [[ "${BAR_RULE_FLAGS[$RULE_NAME]}" != *m* ]] && clause_local_restore
                    return "$rc"
                fi
            fi
        fi
        [[ "${BAR_RULE_FLAGS[$RULE_NAME]}" != *m* ]] && clause_local_restore
    done

    # After all clauses: return with failure if keep-going encountered failures
    rule_jobs_flush job_pid job_rc
    if [[ -n "$rule_failed" ]]; then
        if [[ -n "$evaluate_always" ]]; then
            unset "BAR_RULES_RESULT[#$rule_id]"
        else
            rule_result_record "$rule_id" "$rule_failure_rc"
        fi
        return "$rule_failure_rc"
    fi

    if [[ -n "$evaluate_always" ]]; then
        unset "BAR_RULES_RESULT[#$rule_id]"
    else
        rule_result_record "$rule_id" "$rc"
    fi
    return "$rc"
}

function rule_exists ## <name> - checks if a rule is defined
{
    [[ -v BAR_RULES[$1] ]]
}

function rule_list ## [pattern] - lists all loaded rules or rules matching pattern
{
    ## Because of automatic module loading this list is only a current view for diagnostics.
    local rule
    for rule in $(tr ' ' '\n' <<<"${!BAR_RULES[@]}" | sort); do
        # shellcheck disable=2053
        if [[ "$rule" = ${1:-*} ]]; then
            local clause
            for clause in ${BAR_RULES[$rule]}; do
                local dep
                local deps
                deps=""
                while read -r dep; do
                    [[ -n "$deps" ]] && deps+=" "
                    if [[ "$dep" = *" "* ]]; then
                        deps+="'$dep'"
                    else
                        deps+="$dep"
                    fi
                done <<<"${BAR_CLAUSE_DEPS[$clause]}"
                echo -n "$rule: $deps"
                if [[ -n "${BAR_CLAUSES[$clause]}" ]]; then
                    [[ -n "$deps" ]] && echo -n " "
                    echo -e "-- '${BAR_CLAUSES[$clause]}'"
                else
                    echo
                fi
            done
        fi
        echo
    done | less -SR
}

# Rule sources -- where a rule is written down
#
# 'rule_show' and 'rule_edit' answer what a rule's name alone does not: how its source looks and
# in which file it stands.  Both read the rule files instead of the loaded rule, so what is
# shown is what an edit would change.
#
# The rule files are the rulefile ('$BARF_FILE'), every module of '$BAR_DIR' and bar itself.  A
# rule is found by its 'rule <name>:' statement, a function by its 'function <name>' definition;
# the '##' documentation above a definition belongs to what is shown.
#
# The scan reaches outside the project when bar falls back to an installed copy, so 'rule_show'
# answers those too while 'rule_edit' opens only a file below '$BAR_TOPLEVEL'.

function rule_source_files
{
    # The rule files in the order they are searched: the project's own rules first.
    local -a files=()
    [[ -n "${BARF_FILE:-}" && -f "${BARF_FILE:-}" ]] && files+=("$BARF_FILE")
    if [[ -n "${BAR_DIR:-}" && -d "${BAR_DIR:-}" ]]; then
        files+=("$BAR_DIR"/*)
    fi
    [[ -n "${BAR_SELF:-}" && -f "${BAR_SELF:-}" ]] && files+=("$BAR_SELF")

    local file
    local -A seen=()
    for file in ${files[@]+"${files[@]}"}; do
        [[ -f "$file" ]] || continue
        [[ -n "${seen[$file]:-}" ]] && continue
        seen[$file]=1
        printf '%s\n' "$file"
    done
}

# rule_source_inside <file> - true when the file is written below the base directory
function rule_source_inside
{
    # 'rule_edit' opens files of the project only.  The scan reaches outside it -- the installed
    # bar and the modules bar falls back to when no rule directory exists -- and reading those is
    # what 'rule_show' is for; an edit is made where the file lives, so one changes into that
    # directory instead.
    local base="${BAR_TOPLEVEL:-}" file
    [[ -n "$base" ]] || return 1
    base="$(realpath -- "$base" 2>/dev/null)" || return 1
    file="$(realpath -- "${1:-}" 2>/dev/null)" || return 1
    [[ "$file" == "$base"/* ]]
}

# rule_source_blocks <file> <name> <rule|function> - the blocks which define a name
function rule_source_blocks
{
    # A block is the statement (with its '##' documentation and its continuation lines, or the
    # whole function body) preceded by a '# <file>:<line>' line naming the statement.  Returns 1
    # when the file defines nothing of that name.
    awk -v want="$2" -v mode="$3" '
        function reset_docs() {
            ndoc = 0
        }

        function flush_docs(   i) {
            for (i = 1; i <= ndoc; i++) {
                print doc[i]
            }
            ndoc = 0
        }

        # the name a "rule" statement defines: only a first word ending in ':' names one,
        # everything else is a dependency of MAIN
        function rule_name(line,   rest, token) {
            rest = line
            sub(/^rule[ \t]*/, "", rest)
            while (rest ~ /^--[A-Za-z0-9_-]+([ \t]|$)/) {
                sub(/^--[A-Za-z0-9_-]+[ \t]*/, "", rest)
            }
            token = rest
            sub(/[ \t].*$/, "", token)
            if (token !~ /:$/) {
                return "MAIN"
            }
            sub(/:$/, "", token)
            return ((token == "") ? "MAIN" : token)
        }

        # the name a "function" or "<name> ()" definition defines
        function function_name(line,   rest) {
            rest = line
            sub(/^function[ \t]+/, "", rest)
            sub(/[^A-Za-z0-9_].*$/, "", rest)
            return rest
        }

        BEGIN {
            reset_docs()
            printed = 0
            cont = 0
            infunc = 0
            inbody = 0
        }

        {
            if (infunc) {
                print
                if ($0 ~ /^}/) {
                    infunc = 0
                }
                next
            }
            # an indented block below a make/just style header is the body
            if (inbody) {
                if ($0 ~ /^[ \t]/ || $0 ~ /^[ \t]*$/) {
                    print
                    next
                }
                inbody = 0
            }
            if (cont) {
                print
                cont = ($0 ~ /\\[ \t]*$/)
                next
            }
            if ($0 ~ /^##/ && $0 !~ /^###/) {
                doc[++ndoc] = $0
                next
            }

            matched = 0
            if (mode == "rule" && $0 ~ /^rule([ \t]|$)/) {
                matched = (rule_name($0) == want)
            } else if (mode == "rule" && $0 ~ /^[A-Za-z_][A-Za-z0-9_.-]*:/) {
                # a make/just style header (see "RULE FILE PREPROCESSOR")
                line = $0
                sub(/:.*$/, "", line)
                matched = (line == want)
            } else if (mode == "function" && $0 ~ /^function[ \t]+/) {
                matched = (function_name($0) == want)
            } else if (mode == "function" && $0 ~ /^[A-Za-z_][A-Za-z0-9_]*[ \t]*\(\)/) {
                matched = (function_name($0) == want)
            }

            if (matched) {
                # the header names the statement, the documentation above it follows: that is the
                # line an editor is asked to put the cursor on
                printf "# %s:%d\n", FILENAME, NR
                flush_docs()
                print
                printed++
                if (mode == "function") {
                    infunc = (index($0, "}") > 0) ? 0 : 1
                } else if ($0 ~ /^rule([ \t]|$)/) {
                    cont = ($0 ~ /\\[ \t]*$/)
                } else {
                    inbody = 1
                }
                next
            }
            reset_docs()
        }

        END {
            exit ((printed > 0) ? 0 : 1)
        }
    ' "$1"
}

# rule_source_first_line <file> <name> <rule|function> - the line a definition starts at
function rule_source_first_line
{
    local blocks
    blocks="$(rule_source_blocks "$1" "$2" "$3")" || return 1
    blocks="${blocks%%$'\n'*}"
    printf '%s\n' "${blocks##*:}"
}

# A clause which only calls the function of the rules name: 'rule foo: -' and 'rule foo:' both
# reduce to that body, so the function is where the work is written.
# rule_clause_calls_function <clause> <rulename> - true when the clause only calls that function
function rule_clause_calls_function
{
    local clause="$1"
    local name="$2"
    [[ -n "${BAR_CLAUSE_DEPS[$clause]:-}" ]] && return 1
    local body="${BAR_CLAUSES[$clause]:-}"
    body="${body#"${body%%[![:space:]]*}"}"
    body="${body%"${body##*[![:space:]]}"}"
    [[ "$body" == "$name \"\${RULE_ARGS[@]}\"" ]]
}

# rule_show_function <rulename> - prints the function a rule of that name calls
function rule_show_function
{
    local name="$1"
    local clause
    local calls=
    for clause in ${BAR_RULES[$name]:-}; do
        if rule_clause_calls_function "$clause" "$name"; then
            calls=true
            break
        fi
    done
    [[ -n "$calls" ]] || return 0

    local file blocks
    while IFS= read -r file; do
        if blocks="$(rule_source_blocks "$file" "$name" function)"; then
            printf '\n%s\n' "$blocks"
        fi
    done < <(rule_source_files)
}

# 'rule_autoload' dies on a name nothing provides, and a name that is only defined in a lazily
# loaded module is exactly what 'rule_show' has to answer: load what the name could name, fatal
# only when the scan below finds no definition either.
# rule_show_autoload <name> - loads the module a rule name belongs to
function rule_show_autoload
{
    local modname="${1#always_}"
    modname="${modname#is_}"
    modname="${modname#has_}"
    modname="${modname#try_}"
    modname="${modname%%_*}"
    require --opt "$modname" "${modname}_lib"
}

function rule_show
{
    # body of the 'rule_show' rule
    local name="${1:-}"
    if [[ -z "$name" || "$name" == -* ]]; then
        case "$name" in
        -h | --help)
            require help
            help_usage rule_show
            return 0
            ;;
        *)
            require help
            help_usage_error rule_show "a rule name is required"
            return 2
            ;;
        esac
    fi

    local file blocks
    local found=0
    while IFS= read -r file; do
        if blocks="$(rule_source_blocks "$file" "$name" rule)"; then
            [[ "$found" -gt 0 ]] && printf '\n'
            printf '%s\n' "$blocks"
            found=$((found + 1))
        fi
    done < <(rule_source_files)

    if [[ "$found" -eq 0 ]]; then
        error "rule_show: no rule '$name' in this projects rule files"
        return 1
    fi

    # the clause bodies tell whether the rule just calls a function of its name
    rule_exists "$name" || rule_show_autoload "$name"
    rule_show_function "$name"
}

# rule_file_matches <file> <pattern> - true when the pattern selects that file
function rule_file_matches
{
    # A pattern selects a file as a glob for its path or its basename, or as a plain word
    # anywhere in the path.
    local file="$1"
    local pattern="$2"
    # shellcheck disable=2053
    [[ "$file" == $pattern ]] && return 0
    # shellcheck disable=2053
    [[ "${file##*/}" == $pattern ]] && return 0
    [[ "$file" == *"$pattern"* ]]
}

# rule_editor_open <file> <line> - opens a file in the users editor at that line
function rule_editor_open
{
    local file="$1"
    local line="$2"
    local editor="${BAR_EDITOR:-${VISUAL:-${EDITOR:-}}}"
    if [[ -z "$editor" ]]; then
        local candidate
        for candidate in editor vi vim nano; do
            if command -v -- "$candidate" >/dev/null 2>&1; then
                editor="$candidate"
                break
            fi
        done
    fi
    if [[ -z "$editor" ]]; then
        error "rule_edit: no editor, set BAR_EDITOR or EDITOR"
        return 1
    fi

    local -a cmd=()
    read -r -a cmd <<<"$editor"
    case "${cmd[0]##*/}" in
    code | codium)
        cmd+=("-g" "${file}:${line}")
        ;;
    subl | atom)
        cmd+=("${file}:${line}")
        ;;
    *)
        cmd+=("+${line}" "$file")
        ;;
    esac
    "${cmd[@]}"
}

function rule_edit
{
    # body of the 'rule_edit' rule
    local mode="rule"
    local -a positional=()
    local arg
    for arg in "$@"; do
        case "$arg" in
        -f | --function)
            mode="function"
            ;;
        -h | --help)
            require help
            help_usage rule_edit
            return 0
            ;;
        -*)
            require help
            help_usage_error rule_edit "unknown option '$arg'"
            return 2
            ;;
        *)
            positional+=("$arg")
            ;;
        esac
    done

    local name="${positional[0]:-}"
    local pattern="${positional[1]:-}"
    if [[ -z "$name" ]]; then
        require help
        help_usage_error rule_edit "a rule name is required"
        return 2
    fi
    if [[ "${#positional[@]}" -gt 2 ]]; then
        require help
        help_usage_error rule_edit "unexpected argument '${positional[2]}'"
        return 2
    fi

    local file first
    local -a candidates=() outside=()
    while IFS= read -r file; do
        if [[ -n "$pattern" ]] && ! rule_file_matches "$file" "$pattern"; then
            continue
        fi
        if first="$(rule_source_first_line "$file" "$name" "$mode")"; then
            if rule_source_inside "$file"; then
                candidates+=("$file:$first")
            else
                outside+=("$file:$first")
            fi
        fi
    done < <(rule_source_files)

    if [[ "${#candidates[@]}" -eq 0 ]]; then
        if [[ "${#outside[@]}" -gt 0 ]]; then
            error "rule_edit: $mode '$name' is written outside '${BAR_TOPLEVEL:-.}': ${outside[*]}"
            error "rule_edit: change into that directory to edit it there, 'rule_show $name' answers it from here"
            return 1
        fi
        error "rule_edit: no $mode '$name'${pattern:+ in a file matching '$pattern'}"
        return 1
    fi

    local picked=""
    if [[ "${#candidates[@]}" -eq 1 ]]; then
        picked="${candidates[0]}"
    else
        PS3="rule_edit> "
        select picked in "${candidates[@]}"; do
            [[ -n "$picked" ]] && break
        done
        if [[ -z "$picked" ]]; then
            error "rule_edit: nothing chosen"
            return 1
        fi
    fi

    rule_editor_open "${picked%:*}" "${picked##*:}"
}

# Define --bare rules for read-only rule query functions
rule --bare rule_exists: -
rule --bare rule_list: -

## <rulename> - Prints the source of a rule, with the function it calls
##   - a rule which only calls the function of its name: that function is shown too
rule --bare rule_show: -
## <rulename> [-f|--function] [filepattern] - Opens a definition in the users editor
##   - [-f|--function]: a function definition instead of a rule
##   - [filepattern]: glob or word narrowing the files, one file opens directly
##   - only a file below the base directory opens: change into the directory of one written outside it
rule --bare rule_edit: -

