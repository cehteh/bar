    (( printed < matched )) && truncated=1
    while (( i < printed )); do
        record="${HERMES_KANBAN_ROWS[i]}"
        IFS=$'\037' read -r -a f <<<"$record"
        id="${f[0]:-0}"
        run_status="${f[1]:-}"
        outcome="${f[2]:-}"
        started="${f[3]:-0}"
        ended="${f[4]:-0}"
        profile="${f[5]:-}"
        summary="${f[6]:-}"
        error="${f[7]:-}"
        duration=$(( (ended > 0 ? ended : HERMES_KANBAN_NOW) - started ))
        (( duration < 0 )) && duration=0
        hermes_kanban_json "$run_status"
        run_status_json="$HERMES_KANBAN_JSON"
        hermes_kanban_json "$outcome"
        outcome_json="$HERMES_KANBAN_JSON"
        hermes_kanban_json "$profile"
        profile_json="$HERMES_KANBAN_JSON"
        hermes_kanban_json "$summary"
        summary_json="$HERMES_KANBAN_JSON"
        hermes_kanban_json "$error"
        error_json="$HERMES_KANBAN_JSON"
        run="{\"id\":$id"
        run+=",\"status\":$run_status_json"
        run+=",\"outcome\":$outcome_json"
        run+=",\"started_at\":$started,\"ended_at\":$ended,\"duration_seconds\":$duration"
        run+=",\"profile\":$profile_json"
        run+=",\"summary\":$summary_json"
        run+=",\"error\":$error_json}"
        runs_json+="${runs_json:+,}$run"
        i=$(( i + 1 ))
    done
    out="{"
    hermes_kanban_json "$HERMES_KANBAN_BOARD_NAME"
    out+="\"bar_hermes_kanban\":1,\"mode\":\"runs\",\"board\":$HERMES_KANBAN_JSON"
    hermes_kanban_json "$HERMES_KANBAN_DB_PATH"
    out+=",\"db\":$HERMES_KANBAN_JSON,\"now\":$HERMES_KANBAN_NOW"
    hermes_kanban_json "$task_id"
    out+=",\"task\":{\"id\":$HERMES_KANBAN_JSON"
    hermes_kanban_json "$status"
    out+=",\"status\":$HERMES_KANBAN_JSON"
    hermes_kanban_json "$title"
    out+=",\"title\":$HERMES_KANBAN_JSON"
    hermes_kanban_json "$kind"
    out+=",\"workspace_kind\":$HERMES_KANBAN_JSON"
    hermes_kanban_json "$path"
    out+=",\"workspace_path\":$HERMES_KANBAN_JSON"
    hermes_kanban_json "$branch"
    out+=",\"branch\":$HERMES_KANBAN_JSON}"
    out+=",\"matched\":$matched,\"printed\":$printed,\"limit\":$limit_n"
    out+=",\"truncated\":$([[ "$truncated" == 1 ]] && printf true || printf false)"
    out+=",\"failed\":$HERMES_KANBAN_FAILED,\"runs\":[$runs_json]}"
    printf '%s\n' "$out"
}

# --- usage --------------------------------------------------------------------------------------

function hermes_kanban_help ## - the usage text, on stdout
{
    cat <<'HERMES_KANBAN_USAGE'
usage: hermes_kanban [--json] [--board <slug>|--db <path>] [<selector>..] [--limit <n>|--all]
       hermes_kanban --runs <task-id> [--json] [--limit <n>]

  no selector          the summary: counts by status, the waiting totals (ready, blocked,
                       scheduled), the age of the oldest ready card, the number of live runs
  --status <s>[,<s>]   cards in those statuses (triage, todo, scheduled, ready, running,
                       blocked, review, done, archived)
  --assignee <name>    cards assigned to those profiles [,] separated
  --project <id|slug>  cards linked to that project (the slug is resolved via projects.db)
  --parent <task-id>   the children of one card
  --id <task-id>       one card, or several [,] separated
  --runs <task-id>     the runs of one card instead of a listing
  --limit <n>          print at most n records (0 = all; default 50, 20 for --runs)
  --all                same as '--limit 0'
  --json               one JSON object with the same numbers as the text form
  --board <slug>, --db <path>
                       read another board (default: this caller's board)

exit codes: 0 answered, 2 usage error (an option without a value, or with an empty one),
            3 board unreadable, 4 no such card
HERMES_KANBAN_USAGE
}

function hermes_kanban_usage ## <message> - the failure report, on stderr
{
    printf 'hermes_kanban: %s\n' "$1" >&2
    printf "usage: hermes_kanban [--json] [--status <s>[,<s>]..] [--assignee <n>] [--project <id|slug>] \
[--parent <task-id>] [--id <task-id>] [--limit <n>|--all] [--board <slug>|--db <path>]\n" >&2
    printf '       hermes_kanban --runs <task-id> [--json]\n' >&2
    printf "       hermes_kanban --help\n" >&2
}

# --- the rule -----------------------------------------------------------------------------------

function hermes_kanban
{
    ## RULE_ARGS are the positional parameters of this function: the rule body passes them on.
    local -a args=()
    local raw arg
    local json="" db="" board="" runs_id="" limit=""
    local -a status=() assignee=() ids=() parents=() projects=()
    local -i limit_list=50 limit_runs=20
    local -a clauses=() values=()
    local value exists sql

    for raw in "$@"; do
        if [[ "$raw" == --*=* ]]; then
            args+=("${raw%%=*}" "${raw#*=}")
        else
            args+=("$raw")
        fi
    done
    local -i i=0
    local -i count=${#args[@]}
    while (( i < count )); do
        arg="${args[i]}"
        i=$(( i + 1 ))
        case "$arg" in
        -h | --help)
            hermes_kanban_help
            return 0
            ;;
        --json) json=1 ;;
        --all) limit=0 ;;
        --status | --assignee | --project | --parent | --id | --runs | --limit | --db | --board)
            if (( i >= count )); then
                hermes_kanban_usage "'$arg' needs a value"
                return 2
            fi
            if [[ -z "${args[i]}" ]]; then
                hermes_kanban_usage "'$arg' needs a non-empty value"
                return 2
            fi
            case "$arg" in
            --status) status+=("${args[i]}") ;;
            --assignee) assignee+=("${args[i]}") ;;
            --project) projects+=("${args[i]}") ;;
            --parent) parents+=("${args[i]}") ;;
            --id) ids+=("${args[i]}") ;;
            --runs) runs_id="${args[i]}" ;;
            --limit) limit="${args[i]}" ;;
            --db) db="${args[i]}" ;;
            --board) board="${args[i]}" ;;
            esac
            i=$(( i + 1 ))
            ;;
        *)
            hermes_kanban_usage "unknown argument '$arg'"
            return 2
            ;;
        esac
    done

    [[ -n "${BAR_AGENT_JSON:-}" ]] && json=1
    if [[ -n "$limit" && ! "$limit" =~ ^[0-9]+$ ]]; then
        hermes_kanban_usage "invalid --limit '$limit', want a non-negative number"
        return 2
    fi
    if [[ -n "$board" && ! "$board" =~ ^[a-z0-9][a-z0-9_-]*$ ]]; then
        hermes_kanban_usage "invalid --board '$board'"
        return 2
    fi
    if [[ -n "$runs_id" ]] && (( ${#status[@]} + ${#assignee[@]} + ${#projects[@]} + \
        ${#parents[@]} + ${#ids[@]} > 0 )); then
        hermes_kanban_usage "'--runs' takes no card selector"
        return 2
    fi

    HERMES_KANBAN_DB_PATH="$(hermes_kanban_db_path "$db" "$board")"
    HERMES_KANBAN_BOARD_NAME="$(hermes_kanban_board_name "$(hermes_kanban_root)" "$board")"
    HERMES_KANBAN_NOW="$(date +%s)"

    if ! command -v sqlite3 >/dev/null 2>&1; then
        printf 'hermes_kanban: sqlite3 is not installed\n' >&2
        return 3
    fi
    if [[ ! -f "$HERMES_KANBAN_DB_PATH" ]]; then
        printf 'hermes_kanban: no board database at %s\n' "$HERMES_KANBAN_DB_PATH" >&2
        return 3
    fi
    exists="$(hermes_kanban_sql "select count(*) from sqlite_master where type = 'table' and name = 'tasks';")" || {
        printf 'hermes_kanban: cannot read the board at %s\n' "$HERMES_KANBAN_DB_PATH" >&2
        return 3
    }
    if [[ "$exists" != 1 ]]; then
        printf 'hermes_kanban: %s is not a Kanban database (no tasks table)\n' "$HERMES_KANBAN_DB_PATH" >&2
        return 3
    fi

    if [[ -n "$runs_id" ]]; then
        hermes_kanban_runs_view "$runs_id" "$json" "${limit:-$limit_runs}"
        return $?
    fi

    if (( ${#parents[@]} > 0 )); then
        clauses=()
        for value in "${parents[@]}"; do
            if ! hermes_kanban_card_exists "$value"; then
                printf 'hermes_kanban: no card %s on board %s\n' "$value" "$HERMES_KANBAN_BOARD_NAME" >&2
                return 4
            fi
            values+=("$value")
        done
        clauses+=("t.id in (select child_id from task_links where parent_id in ($(hermes_kanban_in_list "${values[@]}")))")
    fi
    if (( ${#ids[@]} > 0 )); then
        values=()
        for value in "${ids[@]}"; do
            IFS=, read -r -a tmp_ids <<<"$value"
            for arg in ${tmp_ids[@]+"${tmp_ids[@]}"}; do
                if ! hermes_kanban_card_exists "$arg"; then
                    printf 'hermes_kanban: no card %s on board %s\n' "$arg" "$HERMES_KANBAN_BOARD_NAME" >&2
                    return 4
                fi
                values+=("$arg")
            done
        done
        clauses+=("t.id in ($(hermes_kanban_in_list "${values[@]}"))")
    fi
    if (( ${#status[@]} > 0 )); then
        values=()
        for value in "${status[@]}"; do
            IFS=, read -r -a tmp_ids <<<"$value"
            for arg in ${tmp_ids[@]+"${tmp_ids[@]}"}; do
                values+=("$arg")
            done
        done
        clauses+=("t.status in ($(hermes_kanban_in_list "${values[@]}"))")
    fi
    if (( ${#assignee[@]} > 0 )); then
        values=()
        for value in "${assignee[@]}"; do
            IFS=, read -r -a tmp_ids <<<"$value"
            for arg in ${tmp_ids[@]+"${tmp_ids[@]}"}; do
                values+=("$arg")
            done
        done
        clauses+=("t.assignee in ($(hermes_kanban_in_list "${values[@]}"))")
    fi
    if (( ${#projects[@]} > 0 )); then
        values=()
        for value in "${projects[@]}"; do
            values+=("$(hermes_kanban_project_id "$value")")
        done
        clauses+=("t.project_id in ($(hermes_kanban_in_list "${values[@]}"))")
    fi

    if (( ${#clauses[@]} > 0 )) || [[ -n "$limit" ]]; then
        hermes_kanban_gather_cards ${clauses[@]+"${clauses[@]}"}
        hermes_kanban_list_view "$json" "${limit:-$limit_list}"
        return $?
    fi

    hermes_kanban_gather_summary
    if [[ -n "$json" ]]; then
        hermes_kanban_summary_json
    else
        hermes_kanban_summary_text
    fi
}

