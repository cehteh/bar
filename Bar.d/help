  fi

  if [[ -z "$span" ]]; then
    printf '%s\n' "${help_render_cache[@]}"
    return
  fi

  if [[ "$span" =~ ^([0-9]+)-([0-9]+)$ ]]; then
    local start="${BASH_REMATCH[1]}"
    local end="${BASH_REMATCH[2]}"
    local i
    for ((i=start; i<=end; i++)); do
      printf '%s\n' "${help_render_cache[i-1]}"
    done
    return
  fi

  printf '%s\n' "${help_render_cache[@]}"
