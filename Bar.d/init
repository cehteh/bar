# -*- mode: sh; sh-shell: bash -*-
# vim: set ft=bash:
# shellcheck shell=bash
# shellcheck disable=2016

### Module to install, initialize and update bar itself

function init # --hidden|--update|--update-existing|--no-install-deps - initialize bar in a workdir.
{
    # shellcheck disable=2155
    local origin="$(command -v bar)"
    local prefix="${origin%/bin/*}"

    [[ -f "$prefix/bin/bar" && -d "$prefix/share/bar/Bar.d" && -f "$prefix/share/bar/Barf" ]] ||
        die "bar not properly installed, run './bar init_install <prefix>' from its git repository first"

    local update=
    local update_existing=
    local hidden=
    local install_deps=true
    while [[ $# -gt 0 ]]; do
        case "$1" in
        --update)
            update=true
            ;;
        --update-existing)
            update_existing=true
            ;;
        --hidden)
            hidden=true
            ;;
        --no-install-deps)
            install_deps=
            ;;
        *)
            break
            ;;
        esac
        shift
    done

    if [[ -z "$update" && ( -f bar || -f .bar )]]; then
        die "bar already initialized"
    fi

    if [[ -n "$update" || -n "$update_existing" ]]; then
        if [[ -f bar ]]; then
            if [[ "$origin" -nt "bar" ]]; then
                debug "updating 'bar'"
                # prevent writing into the running script
                cp -L "$origin" "bar.new"
                mv  "bar.new" "bar"
            fi
            if [[ -n "$update" ]]; then
                debug "updating 'Bar.d'"
                cp -Lru "$prefix/share/bar/Bar.d/"* "Bar.d"
            else
                debug "updating existing 'Bar.d'"
                rsync -rtuL --existing "$prefix/share/bar/Bar.d/" "Bar.d/"
            fi
        elif [[ -f .bar ]]; then
            if [[ "$origin" -nt ".bar" ]]; then
                debug "updating '.bar'"
                cp -L "$origin" ".bar.new"
                mv  ".bar.new" ".bar"
            fi
            if [[ -n "$update" ]]; then
                debug "updating '.Bar.d'"
                cp -Lru "$prefix/share/bar/Bar.d/"* ".Bar.d"
            else
                debug "updating existing '.Bar.d'"
                rsync -rtuL --existing "$prefix/share/bar/Bar.d/" "Bar.d/"
            fi
        else
            die "bar not initialized"
        fi
        return 0
    fi

    if [[ -z "$hidden" ]]; then
        debug "installing bar"
        cp -L "$origin" "bar.new"
        mv  "bar.new" "bar"
        cp -L "$prefix/share/bar/Barf" "Barf"
        mkdir -p Bar.d
        init_install_modules "$prefix/share/bar/Bar.d" Bar.d
    else
        debug "installing .bar"
        cp -L "$origin" ".bar"
        cp -L "$prefix/share/bar/Barf" ".Barf"
        mkdir -p .Bar.d
        init_install_modules "$prefix/share/bar/Bar.d" .Bar.d
    fi
    # '--no-install-deps' leaves the tree as 'init_install_modules' left it: the 'Barf' is the
    # users file and is meant to be edited before 'init_deps' vendors exactly what it names.
    [[ -z "$install_deps" ]] || init_deps
    return 0
}

function init_install_modules ## <origin Bar.d> <target Bar.d> - installs the modules every bar needs
{
    ## Only the modules which are loaded on every startup: 'std_lib' and 'rule_lib' (both
    ## required by bar itself) and the '*_rules'.  Everything else is vendored on demand when a
    ## rule first names it, which is what 'init_deps' does right after the installation.
    local origin_dir="$1"
    local target_dir="$2"
    local module
    for module in std_lib rule_lib; do
        [[ -f "$origin_dir/$module" ]] || die "no '$module' in '$origin_dir'"
        info "installing '$module'"
        cp -L "$origin_dir/$module" "$target_dir/$module"
    done
    for module in "$origin_dir/"*_rules; do
        [[ -f "$module" ]] || continue
        info "installing '${module##*/}'"
        cp -L "$module" "$target_dir/${module##*/}"
    done
}

function init_deps ## - completes a vendored 'Bar.d' with the modules the Barf really needs
{
    ## 'bar init' installs the mandatory modules only ('init_install_modules'), this walks the
    ## rules of the local 'Barf' and vendors every module they (transitively) require from the
    ## installation bar was run from.  Run it again after the Barf grew a dependency to pick up
    ## the modules it now needs.
    BAR_INSTALL_DEPS=true "${BAR_SELF:-bar}" true
}

rule init_update_gitignore: is_git_toplevel? -- '
     require --opt testdir
     git_add_ignore ".bar.*"
     [[ -v TESTDIR_PREFIX ]] && git_add_ignore "$TESTDIR_PREFIX-"\*
'

## Initialize bar in a workdir. This copies the main 'bar' script, a default 'Barf' and the modules
## bar loads on every startup ('std_lib', 'rule_lib' and the '*_rules') to the current directory,
## then 'init_deps' installs the modules the new 'Barf' needs.  With '--no-install-deps' that last
## step is left out, so the 'Barf' can be customized first and 'bar init_deps' run afterwards to
## vendor exactly what the edited 'Barf' names.  Every other module is vendored from the
## installation the first time a rule names it, so a 'Bar.d/' which was trimmed on purpose keeps
## working.  When the workdir is a git repository then '.gitignore' is updated to exclude the files
## and directories 'bar' will use for temporary/testing storage.  A user may edit the 'Barf' file to
## suit the project/personal preference, run 'init_deps' after that and delete modules from 'Bar.d/'
## which are not needed ('bar modules_prune' deletes the ones which are still unmodified copies of
## the installation's).  When that is done the new/changed files should be committed to version
## control.
rule init: 'called_as? bar' -
rule init: 'called_as? bar' init_update_gitignore
rule init: '!called_as bar' -- error "not called as installed bar"

## Install the modules the current 'Barf' needs into the vendored 'Bar.d'.  Rules which name a
## module (as a dependency or in a 'require' line of their body) get it vendored from the
## installation bar was run from, transitively.  Modules which are already there are left
## untouched, this only ever adds.
rule init_deps: 'called_as? bar' -
rule init_deps: '!called_as bar' -- error "not called as installed bar"

## Updates a initialized working tree. That is 'bar' itself will be updated when a newer
## version is available and any module in 'Bar.d/' that exists in the local working tree will
## be updated as well.  Barf will be left untouched.
rule init_update_existing: 'called_as? bar' -- init --update-existing
rule init_update_existing: 'called_as? bar' init_update_gitignore
rule init_update_existing: '!called_as bar' -- error "not called as installed bar"

## Updates a initialized working tree. That is 'bar' itself will be updated when a newer
## version is available and all modules including ones that are not present in 'Bar.d/' will
## be updated as well.  Barf will be left untouched.
rule init_update: 'called_as? bar' -- init --update
rule init_update: 'called_as? bar' init_update_gitignore
rule init_update: '!called_as bar' -- error "not called as installed bar"

## Since the Barf is the users configuration we can't just update it this 'a bit mouthful'
## rule will do a merge of the local './Barf' with the shipped 'Barf.default'.  This will
## leave conflicts which have to be manually resolved. This is only useful when the shipped
## when 'Barf' was not or only slightly edited.
function init_update_merge_barf
{
    # shellcheck disable=2155
    local origin="$(command -v bar)"
    local prefix="${origin%/bin/*}"

    if [[  -f "$prefix/share/bar/Barf" ]]; then
        info "merging Barf file"
    else
        die "bar not properly installed, run './bar init_install <prefix>' from its git repository first"
    fi

    if [[ -f Barf ]]; then
        git merge-file --diff-algorithm=histogram ./Barf /dev/null "$prefix/share/bar/Barf" ||
            note "Please check the merged Barf file conflict markers and fix them"
    elif [[ -f .Barf ]]; then
        git merge-file --diff-algorithm=histogram ./.Barf /dev/null "$prefix/share/bar/Barf" ||
            note "Please check the merged Barf file conflict markers and fix them"
    else
        die "bar not initialized"
    fi
}

function init_install ## [prefix] - install links in [prefix] or '~/.local'.
{
    ## Bar will usually exist somewhere in a users home directory where it got checked
    ## out. Bar does rolling releases, it is continuously improved. To make this checked out
    ## version available for use this 'init_install' will create symlinks at the given
    ## [prefix] directory or in '~/.local' by default.
    ##
    ## For 'makeitso' every module of 'Bar.d/' is symlinked into '~/.config/makeitso'.  Running
    ## 'init_install' again adds the symlinks of modules which are not linked yet and leaves the
    ## existing ones untouched, so a module which was added to 'Bar.d/' later becomes reachable
    ## without a manual symlink.
    local prefix="${1:-$HOME/.local}"
    shift

    # shellcheck disable=2155
    local origin="$(realpath "$BASH_ARGV0")"
    # link the main script
    if [[ "$origin" != *"/bar" ]]; then
        die "not called as original bar"
    elif [[ -d "$prefix" && ! -f "$prefix/bin/bar" ]]; then
        mkdir -p "$prefix/bin"
        ln -s "$origin" "$prefix/bin/bar" || error "linking $origin to $prefix/bin/bar"
        info "linked $origin to $prefix/bin/bar"
        ln -s "$origin" "$prefix/bin/makeitso" || error "linking $origin to $prefix/bin/makeitso"
        info "linked $origin to $prefix/bin/makeitso"
    fi
    # link Bar.d
    if [[ ! -d "$prefix/share/bar" ]]; then
        mkdir -p "$prefix/share/bar"
        ln -s "${origin%/*}/Bar.d" "$prefix/share/bar/Bar.d"
        info "linked ${origin%/*}/Bar.d to $prefix/share/bar/Bar.d"
        ln -s "${origin%/*}/Barf.default" "$prefix/share/bar/Barf"
        info "linked ${origin%/*}/Barf.default to $prefix/share/bar/Barf"
        ln -s "${origin%/*}/Makeitsof.default" "$prefix/share/bar/Makeitsof"
        info "linked ${origin%/*}/Makeitsof.default to $prefix/share/bar/Makeitsof"
    else
        warn "can't link to $prefix/share/bar/"
    fi

    # link .config/makeitso
    if [[ -L "$HOME/.config/makeitso/std_lib" || ! -d "$HOME/.config/makeitso" ]]; then
        mkdir -p "$HOME/.config/makeitso"
        # Link every module which is not linked yet.  A module added to 'Bar.d/' after the initial
        # installation becomes reachable for 'makeitso' with a re-run of 'init_install', without a
        # manual symlink.  Existing links are left alone (a module may be developed in a worktree
        # and must not be repointed at it), so a re-run only ever adds links.
        local module link
        for module in "${origin%/*}/Bar.d/"*; do
            link="$HOME/.config/makeitso/${module##*/}"
            if [[ ! -e "$link" && ! -L "$link" ]]; then
                ln -s "$module" "$link" && info "linked $module to $link"
            fi
        done
    else
        warn "can't create to $HOME/.config/makeitso"
    fi

    if [[ ! -f "$HOME/.Makeitsof" ]]; then
        cp -L "$prefix/share/bar/Makeitsof" "$HOME/.Makeitsof"
        info "installed default $HOME/.Makeitsof"
    fi

    # link bash completion
    if [[ ! -d "$HOME/.bash_completion" ]]; then
        mkdir -p "$HOME/.bash_completion"
    fi
    if [[ ! -f "$HOME/.bash_completion/bar_complete" ]]; then
        ln -s "${origin%/*}/contrib/bar_complete" "$HOME/.bash_completion/bar_complete" || error "linking completion script"
        info "linked ${origin%/*}/contrib/bar_complete to $HOME/.bash_completion/bar_complete"
        note "To enable bash completion, source $HOME/.bash_completion/bar_complete in your .bashrc or restart your shell"
    fi
}

