# -*- mode: sh; sh-shell: bash -*-
# vim: set ft=bash:
# shellcheck shell=bash

### Support for the shellcheck shell linter
###
### A bar module or a rule file is not plain bash: it may be written in the make/just-like
### syntax 'preprocess' expands.  Those files are checked through 'bar_lint', which lets shellcheck
### read the expanded text, so the sugar is no longer reported as a syntax error.  Everything else
### is checked as it is written.
###
### Shellcheck is surprisingly slow.  In projects using bar one can prevent the bar files
### themselves being checked by setting in 'Barf':
###
###  SHELLCHECK_LS_FILES=":!bar :!Bar.d :!Barf"

require git_lib

declare -gx SHELLCHECK_LS_FILES="${SHELLCHECK_LS_FILES:-}" ## List of file match rules for git-ls-files.

function shellcheck_is_shscript ## <file> - Check if <file> is a shell script
{
    [[ -f "$1" ]] && head -5 "$1" | grep -Eq '^#!.*sh|^# shellcheck'
}

function shellcheck_is_barfile ## <file> - Check if <file> is a bar module or a rule file
{
    ## A module is sourced from a 'Bar.d' directory and carries no shebang.  A rule file names bar
    ## in its shebang ('#!/usr/bin/env bar') or is one of the names bar looks for.
    case "/$1/" in
    */Bar.d/*) return 0 ;;
    esac
    case "${1##*/}" in
    Barf | barf | .Barf | .barf | Barf.default | Pleasef | pleasef | .Pleasef | .pleasef | Pleasef.default)
        return 0
        ;;
    esac
    head -1 "$1" 2>/dev/null | grep -Eq '^#!.*[ /]bar([[:space:]]|$)'
}

function bar_lint ## <file> - Lint a bar module or rule file with shellcheck
{
    ## <file> - The module or rule file to check.
    ##
    ## Shellcheck reads the text 'preprocess' prints, which is the text 'require' sources: a file
    ## written in the make/just syntax is checked as the 'rule' syntax it is expanded to, and
    ## only genuine shell defects are reported.  Diagnostics name the file, not the descriptor the
    ## printed text was read from.  '--shell=bash' because the file's shebang names 'bar'.
    ##
    ## A <file> which is not there is an error (exit 2), never a silent pass.
    local file="$1"
    local from out fd
    local color=auto
    local rc=0
    if [[ ! -f "$file" ]]; then
        error "not a file: $file"
        return 2
    fi
    if [[ -t 1 ]]; then
        color=always
    fi
    exec {fd}< <(preprocess "$file")
    from="/dev/fd/$fd"
    out="$(shellcheck --color="$color" --shell=bash "$from" 2>&1)" || rc=$?
    exec {fd}<&-
    if [[ -n "$out" ]]; then
        printf '%s\n' "${out//$from/$file}"
    fi
    return "$rc"
}

function shellcheck_has_shscripts
{
    local file
    for file in $(git_ls_files -c --other ${SHELLCHECK_LS_FILES:+-- $SHELLCHECK_LS_FILES}); do
        if shellcheck_is_shscript "$file"; then
            trace "Shell scripts found"
            return 0
        fi
    done
    debug "No shell scripts found in the repository"
    return 1
}
memofn shellcheck_has_shscripts

## Checks if the project has any shell scripts. Must be called from a git toplevel.
## Checks whenever any shell scripts are versioned in gitq
rule shellcheck_has_shscripts: is_git_toplevel -

function shellcheck_list_shscripts ## List all shell scripts under git control
{
    local file
    for file in $(git_ls_files -c --other ${SHELLCHECK_LS_FILES:+-- $SHELLCHECK_LS_FILES}); do
        if shellcheck_is_shscript "$file"; then
            echo "$file"
        fi
    done
}
memofn shellcheck_list_shscripts

function shellcheck_lint ## Test if all shell scripts under git control pass the linter.
{
    ## '--color' (without a value) forces ANSI colour even when the output is not a terminal, so
    ## every captured log or memodb entry was full of escape sequences.  '--color=auto' is the
    ## shellcheck default: colour for a human at a terminal, plain text for a capture.
    ##
    ## A bar module or rule file goes through 'bar_lint': it is preprocessed before it is checked,
    ## the make/just syntax is not bash.  Every other file is checked as it is written.
    trace "shellcheck $(shellcheck_list_shscripts)"
    local rc=0
    local file
    local -a plain=()
    while IFS= read -r file; do
        if [[ -z "$file" ]]; then
            continue
        fi
        if shellcheck_is_barfile "$file"; then
            bar_lint "$file" || rc=1
        else
            plain+=("$file")
        fi
    done < <(shellcheck_list_shscripts)
    if (( ${#plain[@]} )); then
        shellcheck --color=auto "${plain[@]}" || rc=1
    fi
    return "$rc"
}

# Define --bare rules for shellcheck query/predicate functions
rule --bare shellcheck_is_shscript: -
rule --bare shellcheck_list_shscripts: -
