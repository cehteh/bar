## <state> <author> - the complete state as one JSON object
function rad_state_json
{
    printf '{"bar_rad":1,"repo":{"rid":%s,"name":%s,"path":%s},"identity":{"alias":%s,"did":%s,"known":%s},"head":{"branch":%s,"commit":%s,"canonical":%s,"canonical_commit":%s,"ahead":%s,"behind":%s},"select":{"state":%s,"author":%s},"patches":' \
        "$(json_string "$RAD_STATE_RID")" "$(json_string "$RAD_STATE_NAME")" \
        "$(json_string "$RAD_STATE_PATH")" "$(json_string "$RAD_STATE_ALIAS")" \
        "$(json_string "$RAD_STATE_DID")" "$(json_bool "$RAD_STATE_KNOWN")" \
        "$(json_string "$RAD_STATE_BRANCH")" "$(json_string "$RAD_STATE_COMMIT")" \
        "$(json_string "$RAD_STATE_CANONICAL")" "$(json_string "$RAD_STATE_CANONICAL_COMMIT")" \
        "$(json_number "$RAD_STATE_AHEAD")" "$(json_number "$RAD_STATE_BEHIND")" \
        "$(json_string "$1")" "$(json_string "$2")"
    rad_state_json_patches "$1" "$2"
    printf ',"issues":'
    rad_state_json_issues
    printf ',"branches":'
    rad_state_json_branches
    printf '}\n'
}

function rad_state ## [--json] [--max <n>] - the radicle state of this checkout in one invocation
{
    local json="" max="$RAD_STATE_MAX" arg="" i=0
    local -a args=( ${RULE_ARGS[@]+"${RULE_ARGS[@]}"} )

    while (( i < ${#args[@]} )); do
        arg="${args[i]}"
        case "$arg" in
        -h | --help)
            help_usage rad_state
            return 0
            ;;
        --json)
            json=1
            ;;
        --max)
            i=$(( i + 1 ))
            max="${args[i]:-}"
            ;;
        *)
            help_usage_error rad_state
            return 2
            ;;
        esac
        i=$(( i + 1 ))
    done
    [[ "$max" =~ ^[0-9]+$ ]] || {
        help_usage_error rad_state
        return 2
    }
    [[ -n "${BAR_AGENT_JSON:-}" ]] && json=1

    is_command_installed "$RAD_BIN" || {
        error "'$RAD_BIN' is not installed"
        return 1
    }
    rad_state_collect || return $?
    RAD_STATE_NOW="$(date +%s)"

    if [[ -n "$json" ]]; then
        rad_state_json all all
    else
        rad_state_text "$max"
    fi
}

function rad_patches ## [--json] [--max <n>] [--state <open|draft|merged|archived|all>] [--author <ours|other|all>] - the patches of this checkout, by state and by author
{
    local json="" max="$RAD_STATE_MAX" select_state="all" select_author="all" arg="" i=0
    local -a args=( ${RULE_ARGS[@]+"${RULE_ARGS[@]}"} )

    while (( i < ${#args[@]} )); do
        arg="${args[i]}"
        case "$arg" in
        -h | --help)
            help_usage rad_patches
            return 0
            ;;
        --json)
            json=1
            ;;
        --max | --state | --author)
            i=$(( i + 1 ))
            case "$arg" in
            --max) max="${args[i]:-}" ;;
            --state) select_state="${args[i]:-}" ;;
            --author) select_author="${args[i]:-}" ;;
            esac
            ;;
        *)
            help_usage_error rad_patches
            return 2
            ;;
        esac
        i=$(( i + 1 ))
    done
    case "$select_state" in
    all | open | draft | merged | archived) ;;
    *)
        help_usage_error rad_patches
        return 2
        ;;
    esac
    case "$select_author" in
    all | ours | other) ;;
    *)
        help_usage_error rad_patches
        return 2
        ;;
    esac
    [[ "$max" =~ ^[0-9]+$ ]] || {
        help_usage_error rad_patches
        return 2
    }
    [[ -n "${BAR_AGENT_JSON:-}" ]] && json=1

    is_command_installed "$RAD_BIN" || {
        error "'$RAD_BIN' is not installed"
        return 1
    }
    rad_state_collect || return $?
    RAD_STATE_NOW="$(date +%s)"

    if [[ -n "$json" ]]; then
        rad_state_json "$select_state" "$select_author"
    else
        local file=""
        rad_state_text_head
        rad_state_text_patches "$max" "$select_state" "$select_author"
        if (( max != 0 && RAD_STATE_CUT != 0 )); then
            file="$(rad_state_complete_file)"
            if { rad_state_text_head; rad_state_text_patches 0 "$select_state" "$select_author"; } >"$file" 2>/dev/null; then
                rad_state_complete_note "$file"
            else
                warn "could not write the complete text to $file"
            fi
        fi
    fi
}

# --- minting the name: the classes bar defines, and the slug of a description --------------------

function rad_classes ## - the branch classes bar defines, one '<class>-' prefix per line
{
    ## Read from the 'is_git_*_branch' rules of the git module, so the vocabulary has one source of
    ## truth: the matcher 'fix-* fix/*' contributes the class 'fix-'.  Bar's matches are regexes, so
    ## 'fix-*' is the prefix 'fix-' followed by anything; the slash forms ('fix/', 'release/') are
    ## not classes of a *topic* here -- this host's layout puts a task id behind the slash
    ## ('<slug>/<task-id>') -- and the bare trunks ('main', 'master', 'devel') have no prefix at all.
    local module="${BAR_DIR:-}/git"
    [[ -f "$module" ]] || return 1
    LC_ALL=C sed -n "s/^rule is_git_[a-z]*_branch: 'git_branch_matches \(.*\)'\$/\1/p" "$module" |
        LC_ALL=C tr ' ' '\n' |
        LC_ALL=C sed -n 's/^\([a-z][a-z]*-\)\*$/\1/p' |
        LC_ALL=C sort -u
}

function rad_slug ## <text> - the description as a name slug, empty when nothing is left
{
    printf '%s' "$1" |
        LC_ALL=C tr '[:upper:]' '[:lower:]' |
        LC_ALL=C sed -e 's/[^a-z0-9._-]\+/-/g' -e 's/--\+/-/g' -e 's/^[-._]\+//' -e 's/[-._]\+$//'
}

# --- rad_trust ------------------------------------------------------------------------------

## The grounds a trust question is answered from: a **disjoint** list (any one of them suffices --
## an implied OR, there are no expressions) and the names a caller asks for.
declare -gra RAD_TRUST_GROUNDS=( delegate owner opened assigned contributed )
declare -g RAD_TRUST_STORAGE=""    ## the node storage of it, once it is resolved
declare -g RAD_TRUST_ITEM_REF=""   ## the COB of the item asked about, once it is resolved

function rad_trust_ground_known ## <name> - 0 when <name> is one of the grounds
{
    local name="$1" known
    for known in "${RAD_TRUST_GROUNDS[@]}"; do
        if [[ "$name" == "$known" ]]; then
            return 0
        fi
    done
    return 1
}
## <repo> - the repository and the node storage of it, in RAD_TRUST_RID/RAD_TRUST_STORAGE
function rad_trust_store
{
    ## Which repository, and where its COBs are: every ground which is a fact about the node's own copy
    ## ('owner', 'opened', 'assigned') and a relative threshold need it -- the two facts the fact tool
    ## answers do not, and resolving it costs a 'rad' invocation, so it happens only when a ground asks
    ## for it.  A repository the node does not hold is *could not answer* (2): nothing about it can be
    ## established, not even 'false'.
    local repo="$1"
    if [[ -n "$RAD_TRUST_STORAGE" ]]; then
        return 0
    fi
    if ! rad_metadata_store rad_trust "$repo"; then
        return 1
    fi
    RAD_TRUST_STORAGE="$RAD_METADATA_STORAGE"
    return 0
}

## <storage> - the NID of the identity which established the repository
function rad_trust_owner_nid
{
    ## The 'owner' ground.  Radicle has no owner field: a repository belongs to its delegates and the
    ## identity document (payload, delegates, threshold) names no single owner.  The one identity a
    ## 'whose repository is this' question can be answered with is the identity that *established* it:
    ## the author of the initial revision of the identity document, which is the one 'rad init' gave
    ## the project to.  An identity document which is not there, or which has no history, answers
    ## nothing -- the ground is 'false' then, never an error.
    local storage="$1"
    local ref="" mail=""
    for ref in refs/rad/id 'refs/namespaces/*/refs/rad/id'; do
        mail="$(git --git-dir="$storage" log --reverse --format=%ae "$ref" 2>/dev/null | head -1)" || mail=""
        if [[ -n "$mail" ]]; then
            break
        fi
    done
    [[ "$mail" == *@z6M* ]] || return 1
    printf '%s' "${mail##*@}"
}

## <storage> - the commits every radicle identity authored in this repository
function rad_trust_total_authored
{
    ## The denominator of a relative threshold: the commits authored as *some* identity
    ## ('<alias>@<NID>'), counted over all refs of the node's copy the same way the fact tool counts the
    ## author's own -- which is what lets one setting ('10%') mean the same in a big and in a small
    ## repository.  A count, never a failure: no commits means zero.
    local storage="$1" total=""
    total="$(git --git-dir="$storage" log --all --pretty=%ae 2>/dev/null | LC_ALL=C grep -c '@z6M')" || total=0
    [[ "$total" =~ ^[0-9]+$ ]] || total=0
    printf '%s' "$total"
}

## <storage> <id> <type> - the COB of the item, in RAD_TRUST_ITEM_REF
function rad_trust_item_ref
{
    ## The item the 'opened' and 'assigned' grounds are about, by its id (short or full) and of the type
    ## the caller named.  An id the node does not hold, or one which is the other type, is the caller's
    ## error and not 'false': a caller asking about an item this node cannot show cannot act on a no.
    local storage="$1" id="$2" type="$3"
    if ! rad_comment_metadata_ref "$storage" "$id"; then
        printf 'rad_trust: the node holds no %s %s\n' "$type" "$id" >&2
        return 1
    fi
    if [[ "$RAD_COMMENT_METADATA_TYPE" != "$type" ]]; then
        printf "rad_trust: '%s' is a %s, not a %s\n" "$id" "$RAD_COMMENT_METADATA_TYPE" "$type" >&2
        return 1
    fi
    RAD_TRUST_ITEM_REF="$RAD_COMMENT_METADATA_REF"
    return 0
}

## <storage> <ref> <type> - the NID of the identity which opened the item
function rad_trust_item_nid
{
    ## The item's author is the author of the op which *created* it.  A COB is chained onto the identity
    ## commits -- and a patch COB onto the patch's own commits -- so the create op is found by its
    ## subject ('Create issue'/'Create patch') and confirmed by the manifest next to it, which names the
    ## item type: a foreign op in the same chain is not the create op, and an op whose manifest says
    ## otherwise is skipped rather than believed.
    local storage="$1" ref="$2" type="$3"
    local op="" mail="" subject="" manifest=""
    while IFS='|' read -r op mail subject; do
        [[ "$subject" == "Create $type" ]] || continue
        manifest="$(git --git-dir="$storage" cat-file -p "$op^{tree}:manifest" 2>/dev/null)" || manifest=""
        if [[ -n "$manifest" && "$manifest" != *"xyz.radicle.$type"* ]]; then
            continue
        fi
        [[ "$mail" == *@z6M* ]] || return 1
        printf '%s' "${mail##*@}"
        return 0
    done < <(git --git-dir="$storage" log --reverse --format='%H|%ae|%s' "$ref" 2>/dev/null)
    return 1
}

function rad_trust ## --repo <rid|path> --author <did|nid|alias> [--issue <id>|--patch <id>] [--grounds <ground,..>] [--threshold <n|n%>] [--dump] [--json] [--second-party] [--requester <did|nid>] - the trust verdict of the triage policy; '--second-party' is the actor against '--requester', and against itself without one
{
    local -a args=() grounds=() parts=() cmd=() ground_json=() ground_true=()
    local raw="" arg="" value="" part=""
    local json="" dump="" repo="" author="" threshold="" item="" item_type="" second_party=""
    local requester="" requester_nid=""
    local tool="" facts="" fields="" did="" nid="" alias="" delegate="no" authored="" reason="" rid=""
    local thr="" commits="" total="" share="" owner_nid="" item_nid="" verdict="" ground="" grounds_json="" sp=""
    local want_delegate=no want_owner=no want_opened=no want_assigned=no want_contributed=no
    local delegate_ok=no contributed_ok=no owner_ok=no opened_ok=no assigned_ok=no reached=no
    local object="" did_i=""
    local -i i=0 count=0

    for raw in "$@"; do
        if [[ "$raw" == --*=* ]]; then
            args+=( "${raw%%=*}" "${raw#*=}" )
        else
            args+=( "$raw" )
        fi
    done
    count=${#args[@]}
    i=0
    while (( i < count )); do
        arg="${args[i]}"
        i=$(( i + 1 ))
        case "$arg" in
        -h | --help)
            help_usage rad_trust
            return 0
            ;;
        --json) json=1 ;;
        --dump) dump=1 ;;
        --second-party) second_party=1 ;;
        --repo | --author | --threshold | --grounds | --issue | --patch | --requester)
            if (( i >= count )) || [[ -z "${args[i]}" ]]; then
                help_usage_error rad_trust "'$arg' needs a non-empty value"
                return 2
            fi
            value="${args[i]}"
            i=$(( i + 1 ))
            case "$arg" in
            --repo) repo="$value" ;;
            --author) author="$value" ;;
            --requester) requester="$value" ;;
            --threshold) threshold="$value" ;;
            --issue | --patch)
                if [[ -n "$item" ]]; then
                    help_usage_error rad_trust "only one item can be asked about (got '$item' and '$value')"
                    return 2
                fi
                item="$value"
                item_type="${arg#--}"
                ;;
            --grounds)
                IFS=',' read -r -a parts <<<"$value"
                for part in "${parts[@]}"; do
                    [[ -n "$part" ]] && grounds+=( "$part" )
                done
                ;;
            esac
            ;;
        *)
            help_usage_error rad_trust "unknown argument '$arg'"
            return 2
            ;;
        esac
    done

    if [[ -z "$repo" || -z "$author" ]]; then
        help_usage_error rad_trust "both --repo and --author are required"
        return 2
    fi
    if [[ -n "$threshold" && ! "$threshold" =~ ^[0-9]+$ && ! "$threshold" =~ ^[0-9]+(\.[0-9]+)?%$ ]]; then
        help_usage_error rad_trust "invalid --threshold '$threshold', want a non-negative number or a percent like '10%'"
        return 2
    fi
    ## '--requester' is the reference '--second-party' compares against; on its own it decides
    ## nothing, so it is a usage error rather than a value which is silently dropped.
    if [[ -n "$requester" && -z "$second_party" ]]; then
        help_usage_error rad_trust "'--requester <who>' names who asked for the decision: it needs '--second-party'"
        return 2
    fi
    ## The requester has to be a unique identity: an alias is not one (two identities can answer to
    ## one), and a comparison against the wrong identity is worse than a refusal.
    if [[ -n "$requester" && "$requester" != z6M* && "$requester" != did:key:z6M* ]]; then
        help_usage_error rad_trust "'--requester <who>' names the identity which asked: a bare NID ('z6M…') or 'did:key:z6M…', never an alias"
        return 2
    fi
    # A second party is one *other* than the identity which asked for the decision.  '--requester'
    # names that identity; without one the requester *is* the actor, so the flag answers 'false'.
    [[ -n "$second_party" ]] && dump=1

    ## Which grounds are asked for: the named ones, or -- with no '--grounds' -- the rule this helper
    ## has always answered (a delegate, or the authored commits reaching the threshold).  '--dump'
    ## means all of them, and evaluates nothing.
    if (( ${#grounds[@]} == 0 )); then
        if [[ -n "$dump" ]]; then
            grounds=( "${RAD_TRUST_GROUNDS[@]}" )
        else
            grounds=( delegate contributed )
        fi
    fi
    for part in "${grounds[@]}"; do
        if ! rad_trust_ground_known "$part"; then
            local grounds
            IFS=',' grounds="${RAD_TRUST_GROUNDS[*]}"
            grounds="${grounds//,/, }"
            help_usage_error rad_trust "unknown ground '$part': one of $grounds"
            return 2
        fi
        case "$part" in
        delegate) want_delegate=yes ;;
        owner) want_owner=yes ;;
        opened) want_opened=yes ;;
        assigned) want_assigned=yes ;;
        contributed) want_contributed=yes ;;
        esac
    done
    [[ -n "$dump" ]] && json=1

    tool="${RAD_TRIAGE_FACTS:-}"
    if [[ -z "$tool" ]]; then
        printf 'rad_trust: no fact tool configured: set RAD_TRIAGE_FACTS to the triage fact tool\n' >&2
        return 2
    fi
    if [[ ! -x "$tool" ]]; then
        printf 'rad_trust: the fact tool is missing or not executable: %s\n' "$tool" >&2
        return 2
    fi
    if ! command -v jq >/dev/null 2>&1; then
        printf 'rad_trust: jq is required to read the facts\n' >&2
        return 2
    fi

    cmd=( "$tool" --repo "$repo" --author "$author" )
    ## The tool's '--threshold' is an absolute count, so a relative threshold is not handed to it: that
    ## comparison is made here, from the same count and the repository's own total.  The tool's own
    ## 'contributor' verdict is not used either -- the grounds are what decides, once.
    [[ -n "$threshold" && "$threshold" != *% ]] && cmd+=( --threshold "$threshold" )
    ## The tool exits non-zero when it cannot answer (an unresolvable author is one of those), and still
    ## prints the JSON which says why -- so the exit code is reported, never interpreted: an empty
    ## answer is 'could not answer', anything else is read and the reason travels on.
    local tool_rc=0
    facts="$("${cmd[@]}" 2>/dev/null)" || tool_rc=$?
    if [[ -z "$facts" ]]; then
        printf 'rad_trust: %s gave no answer for %s (exit %s)\n' "${tool##*/}" "$repo" "$tool_rc" >&2
        return 2
    fi

    ## One jq pass, so the text form and the machine form carry the same numbers.  The fields are joined
    ## with US (0x1f) and not with a tab: an empty field has to survive the read, and IFS whitespace
    ## would collapse it.
    if ! fields="$(printf '%s' "$facts" | jq -r '[
            (if .author == null then "-" else (.author.did // .author.nid // "-") end),
            (if .author == null then "-" else (.author.alias // .author.did // "-") end),
            (if .author != null and .author.is_delegate == true then "yes" else "no" end),
            (((.author.total_authored // .author.commits_as_identity) // "-") | tostring),
            (([.reason, .error] | map(select(. != null and . != "")) | first // "-") | tostring | gsub("[[:cntrl:]]"; " ")),
            ((.rid // "-") | tostring)
        ] | join("\u001f")' 2>/dev/null)"; then
        printf 'rad_trust: cannot read the facts of %s\n' "${tool##*/}" >&2
        return 2
    fi
    IFS=$'\037' read -r did alias delegate authored reason rid <<<"$fields"

    ## An author the repository cannot resolve is *not* an error of the tool: it has no data, and that
    ## is 'unknown' (exit 2), never 'untrusted'.  Nothing can be established for it, so no ground is.
    if [[ "$did" == "-" ]]; then
        if [[ -n "$json" ]]; then
            printf '%s' "$facts" | jq -c '. + {bar_rad: 1, verdict: "unknown"}' 2>/dev/null ||
                printf '{"bar_rad":1,"verdict":"unknown"}\n'
        else
            printf 'unknown author=- delegate=no authored=- threshold=%s reason=%s repo=%s\n' \
                "${threshold:-10}" "$reason" "$rid"
        fi
        return 2
    fi
    nid="$(rad_metadata_nid "$did")"
    thr="${threshold:-10}"

    ## Who asked for the decision.  With no '--requester' it is the actor itself -- no item is read to
    ## find an opener, and the answer is 'false'.  A named requester is a NID or a 'did:key:' one and
    ## nothing else (checked above), so there is nothing here which could resolve to another identity.
    requester_nid="$nid"
    if [[ -n "$requester" ]]; then
        requester_nid="$(rad_metadata_nid "$requester")"
    fi

    ## 'contributed': the commits this identity authored as itself against the threshold -- absolute, or
    ## as the share of the commits every identity authored in this repository.  The total is read when a
    ## relative threshold compares it, and in '--dump' (the cache call wants the share of a repository,
    ## not only of a relative threshold).
    if [[ "$want_contributed" == yes ]]; then
        commits="$authored"
        [[ "$commits" =~ ^[0-9]+$ ]] || commits=0
        if [[ -n "$dump" || "$thr" == *% ]]; then
            rad_trust_store "$repo" || return 2
            total="$(rad_trust_total_authored "$RAD_TRUST_STORAGE")"
            share="$(LC_ALL=C awk -v c="$commits" -v t="${total:-0}" \
                'BEGIN { if (t > 0) printf "%.3f", c / t; else printf "0.000" }')"
            share="${share%0}"; share="${share%0}"; share="${share%0}"; share="${share%.}"
        fi
        if [[ "$thr" == *% ]]; then
            if LC_ALL=C awk -v c="$commits" -v t="${total:-0}" -v p="${thr%\%}" \
                'BEGIN { exit !(t > 0 && (c / t) >= (p / 100)) }'; then
                reached=yes
            fi
        elif (( commits >= thr )); then
            reached=yes
        fi
        if [[ "$reached" == yes ]]; then
            contributed_ok=yes
        fi
        object="{"
        object+="\"commits\":$(json_number "$commits")"
        if [[ -n "$share" ]]; then
            if [[ "$share" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
                object+=",\"share\":$share"
            else
                object+=",\"share\":null"
            fi
        fi
        object+=",\"threshold\":$(json_string "$thr")}"
        ground_json+=( "\"contributed\":$object" )
    fi
    if [[ "$want_delegate" == yes ]]; then
        if [[ "$delegate" == yes ]]; then
            delegate_ok=yes
        fi
        ground_json+=( "\"delegate\":$(json_bool "$delegate")" )
    fi

    ## 'owner' and the two item grounds are facts about the node's own copy of the repository, so they
    ## need its storage -- resolved once, and only when one of them is asked for.
    if [[ "$want_owner" == yes ]]; then
        rad_trust_store "$repo" || return 2
        owner_nid="$(rad_trust_owner_nid "$RAD_TRUST_STORAGE")" || owner_nid=""
        [[ "$owner_nid" == "$nid" ]] && owner_ok=yes
        ground_json+=( "\"owner\":$(json_bool "$owner_ok")" )
    fi
    if [[ "$want_opened" == yes || "$want_assigned" == yes ]]; then
        rad_trust_store "$repo" || return 2
        ## No item named: the two item grounds cannot be established.  They are 'false', never an error
        ## -- a caller which asks about them without an item has nothing to decide either.
        if [[ -n "$item" ]]; then
            rad_trust_item_ref "$RAD_TRUST_STORAGE" "$item" "$item_type" || return 2
            if [[ "$want_opened" == yes ]]; then
                item_nid="$(rad_trust_item_nid "$RAD_TRUST_STORAGE" "$RAD_TRUST_ITEM_REF" "$item_type")" || item_nid=""
                [[ "$item_nid" == "$nid" ]] && opened_ok=yes
                ground_json+=( "\"opened\":$(json_bool "$opened_ok")" )
            fi
            if [[ "$want_assigned" == yes ]]; then
                rad_comment_metadata_assignees "$RAD_TRUST_STORAGE" "$RAD_TRUST_ITEM_REF"
                for did_i in ${RAD_COMMENT_METADATA_ASSIGNEES[@]+"${RAD_COMMENT_METADATA_ASSIGNEES[@]}"}; do
                    if [[ "$did_i" == "$nid" ]]; then
                        assigned_ok=yes
                    fi
                done
                ground_json+=( "\"assigned\":$(json_bool "$assigned_ok")" )
            fi
        else
            [[ "$want_opened" == yes ]] && ground_json+=( '"opened":false' )
            [[ "$want_assigned" == yes ]] && ground_json+=( '"assigned":false' )
        fi
    fi

    ## The verdict: the first ground which holds **in the order the caller listed them**, so a caller
    ## lists its grounds in the order it wants them reported.
    for part in "${grounds[@]}"; do
        case "$part" in
        delegate) [[ "$delegate_ok" == yes ]] && ground_true+=( delegate ) ;;
        owner) [[ "$owner_ok" == yes ]] && ground_true+=( owner ) ;;
        opened) [[ "$opened_ok" == yes ]] && ground_true+=( opened ) ;;
        assigned) [[ "$assigned_ok" == yes ]] && ground_true+=( assigned ) ;;
        contributed) [[ "$contributed_ok" == yes ]] && ground_true+=( contributed ) ;;
        esac
    done
    verdict="untrusted"
    ground=""
    reason="no ground of '${grounds[*]}' holds (delegate=$delegate, authored=$authored, threshold=$thr)"
    if (( ${#ground_true[@]} > 0 )); then
        verdict="trusted"
        ground="${ground_true[0]}"
        case "$ground" in
        delegate) reason="delegate of this repository" ;;
        owner) reason="established this repository" ;;
        opened) reason="opened this item" ;;
        assigned) reason="is an assignee of this item" ;;
        contributed) reason="${authored} commits authored as this Radicle identity (>= ${thr})" ;;
        esac
    fi

    grounds_json="{$(IFS=,; printf '%s' "${ground_json[*]}")}"
    ## 'second_party': somebody *other* than the identity which asked for the decision.  '--requester'
    ## names that identity; without one it is the actor, so the same identity -- 'false'.
    if [[ -n "$second_party" ]]; then
        sp=true
        [[ "$requester_nid" == "$nid" ]] && sp=false
    fi
    if [[ -n "$json" ]]; then
        if [[ -n "$dump" ]]; then
            if [[ -n "$second_party" ]]; then
                printf '%s' "$facts" | jq -c --argjson grounds "$grounds_json" --argjson second_party "$sp" \
                    '. + {bar_rad: 1, grounds: $grounds, second_party: $second_party}' 2>/dev/null ||
                    printf '{"bar_rad":1,"grounds":%s,"second_party":%s}\n' "$grounds_json" "$sp"
            else
                printf '%s' "$facts" | jq -c --argjson grounds "$grounds_json" \
                    '. + {bar_rad: 1, grounds: $grounds}' 2>/dev/null ||
                    printf '{"bar_rad":1,"grounds":%s}\n' "$grounds_json"
            fi
        else
            printf '%s' "$facts" | jq -c --arg verdict "$verdict" --arg ground "$ground" \
                --argjson grounds "$grounds_json" \
                '. + {bar_rad: 1, verdict: $verdict, ground: $ground, grounds: $grounds}' 2>/dev/null ||
                printf '{"bar_rad":1,"verdict":%s,"ground":%s,"grounds":%s}\n' \
                    "$(json_string "$verdict")" "$(json_string "$ground")" "$grounds_json"
        fi
    else
        printf '%s author=%s delegate=%s authored=%s threshold=%s ground=%s reason=%s repo=%s\n' \
            "$verdict" "$alias" "$delegate" "$authored" "$thr" "${ground:--}" "$reason" "$rid"
    fi

    if [[ -n "$dump" ]]; then
        return 0
    fi
    if [[ "$verdict" == trusted ]]; then
        return 0
    fi
    return 1
}

# --- rad_identity: the identity <-> git-author map, and a verified answer for a commit ----------

## <repo> - the repository and the node storage which holds it, in RAD_IDENTITY_RID, _STORAGE and
## _TOPLEVEL (the checkout, empty when the caller is not in one)
function rad_identity_store
{
    ## Everything below is read from the node's own copy: the identity document, the ops and the
    ## namespaces all live in the storage, so this resolves which repository and nothing else.
    local repo="$1" toplevel=""
    rad_metadata_store rad_identity "$repo" || return $?
    RAD_IDENTITY_RID="$RAD_METADATA_RID"
    RAD_IDENTITY_STORAGE="$RAD_METADATA_STORAGE"
    if [[ -n "$repo" && "$repo" != rad:* ]]; then
        toplevel="$(cd "$repo" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null)" || toplevel=""
    else
        ## A RID names the repository, so the checkout is wherever this runs: it is only ever read
        ## for the author line of a commit the store does not hold, and that line proves nothing.
        toplevel="$(git rev-parse --show-toplevel 2>/dev/null)" || toplevel=""
    fi
    RAD_IDENTITY_TOPLEVEL="$toplevel"
    return 0
}

## <storage> - the accepted identity document: RAD_IDENTITY_OP (its revision op), _OBJECT (the COB it
## belongs to), _DELEGATES (one DID per line) and _DOC_THRESHOLD; 1 when the store carries none
function rad_identity_doc
{
    ## The document is an op whose payload blob is the revision: 'delegates' and 'threshold' are read
    ## from the blob, the op and the COB from the store.  The canonical 'refs/rad/id' is the accepted
    ## revision; a copy which carries the identity only under its namespaces answers from there.
    local storage="$1" op="" payload="" blob="" doc="" sha="" ref=""
    RAD_IDENTITY_OP=""
    RAD_IDENTITY_OBJECT=""
    RAD_IDENTITY_DELEGATES=""
    RAD_IDENTITY_DOC_THRESHOLD=""
    op="$(git --git-dir="$storage" rev-parse --verify --quiet 'refs/rad/id^{commit}' 2>/dev/null)" || op=""
    if [[ -z "$op" ]]; then
        op="$(git --git-dir="$storage" for-each-ref --count=1 --format='%(objectname)' \
            'refs/namespaces/*/refs/rad/id' 2>/dev/null)" || op=""
    fi
    [[ -n "$op" ]] || return 1
    payload="$(git --git-dir="$storage" cat-file -p "$op:0" 2>/dev/null)" || return 1
    blob="$(printf '%s' "$payload" | jq -r '.blob // empty' 2>/dev/null)" || blob=""
    [[ -n "$blob" ]] || return 1
    doc="$(git --git-dir="$storage" cat-file -p "$blob" 2>/dev/null)" || return 1
    RAD_IDENTITY_DELEGATES="$(printf '%s' "$doc" | jq -r '.delegates[]?' 2>/dev/null)" ||
        RAD_IDENTITY_DELEGATES=""
    RAD_IDENTITY_DOC_THRESHOLD="$(printf '%s' "$doc" | jq -r '.threshold // empty' 2>/dev/null)" ||
        RAD_IDENTITY_DOC_THRESHOLD=""
    [[ -n "$RAD_IDENTITY_DELEGATES" ]] || return 1
    while read -r sha ref; do
        [[ "$sha" == "$op" ]] || continue
        RAD_IDENTITY_OBJECT="${ref##*/}"
        break
    done < <(git --git-dir="$storage" for-each-ref --format='%(objectname) %(refname)' \
        'refs/namespaces/*/refs/cobs/xyz.radicle.id/**' 2>/dev/null)
    RAD_IDENTITY_OP="$op"
    return 0
}

## <storage> <glob> - one pass of the author map over the ops of the refs matching <glob>; an
## identity an earlier pass answered is never overwritten, so the identity COB wins over a comment
function rad_identity_authors_pass
{
    local storage="$1" glob="$2" sha="" mail="" name="" nid="" ref=""
    local -a refs=()
    while IFS= read -r ref; do
        refs+=("$ref")
    done < <(git --git-dir="$storage" for-each-ref --format='%(refname)' "$glob" 2>/dev/null)
    if (( "${#refs[@]}" == 0 )); then
        return 0
    fi
    while IFS=$'\t' read -r sha mail name; do
        [[ "$mail" == *@z6M* ]] || continue
        nid="${mail##*@}"
        RAD_IDENTITY_MAIL["$mail"]="${name:-${mail%%@*}}"
        if [[ -z "${RAD_IDENTITY_SOURCE[$nid]:-}" ]]; then
            RAD_IDENTITY_SOURCE["$nid"]="$sha"
            RAD_IDENTITY_SOURCE_MAIL["$nid"]="$mail"
        fi
    done < <(git --git-dir="$storage" log --format='%H%x09%ae%x09%an' "${refs[@]}" 2>/dev/null)
    return 0
}

## <storage> - the author lines of every op the store carries: RAD_IDENTITY_MAIL (mail -> name),
## _SOURCE (nid -> the op its alias was read from) and _SOURCE_MAIL (nid -> its mail)
function rad_identity_authors
{
    ## An op is authored '<alias> <alias>@<nid>' and signed with that identity's key -- the author
    ## line is the only place a repository records which git authors an identity uses, so the map is
    ## built from ops and from nothing else 'git log' would report about a branch.  The identity COB
    ## is read first, so 'the op the alias was read from' is the document itself whenever the identity
    ## authored one of its revisions.
    local storage="$1"
    declare -gA RAD_IDENTITY_MAIL=()
    declare -gA RAD_IDENTITY_SOURCE=()
    declare -gA RAD_IDENTITY_SOURCE_MAIL=()
    rad_identity_authors_pass "$storage" 'refs/namespaces/*/refs/cobs/xyz.radicle.id/**'
    rad_identity_authors_pass "$storage" 'refs/namespaces/*/refs/cobs/**'
    return 0
}

## <storage> <sha> - 0 when that commit is a radicle op: its tree carries the manifest which names
## the COB type, which no branch commit of a checkout does
function rad_identity_is_op
{
    ## The shape, never the reachability: a patch COB is chained onto the commits the patch was cut
    ## from, so 'some COB ref reaches this commit' is true of a branch commit as well and would
    ## report an ordinary commit as an op -- and an op signed by the identity which wrote it.
    local manifest=""
    manifest="$(git --git-dir="$1" cat-file -p "$2:manifest" 2>/dev/null)" || return 1
    [[ "$manifest" == *typeName* && "$manifest" == *xyz.radicle.* ]]
}

## <value> - the bare NID of a DID, a NID or an alias; 1 when nothing in this repository names it,
## 2 when an alias does and more than one identity answers to it
function rad_identity_nid
{
    local value="$1" mail="" nid=""
    local -a matches=()
    case "$value" in
    did:key:*)
        printf '%s' "${value#did:key:}"
        return 0
        ;;
    esac
    if [[ "$value" == z6M* ]]; then
        printf '%s' "$value"
        return 0
    fi
    ## An alias is not unique: it is the display name two identities may both use, so the matches are
    ## counted and an ambiguous one is refused rather than resolved by the hash order of the map.
    while IFS= read -r mail; do
        [[ "$mail" == "$value@"* ]] || continue
        nid="${mail##*@}"
        case " ${matches[*]-} " in
        *" $nid "*) continue ;;
        esac
        matches+=("$nid")
    done < <(printf '%s\n' ${RAD_IDENTITY_MAIL[@]+"${!RAD_IDENTITY_MAIL[@]}"} | LC_ALL=C sort)
    if (( "${#matches[@]}" == 0 )); then
        return 1
    fi
    if (( "${#matches[@]}" > 1 )); then
        return 2
    fi
    printf '%s' "${matches[0]}"
}

## <nid> - one identity, in RAD_IDENTITY_ALIAS, _ALIAS_SOURCE, _DELEGATE, _THRESHOLD and
## _GIT_AUTHORS ('<mail>\t<name>' per line, the author lines the store carries for it)
function rad_identity_facts
{
    local nid="$1" mail="" did=""
    RAD_IDENTITY_ALIAS=""
    RAD_IDENTITY_ALIAS_SOURCE=""
    RAD_IDENTITY_DELEGATE="no"
    RAD_IDENTITY_THRESHOLD=""
    RAD_IDENTITY_GIT_AUTHORS=""
    mail="${RAD_IDENTITY_SOURCE_MAIL[$nid]:-}"
    if [[ -n "$mail" ]]; then
        RAD_IDENTITY_ALIAS="${mail%%@*}"
        RAD_IDENTITY_ALIAS_SOURCE="${RAD_IDENTITY_SOURCE[$nid]}"
        RAD_IDENTITY_GIT_AUTHORS="$(for mail in "${!RAD_IDENTITY_MAIL[@]}"; do
            [[ "$mail" == *"@$nid" ]] || continue
            printf '%s\t%s\n' "$mail" "${RAD_IDENTITY_MAIL[$mail]}"
        done | LC_ALL=C sort)"
    fi
    while IFS= read -r did; do
        [[ -n "$did" ]] || continue
        [[ "${did#did:key:}" == "$nid" ]] || continue
        RAD_IDENTITY_DELEGATE="yes"
        RAD_IDENTITY_THRESHOLD="$RAD_IDENTITY_DOC_THRESHOLD"
    done <<<"$RAD_IDENTITY_DELEGATES"
    return 0
}

## <nid> - one identity as one 'identity …' line
function rad_identity_text
{
    local nid="$1" mail="" name="" authors="" separator=""
    while IFS=$'\t' read -r mail name; do
        [[ -n "$mail" ]] || continue
        authors+="${separator}${mail}"
        separator=","
    done <<<"$RAD_IDENTITY_GIT_AUTHORS"
    printf 'identity nid=%s did=did:key:%s alias=%s delegate=%s threshold=%s identity_cob=%s alias_source=%s authors=%s\n' \
        "$nid" "$nid" "${RAD_IDENTITY_ALIAS:--}" "$RAD_IDENTITY_DELEGATE" \
        "${RAD_IDENTITY_THRESHOLD:--}" "$RAD_IDENTITY_OP" "${RAD_IDENTITY_ALIAS_SOURCE:--}" \
        "${authors:--}"
}

## <nid> - one identity as one JSON object
function rad_identity_json_identity
{
    local nid="$1" mail="" name="" authors="" alias="null" alias_source="null" object="null"
    local -a entries=()
    while IFS=$'\t' read -r mail name; do
        [[ -n "$mail" ]] || continue
        entries+=("{\"name\":$(json_string "$name"),\"email\":$(json_string "$mail")}")
    done <<<"$RAD_IDENTITY_GIT_AUTHORS"
    authors="$(json_array ${entries[@]+"${entries[@]}"})"
    [[ -n "$RAD_IDENTITY_ALIAS" ]] && alias="$(json_string "$RAD_IDENTITY_ALIAS")"
    [[ -n "$RAD_IDENTITY_ALIAS_SOURCE" ]] && alias_source="$(json_string "$RAD_IDENTITY_ALIAS_SOURCE")"
    [[ -n "$RAD_IDENTITY_OBJECT" ]] && object="$(json_string "$RAD_IDENTITY_OBJECT")"
    printf '{"nid":%s,"did":%s,"alias":%s,"alias_source":%s,"identity_cob":%s,"identity_object":%s,"git_authors":%s,"delegate":%s,"threshold":%s}\n' \
        "$(json_string "$nid")" "$(json_string "did:key:$nid")" "$alias" "$alias_source" \
        "$(json_string "$RAD_IDENTITY_OP")" "$object" "$authors" \
        "$(json_bool "$RAD_IDENTITY_DELEGATE")" "$(json_number "$RAD_IDENTITY_THRESHOLD")"
}

## - the commit answer as one JSON object, from RAD_IDENTITY_VERIFIED, _HOW, _NID, _COB, _AUTHOR_*,
## _REASON (the identity document is the same op the identity answers name)
function rad_identity_json_commit
{
    local nid="null" how="null" cob="null" reason="null" author="null"
    [[ -n "$RAD_IDENTITY_NID" ]] && nid="$(json_string "$RAD_IDENTITY_NID")"
    [[ -n "$RAD_IDENTITY_HOW" ]] && how="$(json_string "$RAD_IDENTITY_HOW")"
    [[ -n "$RAD_IDENTITY_COB" ]] && cob="$(json_string "$RAD_IDENTITY_COB")"
    [[ -n "$RAD_IDENTITY_REASON" ]] && reason="$(json_string "$RAD_IDENTITY_REASON")"
    if [[ -n "$RAD_IDENTITY_AUTHOR_MAIL" || -n "$RAD_IDENTITY_AUTHOR_NAME" ]]; then
        author="{\"name\":$(json_string "$RAD_IDENTITY_AUTHOR_NAME"),\"email\":$(json_string "$RAD_IDENTITY_AUTHOR_MAIL")}"
    fi
    printf '{"nid":%s,"verified":%s,"how":%s,"identity_cob":%s,"cob":%s,"author":%s,"reason":%s}\n' \
        "$nid" "$(json_bool "$RAD_IDENTITY_VERIFIED")" "$how" "$(json_string "$RAD_IDENTITY_OP")" \
        "$cob" "$author" "$reason"
}

## <storage> <sha> - whether that commit can be tied to an identity, in RAD_IDENTITY_VERIFIED
## ('yes'/'no'), _HOW ('identity', 'namespace' or empty), _NID, _COB, _AUTHOR_NAME/_AUTHOR_MAIL and
## _REASON; 0 verified, 1 not verified
function rad_identity_commit
{
    ## Two ways a commit is tied to an identity, and a name is neither of them: it is an op the store
    ## accepted ('identity' -- 'rad' verified the payload signature against the author's key), or it
    ## is published in that identity's namespace ('namespace' -- the node takes a ref there only from
    ## the identity that owns it).  A canonical branch authenticates nothing: it is written by the
    ## repository's delegates on behalf of the repository, so a commit which only a canonical ref
    ## reaches answers 'no' with that reason.
    local storage="$1" want="$2" sha="" ref="" ns="" mail="" name="" op_nid="" namespace_nid="" reason=""
    local in_store=""
    local -a refs=()
    RAD_IDENTITY_VERIFIED="no"
    RAD_IDENTITY_HOW=""
    RAD_IDENTITY_NID=""
    RAD_IDENTITY_COB=""
    RAD_IDENTITY_AUTHOR_MAIL=""
    RAD_IDENTITY_AUTHOR_NAME=""
    RAD_IDENTITY_REASON=""
    sha="$(git --git-dir="$storage" rev-parse --verify --quiet "$want^{commit}" 2>/dev/null)" || sha=""
    if [[ -n "$sha" ]]; then
        in_store=1
        IFS=$'\t' read -r mail name < <(git --git-dir="$storage" log -1 --format='%ae%x09%an' \
            "$sha" 2>/dev/null) || true
        while IFS= read -r ref; do
            refs+=("$ref")
        done < <(git --git-dir="$storage" for-each-ref --contains "$sha" --format='%(refname)' \
            2>/dev/null)
    elif [[ -n "${RAD_IDENTITY_TOPLEVEL:-}" ]]; then
        ## Not in the store: the author line comes from the caller's own checkout, for the reason --
        ## and it stays an unauthenticated name, which is what the answer says.
        sha="$(git -C "$RAD_IDENTITY_TOPLEVEL" rev-parse --verify --quiet "$want^{commit}" 2>/dev/null)" ||
            sha=""
        if [[ -n "$sha" ]]; then
            IFS=$'\t' read -r mail name < <(git -C "$RAD_IDENTITY_TOPLEVEL" log -1 \
                --format='%ae%x09%an' "$sha" 2>/dev/null) || true
        fi
    fi
    RAD_IDENTITY_AUTHOR_MAIL="$mail"
    RAD_IDENTITY_AUTHOR_NAME="$name"
    if [[ "$mail" == *@z6M* ]]; then
        op_nid="${mail##*@}"
    fi
    for ref in ${refs[@]+"${refs[@]}"}; do
        case "$ref" in
        refs/namespaces/*/refs/cobs/*)
            [[ -n "$op_nid" ]] || continue
            rad_identity_is_op "$storage" "$sha" || continue
            RAD_IDENTITY_HOW="identity"
            RAD_IDENTITY_NID="$op_nid"
            RAD_IDENTITY_COB="${ref##*/}"
            break
            ;;
        esac
    done
    if [[ -z "$RAD_IDENTITY_HOW" ]]; then
        for ref in ${refs[@]+"${refs[@]}"}; do
            case "$ref" in
            refs/namespaces/*/refs/rad/*) continue ;;
            refs/namespaces/*/refs/*)
                ns="${ref#refs/namespaces/}"
                ns="${ns%%/*}"
                [[ "$ns" == z6M* ]] || continue
                namespace_nid="$ns"
                break
                ;;
            esac
        done
        if [[ -n "$namespace_nid" ]]; then
            RAD_IDENTITY_HOW="namespace"
            RAD_IDENTITY_NID="$namespace_nid"
        fi
    fi
    if [[ -n "$RAD_IDENTITY_HOW" ]]; then
        RAD_IDENTITY_VERIFIED="yes"
        return 0
    fi
    if [[ -z "$in_store" ]]; then
        if [[ -n "$mail" ]]; then
            reason="the author line names $name <$mail>, but the commit is neither stored nor published: a name is not an authentication"
        else
            reason="the commit is not in the node's store and not readable in this checkout"
        fi
    elif (( "${#refs[@]}" == 0 )); then
        reason="the commit is in the node's store, but no ref reaches it"
    else
        reason="no identity's namespace reaches the commit (a canonical branch is the repository's, not an identity's)"
    fi
    RAD_IDENTITY_REASON="$reason"
    return 1
}

function rad_identity ## --repo <rid|path> [--did <did|nid|alias>] [--commit <sha>] [--json] - the identities this repository delegates to, and whether a commit can be tied to one
{
    local -a args=()
    local raw="" arg="" value="" json="" repo="" did="" commit="" nid="" line=""
    local -i count=0 i=0 rc=0
    local -a wanted=()
    declare -gA RAD_IDENTITY_MAIL=()
    declare -gA RAD_IDENTITY_SOURCE=()
    declare -gA RAD_IDENTITY_SOURCE_MAIL=()

    for raw in "$@"; do
        args+=("$raw")
    done
    count=${#args[@]}
    while (( i < count )); do
        arg="${args[i]}"
        i=$(( i + 1 ))
        case "$arg" in
        -h | --help)
            help_usage rad_identity
            return 0
            ;;
        --json) json=1 ;;
        --repo | --did | --commit)
            if (( i >= count )) || [[ -z "${args[i]}" ]]; then
                help_usage_error rad_identity "'$arg' needs a non-empty value"
                return 2
            fi
            value="${args[i]}"
            i=$(( i + 1 ))
            case "$arg" in
            --repo) repo="$value" ;;
            --did) did="$value" ;;
            --commit) commit="$value" ;;
            esac
            ;;
        --) break ;;
        -*) help_usage_error rad_identity "unknown option '$arg'"; return 2 ;;
        *) help_usage_error rad_identity "unexpected argument '$arg'"; return 2 ;;
        esac
    done
    if [[ -n "$did" && -n "$commit" ]]; then
        help_usage_error rad_identity "'--did' and '--commit' ask different questions"
        return 2
    fi
    rad_identity_store "$repo" || return $?
    if ! rad_identity_doc "$RAD_IDENTITY_STORAGE"; then
        error "the node holds no identity document for '$RAD_IDENTITY_RID'"
        return 3
    fi
    if [[ -n "$commit" ]]; then
        rad_identity_commit "$RAD_IDENTITY_STORAGE" "$commit" || rc=1
        if [[ -n "$json" ]]; then
            rad_identity_json_commit
        else
            printf 'commit nid=%s verified=%s how=%s identity_cob=%s cob=%s author=%s reason=%s\n' \
                "${RAD_IDENTITY_NID:--}" "$RAD_IDENTITY_VERIFIED" "${RAD_IDENTITY_HOW:--}" \
                "$RAD_IDENTITY_OP" "${RAD_IDENTITY_COB:--}" "${RAD_IDENTITY_AUTHOR_MAIL:--}" \
                "${RAD_IDENTITY_REASON:--}"
        fi
        return $rc
    fi
    rad_identity_authors "$RAD_IDENTITY_STORAGE"
    if [[ -n "$did" ]]; then
        rc=0
        nid="$(rad_identity_nid "$did")" || rc=$?
        if (( rc == 2 )); then
            error "'$did' is the alias of more than one identity of '$RAD_IDENTITY_RID'; name it by DID or NID"
            return 2
        fi
        if (( rc != 0 )); then
            error "'$did' names no identity of '$RAD_IDENTITY_RID'"
            return 3
        fi
        rad_identity_facts "$nid"
        if [[ "$RAD_IDENTITY_DELEGATE" == no && -z "$RAD_IDENTITY_ALIAS" ]]; then
            error "'$did' names no identity of '$RAD_IDENTITY_RID'"
            return 3
        fi
        wanted=("$nid")
    else
        while IFS= read -r line; do
            [[ -n "$line" ]] || continue
            wanted+=("${line#did:key:}")
        done <<<"$RAD_IDENTITY_DELEGATES"
        if (( "${#wanted[@]}" == 0 )); then
            error "'$RAD_IDENTITY_RID' delegates to nobody"
            return 3
        fi
    fi
    for nid in "${wanted[@]}"; do
        rad_identity_facts "$nid"
        if [[ -n "$json" ]]; then
            rad_identity_json_identity "$nid"
        else
            rad_identity_text "$nid"
        fi
    done
    return 0
}

# --- rad_comment_metadata: the metadata a comment carries --------------------------------------

## One record per marker line, oldest first:
##   '<epoch>US<iso>US<type>US<id>US<op>US<alias>US<did>US<mark>US<value>'
## and the same for the entries which survived the trust filter.  For the '--json' form they are
## unpacked again, which is why the shape is fixed here and used nowhere else.
declare -ga RAD_COMMENT_METADATA=()
declare -ga RAD_COMMENT_METADATA_TRUSTED=()
declare -gA RAD_COMMENT_METADATA_AUTHORED=()  ## '<rid>|<nid>' -> the commits that identity authored
declare -g RAD_METADATA_AUTHORED_VALUE=""      ## what 'rad_metadata_authored' hands back
declare -ga RAD_COMMENT_METADATA_ASSIGNEES=()   ## the current assignees of the item asked about
declare -g RAD_COMMENT_METADATA_QUERY=""
declare -g RAD_COMMENT_METADATA_RID=""

function rad_metadata_nid ## <did-or-nid> - the bare NID of an identity
{
    ## 'did:key:z6Mk…', 'did:z6Mk…' and a bare NID all mean the same identity; 'rad' prints the
    ## first form and a human types any of them.
    local value="$1"
    value="${value#did:key:}"
    value="${value#did:}"
    printf '%s' "$value"
}

function rad_metadata_mail_nid ## <mail> - the NID 'rad' writes into a COB op's author mail
{
    ## A COB op is authored as '<alias>@<nid>' (measured: 'cehteh@z6MksaJk…'), so the *actor* of an
    ## op travels in that mail.  The namespace the op was read from does not identify it: one COB's
    ## chain is replicated into every namespace which holds it, byte for byte the same commits.
    local mail="${1##*@}"
    if [[ "$mail" == z6M* ]]; then
        printf '%s' "$mail"
    fi
    return 0
}

function rad_metadata_marks ## <body> - the marker lines at the very start of <body>
{
    ## One '<key>US<value>' record per line of the block.  A marker is '*<key>:<value>' with the key
    ## a word of letters, digits, '_' and '-', starting with a letter -- the '<key>:<value>' header
    ## form and no fixed vocabulary: what a key *means* is the caller's business (this reads any key
    ## back, and only the keys with a registered effect are ever applied).  The block starts at the
    ## comment and ends at the first line which is not a marker: a marker quoted inside a reply is
    ## prose, not a proposal.
    ##
    ## A value runs to the **end of the line** and may contain spaces -- what a value may hold is the
    ## business of the directive that owns the key (a label follows radicle's rules, which is what
    ## 'rad_label_name' is for; a trigger takes one of four words), so this reader hands the line out
    ## as it is instead of deciding for its callers.  Only the surrounding whitespace is trimmed: an
    ## empty value is no proposal and the block goes on, exactly like any other line.
    local body="$1" line rest key value
    while IFS= read -r line; do
        [[ "$line" == '*'* ]] || break
        rest="${line#\*}"
        [[ "$rest" == *:* ]] || break
        key="${rest%%:*}"
        [[ "$key" =~ ^[A-Za-z][A-Za-z0-9_-]*$ ]] || break
        value="${rest#*:}"
        value="${value#"${value%%[![:space:]]*}"}"
        value="${value%"${value##*[![:space:]]}"}"
        [[ -n "$value" ]] || continue
        printf '%s%s%s\n' "$key" "$RAD_US" "$value"
    done <<<"$body"
}

function rad_label_name ## <value> - the label a proposal's value names
{
    ## Radicle's own rule, applied where it belongs: what a label *is* is the applier's business, so
    ## the reader hands the line out whole and the label effect normalises the value.  A label is a
    ## non-empty string **without whitespace** (the store's 'Label::new': no length limit, no other
    ## rejection), and radicle writes a space as a '-', which is why a value carrying one is written
    ## the same way here -- each run of whitespace becomes one '-'.  So '*label:two words' proposes
    ## 'two-words', the label a writer composing that directive is told to emit in the first place.
    local value="${1:-}" out="" word
    for word in $value; do
        [[ -n "$out" ]] && out+="-"
        out+="$word"
    done
    printf '%s\n' "$out"
}

function rad_metadata_authored ## <rid> <nid> - the commits that identity authored, '-' when unknown
{
    ## Asked once per identity and remembered, so several thresholds cost one lookup.
    ##
    ## Counted is only what that identity authored *as itself* ('<alias>@<nid>'): the gate has to
    ## resolve into a radicle identity, and commits of plain git authors carry no radicle identity
    ## and are therefore dropped.  That is why 'commits_as_identity' is read and not the wider
    ## 'total_authored' -- an identity the command cannot resolve stays '-' and is not trusted.
    local rid="$1" nid="$2"
    local key="$rid|$nid"
    if [[ -n "${RAD_COMMENT_METADATA_AUTHORED[$key]+set}" ]]; then
        RAD_METADATA_AUTHORED_VALUE="${RAD_COMMENT_METADATA_AUTHORED[$key]}"
        return 0
    fi
    ## 'RAD_TRUST_CMD' is provided by the deployment (a command and its arguments, e.g.
    ## 'please rad_trust'): where the facts about an identity come from is not this module's
    ## business, and a home directory path does not belong into a vendored source file.
    local -a cmd=()
    local facts="" authored="-"
    read -r -a cmd <<<"${RAD_TRUST_CMD:-}"
    if (( ${#cmd[@]} )) && facts="$("${cmd[@]}" --repo "$rid" --author "$nid" 2>/dev/null)"; then
        authored="$(printf '%s' "$facts" | jq -r '(.author.commits_as_identity // "-") | tostring' 2>/dev/null)" || authored="-"
    fi
    [[ -n "$authored" ]] || authored="-"
    if [[ "$authored" == "-" ]] && (( ${#cmd[@]} )); then
        ## An identity whose count cannot be read is not trusted -- say so, else a broken facts
        ## command looks exactly like a contributor who is below the threshold.
        warn "'${cmd[*]}' answered no identity-authored commits for '$nid'"
    fi
    RAD_COMMENT_METADATA_AUTHORED[$key]="$authored"
    RAD_METADATA_AUTHORED_VALUE="$authored"
    return 0
}

## The trust table of one 'rad_comment_metadata' run.  'Who is trusted' is one question with one
## answer: the forward read and the '--last' walk both have to ask it, and a caller must not be able
## to get a different verdict out of the two paths.  Set up once per run, read by 'rad_metadata_trust'.
declare -gA RAD_COMMENT_METADATA_DELEGATES=()
declare -gA RAD_COMMENT_METADATA_NAMED=()
declare -gA RAD_COMMENT_METADATA_ASSIGNED=()
declare -ga RAD_COMMENT_METADATA_THRESHOLDS=()
declare -g RAD_METADATA_TRUST=""

function rad_metadata_trust ## <rid> <nid> - the verdict for one identity, in 'RAD_METADATA_TRUST'
{
    ## Empty when the identity is not trusted: a delegate, an identity named with '--trust did:…',
    ## one of the item's assignees, or an identity whose authored commits reach one of the
    ## 'contributor(<n>)' thresholds.  An identity which is not of the radicle system at all ('z6M…')
    ## is never trusted -- there is nothing to authenticate such an op against.
    local rid="$1" mdid="$2" authored n
    RAD_METADATA_TRUST=""
    [[ "$mdid" == z6M* ]] || return 0
    if [[ -n "${RAD_COMMENT_METADATA_DELEGATES[$mdid]:-}" ]]; then
        RAD_METADATA_TRUST=delegate
    elif [[ -n "${RAD_COMMENT_METADATA_NAMED[$mdid]:-}" ]]; then
        RAD_METADATA_TRUST=named
    elif [[ -n "${RAD_COMMENT_METADATA_ASSIGNED[$mdid]:-}" ]]; then
        RAD_METADATA_TRUST=assignee
    else
        rad_metadata_authored "$rid" "$mdid"
        authored="$RAD_METADATA_AUTHORED_VALUE"
        if [[ "$authored" =~ ^[0-9]+$ ]]; then
            for n in ${RAD_COMMENT_METADATA_THRESHOLDS[@]+"${RAD_COMMENT_METADATA_THRESHOLDS[@]}"}; do
                if (( authored >= n )); then
                    RAD_METADATA_TRUST="contributor($n)"
                    break
                fi
            done
        fi
    fi
    return 0
}

function rad_metadata_body ## <storage> <op> <type> <subject> - the body of one op of that COB
{
    ## Only the op kinds which can carry a body are opened ('Comment', 'Edit comment', 'Create
    ## issue', 'Edit root'), and the payload is the blob 'rad' names '0'.  An op of another COB can
    ## stand in this chain (rad chains a COB onto the identity commits), so the op has to declare the
    ## type the ref carries -- else a foreign comment would be reported against this item.
    ##
    ## Returns 1 when this op carries no body of that type; the caller skips it either way.
    local storage="$1" op="$2" type="$3" subject="$4"
    local body manifest optype
    case "$subject" in
    Comment | 'Edit comment' | 'Create issue' | 'Edit root') ;;
    *) return 1 ;;
    esac
    body="$(git --git-dir="$storage" show "$op:0" 2>/dev/null | jq -r '.body // empty' 2>/dev/null)" || body=""
    [[ -n "$body" ]] || return 1
    manifest="$(git --git-dir="$storage" show "$op:manifest" 2>/dev/null)" || manifest=""
    if [[ -n "$manifest" ]]; then
        optype="$(printf '%s' "$manifest" | jq -r '.typeName // empty' 2>/dev/null)" || optype=""
        if [[ -n "$optype" && "$optype" != "xyz.radicle.$type" ]]; then
            return 1
        fi
    fi
    printf '%s' "$body"
}

function rad_comment_metadata_ref ## <storage> <item> - the one COB the item names
{
    ## The ref listing is a single call and it is what says which COB the id names.  A COB lives in
    ## every namespace which replicated it, so it is keyed by type and id and only the newest tip is
    ## kept -- else every op would be read once per copy.
    ##
    ## Sets RAD_COMMENT_METADATA_REF/_TYPE/_ID.  Returns 3 when the node holds no such issue or
    ## patch, 2 when the id matches more than one.
    local storage="$1" item="$2"
    local epoch ref type id key
    local -A newest_ref=()
    RAD_COMMENT_METADATA_REF=""
    RAD_COMMENT_METADATA_TYPE=""
    RAD_COMMENT_METADATA_ID=""
    while IFS="$RAD_RS" read -r epoch ref; do
        [[ -n "$ref" ]] || continue
        type="${ref#*refs/cobs/xyz.radicle.}"; type="${type%%/*}"
        id="${ref##*/}"
        [[ "$id" == "$item"* ]] || continue
        key="$type:$id"
        [[ -n "${newest_ref[$key]:-}" ]] && continue
        newest_ref[$key]="$ref"
    done < <(git --git-dir="$storage" for-each-ref --sort=-committerdate \
        --format="%(committerdate:unix)${RAD_RS}%(refname)" \
        'refs/namespaces/*/refs/cobs/xyz.radicle.issue/*' \
        'refs/namespaces/*/refs/cobs/xyz.radicle.patch/*' 2>/dev/null)

    (( ${#newest_ref[@]} )) || return 3
    (( ${#newest_ref[@]} == 1 )) || return 2      ## an issue and a patch share the prefix

    for key in "${!newest_ref[@]}"; do
        RAD_COMMENT_METADATA_REF="${newest_ref[$key]}"
        RAD_COMMENT_METADATA_TYPE="${key%%:*}"
        RAD_COMMENT_METADATA_ID="${key#*:}"
    done
    return 0
}

function rad_comment_metadata_assignees ## <storage> <ref> - the item's current assignees
{
    ## The newest 'assign' op of the chain carries the whole set (a radicle op is the new value of
    ## its field), so the walk stops at the first one -- walking backwards from the tip is what makes
    ## that one read, not one read per op.  Only identities of the radicle system count here: an
    ## assignee which is not a DID/NID is dropped like any other entry without identity.
    local storage="$1" ref="$2" op payload did
    RAD_COMMENT_METADATA_ASSIGNEES=()
    while IFS= read -r op; do
        [[ -n "$op" ]] || continue
        payload="$(git --git-dir="$storage" show "$op:0" 2>/dev/null)" || continue
        [[ "$payload" == *'"type":"assign"'* ]] || continue
        while IFS= read -r did; do
            did="$(rad_metadata_nid "$did")"
            [[ "$did" == z6M* ]] || continue
            RAD_COMMENT_METADATA_ASSIGNEES+=( "$did" )
        done < <(printf '%s' "$payload" | jq -r '.assignees[]? // empty' 2>/dev/null)
        break
    done < <(git --git-dir="$storage" log --format=%H "$ref" 2>/dev/null)
    return 0
}

function rad_comment_metadata_collect ## <storage> <ref> <type> <id> - the marker lines of one item
{
    ## Reads the chain of the one item the ref names -- never the whole repository: the ops and their
    ## payloads are opened for that COB alone ('rad_comment_metadata_ref' is what resolved which one
    ## it is).  Answers oldest first, and inside one second in chain order: the records are laid down
    ## in the order the chain is walked and the sort keeps that order (see below).
    local storage="$1" ref="$2" type="$3" id="$4"
    local op mail iso epoch subject body key value
    local -A newest_ref=()

    RAD_COMMENT_METADATA=()
    while IFS="$RAD_RS" read -r op mail iso epoch subject; do
        body="$(rad_metadata_body "$storage" "$op" "$type" "$subject")" || continue
        while IFS="$RAD_US" read -r key value; do
            [[ -n "$key" && -n "$value" ]] || continue
            RAD_COMMENT_METADATA+=( "$epoch${RAD_US}$iso${RAD_US}$type${RAD_US}${id:0:7}${RAD_US}$op${RAD_US}${mail%%@*}${RAD_US}$(rad_metadata_mail_nid "$mail")${RAD_US}$key${RAD_US}$value" )
        done < <(rad_metadata_marks "$body")
    done < <(git --git-dir="$storage" log --reverse --topo-order \
        --format="%H${RAD_RS}%ae${RAD_RS}%aI${RAD_RS}%at${RAD_RS}%s" "$ref" 2>/dev/null)

    ## Chronological, and inside one second in *chain order*: the records were laid down as the chain
    ## was walked (parent first), so a stable sort on the epoch keeps two markers written in the same
    ## second in the order they were written.  The op sha is deliberately *not* a tie break -- it
    ## would order a pair by hash, and '--last' would point at the wrong one of the two.
    if (( ${#RAD_COMMENT_METADATA[@]} > 1 )); then
        local sorted
        sorted="$(printf '%s\n' "${RAD_COMMENT_METADATA[@]}" |
            LC_ALL=C sort -s -t"$RAD_US" -k1,1n)" || sorted=""
        RAD_COMMENT_METADATA=()
        while IFS= read -r line; do
            [[ -n "$line" ]] && RAD_COMMENT_METADATA+=( "$line" )
        done <<<"$sorted"
    fi
}

function rad_comment_metadata_newest ## <storage> <rid> <ref> <type> <id> <key>.. - the newest block per key
{
    ## The '--last' walk: newest op first, and it stops as soon as every requested key has its newest
    ## *trusted* entry -- so the common case opens one payload instead of the whole chain.  The walk
    ## skips a marker whose author is not attributable, and that is not a stopper: an older trusted
    ## block still applies, else one comment by a passer-by would freeze an item's state.
    ##
    ## 'The newest block carrying that key, taken whole' is meant per key: every line of a key it
    ## found is returned (a comment proposing two labels is one application), and a key nobody asked
    ## for is left alone.  No <key> at all asks for *every* key, which is what the forward read
    ## answers; then the walk cannot stop early, because a key may first appear anywhere in the chain.
    ##
    ## Answers in the shape the forward read answers in -- oldest first, one
    ## '<epoch>US<iso>US<type>US<id>US<op>US<alias>US<did>US<trust>US<key>US<value>' per line.
    local storage="$1" rid="$2" ref="$3" type="$4" id="$5"
    shift 5
    local -a wanted=( "$@" ) chain=() order=() lines=()
    local all=""
    local -A is_wanted=() have=() chosen=() answered=()
    local -i left=${#wanted[@]} n i
    local key want line op mail iso epoch subject body mdid trust

    if (( ${#wanted[@]} == 0 )); then
        all=1
    else
        for key in "${wanted[@]}"; do
            is_wanted["$key"]=1
        done
    fi

    while IFS="$RAD_RS" read -r op mail iso epoch subject; do
        [[ -n "$op" ]] || continue
        chain+=( "$op${RAD_US}$mail${RAD_US}$iso${RAD_US}$epoch${RAD_US}$subject" )
    done < <(git --git-dir="$storage" log --reverse --topo-order \
        --format="%H${RAD_RS}%ae${RAD_RS}%aI${RAD_RS}%at${RAD_RS}%s" "$ref" 2>/dev/null)

    ## Walked in the order the forward read *ends* in -- newest epoch first, and inside one second the
    ## chain's last position -- so 'the newest block' is the last record of that answer and not merely
    ## the tip of the chain.  A chain whose dates are not monotone (an op replayed with an older
    ## clock) would otherwise let the two paths point at different records.
    while IFS= read -r n; do
        [[ -n "$n" ]] && order+=( "$n" )
    done < <(
        for (( i = 0; i < ${#chain[@]}; i++ )); do
            IFS="$RAD_US" read -r _ _ _ epoch _ <<<"${chain[i]}"
            printf '%s%s%s\n' "$epoch" "$RAD_US" "$i"
        done | LC_ALL=C sort -t"$RAD_US" -k1,1nr -k2,2nr | cut -d"$RAD_US" -f2
    )

    for n in ${order[@]+"${order[@]}"}; do
        (( left > 0 )) || [[ -n "$all" ]] || break
        IFS="$RAD_US" read -r op mail iso epoch subject <<<"${chain[n]}"
        body="$(rad_metadata_body "$storage" "$op" "$type" "$subject")" || continue
        mdid="$(rad_metadata_mail_nid "$mail")"
        rad_metadata_trust "$rid" "$mdid"
        trust="$RAD_METADATA_TRUST"
        [[ -n "$trust" ]] || continue
        ## The markers of this op.  A key nobody has answered yet is answered by this op -- with
        ## every line of the key it carries, so a comment proposing two labels is one application --
        ## and a key a *newer* op already answered is not answered again here.
        lines=() answered=()
        while IFS="$RAD_US" read -r key want; do
            [[ -n "$key" && -n "$want" ]] || continue
            [[ -z "$all" && -z "${is_wanted[$key]:-}" ]] && continue
            lines+=( "$key${RAD_US}$want" )
            [[ -n "${have[$key]:-}" ]] && continue
            have["$key"]=1
            answered["$key"]=1
            [[ -z "${is_wanted[$key]:-}" ]] || left=$(( left - 1 ))
        done < <(rad_metadata_marks "$body")
        (( ${#answered[@]} )) || continue
        for line in ${lines[@]+"${lines[@]}"}; do
            key="${line%%"$RAD_US"*}"
            [[ -n "${answered[$key]:-}" ]] || continue
            chosen["$n"]+="$epoch${RAD_US}$iso${RAD_US}$type${RAD_US}${id:0:7}${RAD_US}$op${RAD_US}${mail%%@*}${RAD_US}$mdid${RAD_US}$trust${RAD_US}$key${RAD_US}${line#*"$RAD_US"}"$'\n'
        done
    done

    ## Oldest first, like the forward read: the chain position decides the order, never the date --
    ## an add and its undo land in the same second routinely (the walk above is newest first).
    for (( i = ${#order[@]} - 1; i >= 0; i-- )); do
        n="${order[i]}"
        printf '%s' "${chosen["$n"]:-}"
    done
    return 0
}

function rad_comment_metadata_json ## - the whole answer as one object
{
    ## Complete, never elided: the entries the filter kept, oldest first.
    local entry epoch iso type id op alias did trust key value first=""
    local -a entries=()
    if (( ${#RAD_COMMENT_METADATA_TRUSTED[@]} )); then
        while IFS="$RAD_US" read -r epoch iso type id op alias did trust key value; do
            [[ -n "$value" ]] || continue
            entries+=( "{\"item\":$(json_string "$type"),\"key\":$(json_string "$key"),\"id\":$(json_string "$id"),\"op\":$(json_string "$op"),\"author\":$(json_string "$alias"),\"did\":$(json_string "did:key:$did"),\"trust\":$(json_string "$trust"),\"date\":$(json_string "$iso"),\"value\":$(json_string "$value")}" )
        done <<<"$(printf '%s\n' "${RAD_COMMENT_METADATA_TRUSTED[@]}")"
    fi
    for entry in "${entries[@]}"; do
        first+="${first:+,}$entry"
    done
    ## The assignees belong into the answer: they are one of the reasons an entry is trusted, and a
    ## caller which sees a surprise wants to know where the trust came from.  Identities travel in
    ## the form the radicle tools want ('rad issue assign --add <DID>'), the same one the text
    ## output prints: a consumer must never have to re-normalize them.
    local assignees=""
    for did in ${RAD_COMMENT_METADATA_ASSIGNEES[@]+"${RAD_COMMENT_METADATA_ASSIGNEES[@]}"}; do
        assignees+="${assignees:+,}$(json_string "did:key:$did")"
    done
    printf '{"bar_rad":1,"query":%s,"repo":%s,"count":%s,"assignees":[%s],"entries":[%s]}\n' \
        "$(json_string "$RAD_COMMENT_METADATA_QUERY")" "$(json_string "$RAD_COMMENT_METADATA_RID")" \
        "$(json_number "${#entries[@]}")" "$assignees" "$first"
}

## <name> <rid|path> - the repository and the node storage of it, in the 'RAD_METADATA_*' variables
function rad_metadata_store
{
    ## Which repository: an explicit one (RID, or a path entered to ask that checkout), else the one
    ## this runs in.  Sets 'RAD_METADATA_RID' and 'RAD_METADATA_STORAGE'.  '<name>' is the caller,
    ## only for its diagnostics -- 'not a repository here' and 'the node holds no storage' are not
    ## the same answer for the operator, and neither is a usage error.
    local name="$1" repo="$2"
    local toplevel="" rid="" radpath="" storage="" self=""
    if [[ -n "$repo" && "$repo" != rad:* ]]; then
        if ! toplevel="$(cd "$repo" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null)"; then
            error "not a git repository: '$repo' is neither a RID nor a checkout"
            return 3
        fi
    elif [[ -z "$repo" ]]; then
        if ! toplevel="$(git rev-parse --show-toplevel 2>/dev/null)"; then
            error "not a git repository: 'bar $name' reads the checkout it runs in"
            return 3
        fi
    fi
    if [[ -n "$toplevel" ]]; then
        rid="$(cd "$toplevel" && rad_run inspect --rid)" || return $?
        rid="${rid##*$'\n'}"
    else
        rid="$repo"
    fi
    radpath="$(rad_path)" || radpath=""
    storage="$radpath/storage/${rid#rad:}"
    if [[ -z "$radpath" || ! -d "$storage" ]]; then
        error "the node holds no storage for '$rid': '${RAD_BIN} path' says '${radpath:--}'"
        return 3
    fi
    RAD_METADATA_RID="$rid"
    RAD_METADATA_STORAGE="$storage"
    return 0
}

function rad_comment_metadata ## <item> [--query <label|rmlabel|assign|unassign>].. [--repo <rid|path>] [--trust <spec>].. [--last] [--json] - the trusted proposals an item's comments carry
{
    local -a args=() specs=() parts=() queries=()
    local raw arg value json="" repo="" last="" item="" item_rc=0
    local toplevel="" rid="" radpath="" storage="" delegates="" line did spec key
    local epoch iso type id op alias mdid trust n
    local -a trusted=()
    local -i i=0

    for raw in "$@"; do
        if [[ "$raw" == --*=* ]]; then
            args+=("${raw%%=*}" "${raw#*=}")
        else
            args+=("$raw")
        fi
    done
    local -i count=${#args[@]}
    i=0
    while (( i < count )); do
        arg="${args[i]}"
        i=$(( i + 1 ))
        case "$arg" in
        -h | --help)
            help_usage rad_comment_metadata
            return 0
            ;;
        --json) json=1 ;;
        --last) last=1 ;;
        --query | --repo | --trust)
            if (( i >= count )) || [[ -z "${args[i]}" ]]; then
                help_usage_error rad_comment_metadata "'$arg' needs a non-empty value"
                return 2
            fi
            value="${args[i]}"
            i=$(( i + 1 ))
            case "$arg" in
            --query)
                if [[ ! "$value" =~ ^[A-Za-z][A-Za-z0-9_-]*$ ]]; then
                    help_usage_error rad_comment_metadata "invalid --query '$value': a key is a word of letters, digits, '_' and '-'"
                    return 2
                fi
                queries+=( "$value" )
                ;;
            --repo) repo="$value" ;;
            --trust)
                local part
                IFS=',' read -r -a parts <<<"$value"
                for part in "${parts[@]}"; do
                    [[ -n "$part" ]] && specs+=( "$part" )
                done
                ;;
            esac
            ;;
        -*)
            help_usage_error rad_comment_metadata "unknown argument '$arg'"
            return 2
            ;;
        *)
            ## the one item the question is about (the only positional argument there is)
            if [[ -n "$item" ]]; then
                help_usage_error rad_comment_metadata "only one item can be asked about (got '$item' and '$arg')"
                return 2
            fi
            item="$arg"
            ;;
        esac
    done

    [[ -n "${BAR_AGENT_JSON:-}" ]] && json=1
    if [[ -z "$item" ]]; then
        help_usage_error rad_comment_metadata "the item is required: an issue or patch id, short or full"
        return 2
    fi
    if ! command -v jq >/dev/null 2>&1; then
        printf 'rad_comment_metadata: jq is required to read the op payloads\n' >&2
        return 2
    fi

    ## The trust specs are validated before anything is read: a usage error is not worth a node
    ## lookup, and it has to be reported the same way whether or not the node holds the repository.
    for spec in "${specs[@]}"; do
        case "$spec" in
        did:*) ;;
        'contributor('*')')
            n="${spec#'contributor('}"; n="${n%')'}"
            if [[ ! "$n" =~ ^[0-9]+$ ]]; then
                help_usage_error rad_comment_metadata "invalid trust spec 'contributor($n)', want a number"
                return 2
            fi
            ;;
        *)
            help_usage_error rad_comment_metadata "unknown trust spec '$spec', want did:<did|nid> or contributor(<n>)"
            return 2
            ;;
        esac
    done

    ## 'rad' first: without it nothing can be resolved, and "the node holds no storage" would be
    ## the wrong answer for the operator to chase.
    is_command_installed "$RAD_BIN" || {
        error "'$RAD_BIN' is not installed"
        return 1
    }

    ## Which repository: an explicit one (RID or path), else the checkout this runs in.
    rad_metadata_store rad_comment_metadata "$repo" || return $?
    rid="$RAD_METADATA_RID"
    storage="$RAD_METADATA_STORAGE"

    ## Who is trusted: the delegates answer from the identity document, 'did:' names one identity and
    ## 'contributor(<n>)' is decided from the authored commits the fact tool counts.  The table is
    ## module state, because the '--last' walk asks the same question from its own loop.
    RAD_COMMENT_METADATA_DELEGATES=()
    RAD_COMMENT_METADATA_NAMED=()
    RAD_COMMENT_METADATA_ASSIGNED=()
    RAD_COMMENT_METADATA_THRESHOLDS=()
    delegates="$(rad_run inspect "$rid" --delegates)" || return $?
    while IFS= read -r line; do
        did="${line%% *}"
        [[ -n "$did" ]] || continue
        RAD_COMMENT_METADATA_DELEGATES["$(rad_metadata_nid "$did")"]=1
    done <<<"$delegates"

    for spec in "${specs[@]}"; do
        case "$spec" in
        did:*) RAD_COMMENT_METADATA_NAMED["$(rad_metadata_nid "$spec")"]=1 ;;
        'contributor('*')')
            n="${spec#'contributor('}"; n="${n%')'}"
            RAD_COMMENT_METADATA_THRESHOLDS+=( "$n" )
            ;;
        esac
    done

    ## An asked-for contributor threshold needs the facts command: without it every count reads
    ## 'unknown', which would answer 'nothing is trusted' where the operator asked for trust.
    if (( ${#RAD_COMMENT_METADATA_THRESHOLDS[@]} )) && [[ -z "${RAD_TRUST_CMD:-}" ]]; then
        help_usage_error rad_comment_metadata "'--trust contributor(<n>)' needs RAD_TRUST_CMD: the command which answers the authored commits"
        return 2
    fi

    rad_comment_metadata_ref "$storage" "$item"
    item_rc=$?
    if (( item_rc != 0 )); then
        case "$item_rc" in
        2)
            help_usage_error rad_comment_metadata "'$item' matches more than one issue or patch, use more characters"
            return 2
            ;;
        *)
            error "the node holds no issue or patch '$item' in '$rid'"
            return 3
            ;;
        esac
    fi
    rad_comment_metadata_assignees "$storage" "$RAD_COMMENT_METADATA_REF"

    ## The item's assignees are a trust source of their own: assigning an issue to a contributor
    ## makes that contributor's proposals count -- so the same query can answer differently before
    ## and after an assignment.  That is the design: trust is read when it is asked for, never
    ## stored, and it is always an identity of the radicle system ('z6M…') which carries it.
    for did in ${RAD_COMMENT_METADATA_ASSIGNEES[@]+"${RAD_COMMENT_METADATA_ASSIGNEES[@]}"}; do
        RAD_COMMENT_METADATA_ASSIGNED["$did"]=1
    done

    RAD_COMMENT_METADATA_QUERY="${queries[*]}"
    RAD_COMMENT_METADATA_RID="$rid"
    RAD_COMMENT_METADATA_TRUSTED=()
    if [[ -n "$last" ]]; then
        ## '--last' is the newest block *per key* and it is answered from the tip of the chain
        ## backwards: what applies is known without reading what it superseded.
        while IFS="$RAD_US" read -r epoch iso type id op alias mdid trust key value; do
            [[ -n "$value" ]] || continue
            trusted+=( "$epoch${RAD_US}$iso${RAD_US}$type${RAD_US}$id${RAD_US}$op${RAD_US}$alias${RAD_US}$mdid${RAD_US}$trust${RAD_US}$key${RAD_US}$value" )
        done < <(rad_comment_metadata_newest "$storage" "$rid" "$RAD_COMMENT_METADATA_REF" \
            "$RAD_COMMENT_METADATA_TYPE" "$RAD_COMMENT_METADATA_ID" ${queries[@]+"${queries[@]}"})
    else
        rad_comment_metadata_collect "$storage" "$RAD_COMMENT_METADATA_REF" \
            "$RAD_COMMENT_METADATA_TYPE" "$RAD_COMMENT_METADATA_ID"
        while IFS="$RAD_US" read -r epoch iso type id op alias mdid key value; do
            [[ -n "$value" ]] || continue
            (( ${#queries[@]} == 0 )) || [[ " ${queries[*]} " == *" $key "* ]] || continue
            ## No radicle identity in the op's author (a git-only author, or a mail which is not
            ## '<alias>@<nid>'): there is nothing to authenticate against, so the proposal is dropped
            ## -- silently, like every other proposal which is not trusted.
            rad_metadata_trust "$rid" "$mdid"
            trust="$RAD_METADATA_TRUST"
            [[ -n "$trust" ]] || continue
            trusted+=( "$epoch${RAD_US}$iso${RAD_US}$type${RAD_US}$id${RAD_US}$op${RAD_US}$alias${RAD_US}$mdid${RAD_US}$trust${RAD_US}$key${RAD_US}$value" )
        done <<<"$(printf '%s\n' "${RAD_COMMENT_METADATA[@]:-}")"
    fi
    RAD_COMMENT_METADATA_TRUSTED=( ${trusted[@]+"${trusted[@]}"} )

    if [[ -n "$json" ]]; then
        rad_comment_metadata_json
        return 0
    fi
    (( ${#trusted[@]} )) || return 0      ## nothing trusted is an answer, not a failure
    for line in "${trusted[@]}"; do
        IFS="$RAD_US" read -r epoch iso type id op alias mdid trust key value <<<"$line"
        printf '%s item=%s:%s author=%s did=did:key:%s trust=%s date=%s value=%s\n' \
            "$key" "$type" "$id" "$alias" "$mdid" "$trust" "$iso" "$value"
    done
}

# --- the write layer: one function per effect, each one 'rad' invocation -----------------------

function rad_metadata_rad ## <repo> <args>.. - one 'rad' invocation, in the repository the caller means
{
    ## Every applier below does exactly one invocation of 'rad' and this is where it runs: an empty
    ## <repo> is the checkout the command runs in, a path is entered, a RID is handed to rad with
    ## '-r' (rad then needs no checkout at all).  Nothing is written anywhere else and there is no
    ## second write: an applier either makes its one call or it refuses.
    local repo="$1"
    shift
    if [[ -z "$repo" ]]; then
        rad_run "$@"
    elif [[ "$repo" == rad:* ]]; then
        rad_run "$@" -r "$repo"
    else
        ( cd "$repo" 2>/dev/null && rad_run "$@" )
    fi
}

function rad_metadata_identity ## <repo> <did|alias> - the DID the write commands take
{
    ## A comment cannot be trusted to spell a DID right, so an alias is resolved before it is written
    ## -- by the same fact command the trust gate asks ('RAD_TRUST_CMD', the tool behind 'rad_trust'),
    ## for the repository the caller names (or this checkout).  A value which is already a DID/NID
    ## needs no command; one which resolves to nothing is refused rather than written as it stands.
    local repo="$1" value="$2"
    local -a cmd=()
    local nid="" facts=""
    nid="$(rad_metadata_nid "$value")"
    if [[ "$nid" == z6M* ]]; then
        printf 'did:key:%s' "$nid"
        return 0
    fi
    read -r -a cmd <<<"${RAD_TRUST_CMD:-}"
    if (( ${#cmd[@]} )) && facts="$("${cmd[@]}" --repo "${repo:-$PWD}" --author "$value" 2>/dev/null)"; then
        nid="$(printf '%s' "$facts" | jq -r '(.author.nid // .author.did // "") | tostring' 2>/dev/null)" || nid=""
        nid="$(rad_metadata_nid "$nid")"
        if [[ "$nid" == z6M* ]]; then
            printf 'did:key:%s' "$nid"
            return 0
        fi
    fi
    error "cannot resolve '$value' to a radicle identity: it is neither a DID/NID nor an alias the repository knows"
    return 1
}

function rad_metadata_labels ## <repo> <type> <id> - the labels the item carries now, one per line
{
    ## The mutation target, read fresh and never remembered: the Labels column of 'rad <type> list'
    ## is what the item carries, and the applier knows what it has to delete from it.  This is *not*
    ## how the chain state is read -- a label written after a proposal is stale -- it is a different
    ## question ('what is there' against 'what was proposed').
    local repo="$1" type="$2" id="$3"
    local sub="issue" table rows row cell label
    [[ "$type" == patch ]] && sub="patch"
    table="$(rad_metadata_rad "$repo" "$sub" list --all)" || return 1
    rows="$(rad_state_table_checked "$sub list --all" "$table" ID Labels)" || return 1
    while IFS="$RAD_US" read -r row cell; do
        [[ -n "$cell" ]] || continue
        [[ "$row" == "$id"* ]] || continue
        local IFS=','
        for label in $cell; do
            label="${label#"${label%%[![:space:]]*}"}"
            label="${label%"${label##*[![:space:]]}"}"
            [[ -n "$label" ]] && printf '%s\n' "$label"
        done
    done <<<"$rows"
    return 0
}

## <item> - the 'rad' word and the id of an item as the reader answers it
function rad_metadata_item
{
    ## '<type>:<id>' is the form 'rad_comment_metadata' answers with, so it is the form the appliers
    ## take; a bare id is an issue, which is the common case (labels and assignments are mostly issue
    ## business, and the read side names the type anyway).
    local item="$1"
    RAD_METADATA_SUB="issue"
    RAD_METADATA_ID="$item"
    case "$item" in
    issue:*) RAD_METADATA_SUB="issue"; RAD_METADATA_ID="${item#issue:}" ;;
    patch:*) RAD_METADATA_SUB="patch"; RAD_METADATA_ID="${item#patch:}" ;;
    esac
}

function rad_set_label ## <item> [<add>] [<delete>].. [--repo <rid|path>] - one 'rad <type> label'
{
    ## One label added, and any number of labels deleted in the same write: that is what makes an
    ## item carry one chain state at a time (the new one in, the previous one out).  '<add>' may be
    ## the empty word, which is no label at all -- a removal alone (a lone '*rmlabel:' clearing the
    ## chain slot with no successor) is the same write with nothing to add, and at least one of the
    ## two has to be given.  A label the item does not carry is rad's business, not this function's
    ## -- it hands rad exactly what it was given and reports what it did.
    local -a deletes=() args=()
    local raw value item="" add="" seenadd="" repo=""
    for raw in "$@"; do
        if [[ "$raw" == --repo=* ]]; then
            args+=(--repo "${raw#--repo=}")
        else
            args+=("$raw")
        fi
    done
    local -i i=0 count=${#args[@]}
    while (( i < count )); do
        raw="${args[i]}"
        i=$(( i + 1 ))
        case "$raw" in
        -h | --help)
            help_usage rad_set_label
            return 0
            ;;
        --repo)
            if (( i >= count )) || [[ -z "${args[i]}" ]]; then
                help_usage_error rad_set_label "'--repo' needs a non-empty value"
                return 2
            fi
            repo="${args[i]}"
            i=$(( i + 1 ))
            ;;
        -*)
            help_usage_error rad_set_label "unknown argument '$raw'"
            return 2
            ;;
        *)
            if [[ -z "$item" ]]; then
                item="$raw"
            elif [[ -z "$seenadd" ]]; then
                add="$raw"
                seenadd=1
            else
                deletes+=( "$raw" )
            fi
            ;;
        esac
    done
    if [[ -z "$item" || ( -z "$add" && ${#deletes[@]} -eq 0 ) ]]; then
        help_usage_error rad_set_label "an item, and a label to add or one to delete, are required"
        return 2
    fi
    rad_metadata_item "$item"
    local -a call=("$RAD_METADATA_SUB" label "$RAD_METADATA_ID" --quiet)
    [[ -n "$add" ]] && call+=( "--add=$add" )
    for value in ${deletes[@]+"${deletes[@]}"}; do
        call+=( "--delete=$value" )
    done
    rad_metadata_rad "$repo" "${call[@]}" || return $?
    printf 'applied label item=%s' "$item"
    [[ -n "$add" ]] && printf ' add=%s' "$add"
    (( ${#deletes[@]} )) && printf ' delete=%s' "${deletes[*]}"
    printf '\n'
}

function rad_rm_label ## <item> <glob>.. [--repo <rid|path>] - remove the labels a glob matches
{
    ## The removal half of rad_set_label: what the item carries now is read fresh ('rad <type> list',
    ## the mutation target, never remembered) and every stored label matching one of the globs goes
    ## out in a single write.  A glob matches the whole stored label, anchored at both ends, so
    ## 'pr:*' removes 'pr:<id>' and never 'xpr:<id>', and '*' removes every label -- the chain slot
    ## included, which is an explicit act.  A glob which matches nothing writes nothing and says so:
    ## nothing to remove is an answer, not a failure.  No identity is resolved -- a glob matches
    ## labels, never identities.
    local -a globs=() args=() removed=() call=()
    local raw item="" repo="" label="" glob="" stored=""
    for raw in "$@"; do
        if [[ "$raw" == --repo=* ]]; then
            args+=(--repo "${raw#--repo=}")
        else
            args+=("$raw")
        fi
    done
    local -i i=0 count=${#args[@]}
    while (( i < count )); do
        raw="${args[i]}"
        i=$(( i + 1 ))
        case "$raw" in
        -h | --help)
            help_usage rad_rm_label
            return 0
            ;;
        --repo)
            if (( i >= count )) || [[ -z "${args[i]}" ]]; then
                help_usage_error rad_rm_label "'--repo' needs a non-empty value"
                return 2
            fi
            repo="${args[i]}"
            i=$(( i + 1 ))
            ;;
        -*)
            help_usage_error rad_rm_label "unknown argument '$raw'"
            return 2
            ;;
        *)
            if [[ -z "$item" ]]; then
                item="$raw"
            else
                globs+=( "$raw" )
            fi
            ;;
        esac
    done
    if [[ -z "$item" || ${#globs[@]} -eq 0 ]]; then
        help_usage_error rad_rm_label "an item and at least one glob are required"
        return 2
    fi
    rad_metadata_item "$item"
    stored="$(rad_metadata_labels "$repo" "$RAD_METADATA_SUB" "$RAD_METADATA_ID")" || return $?
    while IFS= read -r label; do
        [[ -n "$label" ]] || continue
        for glob in "${globs[@]}"; do
            # shellcheck disable=2053
            if [[ "$label" == $glob ]]; then
                removed+=( "$label" )
                break
            fi
        done
    done <<<"$stored"
    if (( ${#removed[@]} == 0 )); then
        printf 'no label item=%s (nothing the item carries matches %s)\n' "$item" "${globs[*]}"
        return 0
    fi
    call=( "$RAD_METADATA_SUB" label "$RAD_METADATA_ID" --quiet )
    for label in "${removed[@]}"; do
        call+=( "--delete=$label" )
    done
    rad_metadata_rad "$repo" "${call[@]}" || return $?
    printf 'removed label item=%s delete=%s\n' "$item" "${removed[*]}"
}

## <item> <did|alias> [--repo <rid|path>] - one 'rad <type> assign' add or delete
function rad_metadata_assign
{
    local word="$1" remove="$2"
    shift 2
    local -a args=()
    local raw value item="" who="" repo="" did="" arg
    RAD_ASSIGN_WORD="$word"
    for raw in "$@"; do
        if [[ "$raw" == --repo=* ]]; then
            args+=(--repo "${raw#--repo=}")
        else
            args+=("$raw")
        fi
    done
    local -i i=0 count=${#args[@]}
    while (( i < count )); do
        raw="${args[i]}"
        i=$(( i + 1 ))
        case "$raw" in
        -h | --help)
            help_usage "$RAD_ASSIGN_WORD"
            return 0
            ;;
        --repo)
            if (( i >= count )) || [[ -z "${args[i]}" ]]; then
                help_usage_error "$RAD_ASSIGN_WORD" "'--repo' needs a non-empty value"
                return 2
            fi
            repo="${args[i]}"
            i=$(( i + 1 ))
            ;;
        -*)
            help_usage_error "$RAD_ASSIGN_WORD" "unknown argument '$raw'"
            return 2
            ;;
        *)
            if [[ -z "$item" ]]; then
                item="$raw"
            elif [[ -z "$who" ]]; then
                who="$raw"
            else
                help_usage_error "$RAD_ASSIGN_WORD" "unexpected argument '$raw'"
                return 2
            fi
            ;;
        esac
    done
    if [[ -z "$item" || -z "$who" ]]; then
        help_usage_error "$RAD_ASSIGN_WORD" "an item and an identity are required"
        return 2
    fi
    rad_metadata_item "$item"
    did="$(rad_metadata_identity "$repo" "$who")" || return 1
    if [[ -n "$remove" ]]; then
        arg="--delete=$did"
    else
        arg="--add=$did"
    fi
    rad_metadata_rad "$repo" "$RAD_METADATA_SUB" assign "$RAD_METADATA_ID" --quiet "$arg" || return $?
    if [[ -n "$remove" ]]; then
        printf 'applied unassign item=%s delete=%s\n' "$item" "$did"
    else
        printf 'applied assign item=%s add=%s\n' "$item" "$did"
    fi
}

function rad_assign ## <item> <did|alias> [--repo <rid|path>] - one 'rad <type> assign --add'
{
    rad_metadata_assign rad_assign "" "$@"
}

function rad_unassign ## <item> <did|alias> [--repo <rid|path>] - one 'rad <type> assign --delete'
{
    rad_metadata_assign rad_unassign 1 "$@"
}

function rad_label_is_protected ## <label> - 0 when the label is namespaced, hence protected
{
    ## The one rule of the label model, in one place: a label carrying a ':' is *namespaced* --
    ## 'pr:<id>', 'issue:<id>' and every other '<namespace>:<rest>' -- and such a label is
    ## **protected**: the applier never deletes it implicitly, so it survives every chain
    ## transition, and it leaves the item only when a '*rmlabel:' glob or a direct write names it.
    ## A colon-free label is a candidate for the *chain slot*, and exactly one of those is kept per
    ## item: a new '*label:<colon-free>' replaces the stored one in the same write.
    ##
    ## The colon and nothing else decides this -- a hyphen or an underscore protects nothing, which
    ## is why 'needs-info' is a chain state like any other.  Values only: what matters is the stored
    ## label's own text, never where it came from.
    [[ "${1:-}" == *:* ]]
}

function rad_apply_labels ## <repo> <dry> <entry>.. - the label state of one item, reconciled and applied
{
    ## The label entries of one item are one *state*: the labels the chain proposes against the
    ## labels the item carries, which are read fresh (nothing is remembered between calls).  Three
    ## rules are the whole model:
    ##
    ##  * the **chain slot** is the colon-free label ('rad_label_is_protected').  Exactly one is
    ##    kept, so a proposed colon-free label carries the stored one out in the same write, and a
    ##    second one in the same block carries the first out in turn -- the block's last one wins,
    ##    which is the 'a new *label:nopunct overwrites this' rule read within one block.
    ##  * a **protected** label ('pr:<id>', 'issue:<id>') is never deleted implicitly.  It leaves the
    ##    item only through a '*rmlabel:' or a direct write, so one the block does not name is
    ##    reported and left alone.
    ##  * a **proposal is what a write is made of**.  A block which names no colon-free label says
    ##    nothing about the slot -- adding 'pr:<id>' is not a statement about the chain state -- and
    ##    a block which carries no label at all writes nothing at all: what the item carries is
    ##    reported instead.  Deleting on the strength of an absent proposal would reverse a
    ##    delegate's write, and a delegate may label by hand with no comment at all; a missing line
    ##    is ambiguous, never an instruction.
    ##
    ## An <entry> is one line of the reader's answer as 'key<TAB>item<TAB>id<TAB>value'; the entries
    ## which are not labels are not this function's business, except that they name the item.  A
    ## label the item already says is not written again, and the label form is 'rad_label_name's.
    local repo="$1" dry="$2"
    shift 2
    local -a entries=( "$@" ) derived=() adds=() slot=() drop=() kept=() unmatched=() carried=() repopt=() call=()
    local entry key type id value label itemref="" stored="" prev="" rc=0
    local -i i=0

    for entry in ${entries[@]+"${entries[@]}"}; do
        IFS="$RAD_US" read -r key type id value <<<"$entry"
        [[ -n "$type" && -n "$id" ]] || continue
        itemref="$type:$id"
        break
    done
    [[ -n "$itemref" ]] || return 0
    [[ -n "$repo" ]] && repopt=( --repo "$repo" )
    type="${itemref%%:*}"
    id="${itemref#*:}"

    ## What the chain proposes (every label of the item's block, in the write's own label form) and
    ## what the item carries now.
    for entry in ${entries[@]+"${entries[@]}"}; do
        IFS="$RAD_US" read -r key type id value <<<"$entry"
        [[ "$key" == label && "$type:$id" == "$itemref" ]] || continue
        derived+=( "$(rad_label_name "$value")" )
    done
    type="${itemref%%:*}"
    id="${itemref#*:}"
    stored="$(rad_metadata_labels "$repo" "$type" "$id")" || rc=1
    while IFS= read -r label; do
        [[ -n "$label" ]] || continue
        [[ " ${derived[*]} " == *" $label "* ]] && continue
        if rad_label_is_protected "$label"; then
            kept+=( "$label" )
            continue
        fi
        unmatched+=( "$label" )
    done <<<"$stored"

    ## No label proposed at all: report what the item carries, write nothing.
    if (( ${#derived[@]} == 0 )); then
        carried=( ${unmatched[@]+"${unmatched[@]}"} ${kept[@]+"${kept[@]}"} )
        if (( ${#carried[@]} )); then
            printf 'skip label item=%s (%s is stored, no trusted proposal names it)\n' \
                "$itemref" "${carried[*]}"
        fi
        return $rc
    fi
    ## A protected label the block does not name stays where it is, and says so.
    (( ${#kept[@]} )) &&
        printf 'skip label item=%s (%s is protected, only a removal takes it out)\n' "$itemref" "${kept[*]}"

    ## What to add, in the order the block wrote it -- and which of them is the chain slot.
    for entry in ${entries[@]+"${entries[@]}"}; do
        IFS="$RAD_US" read -r key type id value <<<"$entry"
        [[ "$key" == label && "$type:$id" == "$itemref" ]] || continue
        value="$(rad_label_name "$value")"
        if [[ $'\n'"$stored"$'\n' == *$'\n'"$value"$'\n'* || " ${adds[*]} " == *" $value "* ]]; then
            printf 'skip label item=%s add=%s (the item already says it)\n' "$itemref" "$value"
            continue
        fi
        adds+=( "$value" )
        rad_label_is_protected "$value" || slot+=( "$value" )
    done

    ## A block which names no colon-free label says nothing about the chain slot.
    if (( ${#slot[@]} == 0 )); then
        if (( ${#unmatched[@]} )); then
            printf 'skip label item=%s (%s is stored, the block names no chain state)\n' \
                "$itemref" "${unmatched[*]}"
        fi
        unmatched=()
    fi

    ## Nothing to add and nothing to fix: what is left is the slot's own replacement, a removal
    ## alone, which the write layer takes as an add-less call.
    if (( ${#adds[@]} == 0 )); then
        (( ${#unmatched[@]} )) || return $rc
        if [[ -n "$dry" ]]; then
            printf 'would label item=%s delete=%s\n' "$itemref" "${unmatched[*]}"
            return $rc
        fi
        call=( "$itemref" "" )
        call+=( ${unmatched[@]+"${unmatched[@]}"} )
        call+=( ${repopt[@]+"${repopt[@]}"} )
        rad_set_label "${call[@]}" || rc=1
        return $rc
    fi

    for i in "${!adds[@]}"; do
        drop=()
        (( i == 0 )) && drop+=( ${unmatched[@]+"${unmatched[@]}"} )
        [[ -n "$prev" ]] && drop+=( "$prev" )
        if [[ -n "$dry" ]]; then
            printf 'would label item=%s add=%s' "$itemref" "${adds[i]}"
            (( ${#drop[@]} )) && printf ' delete=%s' "${drop[*]}"
            printf '\n'
        else
            call=( "$itemref" "${adds[i]}" ${drop[@]+"${drop[@]}"} )
            call+=( ${repopt[@]+"${repopt[@]}"} )
            rad_set_label "${call[@]}" || rc=1
        fi
        rad_label_is_protected "${adds[i]}" || prev="${adds[i]}"
    done
    return $rc
}

function rad_apply_from_comments ## <item>.. [--query <key>].. [--repo <rid|path>] [--trust <spec>].. [--dry-run] - apply the newest trusted block per key, as one write per entry
{
    ## The maintenance side of the reader: it asks 'rad_comment_metadata' for the trusted proposals
    ## of an item ('--last', which is the state; a block a later one superseded is history) and
    ## dispatches every entry to the applier of its key.  The reader owns the trust decision -- an
    ## entry whose author cannot be attributed never reaches this function, and it is not reported
    ## here because it was never an entry -- and this function owns the effect.  The keys it knows
    ## are 'label', 'rmlabel', 'assign' and 'unassign'; any other key is reported and never guessed
    ## at.  The removals run first: a block may carry both a '*rmlabel:' and a '*label:' in the same
    ## namespace, and the add has to be the later act (otherwise the removal takes the new label out
    ## again).
    local -a args=() items=() entries=() queries=() specs=() parts=() repopt=() call=()
    local raw value json="" repo="" dry="" item="" entry="" key="" type="" id="" itemref="" did=""
    local rc=0 failed=0
    local -i i=0 count=0

    for raw in "$@"; do
        if [[ "$raw" == --*=* ]]; then
            args+=("${raw%%=*}" "${raw#*=}")
        else
            args+=("$raw")
        fi
    done
    count=${#args[@]}
    while (( i < count )); do
        raw="${args[i]}"
        i=$(( i + 1 ))
        case "$raw" in
        -h | --help)
            help_usage rad_apply_from_comments
            return 0
            ;;
        --dry-run) dry=1 ;;
        --query | --repo | --trust)
            if (( i >= count )) || [[ -z "${args[i]}" ]]; then
                help_usage_error rad_apply_from_comments "'$raw' needs a non-empty value"
                return 2
            fi
            value="${args[i]}"
            i=$(( i + 1 ))
            case "$raw" in
            --query) queries+=( --query "$value" ) ;;
            --repo) repo="$value" ;;
            --trust)
                IFS=',' read -r -a parts <<<"$value"
                for value in ${parts[@]+"${parts[@]}"}; do
                    [[ -n "$value" ]] && specs+=( --trust "$value" )
                done
                ;;
            esac
            ;;
        -*)
            help_usage_error rad_apply_from_comments "unknown argument '$raw'"
            return 2
            ;;
        *) items+=( "$raw" ) ;;
        esac
    done
    if (( ${#items[@]} == 0 )); then
        help_usage_error rad_apply_from_comments "at least one item is required"
        return 2
    fi
    if ! command -v jq >/dev/null 2>&1; then
        printf 'rad_apply_from_comments: jq is required to read the entries of the reader\n' >&2
        return 2
    fi
    [[ -n "$repo" ]] && repopt=( --repo "$repo" )

    for item in "${items[@]}"; do
        call=( "$item" --last --json )
        call+=( ${queries[@]+"${queries[@]}"} )
        call+=( ${specs[@]+"${specs[@]}"} )
        call+=( ${repopt[@]+"${repopt[@]}"} )
        if ! json="$(rad_comment_metadata "${call[@]}")"; then
            rc=$?
            printf 'rad_apply_from_comments: no answer for %s\n' "$item" >&2
            failed=1
            continue
        fi
        entries=()
        while IFS= read -r entry; do
            [[ -n "$entry" ]] && entries+=( "$entry" )
        done < <(printf '%s' "$json" | jq -r '.entries[] | [.key,.item,.id,.value] | @tsv' | tr '\t' "$RAD_US")
        ## The removals first ('*rmlabel:'): a protected label ('pr:<id>', 'issue:<id>') leaves the
        ## item only this way, and a block carrying both a removal and an add in the same namespace
        ## has to end with the new label in -- which it does only when the removal ran before it.
        for entry in ${entries[@]+"${entries[@]}"}; do
            IFS="$RAD_US" read -r key type id value <<<"$entry"
            [[ "$key" == rmlabel ]] || continue
            itemref="$type:$id"
            if [[ -n "$dry" ]]; then
                printf 'would remove label item=%s glob=%s\n' "$itemref" "$value"
                continue
            fi
            rad_rm_label "$itemref" "$value" ${repopt[@]+"${repopt[@]}"} || failed=1
        done
        ## The labels then: they are one state of the item, and the write which changes it may have
        ## to delete the chain slot it replaces.  Then everything else in the order it was written.
        rad_apply_labels "$repo" "$dry" ${entries[@]+"${entries[@]}"} || failed=1
        for entry in ${entries[@]+"${entries[@]}"}; do
            IFS="$RAD_US" read -r key type id value <<<"$entry"
            case "$key" in label | rmlabel) continue ;; esac
            itemref="$type:$id"
            case "$key" in
            assign | unassign)
                if ! did="$(rad_metadata_identity "$repo" "$value")"; then
                    printf 'skip %s item=%s value=%s (no identity behind it)\n' "$key" "$itemref" "$value"
                    failed=1
                    continue
                fi
                if [[ -n "$dry" ]]; then
                    if [[ "$key" == assign ]]; then
                        printf 'would assign item=%s add=%s\n' "$itemref" "$did"
                    else
                        printf 'would unassign item=%s delete=%s\n' "$itemref" "$did"
                    fi
                    continue
                fi
                if [[ "$key" == assign ]]; then
                    rad_assign "$itemref" "$value" ${repopt[@]+"${repopt[@]}"} || failed=1
                else
                    rad_unassign "$itemref" "$value" ${repopt[@]+"${repopt[@]}"} || failed=1
                fi
                ;;
            *)
                printf 'skip %s item=%s value=%s (no effect is registered for that key)\n' \
                    "$key" "$itemref" "$value"
                ;;
            esac
        done
    done
    return $(( rc | failed ))
}

# --- the reaction API: compare and swap on the caller's own reaction state ---------------------
#
# Reactions are *private per identity* and never delegated: the marker an identity leaves is read
# back by reducing the ops that identity wrote, which is why this needs none of the reader's trust
# plumbing.  rad offers no way to set a reaction to a state, only to add one or (at patch level) to
# take one back, so a transition is expressed as 'the marker I expect' -> 'the marker I want' and the
# expectation is checked against the state the store reduces before anything is written.

## The COBs the node holds, '<id>US<issue|patch>' per entry, and whether that list was read in this
## run: the '--state' form needs it to tell one target from the next.
declare -ga RAD_REACTION_COBS=()
declare -g RAD_REACTION_COBS_READ=""

function rad_reaction_accepts ## <char> - 0 when the store would accept it as a reaction
{
    ## One codepoint of rad's allow list (heartwood, 'crates/radicle/src/cob/common.rs').  An emoji
    ## picker hands out '❤️' (heart plus a variation selector) and other sequences, and the store
    ## refuses those with 'invalid reaction': refusing them here costs no call and no write, and it is
    ## the same list -- a character this accepts and the store does not would be a bad promise.
    local char="$1" cp range
    ## U+1F600..U+1F64F, U+1FA75..U+1FA77, U+1FAC0..U+1FAC6, U+1FAE0..U+1FAF8,
    ## U+1F300..U+1F5FF, U+2700..U+27BF, U+1F900..U+1F9FF, U+1F680..U+1F6FF
    local -a ranges=(
        128512:128591 129653:129655 129728:129734 129760:129784
        127744:128511 9984:10175 129280:129535 128640:128767
    )
    [[ "${#char}" == 1 ]] || return 1
    cp="$(printf '%d' "'$char" 2>/dev/null)" || return 1
    [[ "$cp" =~ ^[0-9]+$ ]] || return 1
    for range in "${ranges[@]}"; do
        (( cp >= ${range%%:*} && cp <= ${range##*:} )) && return 0
    done
    return 1
}

function rad_metadata_reactions ## <storage> <ref> <kind> <target> <nid> - our live markers on one target
{
    ## Reads the live reaction markers of *our* identity on one target, as 'rad cob show --format json'
    ## reduces them.
    ##
    ## <kind> names the part of the document to look at: 'comment' is an issue's thread (its root
    ## comment included), 'auto' every reaction-able part of a patch -- a revision, a comment of one, a
    ## review, a comment of a review.  <target> may be short: the answer carries the full id.
    ##
    ## The answer's first line names the target, '|'-separated --
    ## '<count>|<kind>|<id>|<review>|<revision>' -- and the lines after it are the live markers of
    ## ours, one per line.  Returns 3 when the document does not carry the target.
    #
    # What is read is *rad's own reduction* of the COB, never the op stream: a marker its author took
    # back in the same op it set the next one in (one op, two actions) cannot then be read as live, and
    # a caller whose expectation comes from the same source can always complete its transition.
    #
    # What is read on top of, measured on a live node with 'rad cob update' (playground repo, 2026-10-16:
    # every case written as an action file and read back with 'rad cob show'):
    #
    #   * the state is a *set*, never a stack: one entry per (location, emoji) carrying the identities
    #     that have it set, so the same marker cannot be live twice -- while two *different* markers of
    #     one identity can be, which is the shape the last paragraph below is about.
    #   * 'active' is a value, not a toggle: setting a marker that is already live is a no-op (rc 0,
    #     the state keeps it) and withdrawing one that is not live is silently ignored (rc 0, nothing
    #     changes).  The toggle is the typed CLI's convenience ('rad issue react'), never the store's,
    #     so a writer states 'active' and takes a marker back with an action of its own.
    #   * inside one op the actions apply in order and the last one wins: '[A active, A inactive]'
    #     ends with nothing live, '[A inactive, A active]' with it live -- which is what lets one op
    #     be a whole transition, the marker to set first and the one to take back after it.
    #
    # The read is the *current* state and nothing else: 'rad cob show' takes no '--from'/'--until'.  The
    # state of a target at some point in time is the history route ('rad cob log --from/--until', one
    # JSON document per op); it costs a walk of the whole chain and is deliberately not built here.
    #
    # The document differs per COB type: an issue carries '.thread.comments[<id>].reactions' as
    # '<author> <emoji>' pairs, a patch nests '{location, emoji, authors}' objects in four places --
    # '.revisions[<id>].reactions', '.revisions[<id>].discussion.comments[<id>].reactions',
    # '.revisions[<id>].reviews[<author>].reactions' and
    # '.revisions[<id>].reviews[<author>].comments.comments[<id>].reactions'.  The shapes are unified
    # here, once, so every caller sees one structure.
    #
    # The ids travel back with the state because the writer needs exactly them ('review.comment.react'
    # names the review *and* the comment), and reading them off this one document is what keeps the
    # write from opening the store a second time.
    #
    # The COB id and its type are read off the ref (bar asks for a ref, 'rad cob show' for an object)
    # and the RID off the storage directory, which is named after it -- the caller hands in neither.
    #
    # Two markers of ours alive on one target are reported as the *set* they are -- rad allows exactly
    # that ('✅' beside '❓', measured), while the same marker live twice it does not -- and the
    # reduction holds no order which would call one of them newer.  This reader answers the state, all
    # of it; what a caller asks of it is rad_reaction's business, and there '<from>' is one marker,
    # tested for *membership*: the step takes back what it expected and sets what it wants, leaving any
    # second marker alone, so a state of two is resolved one marker at a time.  A target the document
    # does not carry is refused as well (3): an unread document and a document without that target must
    # not both answer 'no live marker of mine', because the caller's CAS would then write over a state
    # nobody looked at.
    local storage="$1" ref="$2" kind="$3" target="$4" nid="$5"
    local typename="${ref%/*}" cob="${ref##*/}" rid="" document="" answer="" header="" found=""
    typename="${typename##*/}"
    rid="rad:${storage##*/}"
    document="$(rad_metadata_rad "$rid" cob show --type "$typename" --object "$cob" --format json)" ||
        return $?
    answer="$(printf '%s' "$document" | jq -r --arg kind "$kind" --arg target "$target" --arg nid "$nid" '
        def live_markers:
            map(if type == "array" then {emoji: .[1], authors: [.[0]]}
                else {emoji: .emoji, authors: (.authors // [])} end)
            | map(select(.authors | index($nid)) | .emoji) | unique;
        ( if $kind == "comment" then
              [ (.thread // {}) | (.comments // {}) | to_entries[]
                | select((.key | startswith($target)))
                | {kind: "comment", id: .key, review: "", revision: "",
                   reactions: (.value.reactions // [])} ]
          else
              # Every reaction-able part of a patch, in one walk: the revision itself, a comment of
              # it, a review, and a comment of a review -- the review id a write has to name is the
              # one this entry nests under, so it comes back with the match.
              [ (.revisions // {}) | to_entries[]
                | .key as $revision | .value as $rev
                | ( ( select((($revision) | startswith($target)))
                      | {kind: "revision", id: $revision, review: "", revision: $revision,
                         reactions: ($rev.reactions // [])} ),
                    ( ($rev.discussion.comments // {}) | to_entries[]
                      | select((.key | startswith($target)))
                      | {kind: "revision-comment", id: .key, review: "", revision: $revision,
                         reactions: (.value.reactions // [])} ),
                    ( ($rev.reviews // {}) | to_entries[] | .value as $review
                      | ( ( select((($review.id // "") | startswith($target)))
                            | {kind: "review", id: $review.id, review: $review.id,
                               revision: $revision, reactions: ($review.reactions // [])} ),
                          ( ($review.comments.comments // {}) | to_entries[]
                            | select((.key | startswith($target)))
                            | {kind: "review-comment", id: .key, review: $review.id,
                               revision: $revision, reactions: (.value.reactions // [])} )
                        )
                    )
                  )
              ]
          end ) as $hits
        | if ($hits | length) == 0 then "0||||"
          else ([($hits | length), $hits[0].kind, $hits[0].id, $hits[0].review, $hits[0].revision]
                | map(tostring) | join("|")),
               (if ($hits | length) == 1 then ($hits[0].reactions | live_markers)[] else empty end)
          end
    ')" || {
        error "the state of $typename:$target is not readable: no answer came back"
        return 1
    }
    header="${answer%%$'\n'*}"
    found="${header%%|*}"
    case "$found" in
    '' | *[!0-9]*)
        error "the state of $typename:$target is not readable: 'rad cob show' answered no state"
        return 1
        ;;
    0)
        error "$typename:$cob carries no '$target': there is no state of ours to compare"
        return 3
        ;;
    1)
        ;;
    *)
        error "'$target' names $found targets of $typename:$cob, name more of it"
        return 2
        ;;
    esac
    # The target line first, then the markers: the caller needs both (the ids to write with, the state
    # to compare), and they were read from the one document this function opened.
    printf '%s\n' "$answer"
    return 0
}

function rad_reaction_ref ## <storage> <id> - the COB a reaction target names, in 'RAD_METADATA_REF'/_TYPE/_ID
{
    ## Resolves a patch, issue, revision, review or comment id to the COB which carries it.
    ## Returns 3 when nothing matches, 2 when the id matches more than one COB.
    #
    # A patch or issue id names the COB itself, and 'rad cob list' says which: one listing per type,
    # matched as a prefix because that is how a caller may name it.  An id which names something
    # *inside* a patch (a revision, a review, a comment of either) is found by reading the patch
    # documents themselves, one 'rad cob show' per object; the first document which carries the id
    # names the COB.  An object the node cannot show ('object ... was not found') is dropped rather
    # than allowed to take the whole resolution down: one document nobody can react through is not an
    # error of the id being looked for.
    local storage="$1" id="$2" rid=""
    local -a issues=() patches=()
    local line="" document="" carries=""
    rid="rad:${storage##*/}"
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ -n "$line" ]] || continue
        [[ "$line" == "$id"* ]] && issues+=( "$line" )
    done < <(rad_metadata_rad "$rid" cob list --type xyz.radicle.issue)
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ -n "$line" ]] || continue
        [[ "$line" == "$id"* ]] && patches+=( "$line" )
    done < <(rad_metadata_rad "$rid" cob list --type xyz.radicle.patch)
    if (( ${#issues[@]} + ${#patches[@]} > 1 )); then
        error "'$id' matches more than one issue or patch, use more characters"
        return 2
    fi
    if (( ${#issues[@]} == 1 )); then
        RAD_METADATA_REF="refs/cobs/xyz.radicle.issue/${issues[0]}"
        RAD_METADATA_TYPE="issue"
        RAD_METADATA_ID="${issues[0]}"
        return 0
    fi
    if (( ${#patches[@]} == 1 )); then
        RAD_METADATA_REF="refs/cobs/xyz.radicle.patch/${patches[0]}"
        RAD_METADATA_TYPE="patch"
        RAD_METADATA_ID="${patches[0]}"
        return 0
    fi
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ -n "$line" ]] || continue
        document="$(rad_metadata_rad "$rid" cob show --type xyz.radicle.patch \
            --object "$line" --format json 2>/dev/null)" || continue
        carries="$(printf '%s' "$document" | jq -r --arg id "$id" '
            [ (.revisions // {} | keys[]),
              (.revisions // {} | to_entries[] | .value | (.discussion.comments // {}) | keys[]),
              (.revisions // {} | to_entries[] | .value | (.reviews // {}) | to_entries[] | .value.id),
              (.revisions // {} | to_entries[] | .value | (.reviews // {}) | to_entries[] | .value
               | (.comments.comments // {}) | keys[])
            ] | map(select(. != null and startswith($id))) | length
        ')" || continue
        [[ "$carries" == 1 ]] || continue
        RAD_METADATA_REF="refs/cobs/xyz.radicle.patch/$line"
        RAD_METADATA_TYPE="patch"
        RAD_METADATA_ID="$line"
        return 0
    done < <(rad_metadata_rad "$rid" cob list --type xyz.radicle.patch)
    error "the node holds no issue, patch or revision '$id' in this repository"
    return 3
}

function rad_metadata_self ## - the NID of the identity 'rad' uses here
{
    # What is *ours*: the actor of an op travels in its author mail ('<alias>@<nid>'), and reactions
    # are private per identity, so our NID is what decides which markers this caller wrote.
    local did=""
    did="$(rad_run self --did)" || return $?
    did="$(rad_metadata_nid "${did##*$'\n'}")"
    if [[ "$did" != z6M* ]]; then
        error "'$RAD_BIN self --did' names no radicle identity"
        return 1
    fi
    printf '%s' "$did"
}

function rad_reaction_action ## <emoji> <active> <kind> <id> <review> <revision> - one 'cob update' action
{
    ## The 'cob update' action for one marker on a target, as the payload rad's own commands write.
    #
    # The action names the level the reader found, never a guess from the target's shape: a comment id
    # for the issue level, the revision for a revision, the review for a review, and the review beside
    # the comment for a comment of one -- the last is the pair 'revision.comment.react' cannot express,
    # which is why the store refuses a review comment written as one.
    local emoji="$1" active="$2" kind="$3" id="$4" review="$5" revision="$6" payload=""
    payload="$(jq -cn --arg reaction "$emoji" --argjson active "$active" --arg kind "$kind" \
        --arg id "$id" --arg review "$review" --arg revision "$revision" \
        'if $kind == "review-comment" then {type:"review.comment.react", review:$review, comment:$id}
         elif $kind == "review" then {type:"review.react", review:$review}
         elif $kind == "revision-comment" then {type:"revision.comment.react", revision:$revision, comment:$id}
         elif $kind == "revision" then {type:"revision.react", revision:$revision}
         else {type:"comment.react", id:$id} end | .reaction = $reaction | .active = $active')" || {
        error 'could not build the reaction action'
        return 1
    }
    printf '%s' "$payload"
}

function rad_reaction_level ## <type> <reader-kind> <id> <cob> - the level a target really is
{
    ## The level a caller is told about, mapped from the part of the document the reader matched:
    ## an issue's root comment is 'root', a comment of the thread or of a revision is 'comment', a
    ## revision is 'revision', a review is 'review'.  One mapping, used by both forms of the command,
    ## so 'rad_reaction' never answers in two vocabularies.
    local type="$1" kind="$2" id="$3" cob="$4"
    case "$kind" in
    revision) printf 'revision\n' ;;
    review) printf 'review\n' ;;
    *)
        if [[ "$type" == issue && "$id" == "$cob" ]]; then
            printf 'root\n'
        else
            printf 'comment\n'
        fi
        ;;
    esac
}

function rad_reaction_dates ## <rid> <typename> <cob> <reader-kind> <id> <review> <revision> <nid> <marker>.. - one JSON object per marker
{
    ## When each live marker was set: '{"emoji","op","date"}' per marker, oldest first, with '-' for
    ## a marker no op of ours accounts for.
    #
    # The liveness is *not* decided here -- that is the store's reduction, which the caller has just
    # read.  What this adds is the date the marker was set, and getting that right is the whole point
    # of the request: one op may carry several actions for one emoji, and inside one op the actions
    # apply in order, the last one winning.  So a marker is dated by the newest op whose *last* action
    # for that (target, emoji) is 'active: true' -- never by the newest op that merely mentions it,
    # which would date a marker to the op that took it back (bar issue 9a815de's reader half), and
    # never by the withdrawal that precedes the set in the same op.
    #
    # The chain is walked in the order its own ops declare ('parents'), not in the order rad printed
    # them: '--format json' promises no order.  An op's depth is the longest path back to the root,
    # so the newest op has the greatest depth -- and a merge carries several parents, which is why
    # the depth is a fixpoint over the edges instead of a walk down 'parents[0]'.
    local rid="$1" typename="$2" cob="$3" kind="$4" id="$5" review="$6" revision="$7" nid="$8"
    shift 8
    local ops="" markers="" result=""
    [[ "$#" -gt 0 ]] || { printf '[]\n'; return 0; }
    ops="$(rad_metadata_rad "$rid" cob log --type "$typename" --object "$cob" --format json)" || {
        error "the op chain of $typename:$cob cannot be read: 'rad cob log' failed"
        return 1
    }
    markers="$(printf '%s\n' "$@" | jq -R . | jq -sc .)" || {
        error 'could not build the marker list'
        return 1
    }
    result="$(printf '%s' "$ops" | jq -s --arg nid "$nid" --arg kind "$kind" --arg id "$id" \
        --arg review "$review" --arg revision "$revision" --argjson markers "$markers" '
        def names($a):
            if $kind == "comment" then ($a.type == "comment.react" and $a.id == $id)
            elif $kind == "revision" then ($a.type == "revision.react" and $a.revision == $revision)
            elif $kind == "review" then ($a.type == "review.react" and $a.review == $review)
            elif $kind == "revision-comment" then
                ($a.type == "revision.comment.react" and $a.revision == $revision and $a.comment == $id)
            else ($a.type == "review.comment.react" and $a.review == $review and $a.comment == $id)
            end;
        map({key: .id, value: .}) | from_entries as $by
        | ( reduce range(0; ($by | length) + 1) as $_ (
                ($by | map_values(0));
                . as $d
                | ($by | map_values(
                    if ((.parents // []) | length) == 0 then 0
                    else 1 + ([ (.parents // [])[] as $p | ($d[$p] // 0) ] | max) end )) )
          ) as $depth
        | [ $markers[] as $e
            | ( [ $by[] | select(.author == $nid)
                  | select(any(.actions[]; .reaction == $e and names(.)))
                  | {op: ., depth: $depth[.id]} ] | max_by(.depth) ) as $newest
            | if $newest == null then {emoji: $e, op: "-", date: "-"}
              else ( [ $newest.op.actions[] | select(.reaction == $e) | select(names(.)) ] | last ) as $a
                | if $a != null and $a.active == true
                  then {emoji: $e, op: $newest.op.id, date: ($newest.op.timestamp / 1000 | todate)}
                  else {emoji: $e, op: "-", date: "-"}
                  end
              end ]
        | sort_by(.date)
    ')" || {
        error "the op chain of $typename:$cob cannot be reduced"
        return 1
    }
    printf '%s\n' "$result"
}

function rad_reaction_cob_index ## <rid> - fill RAD_REACTION_COBS with every COB the node holds
{
    ## The ids the '--state' form needs to tell one target from the next: a word the node holds as an
    ## issue or a patch starts a target, and any other word is the id inside it.  Filled once.
    local rid="$1" typename out line
    [[ -n "$RAD_REACTION_COBS_READ" ]] && return 0
    RAD_REACTION_COBS=()
    for typename in xyz.radicle.issue xyz.radicle.patch; do
        if ! out="$(rad_metadata_rad "$rid" cob list --type "$typename")"; then
            error "the node's COBs cannot be listed: 'rad cob list --type $typename' failed"
            return 1
        fi
        while IFS= read -r line; do
            [[ "$line" =~ ^[0-9a-f]{40}$ ]] || continue
            RAD_REACTION_COBS+=( "${line}${RAD_US}${typename#xyz.radicle.}" )
        done <<<"$out"
    done
    RAD_REACTION_COBS_READ=1
    return 0
}

function rad_reaction_is_cob ## <word> - 0 when the word names a COB the node holds
{
    local word="$1" entry
    [[ -n "$word" ]] || return 1
    for entry in ${RAD_REACTION_COBS[@]+"${RAD_REACTION_COBS[@]}"}; do
        [[ "${entry%%"$RAD_US"*}" == "$word"* ]] && return 0
    done
    return 1
}

function rad_reaction_state ## <repo> <json> <word>.. - the '--state' form, one line per target
{
    ## Publishes what the write path already reads: the live markers of *ours* on a target, and the
    ## op that set each of them.  Read-only -- the store is opened for 'cob show', 'cob log' and
    ## 'cob list' and nothing else.
    #
    # '<word>..' is one or more targets, each named as the write form names them: an issue or patch
    # id alone, or that id beside one id inside it (a comment of the thread, a revision, a review, a
    # comment of a revision or of a review).  A word the node holds as an issue or a patch therefore
    # starts a target and a word it does not hold continues the one before it, which is the only
    # reading that keeps '<issue> <comment>' one target and '<issue> <issue>' two.
    local repo="$1" json="$2"
    shift 2
    local -a words=( "$@" ) groups=() parts=() markers=()
    local storage="" rid="" nid="" word="" group="" ref="" type="" cob="" kind="" target=""
    local typename="" state="" header="" level="" dates="" item="" mlist="" since="" op=""
    local react_kind="" react_id="" react_review="" react_revision="" _count=""

    is_command_installed "$RAD_BIN" || {
        error "'$RAD_BIN' is not installed"
        return 1
    }
    rad_metadata_store rad_reaction "$repo" || return $?
    storage="$RAD_METADATA_STORAGE"
    rid="$RAD_METADATA_RID"
    nid="$(rad_metadata_self)" || return $?

    ## One target needs no listing: the id is resolved (which walks the store when it names something
    ## inside a patch) and that is the answer.  Several do, because only the listing says where one
    ## ends and the next begins.
    if (( ${#words[@]} > 1 )); then
        rad_reaction_cob_index "$rid" || return $?
    fi
    for word in "${words[@]}"; do
        if rad_reaction_is_cob "$word"; then
            [[ -n "$group" ]] && groups+=( "$group" )
            group="$word"
        elif [[ -z "$group" ]]; then
            group="$word"
        elif [[ "$group" == *"$RAD_US"* ]]; then
            error "'$word' would be a third word of one target: a target is an item and one id inside it"
            return 2
        else
            group="$group$RAD_US$word"
        fi
    done
    [[ -n "$group" ]] && groups+=( "$group" )

    for group in "${groups[@]}"; do
        parts=()
        IFS="$RAD_US" read -r -a parts <<<"$group"
        rad_reaction_ref "$storage" "${parts[0]}" || return $?
        ref="$RAD_METADATA_REF"
        type="$RAD_METADATA_TYPE"
        cob="$RAD_METADATA_ID"
        typename="xyz.radicle.issue"
        [[ "$type" == patch ]] && typename="xyz.radicle.patch"
        if [[ "$type" == issue ]]; then
            kind="comment"
            target="${parts[1]:-$cob}"
        else
            kind="auto"
            target="${parts[1]:-${parts[0]}}"
        fi
        ## The state of that target, as the store reduces it: the first line names what the target
        ## really is, the lines after it are the live markers of ours.
        state="$(rad_metadata_reactions "$storage" "$ref" "$kind" "$target" "$nid")" || return $?
        header="${state%%$'\n'*}"
        IFS='|' read -r _count react_kind react_id react_review react_revision <<<"$header"
        markers=()
        if [[ "$state" == *$'\n'* ]]; then
            while IFS= read -r marker; do
                [[ -n "$marker" ]] && markers+=( "$marker" )
            done <<<"${state#*$'\n'}"
        fi
        level="$(rad_reaction_level "$type" "$react_kind" "$react_id" "$cob")"
        dates="[]"
        if (( ${#markers[@]} )); then
            dates="$(rad_reaction_dates "$rid" "$typename" "$cob" "$react_kind" "$react_id" \
                "$react_review" "$react_revision" "$nid" "${markers[@]}")" || return $?
        fi
        item="$type:$cob"
        mlist="-"
        since="-"
        op="-"
        if (( ${#markers[@]} )); then
            IFS=$'\t' read -r mlist since op <<<"$(printf '%s' "$dates" | jq -r '
                [ ([.[].emoji] | join(",")),
                  (([.[] | select(.date != "-")] | last).date // "-"),
                  (([.[].op | select(. != "-")] | last) // "-") ] | @tsv')"
        fi
        if [[ -n "$json" ]]; then
            jq -cn --arg item "$item" --arg level "$level" --arg target "$react_id" \
                --argjson markers "$dates" --arg since "$since" --arg op "$op" \
                '{bar_rad: 1, item: $item, level: $level, target: $target,
                  markers: $markers, since: $since, op: $op}'
        else
            printf 'state item=%s level=%s target=%s markers=%s since=%s op=%s\n' \
                "$item" "$level" "$react_id" "$mlist" "$since" "$op"
        fi
    done
}

function rad_reaction ## [--from <emoji>] [--repo <rid|path>] <to> <target>.. | <from> <to> <target>.. | --state [--json] [--repo <rid|path>] <target>.. - one of our reaction markers set, transitioned or withdrawn against the state the caller expects, or '--state' reporting the live ones
{
    ## Compare and swap on the caller's *own* reaction state: one target, one marker, and the write
    ## happens only when what the caller expects is what the store reduces.
    #
    # rad has no action that states a target's whole reaction state in one go (a marker is set and
    # taken back per emoji), so a transition is the pair 'from -> to' written as one op: the action file
    # carries the marker to set and the one to withdraw, and rad lands the pair as a single op.  Both
    # halves are needed and both are stated: 'active' is a value, not a toggle (re-setting a marker
    # takes nothing back), so a write which only set the new one would leave the old one live beside it.
    # One op's actions apply in order, the last one winning, which is why the marker to set goes first
    # -- the semantics are measured, see rad_metadata_reactions.  The typed commands are not used --
    # 'rad issue react' can only add, and 'rad patch react'/'rad patch comment --react' would be a
    # second code path for the same effect.
    local -a args=() positional=() targets=() actions=()
    local raw value from="" to="" repo="" kind="" level="" storage="" ref="" rid="" nid="" type=""
    local state="" live="" withdrawn="" target="" marker="" header=""
    local react_kind="" react_id="" react_review="" react_revision="" _count=""
    local typename="" action_file="" rc=0
    local from_given="" state_given="" json=""
    local -i i=0 count=0

    for raw in "$@"; do
        if [[ "$raw" == --*=* ]]; then
            args+=("${raw%%=*}" "${raw#*=}")
        else
            args+=("$raw")
        fi
    done
    count=${#args[@]}
    while (( i < count )); do
        raw="${args[i]}"
        i=$(( i + 1 ))
        case "$raw" in
        -h | --help)
            help_usage rad_reaction
            return 0
            ;;
        --state) state_given=1 ;;
        --json) json=1 ;;
        --from | --repo)
            if (( i >= count )); then
                help_usage_error rad_reaction "'$raw' needs a value"
                return 2
            fi
            value="${args[i]}"
            i=$(( i + 1 ))
            case "$raw" in
            --from)
                from="$value"
                from_given=1
                ;;
            --repo) repo="$value" ;;
            esac
            ;;
        -*)
            help_usage_error rad_reaction "unknown argument '$raw'"
            return 2
            ;;
        *) positional+=( "$raw" ) ;;
        esac
    done

    if (( ${#positional[@]} == 0 )); then
        help_usage_error rad_reaction "the reaction to set and its target are required"
        return 2
    fi
    ## '--state' reports, it does not compare: it takes no '<to>' and no '<from>', and every
    ## positional is a target.  The two forms are exclusive because a caller that set a marker while
    ## asking for the state would have to be told which of the two answers it got.
    if [[ -n "$state_given" ]]; then
        if [[ -n "$from_given" ]]; then
            help_usage_error rad_reaction "'--from' compares before a write; '--state' does not: drop one of them"
            return 2
        fi
        rad_reaction_state "$repo" "$json" "${positional[@]}"
        return $?
    fi
    if [[ -n "$json" ]]; then
        help_usage_error rad_reaction "'--json' belongs to '--state': a write answers one line already"
        return 2
    fi
    ## The '<from> <to>' form is the two leading positionals, the '<to> <target>' form starts with
    ## the reaction to set.  What tells them apart is what can be a reaction at all: a target is an
    ## id, never an emoji -- and an empty second word is only a '<to>' if that is what it can be,
    ## which is how 'rad_reaction <from> "" <target>' takes a marker back.
    if (( ${#positional[@]} >= 3 )) && [[ -z "$from_given" ]] &&
        { rad_reaction_accepts "${positional[1]}" ||
            { [[ -z "${positional[1]}" ]] && rad_reaction_accepts "${positional[0]}"; }; }; then
        from="${positional[0]}"
        from_given=1
        to="${positional[1]}"
        targets=( "${positional[@]:2}" )
    else
        to="${positional[0]}"
        targets=( "${positional[@]:1}" )
    fi
    if (( ${#targets[@]} == 0 || ${#targets[@]} > 2 )); then
        help_usage_error rad_reaction "one target (and its comment) is required, got ${#targets[@]} words"
        return 2
    fi
    if [[ -n "$to" ]] && ! rad_reaction_accepts "$to"; then
        help_usage_error rad_reaction "'$to' is not a reaction the store accepts: one emoji, no sequence"
        return 2
    fi
    if [[ -z "$to" ]] && [[ -z "$from" || -z "$from_given" ]]; then
        help_usage_error rad_reaction "an empty reaction only takes back the ones the caller expects"
        return 2
    fi
    ## The step changes exactly one marker, so '<from>' names exactly one: a value carrying several
    ## ('--from "✅ ❓"') is refused here -- it is no state a single step could both expect and resolve
    ## -- and the one marker is checked against the same allow list as '<to>' before any call.
    if [[ -n "$from" && "$from" != "${from//[[:space:]]/}" ]]; then
        help_usage_error rad_reaction "'$from' names more than one marker: a transition changes exactly one"
        return 2
    fi
    if [[ -n "$from" ]] && ! rad_reaction_accepts "$from"; then
        help_usage_error rad_reaction "'$from' is not a reaction the store accepts"
        return 2
    fi
    if [[ -n "$from_given" && "$from" == "$to" ]]; then
        help_usage_error rad_reaction "'$from' to '$to' is not a transition"
        return 2
    fi

    is_command_installed "$RAD_BIN" || {
        error "'$RAD_BIN' is not installed"
        return 1
    }
    rad_metadata_store rad_reaction "$repo" || return $?
    storage="$RAD_METADATA_STORAGE"
    rid="$RAD_METADATA_RID"
    nid="$(rad_metadata_self)" || return $?

    # Which COB the target names: the issue itself (its root comment) or a comment of it; for a patch
    # the first word is the patch (whose id is its root revision) or one revision of it, and the second
    # word is *any* reaction-able part of it -- a comment of the revision, a review, a comment of a
    # review.  Which one it is is not guessed here: the reader walks the document and says.
    rad_reaction_ref "$storage" "${targets[0]}" || return $?
    ref="$RAD_METADATA_REF"
    type="$RAD_METADATA_TYPE"
    if [[ "$type" == issue ]]; then
        kind="comment"
        target="${targets[1]:-$RAD_METADATA_ID}"
    else
        kind="auto"
        target="${targets[1]:-${targets[0]}}"
    fi

    # Our own state on that target, as the store reduces it: its first line names what the target is
    # (the level, the full id, the review a review comment belongs to and the revision it was made on),
    # and the lines after it are the live markers of ours, one per line.  The read is checked -- an
    # unreadable document must never answer like an empty one, because the CAS below would then write
    # over a state nobody read.
    state="$(rad_metadata_reactions "$storage" "$ref" "$kind" "$target" "$nid")" || return $?
    header="${state%%$'\n'*}"
    IFS='|' read -r _count react_kind react_id react_review react_revision <<<"$header"
    live=""
    if [[ "$state" == *$'\n'* ]]; then
        while IFS= read -r marker; do
            [[ -n "$marker" ]] || continue
            live+="${live:+ }$marker"
        done <<<"${state#*$'\n'}"
    fi
    # What is compared is *membership*: is the one marker the caller read still live?  rad reports an
    # entry per emoji, and a second marker of ours beside it is a state this call has nothing to say
    # about -- the step takes back the marker named and sets '<to>', so such a state is resolved one
    # marker at a time instead of being refused ('--from "✅" 👀' beside a live '❓' is a transition).
    local found="no marker"
    [[ -n "$live" ]] && found="'$live'"
    if [[ -n "$from_given" ]]; then
        if [[ -z "$from" ]]; then
            if [[ -n "$live" ]]; then
                error "the state of $type:${react_id} is $found where no marker was expected: nothing was written"
                return 1
            fi
        elif [[ " $live " != *" $from "* ]]; then
            error "the state of $type:${react_id} is $found where '$from' was expected: nothing was written"
            return 1
        fi
    fi

    # The action belongs to the COB the state was read from (the issue, or the patch whatever part of
    # it the caller named); the ids it names in full came back with that state, so nothing is resolved
    # a second time.
    case "$type" in
    issue) typename=xyz.radicle.issue ;;
    patch) typename=xyz.radicle.patch ;;
    esac
    level="$(rad_reaction_level "$type" "$react_kind" "$react_id" "$RAD_METADATA_ID")"

    # Set first, take the old one back after: both actions ride the same op, the newer marker is the
    # one a reader resolves, and a transition therefore leaves one live marker of ours behind -- at
    # every level, which is what the typed commands cannot do for an issue.
    if [[ -n "$to" ]]; then
        actions+=( "$(rad_reaction_action "$to" true "$react_kind" "$react_id" "$react_review" "$react_revision")" ) ||
            return $?
    fi
    # …and the marker the caller expected is taken back in the same op: one expectation, one withdrawal,
    # exactly one marker changed.  '<from>' equal to '<to>' is refused above, so the pair is never the
    # same emoji and the order of the two actions cannot decide the outcome.
    if [[ -n "$from" ]]; then
        actions+=( "$(rad_reaction_action "$from" false "$react_kind" "$react_id" "$react_review" "$react_revision")" ) ||
            return $?
        withdrawn=yes
    fi
    if (( ${#actions[@]} )); then
        action_file="$(mktemp)" || {
            error 'no temporary file for the action list'
            return 1
        }
        printf '%s\n' "${actions[@]}" >"$action_file"
        rad_metadata_rad "$repo" cob update --type "$typename" --object "$RAD_METADATA_ID" \
            --message React "$action_file" >/dev/null || rc=$?
        rm -f "$action_file"
        (( rc == 0 )) || return $rc
    fi

    printf 'applied reaction item=%s:%s level=%s target=%s from=%s to=%s withdrawn=%s\n' \
        "$type" "$RAD_METADATA_ID" "$level" "$react_id" "${from:--}" "${to:--}" "${withdrawn:-no}"
}

function rad_topic_json ## <root> <name> <path> <base> <head> <fetched> - one object
{
    printf '{"bar_rad":1,"action":"topic","root":%s,"name":%s,"path":%s,"branch":%s,"base":%s,"head":%s,"fetched":%s}\n' \
        "$(json_string "$1")" \
        "$(json_string "$2")" \
        "$(json_string "$3")" \
        "$(json_string "$2")" \
        "$(json_string "$4")" \
        "$(json_string "$5")" \
        "$(json_bool "$6")"
}

function rad_topic ## <class> <description> [--root <clone>] [--base <ref>] [--no-fetch] [--dry-run] [--json] - open the topic tree of an incoming item
{
    ## Body of the 'rad_topic' rule.  Nothing is created before the class, the name, the clone,
    ## the base and the collisions have all been resolved, so a refusal leaves no half-made tree.
    local -a args=()
    local raw arg
    local json="" root="" base="" fetch="yes" dry="" class="" description=""
    local -a classes=()
    local value line known="" slug name name_len wanted
    local tree main_tree remote="" branch="" fetched="none" behind="" head out err

    for raw in "$@"; do
        if [[ "$raw" == --*=* ]]; then
            args+=("${raw%%=*}" "${raw#*=}")
        else
            args+=("$raw")
        fi
    done
    local -i i=0 count=${#args[@]}
    while (( i < count )); do
        arg="${args[i]}"
        i=$(( i + 1 ))
        case "$arg" in
        -h | --help)
            help_usage rad_topic
            return 0
            ;;
        --json) json=1 ;;
        --dry-run) dry=1 ;;
        --no-fetch) fetch="" ;;
        --root | --base)
            if (( i >= count )) || [[ -z "${args[i]}" ]]; then
                help_usage_error rad_topic "'$arg' needs a non-empty value"
                return 2
            fi
            value="${args[i]}"
            i=$(( i + 1 ))
            case "$arg" in
            --root) root="$value" ;;
            --base) base="$value" ;;
            esac
            ;;
        -*)
            help_usage_error rad_topic "unknown argument '$arg'"
            return 2
            ;;
        *)
            if [[ -z "$class" ]]; then
                class="$arg"
            elif [[ -z "$description" ]]; then
                description="$arg"
            else
                help_usage_error rad_topic "unexpected argument '$arg'"
                return 2
            fi
            ;;
        esac
    done

    [[ -n "${BAR_AGENT_JSON:-}" ]] && json=1
    if [[ -z "$class" || -z "$description" ]]; then
        help_usage_error rad_topic "a class and a description are required"
        return 2
    fi

    while IFS= read -r line; do
        classes+=("$line")
    done < <(rad_classes)
    if (( ${#classes[@]} == 0 )); then
        printf 'rad_topic: cannot read the branch classes from %s\n' "${BAR_DIR:-?}/git" >&2
        return 2
    fi
    wanted="${class%-}-"
    for line in "${classes[@]}"; do
        [[ "$line" == "$wanted" ]] && known=yes
    done
    if [[ -z "$known" ]]; then
        help_usage_error rad_topic "unknown class '$class', want one of: ${classes[*]}"
        return 2
    fi

    slug="$(rad_slug "$description")"
    if [[ -z "$slug" ]]; then
        help_usage_error rad_topic "the description '$description' has no usable character"
        return 2
    fi
    name="${wanted}${slug}"
    name_len=${#name}
    if (( name_len > 40 )); then
        printf 'rad_topic: the name is %d characters, at most 40 are allowed: %s -- shorten the description\n' \
            "$name_len" "$name" >&2
        return 1
    fi

    ## The clone: always the *main* checkout, also when the caller sits inside a topic tree.
    if [[ -n "$root" ]]; then
        if ! tree="$(git -C "$root" rev-parse --show-toplevel 2>/dev/null)"; then
            help_usage_error rad_topic "'$root' is not a git repository"
            return 2
        fi
    elif ! tree="$(git rev-parse --show-toplevel 2>/dev/null)"; then
        help_usage_error rad_topic "not inside a git repository, pass --root <clone>"
        return 2
    fi
    main_tree="$(rad_main_checkout "$tree")"

    ## The base: the clone's trunk -- upstream *plus* the local work, so branching off the remote
    ## tip would drop everything this host has not published yet.  The remote is fetched first to
    ## *know* the relation; a trunk which is behind upstream is refused, because updating the trunk
    ## is its own step with its own gate.
    if [[ -n "$base" ]]; then
        :
    else
        branch="$(git -C "$main_tree" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
        if git -C "$main_tree" remote get-url rad >/dev/null 2>&1; then
            remote="rad"
        elif git -C "$main_tree" remote get-url origin >/dev/null 2>&1; then
            remote="origin"
        fi
        if [[ -n "$remote" && -n "$fetch" ]]; then
            if git -C "$main_tree" fetch --quiet --no-tags "$remote" >/dev/null 2>&1; then
                fetched="yes"
            else
                fetched="no"
                printf 'rad_topic: could not fetch %s, the relation to the trunk is stale\n' "$remote" >&2
            fi
        fi
        if [[ "$fetched" == "yes" && -n "$remote" && -n "$branch" ]] &&
            git -C "$main_tree" rev-parse --verify --quiet "refs/remotes/$remote/$branch" >/dev/null; then
            behind="$(git -C "$main_tree" rev-list --count "refs/heads/$branch..refs/remotes/$remote/$branch" 2>/dev/null || true)"
            if [[ -n "$behind" && "$behind" != "0" ]]; then
                printf 'rad_topic: the trunk %s is %s commit(s) behind %s/%s -- update the trunk first (fetch, merge upstream into it, run its gate) or name the base with --base\n' \
                    "$branch" "$behind" "$remote" "$branch" >&2
                return 1
            fi
        fi
        if [[ -n "$branch" ]]; then
            base="$branch"
        else
            base="HEAD"
        fi
    fi

    local wt_dir="$main_tree/.worktrees"
    local wt_path="$wt_dir/$name"
    if [[ -e "$wt_path" ]]; then
        printf 'rad_topic: the tree already exists: %s\n' "$wt_path" >&2
        return 1
    fi
    if git -C "$main_tree" show-ref --verify --quiet "refs/heads/$name"; then
        printf 'rad_topic: the branch already exists: %s\n' "$name" >&2
        return 1
    fi

    if [[ -n "$dry" ]]; then
        if [[ -n "$json" ]]; then
            rad_topic_json "$main_tree" "$name" "$wt_path" "$base" "-" "$fetched"
        else
            printf '%s  %s  base=%s\n' "$wt_path" "$name" "$base"
        fi
        return 0
    fi

    rad_exclude_worktrees "$main_tree"
    mkdir -p "$wt_dir" 2>/dev/null || {
        printf 'rad_topic: cannot create %s\n' "$wt_dir" >&2
        return 2
    }
    if ! err="$(git -C "$main_tree" worktree add --quiet "$wt_path" -b "$name" "$base" 2>&1)"; then
        printf 'rad_topic: git worktree add failed: %s\n' "${err:-unknown error}" >&2
        return 2
    fi
    head="$(git -C "$wt_path" rev-parse --short HEAD 2>/dev/null || printf '-')"

    if [[ -n "$json" ]]; then
        rad_topic_json "$main_tree" "$name" "$wt_path" "$base" "$head" "$fetched"
    else
        out="$(printf '%s  %s  base=%s  head=%s' "$wt_path" "$name" "$base" "$head")"
        printf '%s\n' "$out"
    fi
    return 0
}


# --- merging the acceptances: rad_merge_accepted_prs ---------------------------------------------

function rad_merge_delegate ## <rid> <nid> - 0 when that identity is a delegate of the repository
{
    ## The delegate list is a fact about *today*: a repository can delegate us at any time and take
    ## it back, so it is read here, per run, never remembered.  A line is '<did> (<alias>)', so the
    ## identity is what stands before the first blank.
    local rid="$1" nid="$2" did list=""
    [[ -n "$nid" ]] || return 1
    list="$(rad_run inspect "$rid" --delegates)" || return 1
    while IFS= read -r did; do
        did="${did%% *}"
        [[ -n "$did" ]] || continue
        if [[ "$(rad_metadata_nid "$did")" == "$nid" ]]; then
            return 0
        fi
    done <<<"$list"
    return 1
}

function rad_merge_ref ## <storage> <id> - the COB ref of that patch, empty when it is not there
{
    ## A COB lives in the namespace of every identity which replicated it, so the newest copy is the
    ## one to read -- else every op would be read once per copy.
    local storage="$1" id="$2" epoch ref
    while IFS="$RAD_RS" read -r epoch ref; do
        [[ -n "$ref" ]] || continue
        [[ "${ref##*/}" == "$id"* ]] || continue
        printf '%s' "$ref"
        return 0
    done < <(git --git-dir="$storage" for-each-ref --sort=-committerdate \
        --format="%(committerdate:unix)${RAD_RS}%(refname)" \
        'refs/namespaces/*/refs/cobs/xyz.radicle.patch/*' 2>/dev/null)
    return 1
}

function rad_merge_read ## <storage> <ref> <rid> - the head revision of a patch and its newest followup
{
    ## Sets the 'RAD_MERGE_*' facts of one patch:
    ##
    ##   RAD_MERGE_REVISION       the head revision: the newest 'Create patch' or 'Add revision' op,
    ##                            an unrevised patch is its own head.  That op's own id is the id a
    ##                            review has to name -- 'rad patch list' shows the revision's commit
    ##                            instead, which is a different thing.
    ##   RAD_MERGE_COMMIT         the commit that revision carries
    ##   RAD_MERGE_ACCEPT         the identity which accepted it, empty when none did
    ##   RAD_MERGE_STALE          why an acceptance found in the chain does not count, empty when
    ##                            none is stale: 'revision' (an older revision was accepted),
    ##                            'not-a-delegate', 'review:<verdict>' or 'followup:<kind>'
    ##   RAD_MERGE_COMMENT        the newest comment of the chain, '<op> <nid>'
    ##
    ## The acceptance is the newest *followup* of the chain.  A reaction is not one: a marker is
    ## bookkeeping -- the reaction loop writes one on every event it reads -- so counting a marker
    ## as a followup would void the acceptance of every patch the moment somebody looks at it.
    ## Everything else is one: a comment, a new revision, an edit, a lifecycle op.  The walk is over
    ## the COB's own first parent chain (a COB commit carries the whole chain as parents), newest op
    ## first, and it stops at the head revision.
    local storage="$1" ref="$2" rid="$3"
    local op mail subject nid payload verdict revision followed=""
    RAD_MERGE_REVISION="" RAD_MERGE_COMMIT=""
    RAD_MERGE_ACCEPT="" RAD_MERGE_STALE="" RAD_MERGE_COMMENT=""

    while IFS="$RAD_US" read -r op mail subject; do
        [[ -n "$op" ]] || continue
        nid="$(rad_metadata_mail_nid "$mail")"
        [[ -n "$nid" ]] || break     ## no radicle identity: not an op of this item
        case "$subject" in
        'Create patch' | 'Add revision')
            payload="$(git --git-dir="$storage" cat-file -p "${op}^{tree}:0" 2>/dev/null)" || payload=""
            RAD_MERGE_REVISION="$op"
            RAD_MERGE_COMMIT="$(printf '%s' "$payload" | jq -r '.oid // empty' 2>/dev/null)"
            break
            ;;
        esac
    done < <(git --git-dir="$storage" log --first-parent \
        --format="%H${RAD_US}%ae${RAD_US}%s" "$ref" 2>/dev/null)
    [[ -n "$RAD_MERGE_REVISION" ]] || return 1

    while IFS="$RAD_US" read -r op mail subject; do
        [[ -n "$op" ]] || continue
        [[ "$op" == "$RAD_MERGE_REVISION" ]] && break
        nid="$(rad_metadata_mail_nid "$mail")"
        [[ -n "$nid" ]] || break
        case "$subject" in
        React | 'React comment') continue ;;
        Comment) [[ -n "$RAD_MERGE_COMMENT" ]] || RAD_MERGE_COMMENT="$op $nid" ;;
        esac
        [[ -n "$followed" ]] && continue
        followed=1
        case "$subject" in
        Review)
            payload="$(git --git-dir="$storage" cat-file -p "${op}^{tree}:0" 2>/dev/null)" || payload=""
            revision="$(printf '%s' "$payload" | jq -r '.revision // empty' 2>/dev/null)"
            verdict="$(printf '%s' "$payload" | jq -r '.verdict // empty' 2>/dev/null)"
            if [[ "$verdict" != accept ]]; then
                RAD_MERGE_STALE="review:${verdict:-unknown}"
            elif [[ "$revision" != "$RAD_MERGE_REVISION" ]]; then
                RAD_MERGE_STALE="revision"
            elif ! rad_merge_delegate "$rid" "$nid"; then
                RAD_MERGE_STALE="not-a-delegate"
            else
                RAD_MERGE_ACCEPT="$nid"
            fi
            ;;
        Comment) RAD_MERGE_STALE="followup:comment" ;;
        'Add revision') RAD_MERGE_STALE="followup:revision" ;;
        'Edit root') RAD_MERGE_STALE="followup:edit" ;;
        Lifecycle) RAD_MERGE_STALE="followup:lifecycle" ;;
        *) RAD_MERGE_STALE="followup" ;;
        esac
    done < <(git --git-dir="$storage" log --first-parent \
        --format="%H${RAD_US}%ae${RAD_US}%s" "$ref" 2>/dev/null)
    return 0
}

function rad_merge_target ## <toplevel> <patch> - the branch that patch targets, empty when rad hides it
{
    ## 'rad patch list' has no target column and the patch's own revision payload does not carry one
    ## either, so the header of 'rad patch show' is the one place which says it.
    local toplevel="$1" patch="$2" show line
    show="$(cd "$toplevel" && rad_run patch show "$patch")" || return 1
    while IFS= read -r line; do
        [[ "$line" == *"│ Target "* ]] || continue
        line="$(rad_line "$line")"
        printf '%s' "${line%% *}"
        return 0
    done <<<"$show"
    return 1
}

function rad_merge_upstream ## <toplevel> <target> - the commit the canonical branch holds
{
    ## What a patch is merged into is the *canonical* branch as the last fetch left it.  Merging into
    ## the local branch instead would publish whatever else sits on it, which is not this helper's
    ## business.
    local toplevel="$1" target="$2" sha=""
    sha="$(git -C "$toplevel" rev-parse --verify --quiet "refs/remotes/rad/$target^{commit}" 2>/dev/null)" || sha=""
    if [[ -z "$sha" ]]; then
        sha="$(git -C "$toplevel" rev-parse --verify --quiet "refs/heads/$target^{commit}" 2>/dev/null)" || sha=""
    fi
    [[ -n "$sha" ]] || return 1
    printf '%s' "$sha"
}

function rad_merge_push ## <toplevel> <upstream> <head> <target> <patch> - merge and push, print the commit
{
    ## 'merge-tree' writes the merged tree without a working tree (and is the clean-merge test),
    ## 'commit-tree' makes the merge commit, the push names that commit: no tree is ever switched, so
    ## a checkout somebody is working in stays exactly where it is.  A head the canonical branch
    ## already contains is pushed as it is -- a fast-forward, linear history, and the gate run at the
    ## head is the post-merge gate.
    ##
    ## Returns 1 when the push failed and 2 when it went somewhere else: 'refs/heads/<target>' is the
    ## canonical branch, and rad has to say that the canonical reference moved -- a push which
    ## succeeded without that line landed in our own namespace, which is not a merge.
    local toplevel="$1" upstream="$2" head="$3" target="$4" patch="$5"
    local commit="" tree="" out=""
    if git -C "$toplevel" merge-base --is-ancestor "$upstream" "$head" 2>/dev/null; then
        commit="$head"
    else
        tree="$(git -C "$toplevel" merge-tree --write-tree "$upstream" "$head" 2>/dev/null)" || return 1
        [[ -n "$tree" ]] || return 1
        commit="$(printf 'merge patch %s\n' "$patch" |
            git -C "$toplevel" commit-tree "$tree" -p "$upstream" -p "$head" -F - 2>/dev/null)" || return 1
        [[ -n "$commit" ]] || return 1
    fi
    out="$(git -C "$toplevel" push rad "${commit}:refs/heads/${target}" 2>&1)" || return 1
    [[ "$out" == *'Canonical reference'* ]] || return 2
    printf '%s' "$commit"
    return 0
}

function rad_merge_abort ## <toplevel> <storage> <revision> <upstream> <nid> <last-comment> - the abort note
{
    ## 'does not merge at upstream <sha>' is the comment the abort owes the author, and it goes on the
    ## revision it is about.  Once per head revision, not once per run: when our own newest comment
    ## already says exactly that, the patch was reported before and nothing is appended again.
    local toplevel="$1" storage="$2" revision="$3" upstream="$4" nid="$5" last="$6"
    local op="" author="" previous="" body="does not merge at upstream $upstream"
    if [[ -n "$last" ]]; then
        op="${last%% *}"
        author="${last##* }"
    fi
    if [[ -n "$op" && "$author" == "$nid" ]]; then
        previous="$(rad_metadata_body "$storage" "$op" patch Comment 2>/dev/null)" || previous=""
        [[ "$previous" == "$body" ]] && return 0
    fi
    if ! ( cd "$toplevel" && rad_run patch comment "$revision" -m "$body" >/dev/null ); then
        warn "could not comment 'does not merge at upstream $upstream' on $revision"
        return 1
    fi
    return 0
}

function rad_merge_accepted_prs ## [--dry-run] [--no-fetch] [--max <n>] [--json] - merge the patches a delegate accepted and which merge cleanly into their target branch
{
    local -a args=( ${RULE_ARGS[@]+"${RULE_ARGS[@]}"} )
    local -a rows=() ids=()
    local -A tip=()
    local raw arg value dry="" json="" nofetch="" max=0
    local -i i=0 failed=0 landed=0
    local toplevel="" rid="" radpath="" storage="" self="" alias="" nid="" delegate="no"
    local table="" listing="" id="" head="" target="-" upstream="-" revision="-" verdict="" reason=""
    local ref="" commit="" rc=0

    while (( i < ${#args[@]} )); do
        arg="${args[i]}"
        case "$arg" in
        -h | --help)
            help_usage rad_merge_accepted_prs
            return 0
            ;;
        --dry-run) dry=1 ;;
        --json) json=1 ;;
        --no-fetch) nofetch=1 ;;
        --max)
            i=$(( i + 1 ))
            max="${args[i]:-}"
            [[ "$max" =~ ^[0-9]+$ ]] || { help_usage_error rad_merge_accepted_prs "'--max' needs a number"; return 2; }
            ;;
        --max=*)
            max="${arg#--max=}"
            [[ "$max" =~ ^[0-9]+$ ]] || { help_usage_error rad_merge_accepted_prs "'--max' needs a number"; return 2; }
            ;;
        *)
            help_usage_error rad_merge_accepted_prs "unknown argument '$arg'"
            return 2
            ;;
        esac
        i=$(( i + 1 ))
    done
    [[ -n "${BAR_AGENT_JSON:-}" ]] && json=1

    is_command_installed "$RAD_BIN" || {
        error "'$RAD_BIN' is not installed"
        return 1
    }
    ## There is no '--repo': the checkout it is run from is the repository, and its canonical
    ## branch is the one the patches are merged into.
    if ! toplevel="$(git rev-parse --show-toplevel 2>/dev/null)"; then
        error "not a git repository: 'rad_merge_accepted_prs' merges the patches of the checkout it runs in"
        return 3
    fi

    rid="$(cd "$toplevel" && rad_run inspect --rid)" || return $?
    rid="${rid##*$'\n'}"
    radpath="$(rad_path)" || radpath=""
    storage="$radpath/storage/${rid#rad:}"
    if [[ -z "$radpath" || ! -d "$storage" ]]; then
        error "the node holds no storage for '$rid': '${RAD_BIN} path' says '${radpath:--}'"
        return 3
    fi

    self="$(LC_ALL=C "$RAD_BIN" self 2>/dev/null)" || self=""
    if [[ -n "$self" ]]; then
        alias="$(printf '%s\n' "$self" | LC_ALL=C sed -n 's/^Alias[[:space:]]\{1,\}//p' | head -1)"
        nid="$(rad_metadata_nid "$(printf '%s\n' "$self" | LC_ALL=C sed -n 's/^DID[[:space:]]\{1,\}//p' | head -1)")"
    fi
    rad_merge_delegate "$rid" "$nid" && delegate="yes"
    if [[ "$delegate" != yes && -z "$dry" ]]; then
        error "the identity '${alias:--}' is not a delegate of $rid: updating the canonical branch is theirs to do (--dry-run reads what is ready without writing)"
        return 1
    fi

    if [[ -z "$nofetch" ]] && git -C "$toplevel" remote | grep -qx rad; then
        git -C "$toplevel" fetch --quiet rad 2>/dev/null ||
            warn "'git fetch rad' failed, the target branches are read as they are"
    fi

    table="$(cd "$toplevel" && rad_run patch list --open)" || return $?
    listing="$(rad_state_table_checked 'patch list --open' "$table" ID Head)" || return 1
    while IFS="$RAD_US" read -r id head; do
        [[ -n "$id" ]] || continue
        ids+=("$id")
    done <<<"$listing"

    ## Oldest first: an older topic has waited longest, and a merge into the same branch moves the
    ## base under every younger one anyway.
    for (( i = ${#ids[@]} - 1; i >= 0; i-- )); do
        if (( max > 0 && landed >= max )); then
            break
        fi
        id="${ids[i]}"
        head="-" target="-" upstream="-" revision="-" verdict="" reason=""
        if ! ref="$(rad_merge_ref "$storage" "$id")"; then
            rows+=("blocked${RAD_US}${id}${RAD_US}-${RAD_US}-${RAD_US}-${RAD_US}-${RAD_US}no-storage")
            continue
        fi
        rad_merge_read "$storage" "$ref" "$rid" || {
            rows+=("blocked${RAD_US}${id}${RAD_US}-${RAD_US}-${RAD_US}-${RAD_US}-${RAD_US}no-revision")
            continue
        }
        revision="$RAD_MERGE_REVISION"
        head="${RAD_MERGE_COMMIT:--}"
        if [[ -z "$RAD_MERGE_ACCEPT" ]]; then
            rows+=("blocked${RAD_US}${id}${RAD_US}${target}${RAD_US}${head}${RAD_US}${revision}${RAD_US}${upstream}${RAD_US}${RAD_MERGE_STALE:-no-accept}")
            continue
        fi
        if ! target="$(rad_merge_target "$toplevel" "$id")" || [[ -z "$target" ]]; then
            target="-"
            rows+=("blocked${RAD_US}${id}${RAD_US}-${RAD_US}${head}${RAD_US}${revision}${RAD_US}-${RAD_US}no-target")
            continue
        fi
        upstream="${tip[$target]:-}"
        if [[ -z "$upstream" ]] && ! upstream="$(rad_merge_upstream "$toplevel" "$target")"; then
            upstream="-"
            rows+=("blocked${RAD_US}${id}${RAD_US}${target}${RAD_US}${head}${RAD_US}${revision}${RAD_US}-${RAD_US}no-upstream")
            failed=$(( failed + 1 ))
            continue
        fi

        ## Whether it merges at all is read in both modes -- that is the answer a dry run owes,
        ## and it writes nothing to find out.
        verdict="mergeable"
        reason="fast-forward"
        rc=0
        if ! git -C "$toplevel" merge-base --is-ancestor "$upstream" "$head" 2>/dev/null; then
            reason="merge-commit"
            git -C "$toplevel" merge-tree --write-tree "$upstream" "$head" >/dev/null 2>&1 || rc=$?
        fi
        if (( rc == 1 )); then
            verdict="conflict"
            reason="does-not-merge"
            if [[ -z "$dry" ]]; then
                rad_merge_abort "$toplevel" "$storage" "$revision" "$upstream" "$nid" "$RAD_MERGE_COMMENT" ||
                    failed=$(( failed + 1 ))
            fi
        elif (( rc > 1 )); then
            verdict="blocked"
            reason="merge-tree-failed"
            failed=$(( failed + 1 ))
        elif [[ -n "$dry" ]]; then
            reason="dry-run"
        else
            rc=0
            commit="$(rad_merge_push "$toplevel" "$upstream" "$head" "$target" "$id")" || rc=$?
            if (( rc == 0 )); then
                verdict="merged"
                tip["$target"]="$commit"
                landed=$(( landed + 1 ))
            elif (( rc == 2 )); then
                verdict="blocked"
                reason="not-canonical"
                failed=$(( failed + 1 ))
            else
                verdict="blocked"
                reason="push-failed"
                failed=$(( failed + 1 ))
            fi
        fi
        rows+=("${verdict}${RAD_US}${id}${RAD_US}${target}${RAD_US}${head}${RAD_US}${revision}${RAD_US}${upstream}${RAD_US}${reason}")
    done

    if [[ -n "$json" ]]; then
        if (( ${#rows[@]} == 0 )); then
            jq -cn --arg repo "$rid" --arg identity "$alias" --arg delegate "$delegate" \
                '{bar_rad: 1, repo: $repo, identity: $identity, delegate: ($delegate == "yes"), patches: []}'
        else
            printf '%s\n' "${rows[@]}" | jq -Rn --arg repo "$rid" --arg identity "$alias" --arg delegate "$delegate" '
                [inputs | select(length > 0) | split("\u001f")
                 | {verdict: .[0], patch: .[1], target: .[2], head: .[3],
                    revision: .[4], upstream: .[5], reason: .[6]}]
                | {bar_rad: 1, repo: $repo, identity: $identity,
                   delegate: ($delegate == "yes"), patches: .}'
        fi
    elif (( ${#rows[@]} == 0 )); then
        note "no open patch in $rid"
    else
        printf '%s\n' "${rows[@]}" |
            while IFS="$RAD_US" read -r verdict id target head revision upstream reason; do
                printf '%s patch=%s target=%s head=%s revision=%s upstream=%s reason=%s\n' \
                    "$verdict" "$id" "$target" "$head" "$revision" "$upstream" "$reason"
            done
    fi

    if (( failed )); then
        return 1
    fi
    return 0
}

# --- rad_cob: the COB store, one interface for a consumer -----------------------------------------
#
# Every consumer of the store -- the reaction loop, the dashboard, the reader behind
# 'rad_comment_metadata' -- derives its state from the same three questions: which COBs does this
# repository carry, what is one COB's op chain, and what does the store reduce a COB to.  It
# answered them through two independent readers with two shapes, one of them a hand-rolled walk of
# the namespace refs; this is the one interface.  'rad' reads the store -- it owns the layout and
# the choice of copy -- bar reads 'rad', and the consumer reads one shape per question.
#
#   list       every COB the store holds, per type, with the copy a read lands on
#   ops        one COB's op chain, oldest first, the objects 'rad cob log' prints and nothing else
#   document   one COB reduced: an issue's thread, a patch's revisions and their reviews, and an
#              identity COB's repository document (payload, delegates, threshold at the head)
#
# NOTHING HERE DERIVES A NAMESPACE REF.  A COB sits in every namespace that replicated it, so a
# read has to choose one; 'list' names the namespace whose tip is the newest ('copy'), 'document'
# names the one the read landed on, and a read whose tip is not the newest is named as behind
# instead of passing as complete.
#
# 'ops' is the store's own JSON, verbatim: an op is what 'rad cob log --format json' makes of it
# ('id', 'author' as the NID, 'timestamp' as epoch milliseconds, 'actions', 'manifest', 'parents',
# 'related', 'identity') and this helper adds nothing to it -- a consumer which reads the chain
# today reads the same objects tomorrow.  'document' is the normalized shape, because 'cob show'
# speaks two dialects (an issue keeps its timeline under 'thread', an author is a bare NID in a
# comment and an object at the root, dates are milliseconds): one kind of comment object, ISO dates
# in the reader's local offset, a 'redacted' flag instead of a missing body, reactions as
# '{"emoji", "authors"}' whatever the store's two encodings are.  An identity COB is answered by
# the type it was asked as, never by the shape it has: the store keeps its revisions too, so a shape
# test renders it as a patch with an empty target and a fabricated revision -- the consumer asking
# "is this host a delegate, which branch is default" would read that and never learn its question
# was not understood.  '--bodies' adds the comment texts (an empty body and 'redacted: true' for a
# redacted one); without it the document carries the structure and no text.
#
# FAILURE IS PART OF THE INTERFACE.  A consumer that reads only the exit code and stdout tells the
# four apart, because each answer is one JSON line with an 'error' field:
#
#   0  answered
#   1  refused        the store refused; 'detail' is its own first line, unchanged
#   2  usage          (nothing on stdout)
#   3  notfound       no such repository, type or object
#   4  absent         the store lists the object, and nothing materialises (measured on
#                     'example_project2' patch 02e1abf: 'cob list' names it, 'cob show' says it was
#                     not found, and 'rad patch list --all' does not carry it)
#   5  unreadable     the store or the node cannot be read at all -- the difference between 'this
#                     item is gone' and 'nothing can be read right now'
#
# 'refused' is what is left when an object the store lists fails to reduce for any reason other
# than 'not found': a store error, an unsupported manifest, an identity it cannot resolve.

function rad_cob_call ## <args>.. - one 'rad' invocation, its answer (both streams) and its status
{
    ## Like 'rad_run', except that the answer is *returned* and nothing is reported: a store failure
    ## is itself an answer here -- the four failure cases are told apart by it, and the store's own
    ## first line is what 'refused' and 'absent' publish.  'rad' writes its error to stdout, so
    ## folding the streams in loses nothing.
    LC_ALL=C "$RAD_BIN" "$@" 2>&1
}

function rad_cob_first_line ## <text> - the first line of <text>
{
    local line
    while IFS= read -r line; do
        printf '%s' "$line"
        return 0
    done <<<"$1"
}

function rad_cob_fail ## <case> <type> <cob> <detail> - the answer of a failure and its exit code
{
    ## One JSON line on stdout, so the four cases are told apart by what a consumer already reads.
    ## 'detail' is the store's own first line where there is one: a paraphrase would hide the
    ## sentence the operator has to search for.
    local case_name="$1" typename="${2:-}" cob="${3:-}" detail="${4:-}"
    jq -cn --arg error "$case_name" --arg kind "${typename#xyz.radicle.}" --arg cob "$cob" \
        --arg detail "$detail" \
        '{error: $error,
          kind: (if $kind == "" then null else $kind end),
          cob: (if $cob == "" then null else $cob end),
          detail: $detail}'
    case "$case_name" in
    notfound) return 3 ;;
    absent) return 4 ;;
    unreadable) return 5 ;;
    *) return 1 ;;
    esac
}

function rad_cob_typename ## <type> - the store's type name, 1 when it is not one of the three
{
    case "$1" in
    issue | patch | id) printf 'xyz.radicle.%s' "$1" ;;
    xyz.radicle.issue | xyz.radicle.patch | xyz.radicle.id) printf '%s' "$1" ;;
    *) return 1 ;;
    esac
}

function rad_cob_repo ## <verb> <repo> - the repository a read is about, in RAD_COB_*
{
    ## A RID is answered by the node alone ('rad' then needs no checkout); a path -- or nothing,
    ## which is the checkout the command runs in -- is named by 'rad inspect --rid'.  A RID the node
    ## holds no storage for is 'notfound' (the repository is not here), while a node which cannot
    ## even say where its storage is has nothing to read at all ('unreadable').
    local name="$1" repo="$2"
    local toplevel="" rid="" radpath="" storage=""
    if [[ -n "$repo" && "$repo" != rad:* ]]; then
        toplevel="$(cd "$repo" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null)" || toplevel=""
        if [[ -z "$toplevel" ]]; then
            error "'$repo' is neither a RID nor a checkout"
            rad_cob_fail notfound "" "" "'$repo' is neither a RID nor a checkout"
            return 3
        fi
    elif [[ -z "$repo" ]]; then
        toplevel="$(git rev-parse --show-toplevel 2>/dev/null)" || toplevel=""
        if [[ -z "$toplevel" ]]; then
            error "'rad_cob $name' reads the checkout it runs in, and this is none; '--repo' names one"
            rad_cob_fail notfound "" "" "not a checkout, and no --repo names the repository"
            return 3
        fi
    fi
    if [[ -n "$toplevel" ]]; then
        if ! rid="$(cd "$toplevel" && rad_run inspect --rid)"; then
            rad_cob_fail notfound "" "" "no radicle repository at '$toplevel'"
            return 3
        fi
        rid="${rid##*$'\n'}"
    else
        rid="$repo"
    fi
    radpath="$(rad_path)" || radpath=""
    if [[ -z "$radpath" ]]; then
        rad_cob_fail unreadable "" "" "'$RAD_BIN path' names no storage"
        return 5
    fi
    storage="$radpath/storage/${rid#rad:}"
    if [[ ! -d "$storage" ]]; then
        ## No storage for that RID is 'not found' only when the node itself answers: a profile
        ## which is not there, or a node which cannot be reached, has nothing to read at all, and a
        ## consumer must not read that as 'the repository is gone'.
        if ! self="$(rad_cob_call self)"; then
            rad_cob_fail unreadable "" "" "'$RAD_BIN' cannot answer: $(rad_cob_first_line "$self")"
            return 5
        fi
        rad_cob_fail notfound "" "" "the node holds no storage for '$rid'"
        return 3
    fi
    RAD_COB_RID="$rid"
    RAD_COB_STORAGE="$storage"
    return 0
}

function rad_cob_ids ## <rid> <typename> - the ids the store holds of one type, one per line
{
    local rid="$1" typename="$2" out=""
    if ! out="$(rad_cob_call cob list -r "$rid" -t "$typename")"; then
        return 1
    fi
    printf '%s\n' "$out" | LC_ALL=C grep -E '^[0-9a-f]{40}$' || true
}

function rad_cob_tip ## <ops-json> - the id of the newest op rad printed, empty when there is none
{
    local line
    while IFS= read -r line; do
        [[ "$line" == \{* ]] || continue
        printf '%s' "$line" | jq -r '.id // empty' 2>/dev/null
        return 0
    done <<<"$1"
}

function rad_cob_copy_note ## <storage> <type> <id> <op_id> - name the copy a read landed on
{
    ## Sets 'RAD_COB_COPY' to the namespace a read landed on, and says it on stderr -- always, not
    ## at some verbosity: it is the answer to 'which copy is this', and a consumer that derives a
    ## verdict from a chain behind the newest copy has to be able to see that.  The op's id is the
    ## commit a namespace ref points at, so the tip names its copies; when the newest copy is a
    ## different tip the answer is behind it, and that is a loud line, not a note.
    local storage="$1" typename="$2" id="$3" op_id="$4"
    local nids="" newest="" newest_tip="" newest_nid="" label="${typename#xyz.radicle.}"
    RAD_COB_COPY=""
    [[ -n "$op_id" ]] || return 0
    nids="$(rad_cob_nids "$storage" "$typename" "$id" "$op_id")"
    nids="${nids% }"
    newest="$(rad_cob_newest "$storage" "$typename" "$id")"
    if [[ -n "$newest" ]]; then
        newest_tip="${newest#* }"
        newest_tip="${newest_tip%% *}"
        newest_nid="${newest##* }"
    fi
    RAD_COB_COPY="${nids%% *}"
    [[ -n "$RAD_COB_COPY" ]] || RAD_COB_COPY="$newest_nid"
    if [[ -z "$newest" ]]; then
        printf 'rad_cob: copy %s:%s: the storage names no copy, read tip %s\n' "$label" "$id" "$op_id" >&2
        return 0
    fi
    if [[ "$newest_tip" != "$op_id" ]]; then
        printf 'rad_cob: copy %s:%s: read tip %s, but the newest copy is %s at %s -- the answer is behind\n' \
            "$label" "$id" "$op_id" "$newest_nid" "$newest_tip" >&2
        return 0
    fi
    printf 'rad_cob: copy %s:%s: read from %s at %s\n' "$label" "$id" "${nids// /,}" "$op_id" >&2
}

function rad_cob_list ## see the module header
{
    local -a args=() types=() rows=() missed=() parts=()
    local arg value repo="" type="" typename="" out="" id="" newest="" copy=""
    local -i i=0 count=0 listed=0

    for arg in "$@"; do
        if [[ "$arg" == --*=* ]]; then
            args+=("${arg%%=*}" "${arg#*=}")
        else
            args+=("$arg")
        fi
    done
    count=${#args[@]}
    while (( i < count )); do
        arg="${args[i]}"
        i=$(( i + 1 ))
        case "$arg" in
        -h | --help)
            help_usage rad_cob
            return 0
            ;;
        --json) : ;;
        --format)
            if (( i >= count )) || [[ -z "${args[i]}" ]]; then
                help_usage_error rad_cob "'--format' needs a value"
                return 2
            fi
            value="${args[i]}"
            i=$(( i + 1 ))
            if [[ "$value" != json ]]; then
                help_usage_error rad_cob "'--format $value' is not an answer this helper prints (json only)"
                return 2
            fi
            ;;
        --repo | --type)
            if (( i >= count )) || [[ -z "${args[i]}" ]]; then
                help_usage_error rad_cob "'$arg' needs a non-empty value"
                return 2
            fi
            value="${args[i]}"
            i=$(( i + 1 ))
            case "$arg" in
            --repo) repo="$value" ;;
            --type)
                IFS=',' read -r -a parts <<<"$value"
                for type in ${parts[@]+"${parts[@]}"}; do
                    if [[ -n "$type" ]]; then
                        types+=("$type")
                    fi
                done
                ;;
            esac
            ;;
        -*)
            help_usage_error rad_cob "unknown argument '$arg'"
            return 2
            ;;
        *)
            help_usage_error rad_cob "unexpected argument '$arg'"
            return 2
            ;;
        esac
    done
    (( ${#types[@]} )) || types=(issue patch id)
    for type in "${types[@]}"; do
        if ! rad_cob_typename "$type" >/dev/null; then
            help_usage_error rad_cob "'$type' is not a COB type this store carries (issue, patch, id)"
            return 2
        fi
    done

    rad_cob_repo list "$repo" || return $?
    for type in "${types[@]}"; do
        typename="$(rad_cob_typename "$type")"
        if ! out="$(rad_cob_ids "$RAD_COB_RID" "$typename")"; then
            missed+=("${typename#xyz.radicle.}")
            continue
        fi
        listed=$(( listed + 1 ))
        while IFS= read -r id; do
            [[ -n "$id" ]] || continue
            newest="$(rad_cob_newest "$RAD_COB_STORAGE" "$typename" "$id")"
            copy=""
            if [[ -n "$newest" ]]; then
                copy="${newest##* }"
            fi
            rows+=("$(printf '%s%s%s%s%s' "${typename#xyz.radicle.}" "$RAD_US" "$id" "$RAD_US" "$copy")")
        done <<<"$out"
    done
    if (( listed == 0 )); then
        error "the store answered no type of '$RAD_COB_RID': ${missed[*]}"
        rad_cob_fail unreadable "" "" "the store cannot be read: 'rad cob list' failed for ${missed[*]}"
        return 5
    fi
    for type in ${missed[@]+"${missed[@]}"}; do
        error "the store did not answer for '$type': the answer carries the other types only"
    done
    (( ${#rows[@]} )) || return 0
    printf '%s\n' "${rows[@]}" | jq -Rc 'split("\u001f")
        | {kind: .[0], cob: .[1], copy: (if (.[2] // "") == "" then null else .[2] end)}'
    return 0
}

function rad_cob_ops ## see the module header
{
    local -a args=() call=()
    local arg value repo="" type="" object="" from="" until="" typename="" out="" detail="" known=""
    local -i i=0 count=0 match=0

    for arg in "$@"; do
        if [[ "$arg" == --*=* ]]; then
            args+=("${arg%%=*}" "${arg#*=}")
        else
            args+=("$arg")
        fi
    done
    count=${#args[@]}
    while (( i < count )); do
        arg="${args[i]}"
        i=$(( i + 1 ))
        case "$arg" in
        -h | --help)
            help_usage rad_cob
            return 0
            ;;
        --json) : ;;
        --format)
            if (( i >= count )) || [[ -z "${args[i]}" ]]; then
                help_usage_error rad_cob "'--format' needs a value"
                return 2
            fi
            value="${args[i]}"
            i=$(( i + 1 ))
            if [[ "$value" != json ]]; then
                help_usage_error rad_cob "'--format $value' is not an answer this helper prints (json only)"
                return 2
            fi
            ;;
        --repo | --type | --object | --from | --until)
            if (( i >= count )) || [[ -z "${args[i]}" ]]; then
                help_usage_error rad_cob "'$arg' needs a non-empty value"
                return 2
            fi
            value="${args[i]}"
            i=$(( i + 1 ))
            case "$arg" in
            --repo) repo="$value" ;;
            --type) type="$value" ;;
            --object) object="$value" ;;
            --from) from="$value" ;;
            --until) until="$value" ;;
            esac
            ;;
        -*)
            help_usage_error rad_cob "unknown argument '$arg'"
            return 2
            ;;
        *)
            help_usage_error rad_cob "unexpected argument '$arg'"
            return 2
            ;;
        esac
    done
    if [[ -z "$type" || -z "$object" ]]; then
        help_usage_error rad_cob "'ops' needs --type and --object"
        return 2
    fi
    typename="$(rad_cob_typename "$type")" || {
        help_usage_error rad_cob "'$type' is not a COB type this store carries (issue, patch, id)"
        return 2
    }

    rad_cob_repo ops "$repo" || return $?
    ## The store's own listing decides 'not found' from 'absent': an id it lists whose chain does
    ## not materialise is absent, an id it does not list does not exist.  Without the listing the
    ## two are the same message, and a consumer would act on 'gone' for both.
    if ! known="$(rad_cob_ids "$RAD_COB_RID" "$typename")"; then
        error "the store did not answer for '$typename'"
        rad_cob_fail unreadable "$typename" "$object" "the store cannot be read: 'rad cob list' failed"
        return 5
    fi
    while IFS= read -r value; do
        if [[ -n "$value" && "$value" == "$object"* ]]; then
            match=$(( match + 1 ))
        fi
    done <<<"$known"

    call=(cob log -r "$RAD_COB_RID" -t "$typename" -o "$object" --format json)
    if [[ -n "$from" ]]; then
        call+=(--from "$from")
    fi
    if [[ -n "$until" ]]; then
        call+=(--until "$until")
    fi
    if ! out="$(rad_cob_call "${call[@]}")"; then
        detail="$(rad_cob_first_line "$out")"
        if [[ "$detail" == *"not found"* ]]; then
            if (( match )); then
                rad_cob_fail absent "$typename" "$object" "$detail"
                return 4
            fi
            rad_cob_fail notfound "$typename" "$object" "$detail"
            return 3
        fi
        rad_cob_fail refused "$typename" "$object" "$detail"
        return 1
    fi
    rad_cob_copy_note "$RAD_COB_STORAGE" "$typename" "$object" "$(rad_cob_tip "$out")"
    ## 'rad cob log' prints newest first; a chain is read oldest first.  '--from' and '--until'
    ## narrow the same chain and both bounds are inclusive (measured on rad 1.10.3), so the window
    ## is reversed rather than re-derived.
    printf '%s\n' "$out" | LC_ALL=C awk '/^\{/ { line[++n] = $0 } END { for (i = n; i > 0; i--) print line[i] }'
    return 0
}

## The document's shape, one jq program: 'cob show' speaks two dialects -- an issue keeps its
## timeline under 'thread', a patch keeps revisions with their discussions and reviews -- and this
## maps either onto one kind of comment, ISO dates in the reader's local offset ('$off' seconds and
## '$zone' as '+hh:mm'), 'redacted' instead of a missing body, and reactions as objects.
##
## An identity COB is told apart by the type asked for, never by the shape: it keeps 'revisions' in
## the store just like a patch does, and a shape test is what rendered it as one.  Its document is
## the repository at the head revision -- the root revision carries an older payload, delegates and
## threshold -- with those revisions and the timeline left out.
declare -gr RAD_COB_DOCUMENT_JQ='
def nid: (if type == "object" then (.id // "") else (. // "") end) | sub("^did:key:"; "");
def iso:
  if type == "number" then (((. / 1000 | floor) + $off) | gmtime | strftime("%Y-%m-%dT%H:%M:%S")) + $zone
  else null end;
def markers:
  (if type == "array" then . else [] end)
  | map(if type == "array" then {emoji: .[1], authors: [.[0]]}
        else {emoji: .emoji, authors: (.authors // [])} end)
  | map(select(.emoji != null));
def edits_of:
  (if type == "array" then . else [] end)
  | map({author: ((.author // "") | sub("^did:key:"; "")),
         date: ((.timestamp // null) | iso),
         body: (.body // "")});
def comment($tl):
  .key as $id
  | {id: $id,
     author: ((.value.author // "") | sub("^did:key:"; "")),
     date: ((.value.edits // []) | if length > 0 then .[0].timestamp | iso else null end),
     redacted: ((.value.body // null) == null),
     replyTo: (.value.replyTo // null),
     resolved: (.value.resolved // false),
     root: ($id == ($tl[0] // "")),
     reactions: (.value.reactions | markers)}
  + (if $bodies == "yes"
     then {body: (.value.body // ""), edits: (.value.edits | edits_of)}
     else {} end)
  + {order: (($tl | index($id)) // 999999)};
def comments($tl):
  (if type == "object" then to_entries else [] end)
  | map(comment($tl))
  | sort_by(.order)
  | map(del(.order));
def review($tl):
  {id: (.id // null),
   author: (.author | nid),
   verdict: (.verdict // "comment"),
   date: ((.summary // []) | if length > 0 then .[0].timestamp | iso else (.timestamp | iso) end),
   labels: (.labels // []),
   reactions: (.reactions | markers),
   comments: ((.comments.comments // {}) | comments($tl))}
  + (if $bodies == "yes" then {summary: ((((.summary // []) | last) // {}).body // "")} else {} end);

## The repository an identity COB names, as the head revision has it: the op the store calls the
## current one is the head, and a COB which names none falls back to the root -- the first revision,
## and the best answer there is.  Nothing is fabricated: a field the payload does not carry is an
## empty string, and the delegates are handed on as the store spells them, did:key included.
def iddocument:
  . as $d
  | (($d.current // $d.root) // "") as $cur
  | (((($d.revisions // {})[$cur] // {}).doc) // {}) as $doc
  | ((($doc.payload // {})["xyz.radicle.project"]) // {}) as $project
  | {kind: "id",
     cob: $cob,
     copy: (if $copy == "" then null else $copy end),
     current: (if $cur == "" then null else $cur end),
     name: ($project.name // ""),
     description: ($project.description // ""),
     defaultBranch: ($project.defaultBranch // ""),
     delegates: ($doc.delegates // []),
     threshold: ($doc.threshold // null)};

. as $d
| ($d.timeline // $d.thread.timeline // []) as $tl
| (($tl[0]) // "") as $root
| if $type == "xyz.radicle.id" then
    iddocument
  elif ($d.revisions // null) != null then
    {kind: "patch",
     cob: $cob,
     copy: (if $copy == "" then null else $copy end),
     author: ($d.author | nid),
     title: ($d.title // ""),
     state: ($d.state // null),
     target: ($d.target // null),
     labels: ($d.labels // []),
     assignees: ($d.assignees // []),
     merges: ($d.merges // {}),
     timeline: $tl,
     revisions: [ ($d.revisions // {}) | to_entries[]
                  | .key as $rev | .value as $r
                  | {id: ($r.id // $rev),
                     author: ($r.author | nid),
                     date: ($r.timestamp | iso),
                     base: ($r.base // null),
                     oid: ($r.oid // null),
                     resolves: ($r.resolves // null),
                     reactions: ($r.reactions | markers),
                     comments: (($r.discussion.comments // {}) | comments($tl)),
                     reviews: [ (($r.reviews // {}) | to_entries[] | .value | review($tl)) ]}
                    + (if $bodies == "yes"
                       then {description: (((($r.description // []) | last) // {}).body // ""),
                             description_edits: ($r.description | edits_of)}
                       else {} end) ]}
  else
    {kind: "issue",
     cob: $cob,
     copy: (if $copy == "" then null else $copy end),
     author: (((($d.thread.comments // {})[$root] // {}).author // "") | sub("^did:key:"; "")),
     title: ($d.title // ""),
     state: ($d.state // null),
     labels: ($d.labels // []),
     assignees: ($d.assignees // []),
     timeline: $tl,
     comments: (($d.thread.comments // {}) | comments($tl))}
  end
'

function rad_cob_document ## see the module header
{
    local -a args=() call=() parts=()
    local arg value repo="" type="" object="" bodies="no" typename="" out="" detail="" known="" op_id=""
    local zone="" off=0
    local -i i=0 count=0 match=0

    for arg in "$@"; do
        if [[ "$arg" == --*=* ]]; then
            args+=("${arg%%=*}" "${arg#*=}")
        else
            args+=("$arg")
        fi
    done
    count=${#args[@]}
    while (( i < count )); do
        arg="${args[i]}"
        i=$(( i + 1 ))
        case "$arg" in
        -h | --help)
            help_usage rad_cob
            return 0
            ;;
        --json) : ;;
        --bodies) bodies="yes" ;;
        --format)
            if (( i >= count )) || [[ -z "${args[i]}" ]]; then
                help_usage_error rad_cob "'--format' needs a value"
                return 2
            fi
            value="${args[i]}"
            i=$(( i + 1 ))
            if [[ "$value" != json ]]; then
                help_usage_error rad_cob "'--format $value' is not an answer this helper prints (json only)"
                return 2
            fi
            ;;
        --repo | --type | --object)
            if (( i >= count )) || [[ -z "${args[i]}" ]]; then
                help_usage_error rad_cob "'$arg' needs a non-empty value"
                return 2
            fi
            value="${args[i]}"
            i=$(( i + 1 ))
            case "$arg" in
            --repo) repo="$value" ;;
            --type) type="$value" ;;
            --object) object="$value" ;;
            esac
            ;;
        -*)
            help_usage_error rad_cob "unknown argument '$arg'"
            return 2
            ;;
        *)
            help_usage_error rad_cob "unexpected argument '$arg'"
            return 2
            ;;
        esac
    done
    if [[ -z "$type" || -z "$object" ]]; then
        help_usage_error rad_cob "'document' needs --type and --object"
        return 2
    fi
    typename="$(rad_cob_typename "$type")" || {
        help_usage_error rad_cob "'$type' is not a COB type this store carries (issue, patch, id)"
        return 2
    }
    rad_cob_repo document "$repo" || return $?
    if ! known="$(rad_cob_ids "$RAD_COB_RID" "$typename")"; then
        error "the store did not answer for '$typename'"
        rad_cob_fail unreadable "$typename" "$object" "the store cannot be read: 'rad cob list' failed"
        return 5
    fi
    while IFS= read -r value; do
        if [[ -n "$value" && "$value" == "$object"* ]]; then
            match=$(( match + 1 ))
        fi
    done <<<"$known"

    call=(cob show -r "$RAD_COB_RID" -t "$typename" -o "$object" --format json)
    if ! out="$(rad_cob_call "${call[@]}")"; then
        detail="$(rad_cob_first_line "$out")"
        if [[ "$detail" == *"not found"* ]]; then
            if (( match )); then
                rad_cob_fail absent "$typename" "$object" "$detail"
                return 4
            fi
            rad_cob_fail notfound "$typename" "$object" "$detail"
            return 3
        fi
        rad_cob_fail refused "$typename" "$object" "$detail"
        return 1
    fi
    op_id="$(printf '%s' "$out" | jq -r '((.timeline // .thread.timeline // []) | last) // empty' 2>/dev/null)" || op_id=""
    rad_cob_copy_note "$RAD_COB_STORAGE" "$typename" "$object" "$op_id"

    ## One offset for the whole document, taken once: the store's timestamps carry no zone, and one
    ## call per timestamp would cost a process each.  '$zone' is what 'date +%z' prints, so a date
    ## here reads like 'date --iso-8601=seconds' renders it.
    zone="$(date +%z)"
    IFS=':' read -r -a parts <<<"${zone:0:3}:${zone:3:2}"
    off=$(( 10#${parts[0]:1} * 3600 + 10#${parts[1]} * 60 ))
    if [[ "${zone:0:1}" == '-' ]]; then
        off=$(( -off ))
    fi
    zone="${zone:0:3}:${zone:3:2}"

    printf '%s' "$out" | jq -c --arg cob "$object" --arg copy "${RAD_COB_COPY:-}" --arg bodies "$bodies" \
        --arg type "$typename" \
        --argjson off "$off" --arg zone "$zone" "$RAD_COB_DOCUMENT_JQ"
    return 0
}

# --- the state of a COB: 'rad_cob state' -------------------------------------------------------

# The reduction, over the whole repository in one pass, because the two reads the store offers
# disagree by construction: 'cob log' is the chain (a marker its author took back in the next action
# of the same op reads as live for ever), 'cob show' is the reduction (no op id, no date, a different
# shape per type).  So the markers, comments and revisions are reduced here, from the ops themselves,
# under the rule 'rad_reaction' applies when it compares.
#
# One 'git for-each-ref' names the copies, one 'git log' prints the ops of every chain with the diff
# against their first parent, one 'jq' reduces: three invocations whatever the number of COBs.  The
# inventory is the storage's own refs, the same thing 'rad cob list' reads.
#
# An op's tree holds that op's actions as the files '0', '1', ... in application order.  The diff of
# an op against its first parent is read instead of the tree itself (a tree is a binary object, and
# reading N of them is N processes): the tree is that of the first parent with the diff applied --
# exact, and the reason an op whose actions repeat its parent's (a comment written twice) is reported
# with those actions and not as an empty op.
#
# The chain is a DAG, not a line: an op's parents are the previous op, what it relates to (the
# comment it replies to, the revision it reviews) and the identity op which authorized the write, so
# a comment written from another copy of the COB arrives as a side parent.  Every op reachable that
# way is read, and the walk ends where the parent is not an op of this store.

declare -gr RAD_COB_STATE_JQ='
def reach($by; $start):
    def step($frontier; $seen):
        ($frontier | map($by[.] | select(. != null) | .parents[]) | unique
         | map(select($by[.] != null))
         | map(select(($seen[.] // false) | not))) as $fresh
        | if ($fresh | length) == 0 then ($seen | keys)
          else step($fresh; ($seen + ($fresh | map({(.): true}) | add))) end;
    if $by[$start] == null then [] else step([$start]; {($start): true}) end;

def topo($by; $reach):
    ($reach | map({(.): true}) | add // {}) as $in
    | ( [ $reach[] | {key: ., value: [ $by[.].parents[] | select(($in[.] // false)) ]} ] | from_entries ) as $par
    | { done: {}, order: [] }
    | until( (.order | length) == ($reach | length);
        . as $st
        | ( reduce ( $reach[] | select(($st.done[.] // false) | not) ) as $o ( $st;
              if ([ $par[$o][] | select(($st.done[.] // false) | not) ] | length) == 0
              then .done[$o] = true | .order += [$o] else . end ) )
        | if (.order | length) == ($st.order | length) then .order = $reach else . end )
    | .order;

def level_of($kind; $cob; $doc):
    if $kind == "issue" then
        (if $doc.type == "comment.react" then (if $doc.id == $cob then "root" else "comment" end) else "" end)
    elif $kind == "patch" then
        ({"revision.react": "revision",
          "revision.comment.react": "revision-comment",
          "review.react": "review",
          "review.comment.react": "review-comment"}[$doc.type] // "")
    else "" end;

def target_of($kind; $doc):
    if $kind == "issue" then ($doc.id // "")
    elif $doc.type == "revision.react" then ($doc.revision // "")
    elif $doc.type == "review.react" then ($doc.review // "")
    else ($doc.comment // $doc.revision // "") end;

(map({(.op): .}) | add // {}) as $by
| [ $cobs[] | . as $c
    | ( reach($by; $c.tip) ) as $reach
    | if ($reach | length) == 0
      then error("the chain of \($c.cob) cannot be read from the storage")
      else . end
    | ( topo($by; $reach) | to_entries | map({op: .value, seq: .key}) ) as $order
    | ( [ $order[] | .op as $o | $by[$o] + {seq: .seq} ] ) as $ops
    | ( [ foreach $ops[] as $o
            ( { tree: {} };
              ( reduce (($o.deleted // [])[]) as $d (.tree; del(.[$d]))
                | . + ($o.changed // {}) ) as $next
              | .tree = $next;
              $o + {actions: ( .tree | to_entries
                               | map(select(.key != "manifest"))
                               | sort_by(.key | tonumber)
                               | map({file: (.key | tonumber), doc: .value})) } ) ] ) as $chain
    | ( [ $chain[] as $o | $o.actions[] | .doc | select(.type == "review") | {op: $o.op, revision: .revision} ]
        | map({key: .op, value: .revision}) | from_entries ) as $revof
    | ( [ $chain[] | .actions[] | .doc | select(.type | endswith(".redact")) | (.comment // .id) ]
        | unique ) as $redacted
    | ( reduce ( $chain[] as $o | ($o.actions[]) as $a | $a.doc as $d
                 | { level: level_of($c.kind; $c.cob; $d), target: target_of($c.kind; $d),
                     emoji: ($d.reaction // ""), active: ($d.active == true),
                     author: $o.author, op: $o.op, date: $o.date, seq: $o.seq }
                 | select(.level != "" and .emoji != "" and .target != "") ) as $e
          ( {};
            ($e.level + "\u0001" + $e.target + "\u0001" + $e.emoji) as $k
            | if $e.active then
                if ((.[$k] // []) | map(.author) | index($e.author)) != null then .
                else .[$k] = ((.[$k] // []) + [{author: $e.author, op: $e.op, date: $e.date, seq: $e.seq}]) end
              else
                .[$k] = ((.[$k] // []) | map(select(.author != $e.author)))
                | if (.[$k] | length) == 0 then del(.[$k]) else . end
              end
          )
        | to_entries
        | map(.key as $k | ($k | split("\u0001")) as $p
              | .value[] | {level: $p[0], target: $p[1], emoji: $p[2],
                            op: .op, author: .author, date: .date, seq: .seq})
        | sort_by([.seq, .level, .target, .emoji, .author])
        | map(select(. as $m | ($redacted | index($m.target)) == null))
        | map(del(.seq)) ) as $markers
    | ( [ $chain[] as $o | $o.actions[] | .doc as $d
          | select($d.type == "comment" or $d.type == "revision.comment" or $d.type == "review.comment")
          | {id: $o.op, author: $o.author, date: $o.date,
             revision: (if $c.kind == "issue" then "-"
                        elif $d.type == "revision.comment" then $d.revision
                        else ($revof[$d.review] // "-") end),
             seq: $o.seq} ]
        | sort_by(.seq) | map(del(.seq)) ) as $comments
    | { cob: $c.cob, kind: $c.kind, head: $c.tip, copy: $c.copy,
        markers: $markers, comments: $comments,
        revisions: [ $chain[] as $o | $o.actions[] | .doc | select(.type == "revision")
                     | {oid: .oid, op: $o.op, date: $o.date} ] }
  ]
| .[] | select((($since[.cob] // "") as $s | ($s == "" or (.head | startswith($s) | not))))
'

function rad_cob_state_tips ## <storage> <typename>.. - '<type>\t<id>\t<tip>\t<copy>' per COB
{
    ## One listing for every type asked for; the copy named is the one whose tip is newest.
    # A COB sits in every namespace which replicated it, so the copy to read is the newest tip --
    # the rule 'rad_cob list' publishes ('rad_cob_newest'), applied to every COB at once because the
    # tip is where the reduction starts.  A storage which cannot be read is not an empty repository,
    # so the caller still has to tell those apart.
    local storage="$1"
    local -a refs=()
    local typename out=""
    shift
    for typename in "$@"; do
        refs+=("refs/namespaces/*/refs/cobs/$typename/*")
    done
    out="$(git --git-dir="$storage" for-each-ref --sort=-committerdate \
        --format="%(committerdate:unix)${RAD_RS}%(objectname)${RAD_RS}%(refname)" \
        "${refs[@]}" 2>/dev/null)" || return 1
    [[ -n "$out" ]] || return 0
    printf '%s\n' "$out" | LC_ALL=C awk -F'\t' '
        {
            ref = $3
            nid = ref; sub(/^refs\/namespaces\//, "", nid); sub(/\/.*/, "", nid)
            id = ref; sub(/.*\//, "", id)
            type = ref; sub(/.*refs\/cobs\//, "", type); sub(/\/.*/, "", type)
            key = type " " id
            if (key in seen) next
            seen[key] = 1
            print type "\t" id "\t" $2 "\t" nid
        }'
}

function rad_cob_state_ops ## <storage> <tip>.. - one JSON object per op, with what its tree holds
{
    ## One JSON object per op of every chain, in one 'git log', each with its diff against its first
    ## parent.
    # An op is a commit carrying the store's 'Rad-Resource:' trailer, which no commit of the code
    # carries -- the identity ops are the one exception, and they are not asked for.  The diff is
    # read rather than the tree because a tree is a binary object: the files it names are the
    # actions, in application order, and the caller rebuilds each tree from its first parent's
    # ('changed' added, 'deleted' removed).
    local storage="$1"
    shift
    git --git-dir="$storage" log --grep='Rad-Resource:' \
        --no-color --no-ext-diff --no-renames --diff-merges=first-parent --unified=0 \
        --format=$'\036%H\037%P\037%aI\037%ae' -p "$@" 2>/dev/null |
        LC_ALL=C awk '
            function flush_op(   i, n, p, f, first) {
                if (op == "") return
                printf "{\"op\":\"%s\",\"parents\":[", op
                n = split(parents, p, " ")
                for (i = 1; i <= n; i++) printf "%s\"%s\"", (i > 1 ? "," : ""), p[i]
                printf "],\"date\":\"%s\",\"author\":\"%s\",\"changed\":{", date, author
                first = 1
                for (f in act) {
                    if (f in dead) continue
                    printf "%s\"%s\":%s", (first ? "" : ","), f, act[f]
                    first = 0
                }
                printf "},\"deleted\":["
                first = 1
                for (f in dead) {
                    printf "%s\"%s\"", (first ? "" : ","), f
                    first = 0
                }
                printf "]}\n"
                delete act
                delete dead
                op = ""; parents = ""; date = ""; author = ""; file = ""
            }
            substr($0, 1, 1) == "\036" {
                flush_op()
                split(substr($0, 2), h, "\037")
                op = h[1]; parents = h[2]; date = h[3]; author = h[4]
                sub(/.*@/, "", author)
                next
            }
            /^diff --git a\// {
                file = $0
                sub(/^diff --git a\//, "", file)
                sub(/ b\/.*/, "", file)
                next
            }
            /^deleted file mode/ {
                if (file ~ /^[0-9]+$/ || file == "manifest") dead[file] = 1
                next
            }
            /^\+\+\+ / || /^--- / || /^\\/ || /^@@/ || /^new file mode/ || /^old mode/ || /^index / { next }
            /^\+/ {
                if (file !~ /^[0-9]+$/ && file != "manifest") next
                if (file in dead) next
                act[file] = (file in act) ? act[file] "\n" substr($0, 2) : substr($0, 2)
                next
            }
            END { flush_op() }'
}

function rad_cob_state ## see the module header
{
    ## The verb: parse, name the repository, take the copies, read the chains, reduce.
    # Three invocations whatever the number of COBs: it never asks the store per COB, because the
    # COBs are the storage's refs and the ops are one 'git log'.
    local -a args=() wanted=() typenames=() ids=() tips=() records=() since_args=() parts=()
    local raw arg value repo="" type="" since_pair="" out=""
    local tip_lines="" cobs_json="" since_json="{}" detail=""
    local typename type id tip copy key
    local -i i=0 count=0
    local -A since_map=()

    for raw in "$@"; do
        if [[ "$raw" == --*=* ]]; then
            args+=("${raw%%=*}" "${raw#*=}")
        else
            args+=("$raw")
        fi
    done
    count=${#args[@]}
    while (( i < count )); do
        arg="${args[i]}"
        i=$(( i + 1 ))
        case "$arg" in
        -h | --help)
            help_usage rad_cob
            return 0
            ;;
        --json) : ;;
        --format)
            if (( i >= count )) || [[ -z "${args[i]}" ]]; then
                help_usage_error rad_cob "'--format' needs a value"
                return 2
            fi
            value="${args[i]}"
            i=$(( i + 1 ))
            if [[ "$value" != json ]]; then
                help_usage_error rad_cob "'--format $value' is not an answer this helper prints (json only)"
                return 2
            fi
            ;;
        --repo | --type | --since)
            if (( i >= count )) || [[ -z "${args[i]}" ]]; then
                help_usage_error rad_cob "'$arg' needs a non-empty value"
                return 2
            fi
            value="${args[i]}"
            i=$(( i + 1 ))
            case "$arg" in
            --repo) repo="$value" ;;
            --type) wanted+=("$value") ;;
            --since) since_args+=("$value") ;;
            esac
            ;;
        -*)
            help_usage_error rad_cob "unknown argument '$arg'"
            return 2
            ;;
        *)
            help_usage_error rad_cob "unexpected argument '$arg'"
            return 2
            ;;
        esac
    done

    ## '--type' is a set: each value may name several types, and 'all' names both kinds a reading
    ## of state is made of.  'id' is refused: an identity COB has no markers, comments or revisions.
    if (( ${#wanted[@]} == 0 )); then
        wanted=(all)
    fi
    for value in "${wanted[@]}"; do
        parts=()
        IFS=, read -r -a parts <<<"$value"
        for type in "${parts[@]}"; do
            case "$type" in
            "" ) continue ;;
            all) typenames+=(xyz.radicle.issue xyz.radicle.patch) ;;
            *)
                typename="$(rad_cob_typename "$type")" || {
                    help_usage_error rad_cob "'$type' is not a COB type whose state this helper reads (issue, patch, all)"
                    return 2
                }
                if [[ "$typename" == xyz.radicle.id ]]; then
                    help_usage_error rad_cob "'id' is not a COB type whose state this helper reads (issue, patch, all)"
                    return 2
                fi
                typenames+=("$typename")
                ;;
            esac
        done
    done
    if (( ${#typenames[@]} == 0 )); then
        help_usage_error rad_cob "'--type' named no COB type (issue, patch, all)"
        return 2
    fi

    ## '--since <cob>:<op>' skips a COB whose head is still <op>; both sides are prefixes.
    # A skip, not a delta: the reduction always runs over the whole chain.  A malformed pair is a
    # usage error, not a silent skip.
    if (( ${#since_args[@]} > 0 )); then
        for value in "${since_args[@]}"; do
            if [[ "$value" != *:* ]]; then
                help_usage_error rad_cob "'--since $value' is not '<cob>:<op>'"
                return 2
            fi
            key="${value%%:*}"
            since_pair="${value#*:}"
            if [[ -z "$key" || -z "$since_pair" ]]; then
                help_usage_error rad_cob "'--since $value' is not '<cob>:<op>'"
                return 2
            fi
        done
    fi

    rad_cob_repo state "$repo" || return $?

    if ! tip_lines="$(rad_cob_state_tips "$RAD_COB_STORAGE" "${typenames[@]}")"; then
        error "the storage of '$RAD_COB_RID' cannot be listed"
        rad_cob_fail unreadable "" "" "the node storage cannot be read: 'git for-each-ref' failed"
        return 5
    fi
    while IFS=$'\t' read -r type id tip copy; do
        [[ -n "$id" ]] || continue
        records+=("{\"kind\":\"${type#xyz.radicle.}\",\"cob\":\"$id\",\"tip\":\"$tip\",\"copy\":\"$copy\"}")
        ids+=("$id")
        tips+=("$tip")
    done <<<"$tip_lines"
    if (( ${#records[@]} == 0 )); then
        ## An empty repository is an answer: nothing moved, nothing to report.
        # A storage that could not be read never reaches this point (it fails above).
        return 0
    fi

    if (( ${#since_args[@]} > 0 )); then
        for value in "${since_args[@]}"; do
            key="${value%%:*}"
            since_pair="${value#*:}"
            for id in "${ids[@]}"; do
                if [[ "$id" == "$key"* ]]; then
                    since_map["$id"]="$since_pair"
                    break
                fi
            done
        done
    fi
    if (( ${#since_map[@]} > 0 )); then
        since_json="$(
            for id in "${!since_map[@]}"; do
                printf '%s\n%s\n' "$id" "${since_map[$id]}"
            done |
                jq -Rn '[ inputs ] | [ range(0; length; 2) as $i | {key: .[$i], value: .[$i + 1]} ] | from_entries'
        )" || since_json="{}"
    fi

    cobs_json="[$(printf '%s\n' "${records[@]}" | paste -sd, -)]"
    if ! out="$(rad_cob_state_ops "$RAD_COB_STORAGE" "${tips[@]}" |
        jq -c --argjson cobs "$cobs_json" --argjson since "$since_json" -s "$RAD_COB_STATE_JQ" 2>&1)"; then
        detail="$(rad_cob_first_line "$out")"
        error "the state of '$RAD_COB_RID' cannot be reduced: $detail"
        rad_cob_fail unreadable "" "" "the op chain cannot be reduced: $detail"
        return 5
    fi
    ## An empty answer is no line at all, never a blank one: a consumer reads zero records as
    ## "nothing moved".
    [[ -n "$out" ]] && printf '%s\n' "$out"
    return 0
}

function rad_cob ## list [--repo <rid|path>] [--type <type>].. | ops|document --repo <rid|path> --type <type> --object <cob> [--from <op>] [--until <op>] [--bodies] | state [--repo <rid|path>] [--type <type>].. [--since <cob>:<op>].. - the COB store as one interface, one verb per question
{
    local -a args=( ${RULE_ARGS[@]+"${RULE_ARGS[@]}"} )
    local verb="${args[0]:-}"
    case "$verb" in
    -h | --help)
        help_usage rad_cob
        return 0
        ;;
    list | ops | document | state) ;;
    "")
        help_usage_error rad_cob "a verb is required: list, ops, document or state"
        return 2
        ;;
    *)
        help_usage_error rad_cob "unknown verb '$verb'"
        return 2
        ;;
    esac
    ## Every verb's answer is a JSON object -- including the one that names a failure -- so jq is a
    ## dependency of the family, checked once, before a verb spends a call on the store.
    if ! command -v jq >/dev/null 2>&1; then
        printf 'rad_cob: jq is required to read the store\n' >&2
        return 1
    fi
    rad_cob_"$verb" "${args[@]:1}"
}

# --- asking the siblings to re-cut: rad_rebase_ask ----------------------------------------------

function rad_rebase_show_field ## <show> <field> - one header value of 'rad patch show'
{
    ## '<show>' is the whole output.  The header line reads '│ <Field>   <value>' and the value is
    ## padded to the box, so it is cut exactly like a table row: the field name is the cell 'rad_line'
    ## drops, and what is left is the value.  Never parsed from the document -- a patch's own
    ## revision payload carries no branch, and the COB's 'target' field is 'delegates' (the *review*
    ## target, who is asked to review), not the branch.  'rad patch list' has no such column either.
    local show="$1" field="$2" line=""
    while IFS= read -r line; do
        [[ "$line" == *"│ $field "* ]] || continue
        rad_line "$line"
        return 0
    done <<<"$show"
    return 1
}

function rad_rebase_live_comment ## <storage> <ref> - the newest comment of the chain, and its body
{
    ## Sets 'RAD_REBASE_COMMENT' (the op id) and 'RAD_REBASE_BODY'.  Empty when the chain has no
    ## comment at all.
    ##
    ## Redaction-aware, and it has to be: a COB chain is append-only, so a directive the loop has
    ## already consumed is still in the history -- its deletion is a 'Redact comment' op naming it --
    ## and a read that trusted the text would call a spent '*trigger:rebase' live and never ask that
    ## patch again.  Walked newest first, so a redaction is always read before the comment it removes.
    local storage="$1" ref="$2" op subject payload id
    local -A redacted=()
    RAD_REBASE_COMMENT="" RAD_REBASE_BODY=""
    while IFS="$RAD_US" read -r op subject; do
        [[ -n "$op" ]] || continue
        case "$subject" in
        'Redact comment')
            payload="$(git --git-dir="$storage" cat-file -p "${op}^{tree}:0" 2>/dev/null)" || payload=""
            id="$(printf '%s' "$payload" | jq -r '.comment // empty' 2>/dev/null)"
            [[ -n "$id" ]] && redacted["$id"]=1
            ;;
        Comment)
            [[ -n "$RAD_REBASE_COMMENT" ]] && continue
            [[ -n "${redacted[$op]:-}" ]] && continue
            payload="$(git --git-dir="$storage" cat-file -p "${op}^{tree}:0" 2>/dev/null)" || payload=""
            RAD_REBASE_COMMENT="$op"
            RAD_REBASE_BODY="$(printf '%s' "$payload" | jq -r '.body // empty' 2>/dev/null)"
            ;;
        esac
    done < <(git --git-dir="$storage" log --first-parent --format="%H${RAD_US}%s" "$ref" 2>/dev/null)
    return 0
}

function rad_rebase_ask ## [--after <patch>] [--branch <branch>] [--onto <sha>] [--dry-run] [--no-fetch] [--json] - ask the pending patches of a branch to re-cut themselves after a merge landed
{
    local -a args=( ${RULE_ARGS[@]+"${RULE_ARGS[@]}"} )
    local -a rows=() ids=() heads=()
    local raw value after="" branch="" onto="" dry="" json="" nofetch=""
    local directive='*trigger:rebase'
    local -i i=0 n=0 failed=0 asked_count=0
    local toplevel="" rid="" radpath="" storage="" branch_tip="" table="" listing="" show=""
    local id="" member_head="" target="" author="" status="" landed="" ref=""
    local verdict="" reason=""

    while (( i < ${#args[@]} )); do
        raw="${args[i]}"
        case "$raw" in
        -h | --help)
            help_usage rad_rebase_ask
            return 0
            ;;
        --dry-run) dry=1 ;;
        --json) json=1 ;;
        --no-fetch) nofetch=1 ;;
        --after | --branch | --onto)
            i=$(( i + 1 ))
            value="${args[i]:-}"
            if [[ -z "$value" ]]; then
                help_usage_error rad_rebase_ask "'$raw' needs a value"
                return 2
            fi
            case "$raw" in
            --after) after="$value" ;;
            --branch) branch="$value" ;;
            --onto) onto="$value" ;;
            esac
            ;;
        --after=*) after="${raw#--after=}" ;;
        --branch=*) branch="${raw#--branch=}" ;;
        --onto=*) onto="${raw#--onto=}" ;;
        *)
            help_usage_error rad_rebase_ask "unknown argument '$raw'"
            return 2
            ;;
        esac
        i=$(( i + 1 ))
    done
    [[ -n "${BAR_AGENT_JSON:-}" ]] && json=1

    is_command_installed "$RAD_BIN" || {
        error "'$RAD_BIN' is not installed"
        return 1
    }
    if ! toplevel="$(git rev-parse --show-toplevel 2>/dev/null)"; then
        error "not a git repository: 'rad_rebase_ask' reads the patches of the checkout it runs in"
        return 3
    fi

    rid="$(cd "$toplevel" && rad_run inspect --rid)" || return $?
    rid="${rid##*$'\n'}"
    radpath="$(rad_path)" || radpath=""
    storage="$radpath/storage/${rid#rad:}"
    if [[ -z "$radpath" || ! -d "$storage" ]]; then
        error "the node holds no storage for '$rid': '${RAD_BIN} path' says '${radpath:--}'"
        return 3
    fi

    if [[ -z "$nofetch" ]] && git -C "$toplevel" remote | grep -qx rad; then
        git -C "$toplevel" fetch --quiet rad 2>/dev/null ||
            warn "'git fetch rad' failed, the branch tips are read as they are"
    fi

    ## The branch: what the merge landed on, never a guess.  '--after' asks the merged patch itself
    ## (rad resolves its upstream, else the repository's default branch), '--branch' names it
    ## outright, and with neither it is the default branch the node's storage points at -- a
    ## delegate may make any branch the default, so the name decides nothing and is not inspected.
    if [[ -n "$after" ]]; then
        show="$(cd "$toplevel" && rad_run patch show "$after")" || return 1
        status="$(rad_rebase_show_field "$show" Status)" || status=""
        if [[ "$status" != merged ]]; then
            error "patch '$after' is '${status:-unreadable}', not merged: the sweep is the answer to a merge that landed, so nothing was asked"
            return 1
        fi
        target="$(rad_rebase_show_field "$show" Target)" || target=""
        landed="$(rad_rebase_show_field "$show" Head)" || landed=""
        if [[ -n "$branch" && -n "$target" && "$branch" != "$target" ]]; then
            warn "'--branch $branch' is not the branch '$after' landed on ('$target'): the merged patch decides"
        fi
        [[ -n "$target" ]] && branch="$target"
    fi
    if [[ -z "$branch" ]]; then
        branch="$(git --git-dir="$storage" symbolic-ref --short HEAD 2>/dev/null)" || branch=""
        if [[ -z "$branch" ]]; then
            help_usage_error rad_rebase_ask "no branch to sweep: '--after' or '--branch' is required and the storage has no default branch"
            return 2
        fi
    fi
    branch="${branch#refs/heads/}"

    if [[ -n "$onto" ]]; then
        branch_tip="$onto"
    elif ! branch_tip="$(rad_merge_upstream "$toplevel" "$branch")"; then
        error "the canonical branch '$branch' is not in this checkout: 'refs/remotes/rad/$branch' and 'refs/heads/$branch' are both missing"
        return 3
    fi
    ## A merge that did not land is not a merge.  The patch has to read 'merged' (above) *and* the
    ## commit it was merged as has to be in the branch now: a push that failed, a merge into another
    ## branch, or a landing that invented its own base is not something the siblings are asked about.
    if [[ -n "$after" && -n "$landed" ]] &&
        ! git -C "$toplevel" merge-base --is-ancestor "$landed" "$branch_tip" 2>/dev/null; then
        error "the merge of '$after' ($landed) is not in '$branch' ($branch_tip): nothing was asked"
        return 1
    fi

    table="$(cd "$toplevel" && rad_run patch list --open)" || return $?
    listing="$(rad_state_table_checked 'patch list --open' "$table" ID Head)" || return 1
    while IFS="$RAD_US" read -r id member_head; do
        [[ -n "$id" ]] || continue
        ids+=("$id")
        heads+=("$member_head")
    done <<<"$listing"

    for (( n = 0; n < ${#ids[@]}; n++ )); do
        id="${ids[n]}"
        member_head="${heads[n]}"
        verdict="" reason=""
        ## The patch that just landed is no member: it is closed by the merge, and were it still
        ## open its own head is the thing that landed -- asking it to re-cut would move what the
        ## branch now holds.  Compared as a prefix, because the two sides are read from different
        ## places: the listing prints seven hex, '--after' is the full id the caller was handed.
        [[ -n "$after" && ( "$after" == "$id"* || "$id" == "$after"* ) ]] && continue
        if ! show="$(cd "$toplevel" && rad_run patch show "$id")"; then
            rows+=("skipped${RAD_US}${id}${RAD_US}-${RAD_US}-${RAD_US}unreadable")
            continue
        fi
        target="$(rad_rebase_show_field "$show" Target)" || target=""
        author="$(rad_rebase_show_field "$show" Author)" || author=""
        ## The write needs the full 40-hex id: 'rad patch list' prints seven and 'rad patch
        ## comment' resolves only the whole object id, so a directive posted under the listing's id
        ## is refused for every member -- measured after one landing, 30 refusals and not one
        ## directive.  The header carries it, so it costs no extra call.
        # 'rad patch comment' also takes no repo selector (it answers "unexpected argument '-r'
        # found", exit 2), so the write runs in the checkout, which is how 'rad' resolves the
        # repository there.  Measured on bar 782e7b2: its merge asked nobody, every directive
        # 'write-refused'.  An implementation note, not help text -- it stays out of the README.
        full="$(rad_rebase_show_field "$show" Patch)" || full=""
        if [[ "$target" != "$branch" ]]; then
            verdict="skipped"
            reason="other-branch:${target:--}"
        elif [[ "$author" != *" (you)" ]]; then
            ## Another author's patch is not ours to publish: a revision only ever goes into the
            ## namespace of its own author, so a directive there could not be worked.
            verdict="skipped"
            reason="not-ours:${author%% *}"
        elif git -C "$toplevel" merge-base --is-ancestor "$branch_tip" "$member_head" 2>/dev/null; then
            verdict="current"
            reason="already-at-the-branch_tip"
        else
            ref="$(rad_merge_ref "$storage" "$id")" || ref=""
            RAD_REBASE_COMMENT="" RAD_REBASE_BODY=""
            if [[ -n "$ref" ]]; then
                rad_rebase_live_comment "$storage" "$ref"
            fi
            if [[ "$RAD_REBASE_BODY" == "$directive" ]]; then
                ## A directive already standing is never sent twice: the sole line is always the
                ## same text, so a second one is a duplicate op, and the loop answers it as such.
                verdict="skipped"
                reason="already-asked:${RAD_REBASE_COMMENT:0:7}"
            elif [[ -n "$dry" ]]; then
                verdict="asked"
                reason="dry-run"
            elif [[ ! "$full" =~ ^[0-9a-f]{40}$ ]]; then
                ## The one thing that may not be guessed at: a write under a short id is refused,
                ## and the refusal reads like a repository refusing us rather than a wrong id form.
                verdict="failed"
                reason="no-full-id"
                failed=$(( failed + 1 ))
            elif ( cd "$toplevel" 2>/dev/null &&
                    rad_metadata_rad "" patch comment "$full" -m "$directive" >/dev/null 2>&1 ); then
                verdict="asked"
                reason="directive-posted"
                asked_count=$(( asked_count + 1 ))
            else
                verdict="failed"
                reason="write-refused"
                failed=$(( failed + 1 ))
            fi
        fi
        rows+=("${verdict}${RAD_US}${id}${RAD_US}${target:--}${RAD_US}${member_head:--}${RAD_US}${reason}")
    done

    if [[ -n "$json" ]]; then
        if (( ${#rows[@]} == 0 )); then
            jq -cn --arg repo "$rid" --arg branch "$branch" --arg branch_tip "$branch_tip" \
                '{bar_rad: 1, repo: $repo, action: "rebase_ask", branch: $branch, branch_tip: $branch_tip, patches: []}'
        else
            printf '%s\n' "${rows[@]}" | jq -Rn --arg repo "$rid" --arg branch "$branch" --arg branch_tip "$branch_tip" '
                [inputs | select(length > 0) | split("\u001f")
                 | {verdict: .[0], patch: .[1], target: .[2], head: .[3], reason: .[4]}]
                | {bar_rad: 1, repo: $repo, action: "rebase_ask", branch: $branch, branch_tip: $branch_tip,
                   patches: .}'
        fi
    elif (( ${#rows[@]} == 0 )); then
        note "no open patch in $rid"
    else
        printf '%s\n' "${rows[@]}" |
            while IFS="$RAD_US" read -r verdict id target member_head reason; do
                printf '%s patch=%s target=%s head=%s reason=%s\n' \
                    "$verdict" "$id" "$target" "$member_head" "$reason"
            done
    fi

    if (( failed )); then
        return 1
    fi
    return 0
}

# --- a branch: rad_branch_sync ------------------------------------------------------------------

function rad_branch_checkout ## <tree> <branch> - the checkout which has <branch> checked out, empty when none
{
    # 'git worktree list' is shared by every tree of the clone, so the clone's own checkout and a
    # topic tree answer alike.  The branch is compared as the whole ref -- the listing prints
    # 'branch refs/heads/<name>' under its 'worktree <path>' line, and a detached tree prints
    # 'detached' instead -- so a branch no tree holds answers with nothing.
    local tree="$1" want="refs/heads/$2" line="" path=""
    while IFS= read -r line; do
        case "$line" in
        'worktree '*) path="${line#worktree }" ;;
        "branch $want") printf '%s' "$path"; return 0 ;;
        esac
    done < <(git -C "$tree" worktree list --porcelain 2>/dev/null)
    return 1
}

function rad_branch_sync ## [--branch <branch>] [--dry-run] [--json] - fast-forward a local branch to its remote tip, and write nothing when that would not be clean
{
    local -a args=( ${RULE_ARGS[@]+"${RULE_ARGS[@]}"} )
    local raw value branch="" dry="" json=""
    local -i i=0
    local tree="" rid="" radpath="" storage="" remote="" local_sha="" upstream=""
    local state="" where="" ahead="" out="" updated=false

    while (( i < ${#args[@]} )); do
        raw="${args[i]}"
        case "$raw" in
        -h | --help)
            help_usage rad_branch_sync
            return 0
            ;;
        --dry-run) dry=1 ;;
        --json) json=1 ;;
        --branch)
            i=$(( i + 1 ))
            value="${args[i]:-}"
            if [[ -z "$value" ]]; then
                help_usage_error rad_branch_sync "'--branch' needs a branch name"
                return 2
            fi
            branch="$value"
            ;;
        --branch=*) branch="${raw#--branch=}" ;;
        *)
            help_usage_error rad_branch_sync "unknown argument '$raw'"
            return 2
            ;;
        esac
        i=$(( i + 1 ))
    done
    [[ -n "${BAR_AGENT_JSON:-}" ]] && json=1

    is_command_installed "$RAD_BIN" || {
        error "'$RAD_BIN' is not installed"
        return 1
    }
    if ! tree="$(git rev-parse --show-toplevel 2>/dev/null)"; then
        error "not a git repository: 'rad_branch_sync' moves a branch of the checkout it runs in"
        return 3
    fi
    rid="$(cd "$tree" && rad_run inspect --rid)" || return $?
    rid="${rid##*$'\n'}"
    radpath="$(rad_path)" || radpath=""
    storage="$radpath/storage/${rid#rad:}"
    if [[ -z "$radpath" || ! -d "$storage" ]]; then
        error "the node holds no storage for '$rid': '${RAD_BIN} path' says '${radpath:--}'"
        return 3
    fi

    # The remote: 'rad' whenever the clone has one, else 'origin'.  A clone with neither has no
    # branch of record to sync against.
    if git -C "$tree" remote | grep -qx rad; then
        remote=rad
    elif git -C "$tree" remote | grep -qx origin; then
        remote=origin
    else
        error "this clone has neither a 'rad' nor an 'origin' remote"
        return 3
    fi

    # The branch: the node's storage has the canonical branch checked out, and a delegate may make
    # any branch the default, so the name decides nothing and the storage is asked.
    # '--branch' names one outright; the clone's own HEAD is the fallback when the storage names
    # none (a clone whose radicle remote is a plain git remote).
    if [[ -z "$branch" ]]; then
        branch="$(git --git-dir="$storage" symbolic-ref --quiet --short HEAD 2>/dev/null)" || branch=""
    fi
    if [[ -z "$branch" ]]; then
        branch="$(git -C "$tree" symbolic-ref --quiet --short HEAD 2>/dev/null)" || branch=""
    fi
    branch="${branch#refs/heads/}"
    if [[ -z "$branch" ]]; then
        error "no branch to sync: the storage names none and this checkout is detached"
        return 3
    fi

    local_sha="$(git -C "$tree" rev-parse --verify --quiet "refs/heads/$branch^{commit}" 2>/dev/null)" || local_sha=""
    if [[ -z "$local_sha" ]]; then
        error "this clone has no branch '$branch' ('refs/heads/$branch' is missing): a sync moves a branch, it never creates one"
        return 3
    fi

    # The tip is asked of the remote, never read off a tracking ref: a radicle clone maps only tags
    # into 'refs/remotes/rad/*', so there is no 'rad/<branch>' to read there, and where one exists
    # it is only as fresh as the last fetch.  'ls-remote' reads the node's store and writes nothing.
    out="$(git -C "$tree" ls-remote "$remote" "refs/heads/$branch" 2>/dev/null)" || out=""
    upstream="${out%%$'\t'*}"
    upstream="${upstream//[[:space:]]/}"
    if [[ -z "$upstream" ]]; then
        error "'$remote' names no branch '$branch': there is nothing to sync against"
        return 3
    fi

    # The objects are delivered *before* the relation is asked: an ancestry test against a commit
    # the clone has never seen cannot answer, and a 'diverged' read into that would refuse a branch
    # which is merely behind.  Objects only -- '--refmap=' clears the clone's refspec, so two syncs
    # cannot collide on 'refs/remotes/*' (measured in the loop: 7 of 8 parallel fetches failed with
    # "cannot lock ref") -- which is also why a dry run may fetch and still move nothing.
    if ! git -C "$tree" cat-file -e "${upstream}^{commit}" 2>/dev/null; then
        git -C "$tree" fetch --quiet --no-write-fetch-head --refmap= "$remote" "refs/heads/$branch" >/dev/null 2>&1 || true
    fi

    if ! git -C "$tree" cat-file -e "${upstream}^{commit}" 2>/dev/null; then
        state="fetch-failed"
    elif [[ "$local_sha" == "$upstream" ]]; then
        state="current"
    elif git -C "$tree" merge-base --is-ancestor "$upstream" "$local_sha" 2>/dev/null; then
        # The branch carries commits the remote does not have: a sync never rebases and never resets
        # one, so this is reported and left exactly as it is.
        state="ahead"
        ahead="$(git -C "$tree" rev-list --count "$upstream..$local_sha" 2>/dev/null)" || ahead=""
    elif git -C "$tree" merge-base --is-ancestor "$local_sha" "$upstream" 2>/dev/null; then
        state="behind"
    else
        state="diverged"
    fi

    if [[ "$state" == behind ]]; then
        where="$(rad_branch_checkout "$tree" "$branch")" || where=""
        if [[ -n "$where" && -n "$(git -C "$where" status --porcelain --untracked-files=no 2>/dev/null)" ]]; then
            # The one thing a sync may not work around: the tree which holds the branch carries
            # uncommitted work, so the fast-forward is not clean.  Nothing is written, and the next
            # arrival tries again -- the update is infallible, so it needs no state to retry from.
            state="uncommitted"
        elif [[ -n "$dry" ]]; then
            state="would-update"
        else
            if [[ -n "$where" ]]; then
                if git -C "$where" merge --quiet --ff-only "$upstream" >/dev/null 2>&1; then
                    state="updated"
                else
                    state="merge-failed"
                fi
            elif git -C "$tree" update-ref "refs/heads/$branch" "$upstream" "$local_sha" 2>/dev/null; then
                # A branch no tree holds is moved as a ref, with the old value as the guard: no tree
                # is switched, so a checkout somebody works in stays exactly where it is.
                state="updated"
            else
                state="update-failed"
            fi
            if [[ "$state" == updated ]]; then
                # A tracking ref the clone carries is part of "the base is in good shape" -- the
                # merge helpers read it in preference to the local branch.  Refreshed only where it
                # already exists: creating it in a tags-only clone would mint a ref no fetch of that
                # clone ever updates again.
                if git -C "$tree" rev-parse --verify --quiet "refs/remotes/$remote/$branch" >/dev/null 2>&1; then
                    git -C "$tree" update-ref "refs/remotes/$remote/$branch" "$upstream" 2>/dev/null || true
                fi
            fi
        fi
    fi

    if [[ "$state" == updated ]]; then
        updated=true
    fi

    if [[ -n "$json" ]]; then
        jq -cn --arg repo "$rid" --arg branch "$branch" --arg remote "$remote" --arg state "$state" \
            --arg local "$local_sha" --arg upstream "$upstream" --arg tree "$where" --arg ahead "$ahead" \
            --argjson updated "$updated" \
            '{bar_rad: 1, action: "branch_sync", repo: $repo, branch: $branch, remote: $remote,
              state: $state, local: $local, upstream: $upstream, updated: $updated,
              tree: $tree, ahead: $ahead}'
    else
        case "$state" in
        updated) printf 'updated branch=%s from=%s to=%s\n' "$branch" "${local_sha:0:7}" "${upstream:0:7}" ;;
        would-update) printf 'would-update branch=%s from=%s to=%s\n' "$branch" "${local_sha:0:7}" "${upstream:0:7}" ;;
        current) printf 'current branch=%s at=%s\n' "$branch" "${local_sha:0:7}" ;;
        ahead) printf 'ahead branch=%s at=%s by=%s\n' "$branch" "${local_sha:0:7}" "${ahead:-?}" ;;
        diverged) printf 'diverged branch=%s local=%s upstream=%s\n' "$branch" "${local_sha:0:7}" "${upstream:0:7}" ;;
        uncommitted) printf 'uncommitted branch=%s at=%s tree=%s\n' "$branch" "${local_sha:0:7}" "$where" ;;
        *) printf '%s branch=%s local=%s upstream=%s\n' "$state" "$branch" "${local_sha:0:7}" "${upstream:0:7}" ;;
        esac
    fi

    case "$state" in
    current | updated | ahead | would-update) return 0 ;;
    *) return 1 ;;
    esac
}
