## - the local branches as one JSON object
function rad_state_json_branches
{
    local entry="" name="" commit="" ahead="" patch=""
    local joined="" object=""
    local total=0 without=0

    for entry in ${RAD_STATE_BRANCHES[@]+"${RAD_STATE_BRANCHES[@]}"}; do
        IFS="$RAD_US" read -r name commit ahead patch <<<"$entry"
        total=$(( total + 1 ))
        [[ "$patch" == "-" ]] && without=$(( without + 1 ))
        if [[ "$patch" == "-" ]]; then
            patch="null"
        else
            patch="$(json_string "$patch")"
        fi
        object="$(printf '{"name":%s,"commit":%s,"ahead":%s,"patch":%s}' \
            "$(json_string "$name")" "$(json_string "$commit")" \
            "$(json_number "$ahead")" "$patch")"
        joined+="${joined:+,}${object}"
    done
