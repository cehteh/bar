# -*- mode: sh; sh-shell: bash -*-
# vim: set ft=bash:
# shellcheck shell=bash
# shellcheck disable=SC2016

### The Radicle/source-work flow of this host: the two questions which precede the work itself --
### whether the author of an incoming item may be trusted, and how a topic starts.
###
### 'radwork_trust' answers whether the author of an incoming issue or patch counts as a *trusted
### source* for the triage policy (`incoming-issue-triage` §3): a delegate of that repository, or an
### identity with at least <threshold> authored commits.  The numbers come from the fact tool
### 'tools/radicle_triage/triage-facts' (delegates from the identity document, the commits an
### identity authored as its own NID from the COB commits, plus the code commits of the humans
### behind its patches); this helper is the one action which turns them into the verdict and the exit
### code, so the question costs no agent turn and no prose:
###
###   bar radwork_trust --repo rad:z3WhBdHt… --author cehteh
###   trusted author=cehteh delegate=yes authored=396 threshold=10 reason=delegate of this repository repo=rad:z3WhBdHt1VVNyeQ61zpY66pNzuSrP
###
###   exit 0 trusted -- 1 untrusted -- 2 could not answer (unknown author, no data, usage)
###
### 'radwork_topic' opens the topic tree of that work in one action: it mints the name from the
### branch *class* and the description, resolves the clone and the freshest base, keeps '.worktrees/'
### out of the main checkout's status and runs 'git worktree add' -- the sequence an agent otherwise
### reassembles by hand every time it starts a topic:
###
###   bar radwork_topic fix "crash on empty config"
###   /home/ct/hermes_src/bar/.worktrees/fix-crash-on-empty-config  fix-crash-on-empty-config  base=rad/main  head=55d5924
###
### The name is '<class>-<description>'.  The class vocabulary is read from the branch matchers of
### the 'git' module ('is_git_*_branch'), so bar's own classes and the gates it hangs off them stay
### the one source of truth, and a topic's name says what kind of change it is from anywhere -- the
### worktree, the branch and the patch head.  A name without a class is refused, never guessed.
### <description> is slugified to '[a-z0-9._-]' and the whole name stays within 40 characters, the
### limit the Hermes worktree machinery sanitises to; a description which cannot fit is refused, never
### silently cut.
###
### The clone is the *main checkout* of the repository '--root' names, or the one the current
### directory is in -- a linked worktree resolves to its clone, so the call works from inside any
### topic.  The base is the clone's *trunk*: on this host the trunk is upstream plus the local work
### which is not published yet, so branching off the remote tip would drop that work.  The 'rad'
### remote (else 'origin') is therefore fetched first -- to *know* the relation -- and a trunk which
### is behind upstream is refused, because updating the trunk is its own step with its own gate and
### never a side effect of opening a topic.  '--base <ref>' overrides the base, '--no-fetch' skips
### the fetch.
###
### Neither rule writes to the main checkout: the tree is created below '<clone>/.worktrees/', kept
### out of 'git status' by a line in '.git/info/exclude' (never by the tracked '.gitignore'), and
### 'git worktree add' does not touch the trunk's HEAD.

# helper-module: radwork

# helper: radwork_trust | whether the author of an incoming Radicle issue or patch counts as a trusted source, that is a delegate or an identity with at least <threshold> authored commits | radwork_trust --repo <rid-or-path> --author <did-or-nid-or-alias> [--threshold <n>] [--json] | one '<verdict> author=… delegate=… authored=… threshold=… reason=… repo=…' line, <verdict> one of trusted, untrusted, unknown; '--json' the same facts as one object
## The trust verdict of the triage policy; exit 0 trusted, 1 untrusted, 2 could not answer.
rule radwork_trust: -

# helper: radwork_topic | open the topic tree of an incoming item: mint the '<class>-<description>' name, resolve the clone and the freshest base, keep '.worktrees/' out of 'git status' and create the worktree | radwork_topic <class> <description> [--root <clone>] [--base <ref>] [--no-fetch] [--dry-run] [--json] | one '<path>  <branch>  base=<base>  head=<sha>' line; '--json' the same as one object
## Creates '<clone>/.worktrees/<class>-<description>' on the branch of the same name; exit 0 created,
## 1 refused (the tree or the branch exists, the name is too long), 2 could not answer (usage, an
## unknown class, not a git repository, git failed).
rule radwork_topic: -

# --- shared -------------------------------------------------------------------------------------

function radwork_json_string ## <text> - a JSON string literal
{
    local text="$1"
    text="${text//\\/\\\\}"
    text="${text//\"/\\\"}"
    text="$(printf '%s' "$text" | LC_ALL=C tr -d '[:cntrl:]')"
    printf '"%s"' "$text"
}

function radwork_json_flag ## <text> - 'true', 'false' or 'null' for a yes/no/unset field
{
    case "$1" in
    yes) printf 'true' ;;
    no) printf 'false' ;;
    *) printf 'null' ;;
    esac
}

function radwork_classes ## - the branch classes bar defines, one '<class>-' prefix per line
{
    ## Read from the 'is_git_*_branch' rules of the git module, so the vocabulary has one source of
    ## truth: the matcher 'fix-* fix/*' contributes the class 'fix-'.  Bar's matches are regexes, so
    ## 'fix-*' is the prefix 'fix-' followed by anything; the slash forms ('fix/', 'release/') are
    ## not classes of a *topic* here -- this host's layout puts a task id behind the slash
    ## ('<slug>/<task-id>') -- and the bare trunks ('main', 'master', 'devel') have no prefix at all.
    local module="${BAR_DIR:-}/git"
    [[ -f "$module" ]] || return 1
    LC_ALL=C sed -n "s/^rule is_git_[a-z]*_branch: 'git_branch_matches \(.*\)'\$/\1/p" "$module" |
        LC_ALL=C tr ' ' '\n' |
        LC_ALL=C sed -n 's/^\([a-z][a-z]*-\)\*$/\1/p' |
        LC_ALL=C sort -u
}

function radwork_slug ## <text> - the description as a name slug, empty when nothing is left
{
    printf '%s' "$1" |
        LC_ALL=C tr '[:upper:]' '[:lower:]' |
        LC_ALL=C sed -e 's/[^a-z0-9._-]\+/-/g' -e 's/--\+/-/g' -e 's/^[-._]\+//' -e 's/[-._]\+$//'
}

function radwork_exclude_worktrees ## <clone> - keep '<clone>/.worktrees/' out of 'git status'
{
    ## The line goes into '.git/info/exclude', never into a tracked '.gitignore': the main checkout
    ## has to stay byte-identical, and a tree which exists is not a fact about the project.
    local clone="$1" git_dir exclude
    git_dir="$(git -C "$clone" rev-parse --absolute-git-dir 2>/dev/null)" || return 0
    exclude="$git_dir/info/exclude"
    mkdir -p "$git_dir/info" 2>/dev/null || return 0
    if [[ ! -f "$exclude" ]] || ! LC_ALL=C grep -qxF '.worktrees/' "$exclude"; then
        printf '.worktrees/\n' >>"$exclude" || return 0
    fi
    return 0
}

# --- radwork_trust ------------------------------------------------------------------------------

function radwork_usage_trust ## [reason] - usage on stderr
{
    [[ -n "${1:-}" ]] && printf 'radwork_trust: %s\n' "$1" >&2
    printf 'usage: radwork_trust --repo <rid|path> --author <did|nid|alias> [--threshold <n>] [--json]\n' >&2
}

function radwork_trust ## see the module header
{
    ## Body of the 'radwork_trust' rule: one verdict line and the exit code which carries it.  The
    ## facts come from the backing tool, this function adds the policy (which is what the triage
    ## skill would otherwise spell out per item).
    local -a args=()
    local raw arg
    local json="" repo="" author="" threshold=""
    local value

    for raw in "$@"; do
        if [[ "$raw" == --*=* ]]; then
            args+=("${raw%%=*}" "${raw#*=}")
        else
            args+=("$raw")
        fi
    done
    local -i i=0 count=${#args[@]}
    while (( i < count )); do
        arg="${args[i]}"
        i=$(( i + 1 ))
        case "$arg" in
        --json) json=1 ;;
        --repo | --author | --threshold)
            if (( i >= count )) || [[ -z "${args[i]}" ]]; then
                radwork_usage_trust "'$arg' needs a non-empty value"
                return 2
            fi
            value="${args[i]}"
            i=$(( i + 1 ))
            case "$arg" in
            --repo) repo="$value" ;;
            --author) author="$value" ;;
            --threshold) threshold="$value" ;;
            esac
            ;;
        *)
            radwork_usage_trust "unknown argument '$arg'"
            return 2
            ;;
        esac
    done

    [[ -n "${BAR_AGENT_JSON:-}" ]] && json=1
    if [[ -z "$repo" || -z "$author" ]]; then
        radwork_usage_trust "both --repo and --author are required"
        return 2
    fi
    if [[ -n "$threshold" && ! "$threshold" =~ ^[0-9]+$ ]]; then
        radwork_usage_trust "invalid --threshold '$threshold', want a non-negative number"
        return 2
    fi

    local tool="${RADWORK_TRIAGE_FACTS:-$HOME/.hermes/docs/hermes_src/tools/radicle_triage/triage-facts}"
    if [[ ! -x "$tool" ]]; then
        printf 'radwork_trust: the fact tool is missing or not executable: %s\n' "$tool" >&2
        return 2
    fi
    if ! command -v jq >/dev/null 2>&1; then
        printf 'radwork_trust: jq is required to read the facts\n' >&2
        return 2
    fi

    local -a cmd=("$tool" --repo "$repo" --author "$author")
    [[ -n "$threshold" ]] && cmd+=(--threshold "$threshold")
    local facts
    if ! facts="$("${cmd[@]}" 2>/dev/null)"; then
        printf 'radwork_trust: %s failed for repo %s\n' "${tool##*/}" "$repo" >&2
        return 2
    fi

    ## One jq pass, so the text form and the machine form carry the same numbers.  An author the
    ## repository cannot resolve is *not* an error of the tool: it has no data, and that is the
    ## 'unknown' verdict (exit 2), never 'untrusted'.  The fields are joined with US (0x1f) and not
    ## with a tab: an empty field has to survive the read, and IFS whitespace would collapse it.
    local fields verdict author_name delegate authored thr reason rid
    if ! fields="$(printf '%s' "$facts" | jq -r '[
            (if .contributor == true then "trusted" elif .contributor == false then "untrusted" else "unknown" end),
            (if .author == null then "-" else (.author.alias // .author.did // "-") end),
            (if .author != null and .author.is_delegate == true then "yes" else "no" end),
            ((.author.total_authored // "-") | tostring),
            ((.threshold // "-") | tostring),
            (([.reason, .error] | map(select(. != null and . != "")) | first // "-") | tostring | gsub("[[:cntrl:]]"; " ")),
            ((.rid // "-") | tostring)
        ] | join("\u001f")' 2>/dev/null)"; then
        printf 'radwork_trust: cannot read the facts of %s\n' "${tool##*/}" >&2
        return 2
    fi
    IFS=$'\037' read -r verdict author_name delegate authored thr reason rid <<<"$fields"

    if [[ -n "$json" ]]; then
        printf '%s' "$facts" | jq -c --arg verdict "$verdict" \
            '. + {bar_radwork: 1, verdict: $verdict}' 2>/dev/null ||
            printf '{"bar_radwork":1,"verdict":%s}\n' "$(radwork_json_string "$verdict")"
    else
        printf '%s author=%s delegate=%s authored=%s threshold=%s reason=%s repo=%s\n' \
            "$verdict" "$author_name" "$delegate" "$authored" "$thr" "$reason" "$rid"
    fi

    case "$verdict" in
    trusted) return 0 ;;
    untrusted) return 1 ;;
    *) return 2 ;;
    esac
}

# --- radwork_topic ------------------------------------------------------------------------------

function radwork_usage_topic ## [reason] - usage on stderr
{
    [[ -n "${1:-}" ]] && printf 'radwork_topic: %s\n' "$1" >&2
    printf 'usage: radwork_topic <class> <description> [--root <clone>] [--base <ref>] [--no-fetch] [--dry-run] [--json]\n' >&2
}

function radwork_topic_json ## <root> <name> <path> <base> <head> <fetched> - one object
{
    printf '{"bar_radwork":1,"action":"topic","root":%s,"name":%s,"path":%s,"branch":%s,"base":%s,"head":%s,"fetched":%s}\n' \
        "$(radwork_json_string "$1")" \
        "$(radwork_json_string "$2")" \
        "$(radwork_json_string "$3")" \
        "$(radwork_json_string "$2")" \
        "$(radwork_json_string "$4")" \
        "$(radwork_json_string "$5")" \
        "$(radwork_json_flag "$6")"
}

function radwork_topic ## see the module header
{
    ## Body of the 'radwork_topic' rule.  Nothing is created before the class, the name, the clone,
    ## the base and the collisions have all been resolved, so a refusal leaves no half-made tree.
    local -a args=()
    local raw arg
    local json="" root="" base="" fetch="yes" dry="" class="" description=""
    local -a classes=()
    local value line known="" slug name name_len wanted
    local tree main_tree remote="" branch="" fetched="none" behind="" head out err

    for raw in "$@"; do
        if [[ "$raw" == --*=* ]]; then
            args+=("${raw%%=*}" "${raw#*=}")
        else
            args+=("$raw")
        fi
    done
    local -i i=0 count=${#args[@]}
    while (( i < count )); do
        arg="${args[i]}"
        i=$(( i + 1 ))
        case "$arg" in
        --json) json=1 ;;
        --dry-run) dry=1 ;;
        --no-fetch) fetch="" ;;
        --root | --base)
            if (( i >= count )) || [[ -z "${args[i]}" ]]; then
                radwork_usage_topic "'$arg' needs a non-empty value"
                return 2
            fi
            value="${args[i]}"
            i=$(( i + 1 ))
            case "$arg" in
            --root) root="$value" ;;
            --base) base="$value" ;;
            esac
            ;;
        -*)
            radwork_usage_topic "unknown argument '$arg'"
            return 2
            ;;
        *)
            if [[ -z "$class" ]]; then
                class="$arg"
            elif [[ -z "$description" ]]; then
                description="$arg"
            else
                radwork_usage_topic "unexpected argument '$arg'"
                return 2
            fi
            ;;
        esac
    done

    [[ -n "${BAR_AGENT_JSON:-}" ]] && json=1
    if [[ -z "$class" || -z "$description" ]]; then
        radwork_usage_topic "a class and a description are required"
        return 2
    fi

    while IFS= read -r line; do
        classes+=("$line")
    done < <(radwork_classes)
    if (( ${#classes[@]} == 0 )); then
        printf 'radwork_topic: cannot read the branch classes from %s\n' "${BAR_DIR:-?}/git" >&2
        return 2
    fi
    wanted="${class%-}-"
    for line in "${classes[@]}"; do
        [[ "$line" == "$wanted" ]] && known=yes
    done
    if [[ -z "$known" ]]; then
        radwork_usage_topic "unknown class '$class', want one of: ${classes[*]}"
        return 2
    fi

    slug="$(radwork_slug "$description")"
    if [[ -z "$slug" ]]; then
        radwork_usage_topic "the description '$description' has no usable character"
        return 2
    fi
    name="${wanted}${slug}"
    name_len=${#name}
    if (( name_len > 40 )); then
        printf 'radwork_topic: the name is %d characters, at most 40 are allowed: %s -- shorten the description\n' \
            "$name_len" "$name" >&2
        return 1
    fi

    ## The clone: always the *main* checkout, also when the caller sits inside a topic tree.
    if [[ -n "$root" ]]; then
        if ! tree="$(git -C "$root" rev-parse --show-toplevel 2>/dev/null)"; then
            radwork_usage_topic "'$root' is not a git repository"
            return 2
        fi
    elif ! tree="$(git rev-parse --show-toplevel 2>/dev/null)"; then
        radwork_usage_topic "not inside a git repository, pass --root <clone>"
        return 2
    fi
    main_tree="$(git -C "$tree" worktree list --porcelain 2>/dev/null |
        LC_ALL=C awk '/^worktree / { print $2; exit }')"
    [[ -n "$main_tree" ]] || main_tree="$tree"

    ## The base: the clone's trunk -- upstream *plus* the local work, so branching off the remote
    ## tip would drop everything this host has not published yet.  The remote is fetched first to
    ## *know* the relation; a trunk which is behind upstream is refused, because updating the trunk
    ## is its own step with its own gate.
    if [[ -n "$base" ]]; then
        :
    else
        branch="$(git -C "$main_tree" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
        if git -C "$main_tree" remote get-url rad >/dev/null 2>&1; then
            remote="rad"
        elif git -C "$main_tree" remote get-url origin >/dev/null 2>&1; then
            remote="origin"
        fi
        if [[ -n "$remote" && -n "$fetch" ]]; then
            if git -C "$main_tree" fetch --quiet --no-tags "$remote" >/dev/null 2>&1; then
                fetched="yes"
            else
                fetched="no"
                printf 'radwork_topic: could not fetch %s, the relation to the trunk is stale\n' "$remote" >&2
            fi
        fi
        if [[ "$fetched" == "yes" && -n "$remote" && -n "$branch" ]] &&
            git -C "$main_tree" rev-parse --verify --quiet "refs/remotes/$remote/$branch" >/dev/null; then
            behind="$(git -C "$main_tree" rev-list --count "refs/heads/$branch..refs/remotes/$remote/$branch" 2>/dev/null || true)"
            if [[ -n "$behind" && "$behind" != "0" ]]; then
                printf 'radwork_topic: the trunk %s is %s commit(s) behind %s/%s -- update the trunk first (fetch, merge upstream into it, run its gate) or name the base with --base\n' \
                    "$branch" "$behind" "$remote" "$branch" >&2
                return 1
            fi
        fi
        if [[ -n "$branch" ]]; then
            base="$branch"
        else
            base="HEAD"
        fi
    fi

    local wt_dir="$main_tree/.worktrees"
    local wt_path="$wt_dir/$name"
    if [[ -e "$wt_path" ]]; then
        printf 'radwork_topic: the tree already exists: %s\n' "$wt_path" >&2
        return 1
    fi
    if git -C "$main_tree" show-ref --verify --quiet "refs/heads/$name"; then
        printf 'radwork_topic: the branch already exists: %s\n' "$name" >&2
        return 1
    fi

    if [[ -n "$dry" ]]; then
        if [[ -n "$json" ]]; then
            radwork_topic_json "$main_tree" "$name" "$wt_path" "$base" "-" "$fetched"
        else
            printf '%s  %s  base=%s\n' "$wt_path" "$name" "$base"
        fi
        return 0
    fi

    radwork_exclude_worktrees "$main_tree"
    mkdir -p "$wt_dir" 2>/dev/null || {
        printf 'radwork_topic: cannot create %s\n' "$wt_dir" >&2
        return 2
    }
    if ! err="$(git -C "$main_tree" worktree add --quiet "$wt_path" -b "$name" "$base" 2>&1)"; then
        printf 'radwork_topic: git worktree add failed: %s\n' "${err:-unknown error}" >&2
        return 2
    fi
    head="$(git -C "$wt_path" rev-parse --short HEAD 2>/dev/null || printf '-')"

    if [[ -n "$json" ]]; then
        radwork_topic_json "$main_tree" "$name" "$wt_path" "$base" "$head" "$fetched"
    else
        out="$(printf '%s  %s  base=%s  head=%s' "$wt_path" "$name" "$base" "$head")"
        printf '%s\n' "$out"
    fi
    return 0
}
