#!/usr/bin/env bar
# -*- mode: sh; sh-shell: bash -*-
# vim: set ft=bash:
# shellcheck shell=bash
# shellcheck disable=SC2016

#
# This is the default Barf rule file shipped with bar.
# It enables almost all bells and whistles here and implements some opinionated defaults.
# Please customize it for your project.
#
# the rules here ideally compose from std_rules and your custom rules.
#

# default/MAIN
MAIN: lints tests doc build

# the checks an agent runs; 'bar check agent' prints the terse contract block for them
rule agent: lints tests

# faster checking, can be used standalone or with 'watch'
fastchk: [conclusive] is_git_release_branch? lints tests doc
fastchk: [conclusive] is_git_main_branch? lints tests doc
fastchk: [conclusive] is_git_devel_branch? lints
fastchk: [conclusive] is_git_feature_branch? lint_sources
fastchk: [conclusive] is_git_bugfix_branch? lint_sources
fastchk: [conclusive] is_git_hotfix_branch? lint_sources tests
fastchk: [conclusive] is_git_improvement_branch? lint_sources
fastchk: [conclusive] is_git_doc_branch? lint_docs
fastchk: [conclusive] is_git_wip_branch? lint_sources
fastchk: [conclusive] is_git_experimental_branch? lint_sources
fastchk: lints tests doc

# automatically format fix code as much as possible and do a check
dwim: fmt fix fastchk

# rules using this should be responsible to do only work that is necessary.
PREPROCESS: fetch_resources build_assets

# commits and merges to release branches
pre-commit: is_git_release_branch? release_commit
pre-merge-commit: is_git_release_branch? release_commit
commit-msg: is_git_release_branch? release_commit_results

release_commit: main_commit 'memodb_schedule bench'
release_commit_results: main_commit_results 'memodb_result bench'

# commits and merges to the main branch
pre-commit: is_git_main_branch? main_commit
pre-merge-commit: is_git_main_branch? main_commit
commit-msg: is_git_main_branch? main_commit_results

main_commit: devel_commit (memodb_schedule audit) (memodb_schedule doc) (memodb_schedule build)
main_commit_results: devel_commit_results (memodb_result audit) (memodb_result doc) (memodb_result build)

# commits and merges to devel branches
pre-commit: is_git_devel_branch? devel_commit
pre-merge-commit: is_git_devel_branch? devel_commit
commit-msg: is_git_devel_branch? devel_commit_results

devel_commit: feature_commit (memodb_schedule tests) (memodb_schedule test_expensive)
devel_commit_results: feature_commit_results (memodb_result tests) (memodb_result test_expensive)

# commits and merges to feature branches
pre-commit: is_git_feature_branch? feature_commit
pre-merge-commit: is_git_feature_branch? feature_commit
commit-msg: is_git_feature_branch? feature_commit_results

feature_commit: lints (memodb_schedule test_units)
feature_commit_results: (memodb_result test_units)

# commits and merges to bugfix branches
pre-commit: is_git_bugfix_branch? devel_commit
pre-merge-commit: is_git_bugfix_branch? devel_commit
commit-msg: is_git_bugfix_branch? devel_commit_results

# commits and merges to hotfix branches
pre-commit: is_git_hotfix_branch? devel_commit
pre-merge-commit: is_git_hotfix_branch? devel_commit
commit-msg: is_git_hotfix_branch? devel_commit_results

# commits and merges to improvement branches
pre-commit: is_git_improvement_branch? devel_commit
pre-merge-commit: is_git_improvement_branch? devel_commit
commit-msg: is_git_improvement_branch? devel_commit_results

pre-commit: is_git_doc_branch? lint_docs
pre-merge-commit: is_git_doc_branch? lint_docs

pre-commit: is_git_wip_branch? feature_commit
pre-merge-commit: is_git_wip_branch? feature_commit
commit-msg: is_git_wip_branch? feature_commit_results

pre-commit: is_git_experimental_branch? feature_commit
pre-merge-commit: is_git_experimental_branch? feature_commit
commit-msg: is_git_experimental_branch? feature_commit_results

# called by githook, create temporary testdir and run the main rule there
SETUP: (called_as? pre-commit) testdir_enter
SETUP: (called_as? pre-merge-commit) testdir_enter
SETUP: (called_as? prepare-commit-msg) testdir_enter
SETUP: (called_as? commit-msg) testdir_enter

activate: (githook_enable~ pre-commit) (githook_enable~ pre-merge-commit) (githook_enable~ prepare-commit-msg) (githook_enable~ commit-msg)
